  "propConfig": {
    "custom.Administrator": {
      "access": "PROTECTED",
      "binding": {
        "config": {
          "struct": {
            "list": "tag(\u0027[default]_Config/Security/AdminRoles\u0027)",
            "roles": "{session.props.auth.user.roles}"
          },
          "waitOnAll": false
        },
        "transforms": [
          {
            "code": "\treturn shared.Security.hasAnyRole(value.roles, value.list)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.AlarmConfigReadOnly": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.ReadOnly}, true) || !coalesce({session.custom.Permissions.AlarmConfiguration.Edit}, false)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.CanOpenFaceplates": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.Permissions.Faceplates.Open}, false)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.EngineeringReadOnly": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.ReadOnly}, true) || !coalesce({session.custom.Permissions.Engineering.Edit}, false)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.EngineeringView": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.Permissions.Engineering.View}, false)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.IntegrationAccess": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.Permissions.TicketLogger.Settings}, false)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.Permissions": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "struct": {
            "matrix": "tag(\u0027[default]_Config/RolesPermissions\u0027)",
            "roles": "{session.props.auth.user.roles}",
            "full": "tag(\u0027[default]_Config/Security/FullPermissionRoles\u0027)",
            "inherits": "tag(\u0027[default]_Config/Security/RoleInherits\u0027)",
            "restricted": "tag(\u0027[default]_Config/Security/RestrictedRows\u0027)",
            "defaults": "tag(\u0027[default]_Config/Security/NewRoleDefaults\u0027)"
          },
          "waitOnAll": false
        },
        "transforms": [
          {
            "type": "script",
            "code": "\t# {Device: {Action: bool}} for the logged-in user from [default]_Config/RolesPermissions (one column per\n\t# role, union over the user\u0027s roles + _Config/Security/RoleInherits; FullPermissionRoles hold every\n\t# action). Struct so it re-evaluates on login / role change as well as on matrix edits.\n\t# RestrictedRows (Ticket Logger) are not implied by FullPermissionRoles (device-perms 2026-10-24).\n\t# A role without a matrix column yet holds _Config/Security/NewRoleDefaults (role-wizard 2026-10-24).\n\treturn shared.Security.permissions(value.roles, value.matrix, value.full, value.inherits,\n\t\tvalue.restricted, value.defaults)\n"
          }
        ]
      },
      "access": "PROTECTED"
    },
    "custom.ReadOnly": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "!coalesce({session.custom.Permissions.Faceplates.Operate}, false)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.TicketLogAccess": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.Permissions.TicketLogger.Use}, false)"
        }
      },
      "access": "PROTECTED"
    },
