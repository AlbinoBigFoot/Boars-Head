{
  "base": {
    "animation": {
      "duration": "1s",
      "direction": "normal",
      "iterationCount": "infinite",
      "timingFunction": "steps(1, end)",
      "keyframes": {
        "0%": {
          "backgroundColor": "var(--status-level-critical)"
        },
        "50%": {
          "backgroundColor": "var(--status-level-warning)"
        },
        "100%": {
          "backgroundColor": "var(--status-level-warning)"
        }
      }
    }
  }
}
