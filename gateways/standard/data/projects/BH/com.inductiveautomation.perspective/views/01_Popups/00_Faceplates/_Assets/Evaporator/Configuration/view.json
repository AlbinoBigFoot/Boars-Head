{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 560,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "8px",
        "height": "100%",
        "minHeight": 0,
        "overflowX": "hidden",
        "overflowY": "auto",
        "padding": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Defrost"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigSection",
          "params": {
            "title": "Defrost",
            "tagPath": "",
            "rowsJson": "[{\"leaf\":\"Cfg_DefrostStartMode\",\"kind\":\"multistate\",\"label\":\"Defrost Start Mode\",\"enum\":\"Evaporator/DefrostStartMode\"},{\"leaf\":\"Cfg_CycFans\",\"kind\":\"multistate\",\"label\":\"Idle Fan Mode\",\"enum\":\"Evaporator/CycleFans\"},{\"leaf\":\"Cfg_CoolingTime\",\"kind\":\"numeric\",\"label\":\"Cooling Time Between Defrosts\"},{\"leaf\":\"Cfg_Runtime\",\"kind\":\"numeric\",\"label\":\"Runtime Before Defrost\"}]"
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "ToD"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigSection",
          "params": {
            "title": "Time of Day Schedule",
            "tagPath": "",
            "rowsJson": "[{\"leaf\":\"Cfg_Def1stTOD\",\"kind\":\"time\",\"label\":\"1st Defrost\"},{\"leaf\":\"Cfg_Def2ndTOD\",\"kind\":\"time\",\"label\":\"2nd Defrost\"},{\"leaf\":\"Cfg_Def3rdTOD\",\"kind\":\"time\",\"label\":\"3rd Defrost\"},{\"leaf\":\"Cfg_Def4thTOD\",\"kind\":\"time\",\"label\":\"4th Defrost\"}]"
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Steps"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigSection",
          "params": {
            "title": "Defrost Steps",
            "tagPath": "",
            "rowsJson": "[{\"leaf\":\"Cfg_PumpOut\",\"kind\":\"numeric\",\"label\":\"Pump Out Time\"},{\"leaf\":\"Cfg_MainHotGas\",\"kind\":\"numeric\",\"label\":\"Hot Gas Time\"},{\"leaf\":\"Cfg_SoftHotGas\",\"kind\":\"numeric\",\"label\":\"Soft Hot Gas Time\"},{\"leaf\":\"Cfg_Bleed\",\"kind\":\"numeric\",\"label\":\"Bleed Time\"},{\"leaf\":\"Cfg_FanDelay\",\"kind\":\"numeric\",\"label\":\"Fan Delay Time\"}]"
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Temperature"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigSection",
          "params": {
            "title": "Temperature Control",
            "tagPath": "",
            "rowsJson": "[{\"leaf\":\"Temp/SP\",\"kind\":\"numeric\",\"label\":\"Zone Air Temp Setpoint\"},{\"leaf\":\"Cfg_ZoneAirTempDB\",\"kind\":\"numeric\",\"label\":\"Zone Air Temp Deadband\"}]"
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "SetBack"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigSection",
          "params": {
            "title": "Set Back",
            "tagPath": "",
            "rowsJson": "[{\"leaf\":\"SB_Enable\",\"kind\":\"checkbox\",\"label\":\"Set Back Enabled\"},{\"leaf\":\"ZAT_MinSet\",\"kind\":\"numeric\",\"label\":\"Set Back Min Temp\"},{\"leaf\":\"ZAT_MaxSet\",\"kind\":\"numeric\",\"label\":\"Set Back Max Temp\"},{\"leaf\":\"SB_StartTime\",\"kind\":\"time\",\"label\":\"Set Back Start\"},{\"leaf\":\"SB_StopTime\",\"kind\":\"time\",\"label\":\"Set Back Stop\"}]"
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
