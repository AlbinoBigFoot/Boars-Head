{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct",
          "overlays": {
            "bad": false,
            "error": false,
            "pending": false,
            "stale": false,
            "unknown": false,
            "disabled": false
          }
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "row",
      "style": {
        "classes": "faceplate-cmd-row",
        "gap": "6px",
        "flexWrap": "wrap",
        "width": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "CmdState"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-fault-chip",
            "gap": "2px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Code"
            },
            "props": {
              "text": "CMD",
              "style": {
                "classes": "faceplate-fault-code font-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "State"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', '—',\n\tif(coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Cmd/Value')), null, tag({view.params.tagPath} + '/Cmd/Value')), null),\n\t\ttry(if(isBadOrError(tag({view.params.tagPath} + '/Cmd_Open/Value')), null, tag({view.params.tagPath} + '/Cmd_Open/Value')), null), false),\n\t\t'ON', 'OFF'))"
                  },
                  "type": "expr",
                  "overlays": {
                    "bad": false,
                    "error": false,
                    "pending": false,
                    "stale": false,
                    "unknown": false,
                    "disabled": false
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Cmd/Value')), null, tag({view.params.tagPath} + '/Cmd/Value')), null),\n\t\ttry(if(isBadOrError(tag({view.params.tagPath} + '/Cmd_Open/Value')), null, tag({view.params.tagPath} + '/Cmd_Open/Value')), null), false),\n\t\t'faceplate-fault-state faceplate-ls-on',\n\t\t'faceplate-fault-state faceplate-ls-off'))"
                  },
                  "type": "expr",
                  "overlays": {
                    "bad": false,
                    "error": false,
                    "pending": false,
                    "stale": false,
                    "unknown": false,
                    "disabled": false
                  }
                }
              }
            },
            "props": {
              "text": "OFF",
              "style": {
                "classes": "faceplate-fault-state faceplate-ls-off"
              }
            }
          }
        ]
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnOpen"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tshared.ValveCommands.openValve(base, 'SO')\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly} &&\n({view.params.tagPath} = '' ||\n try(isBadOrError(tag({view.params.tagPath} + '/Rdy_Open/Value')), true) ||\n coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Rdy_Open/Value')), null, tag({view.params.tagPath} + '/Rdy_Open/Value')), null), true))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '', 'faceplate-cmd-btn font-label',\n\tif(if(coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Cfg_HasOpenLS/Value')), null, tag({view.params.tagPath} + '/Cfg_HasOpenLS/Value')), null), false),\n\t\tcoalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/OpenLS/Value')), null, tag({view.params.tagPath} + '/OpenLS/Value')), null), false),\n\t\tcoalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Cmd/Value')), null, tag({view.params.tagPath} + '/Cmd/Value')), null),\n\t\t\ttry(if(isBadOrError(tag({view.params.tagPath} + '/Cmd_Open/Value')), null, tag({view.params.tagPath} + '/Cmd_Open/Value')), null), false)),\n\t\t'faceplate-cmd-btn faceplate-cmd-btn-active font-label',\n\t\t'faceplate-cmd-btn font-label'))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          }
        },
        "props": {
          "text": "Open",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnClose"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tshared.ValveCommands.closeValve(base, 'SO')\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly} &&\n({view.params.tagPath} = '' ||\n try(isBadOrError(tag({view.params.tagPath} + '/Rdy_Close/Value')), true) ||\n coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Rdy_Close/Value')), null, tag({view.params.tagPath} + '/Rdy_Close/Value')), null), true))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '', 'faceplate-cmd-btn font-label',\n\tif(if(coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Cfg_HasClosedLS/Value')), null, tag({view.params.tagPath} + '/Cfg_HasClosedLS/Value')), null), false),\n\t\tcoalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/ClosedLS/Value')), null, tag({view.params.tagPath} + '/ClosedLS/Value')), null), false),\n\t\t!coalesce(try(if(isBadOrError(tag({view.params.tagPath} + '/Cmd/Value')), null, tag({view.params.tagPath} + '/Cmd/Value')), null),\n\t\t\ttry(if(isBadOrError(tag({view.params.tagPath} + '/Cmd_Open/Value')), null, tag({view.params.tagPath} + '/Cmd_Open/Value')), null), false)),\n\t\t'faceplate-cmd-btn faceplate-cmd-btn-active font-label',\n\t\t'faceplate-cmd-btn font-label'))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          }
        },
        "props": {
          "text": "Close",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnReset"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tshared.ValveCommands.resetValve(base)\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "Reset",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      }
    ]
  }
}
