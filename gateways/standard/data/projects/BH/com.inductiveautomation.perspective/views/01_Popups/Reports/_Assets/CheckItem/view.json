{
  "custom": {},
  "params": {
    "item": {
      "head": false,
      "id": "",
      "indent": 0,
      "kind": "",
      "label": "",
      "on": false
    }
  },
  "propConfig": {
    "params.item": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 28,
      "width": 320
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tit = self.view.params.item\n\tsystem.perspective.sendMessage('rptEdit', {'kind': it.kind, 'id': it.id, 'on': bool(self.props.selected)}, scope='page')\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Check"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!coalesce({view.params.item.head}, false)"
              },
              "type": "expr"
            }
          },
          "props.selected": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.item.on}, false)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.item.label}, '')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "form-check",
            "height": "28px",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          },
          "text": ""
        },
        "type": "ia.input.checkbox"
      },
      {
        "meta": {
          "name": "Caption"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.item.head}, false)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.item.label}, '')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "form-th",
            "paddingTop": "8px"
          },
          "text": ""
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.paddingLeft": {
        "binding": {
          "config": {
            "expression": "toStr(coalesce({view.params.item.indent}, 0) * 20) + 'px'"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "height": "28px",
        "minWidth": "0",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}