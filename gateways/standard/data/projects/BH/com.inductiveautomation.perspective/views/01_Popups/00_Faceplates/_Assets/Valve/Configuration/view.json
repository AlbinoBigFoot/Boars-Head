                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Body"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "2px",
                "width": "100%"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "TransitT"
                },
                "props": {
                  "direction": "row",
                  "alignItems": "center",
                  "justify": "space-between",
                  "style": {
                    "gap": "8px",
                    "padding": "4px 0",
                    "width": "100%"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Lbl"
                    },
                    "props": {
                      "text": "Time after command with no motion before fault",
