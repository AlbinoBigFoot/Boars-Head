                      "name": "Num"
                    },
                    "position": {
                      "basis": "80px",
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.value": {
                        "binding": {
                          "config": {
                            "mode": "indirect",
                            "tagPath": "{tagPath}/TravelTime/Value",
                            "bidirectional": true,
                            "fallbackDelay": 2.5,
                            "references": {
                              "tagPath": "{view.params.tagPath}"
                            }
                          },
                          "type": "tag"
                        }
                      },
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "!{session.custom.ReadOnly}"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "value": 0,
                      "format": "#,##0.###",
                      "style": {
                        "classes": "font-value",
                        "width": "100%"
                      }
                    }
                  }
                ]
              },
              {
