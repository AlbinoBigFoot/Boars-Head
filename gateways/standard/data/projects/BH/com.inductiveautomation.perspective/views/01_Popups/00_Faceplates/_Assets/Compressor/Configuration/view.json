{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 280,
      "width": 480
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "auto",
        "padding": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "CfgTitle"
        },
        "props": {
          "style": {
            "classes": "faceplate-section-title font-label"
          },
          "text": "PLC setpoints (writable)"
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "MinRuntime"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "marginBottom": "12px",
            "gap": "2px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "MinRuntimeLbl"
            },
            "props": {
              "style": {
                "classes": "font-label",
                "fontSize": "12px",
                "fontWeight": "600"
              },
              "text": "Min runtime set \u2014 click value to edit"
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "MinRuntimeEdit"
            },
            "propConfig": {
              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/Min_Runtime_Set')"
                  },
                  "type": "expr"
                }
              },
              "props.params.permissions": {
                "binding": {
                  "config": {
                    "expression": "!{session.custom.ReadOnly}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "params": {
                "permissions": true,
                "setpoint": false,
                "spacing": {
                  "center": false,
                  "data": 0,
                  "engUnit": 30
                },
                "tagPath": ""
              },
              "path": "03_Elements/00_Control/AnalogValue",
              "style": {
                "height": "22px"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "FailTimer"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "marginBottom": "12px",
            "gap": "2px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "FailTimerLbl"
            },
            "props": {
              "style": {
                "classes": "font-label",
                "fontSize": "12px",
                "fontWeight": "600"
              },
              "text": "Fail timer PRE \u2014 click value to edit"
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "FailTimerEdit"
            },
            "propConfig": {
              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/Fail_Timer_PRE')"
                  },
                  "type": "expr"
                }
              },
              "props.params.permissions": {
                "binding": {
                  "config": {
                    "expression": "!{session.custom.ReadOnly}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "params": {
                "permissions": true,
                "setpoint": false,
                "spacing": {
                  "center": false,
                  "data": 0,
                  "engUnit": 30
                },
                "tagPath": ""
              },
              "path": "03_Elements/00_Control/AnalogValue",
              "style": {
                "height": "22px"
              }
            }
          }
        ]
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
