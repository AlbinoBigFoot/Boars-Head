                  "config": {
                    "script": "\taction = self.view.params.btnActionSecondary\n\t\t\n\tif len(action):\n\t\tsystem.perspective.sendMessage(messageType=action, payload=self.view.params.payload, scope='page')\n\t\t\n\tsystem.perspective.closePopup(id = \"alertDialog\")"
