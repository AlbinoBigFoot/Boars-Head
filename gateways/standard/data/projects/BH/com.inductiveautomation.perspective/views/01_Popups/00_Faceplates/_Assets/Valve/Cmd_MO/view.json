{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "row",
      "style": {
        "classes": "faceplate-cmd-row",
        "gap": "6px",
        "flexWrap": "wrap",
        "width": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "CmdState"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-fault-chip",
            "gap": "2px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Code"
            },
            "props": {
              "text": "CMD",
              "style": {
                "classes": "faceplate-fault-code font-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "State"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Cmd/Value'),\n\t\ttag({view.params.tagPath} + '/Cmd_Open/Value')),\n\t\t'ON', 'OFF'))"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(tag({view.params.tagPath} + '/Cmd/Value'),\n\t\ttag({view.params.tagPath} + '/Cmd_Open/Value')),\n\t\t'faceplate-fault-state faceplate-ls-on',\n\t\t'faceplate-fault-state faceplate-ls-off'))"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "OFF",
              "style": {
                "classes": "faceplate-fault-state faceplate-ls-off"
              }
            }
          }
        ]
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnOpen"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Open/Value', base + '/Cmd_Close/Value', base + '/OpenLS/Value', base + '/ClosedLS/Value', base + '/Status/Value']\n\tvals = [True, False, True, False, 2]\n\tsystem.tag.writeBlocking([_r(p) for p in paths], vals)\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "Open",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnClose"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Open/Value', base + '/Cmd_Close/Value', base + '/OpenLS/Value', base + '/ClosedLS/Value', base + '/Status/Value']\n\tvals = [False, True, False, True, 1]\n\tsystem.tag.writeBlocking([_r(p) for p in paths], vals)\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "Close",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnReset"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tsystem.tag.writeBlocking([_r(base + '/Cmd_Reset/Value')], [True])\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "Reset",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      }
    ]
  }
}
