{
  "custom": {
    "label": "",
    "metadata": "",
    "values": {
      "temp": "",
      "status": ""
    }
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\r\n    if(\r\n        isNull({view.custom.metadata.shortDescription}) ||\r\n        {view.custom.metadata.shortDescription} = '',\r\n        if({view.params.tagPath} = '',\r\n           '',\r\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\r\n        {view.custom.metadata.shortDescription}\r\n    ),\r\n'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\r\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\r\n\ttag({view.params.tagPath} + '.Metadata'),\r\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.values.temp": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\r\n\t'',\r\n\t{view.params.tagPath} + '/Temp/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.status": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\r\n\t'',\r\n\t{view.params.tagPath} + '/Status/Value')"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 480,
      "width": 400
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#1A2329",
        "padding": "16px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.custom.label} != ''"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "#ECEFF1",
            "fontSize": "22px",
            "fontWeight": "700",
            "marginBottom": "4px"
          },
          "text": ""
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Status"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.custom.values.status}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "tagPath": ""
          },
          "path": "03_Elements/01_Status/StatusIndicator",
          "style": {
            "marginBottom": "12px"
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "AnalogValue"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.custom.values.temp}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "spacing": {
              "center": true,
              "data": 0,
              "engUnit": 30
            },
            "tagPath": ""
          },
          "path": "03_Elements/01_Status/AnalogValue",
          "style": {
            "marginBottom": "16px"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "BodyNote"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "backgroundColor": "#263238",
            "borderColor": "#37474F",
            "borderRadius": "6px",
            "borderStyle": "solid",
            "borderWidth": "1px",
            "color": "#B0BEC5",
            "fontSize": "13px",
            "padding": "12px"
          },
          "text": "Cooling Tower faceplate stub \u2014 add fan / basin / approach controls here. Bindings use tagPath + custom.*"
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "CloseButton"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\ttagPath = str(self.view.params.tagPath)\n\tlabel = str(self.view.custom.label)\n\tsystem.perspective.closePopup('ct-fp-%s' % (tagPath or label))\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "props": {
          "style": {
            "marginTop": "12px"
          },
          "text": "Close"
        }
      }
    ]
  }
}
