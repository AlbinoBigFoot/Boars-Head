{
  "custom": {
    "pax": "",
    "paxRoot": ""
  },
  "params": {
    "popupId": "",
    "tagPath": "",
    "title": ""
  },
  "propConfig": {
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.pax": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(right(coalesce({view.params.tagPath}, ''), 10) = '/Interlock', case(toStr(coalesce(try(tag(left({view.params.tagPath}, len({view.params.tagPath}) - 10) + '.TypeId'), ''), '')), 'Devices/Pump', 'Motor', 'Devices/Valve', 'Valve', 'Devices/Tank', 'Tank', 'Devices/Compressor', 'Comp', 'Devices/Evaporator', 'CG', 'Devices/ExhaustFan', 'EF', 'Devices/LTU', 'LTU', 'Devices/SafetyRelay', 'Relay', 'Devices/SuctionSequence', 'Seq', 'Devices/DischargeSequence', 'Dsq', 'Devices/Sensor', if(coalesce(try(toBoolean(tag(left({view.params.tagPath}, len({view.params.tagPath}) - 10) + '/AIn.Enabled')), false), false), 'AIn', if(coalesce(try(toBoolean(tag(left({view.params.tagPath}, len({view.params.tagPath}) - 10) + '/AInRef.Enabled')), false), false), 'AInRef', '')), 'Devices/DiscreteInput', if(coalesce(try(toBoolean(tag(left({view.params.tagPath}, len({view.params.tagPath}) - 10) + '/DIn.Enabled')), false), false), 'DIn', ''), ''), '')"
        }
      }
    },
    "custom.paxRoot": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(right(coalesce({view.params.tagPath}, ''), 10) = '/Interlock', left({view.params.tagPath}, len({view.params.tagPath}) - 10) + '/Intlk', '')"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 680,
      "width": 560
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-component container-card container-card-border faceplate faceplate-tabs-vertical",
        "height": "100%",
        "width": "100%",
        "minHeight": 0,
        "overflow": "hidden",
        "padding": "0px"
      }
    },
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "if((coalesce(try(isGood(tag({view.custom.paxRoot} + '/Cfg_Tag')), false), false) || coalesce(try(isGood(tag({view.custom.paxRoot} + '/Cfg_Desc')), false), false)), if(coalesce(try(toStr(tag({view.custom.paxRoot} + '/Cfg_Tag')), ''), '') != '', coalesce(try(toStr(tag({view.custom.paxRoot} + '/Cfg_Tag')), ''), ''), coalesce({view.params.title}, '')) + if(coalesce(try(toStr(tag({view.custom.paxRoot} + '/Cfg_Desc')), ''), '') != '', ' - ' + coalesce(try(toStr(tag({view.custom.paxRoot} + '/Cfg_Desc')), ''), ''), ''), '—')"
                  },
                  "type": "expr",
                  "overlays": {
                    "bad": false,
                    "error": false,
                    "pending": false,
                    "stale": false,
                    "unknown": false,
                    "disabled": false
                  },
                  "overlayOptOut": true
                }
              }
            },
            "props": {
              "style": {
                "classes": "faceplate-title Fonts/Title"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tpid = str(self.view.params.popupId or '').strip()\n\tif pid:\n\t\tsystem.perspective.closePopup(pid)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "style": {
                "classes": "color-icon container-icon faceplate-close",
                "minHeight": 36,
                "minWidth": 36,
                "zIndex": 41,
                "position": "relative"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "48px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "classes": "faceplate-header bg-header",
            "pointerEvents": "none",
            "zIndex": 40,
            "overflow": "hidden",
            "position": "relative"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Panel"
        },
        "position": {
          "grow": 1,
          "basis": "0px"
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/InterlockPanel",
          "params": {
            "tagPath": "",
            "vertical": true
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false,
          "style": {
            "minHeight": 0
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
