{
  "custom": {
    "inArray": false
  },
  "params": {
    "discrete": false,
    "tagPath": ""
  },
  "propConfig": {
    "custom.inArray": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "tags": "{session.custom.AdhocTrend.tags}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value.tagPath !\u003d \u0027\u0027 and len(value.tags) \u003e 0:\n\t\tif value.tagPath in value.tags:\n\t\t\treturn True\n\treturn False",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.discrete": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 120,
      "width": 180
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif len(self.session.custom.AdhocTrend.tags) \u003c 10:\n\t\ttagPath \u003d self.view.params.tagPath\n\t\tif tagPath not in self.session.custom.AdhocTrend.tags:\n\t\t\tself.session.custom.AdhocTrend.tags.append(tagPath)\n\t\t\tsystem.perspective.closePopup(\u0027ContextMenu\u0027)\n\telse:\n\t\tshared.Alerts.showAlert(state\u003d\"warning\",title\u003d\"Adhoc Trending\",message\u003d\u0027You have exceeded the limit of 10 tags, Please remove tags that are not required from the trend.\u0027,showCloseBtn\u003dFalse,btnTextPrimary\u003d\"Okay\",btnTextSecondary\u003d\"\",btnActionPrimary\u003d\"\",btnActionSecondary\u003d\"\",payload\u003d{})"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "AddToTrend"
        },
        "position": {
          "basis": "32px",
          "grow": 1
        },
        "propConfig": {
          "props.params.classes": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\r\n\t\"Container/Card Container/Icon Fonts/Header\",\r\n\t\"Container/Card Colors/Disabled Fonts/Header\"\r\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.cursor": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\r\n\t\"pointer\",\r\n\t\"auto\"\r\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.fontWeight": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\r\n\t\"500\",\r\n\t\"normal\"\r\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "name": "(+) Add to trend"
