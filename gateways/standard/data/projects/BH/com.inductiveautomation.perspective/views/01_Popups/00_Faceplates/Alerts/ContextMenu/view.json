{
  "custom": {
    "inArray": false
  },
  "params": {
    "discrete": false,
    "tagPath": ""
  },
  "propConfig": {
    "custom.inArray": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "tags": "{session.custom.AdhocTrend.tags}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value.tagPath != '' and len(value.tags) > 0:\n\t\tif value.tagPath in value.tags:\n\t\t\treturn True\n\treturn False",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.discrete": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize.height": {
      "binding": {
        "config": {
          "expression": "if({session.custom.TicketLogAccess}, 152, 120)"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 152,
      "width": 180
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\ttagPath = self.view.params.tagPath\n\tviewName = self.view.id.split('@')[0]\n\tshared.Alerts.contextMenuTicketLog(tagPath, viewName)\n\tsystem.perspective.closePopup('ContextMenu')"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "TicketLogger"
        },
        "position": {
          "basis": "32px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "params": {
            "name": "Ticket Logger",
            "classes": "container-item Fonts/Header",
            "cursor": "pointer",
            "fontWeight": "500"
          },
          "path": "01_Popups/00_Faceplates/Alerts/Menu"
        },
        "type": "ia.display.view",
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "session.custom.TicketLogAccess"
              },
              "type": "property"
            }
          },
          "position.basis": {
            "binding": {
              "config": {
                "expression": "if({session.custom.TicketLogAccess}, \"32px\", \"0px\")"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif len(self.session.custom.AdhocTrend.tags) < 10:\n\t\ttagPath = self.view.params.tagPath\n\t\tif tagPath not in self.session.custom.AdhocTrend.tags:\n\t\t\tself.session.custom.AdhocTrend.tags.append(tagPath)\n\t\t\t_pid, plots, penPlots = shared.AdhocTrend.route_new_pen(self.session.custom.AdhocTrend, tagPath)\n\t\t\tself.session.custom.AdhocTrend.plots = plots\n\t\t\tself.session.custom.AdhocTrend.penPlots = penPlots\n\t\tshared.Alerts.showAdhocTrend()\n\t\tsystem.perspective.closePopup('ContextMenu')\n\telse:\n\t\tshared.Alerts.showAlert(state=\"warning\",title=\"Adhoc Trending\",message='You have exceeded the limit of 10 tags, Please remove tags that are not required from the trend.',showCloseBtn=False,btnTextPrimary=\"Okay\",btnTextSecondary=\"\",btnActionPrimary=\"\",btnActionSecondary=\"\",payload={})\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "AddToTrend"
        },
        "position": {
          "basis": "32px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "params": {
            "name": "(+) Add to trend"
          },
          "path": "01_Popups/00_Faceplates/Alerts/Menu"
        },
        "type": "ia.display.view",
        "propConfig": {
          "props.params.classes": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\n\t\"container-item Fonts/Header\",\n\t\"container-item bg-disabled Fonts/BadData\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.cursor": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\n\t\"pointer\",\n\t\"auto\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.fontWeight": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\n\t\"500\",\n\t\"normal\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        }
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\ttagPath = self.view.params.tagPath\n\tif tagPath in self.session.custom.AdhocTrend.tags:\n\t\tself.session.custom.AdhocTrend.tags.remove(tagPath)\n\t\tsystem.perspective.closePopup('ContextMenu')"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "RemoveToTrend"
        },
        "position": {
          "basis": "32px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "params": {
            "name": "(-) Remove from trend"
          },
          "path": "01_Popups/00_Faceplates/Alerts/Menu"
        },
        "type": "ia.display.view",
        "propConfig": {
          "props.params.classes": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if({value},\n\t\"container-item Fonts/Header\",\n\t\"container-item bg-disabled Fonts/BadData\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.cursor": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if({value},\n\t\"pointer\",\n\t\"auto\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.fontWeight": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if({value},\n\t\"500\",\n\t\"normal\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        }
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\ttagPath = self.view.params.tagPath\n\tif tagPath in self.session.custom.AdhocTrend.tags:\n\t\tshared.Alerts.showAdhocTrend()\n\t\tsystem.perspective.closePopup('ContextMenu')"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "OpenTrend"
        },
        "position": {
          "basis": "32px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "params": {
            "name": "Open Trend"
          },
          "path": "01_Popups/00_Faceplates/Alerts/Menu"
        },
        "type": "ia.display.view",
        "propConfig": {
          "props.params.classes": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if({value},\n\t\"container-item Fonts/Header\",\n\t\"container-item bg-disabled Fonts/BadData\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.cursor": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if({value},\n\t\"pointer\",\n\t\"auto\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.fontWeight": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if({value},\n\t\"500\",\n\t\"normal\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        }
      }
    ],
    "events": {
      "dom": {
        "onMouseLeave": {
          "config": {
            "draggable": true,
            "id": "ContextMenu",
            "modal": false,
            "overlayDismiss": false,
            "resizable": true,
            "showCloseIcon": true,
            "type": "close",
            "viewPath": "01_Popups/00_Faceplates/Alerts/ContextMenu",
            "viewportBound": false
          },
          "scope": "C",
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-component container-card"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
