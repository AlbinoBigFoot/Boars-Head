{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "row",
      "style": {
        "classes": "faceplate-cmd-row",
        "gap": "6px",
        "flexWrap": "wrap",
        "width": "100%"
      }
    },
    "children": [
      {
        "type": "ia.input.numeric-entry-field",
        "meta": {
          "name": "PositionEntry"
        },
        "position": {
          "basis": "100px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '', 0, coalesce(tag({view.params.tagPath} + '/Cmd_Position/Value'), 0))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "format": "#0.0",
          "style": {
            "classes": "font-value",
            "height": "28px",
            "width": "100%"
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnApply"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tval = self.getSibling('PositionEntry').props.value\n\tpaths = [base + '/Cmd_Position/Value']\n\tvals = [float(val) if val is not None else 0.0]\n\tsystem.tag.writeBlocking(paths, vals)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "Apply",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "BtnReset"
        },
        "position": {
          "basis": "72px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Reset/Value']\n\tvals = [True]\n\tsystem.tag.writeBlocking(paths, vals)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "!{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "Reset",
          "style": {
            "classes": "faceplate-cmd-btn font-label"
          },
          "primary": false
        }
      }
    ]
  }
}
