{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 780,
      "width": 960
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Icon"
                },
                "position": {
                  "basis": "28px",
                  "shrink": 0
                },
                "props": {
                  "path": "material/show_chart",
                  "style": {
                    "classes": "color-icon"
                  }
                },
                "type": "ia.display.icon"
              },
              {
                "meta": {
                  "name": "Title"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "style": {
                    "classes": "Fonts/Title",
                    "paddingBottom": "0.5%",
                    "paddingLeft": "0.5%",
                    "paddingTop": "0.5%"
                  },
                  "text": "Adhoc Trending"
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "TitleRow"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "props": {
              "alignItems": "center",
              "gap": 8
            },
            "type": "ia.container.flex"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tfrom shared import Alerts\n\tAlerts.closeAdhocTrendConfig()\n\tsystem.perspective.closePopup(\u0027AdhocTrend\u0027)"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "style": {
                "classes": "color-icon container-icon adhoc-trend-faceplate-close",
                "cursor": "pointer",
                "minHeight": 36,
                "minWidth": 36,
                "padding": 4,
                "position": "relative",
                "zIndex": 41
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "classes": "container-header adhoc-trend-faceplate-header",
            "flexShrink": 0,
            "paddingLeft": "4px",
            "paddingRight": "4px",
            "position": "relative",
            "zIndex": 40
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Trend"
        },
        "position": {
          "basis": "0px",
          "grow": 1
        },
        "props": {
          "params": {
            "faceplateMode": true
          },
          "path": "98_Configuration/AdhocTrend/Trend",
          "style": {
            "classes": "adhoc-trend-faceplate-embed",
            "height": "100%",
            "margin": "0",
            "minHeight": 0,
            "minWidth": 0,
            "overflow": "hidden",
            "padding": "0",
            "position": "relative",
            "width": "100%",
            "zIndex": 1
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "contextMenu": {},
      "name": "root"
    },
    "propConfig": {
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}[\u0027items\u0027]) \u003e 0 \u0026\u0026 {value}[\u0027permission\u0027]",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath \u003d \u0027\u0027\n\ttry:\n\t\ttagPath \u003d self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() \u003d\u003d \u0027\u0027:\n\t\ttagPath \u003d value.tagPath + self.view.id.split(\u0027@\u0027)[0].split(\u0027/\u0027)[-1]\n\titems \u003d [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component Fonts/Value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split(\u0027@\u0027)[0], \u0027sender\u0027: self.view.id\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "boxSizing": "border-box",
        "classes": "bg-container container-card container-card-border adhoc-trend-faceplate",
        "height": "100%",
        "margin": "0",
        "minHeight": 0,
        "minWidth": 0,
        "overflow": "hidden",
        "paddingBottom": "4px",
        "paddingLeft": "4px",
        "paddingRight": "4px",
        "paddingTop": "0px",
        "width": "100%"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender \u003d payload.get(\u0027sender\u0027)\n\tif sender and sender !\u003d self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload[\u0027tagPath\u0027], payload[\u0027viewName\u0027])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
}