{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 780,
      "width": 960
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-container container-card container-card-border adhoc-trend-faceplate",
        "height": "100%",
        "width": "100%",
        "overflow": "hidden",
        "paddingLeft": "4px",
        "paddingRight": "4px",
        "paddingBottom": "4px",
        "minHeight": 0,
        "minWidth": 0,
        "paddingTop": "0px",
        "margin": "0",
        "boxSizing": "border-box"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "classes": "container-header adhoc-trend-faceplate-header",
            "paddingLeft": "4px",
            "paddingRight": "4px",
            "position": "relative",
            "zIndex": 40,
            "flexShrink": 0
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "TitleRow"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "props": {
              "alignItems": "center",
              "gap": 8
            },
            "children": [
              {
                "type": "ia.display.icon",
                "meta": {
                  "name": "Icon"
                },
                "position": {
                  "basis": "28px",
                  "shrink": 0
                },
                "props": {
                  "path": "material/show_chart",
                  "style": {
                    "classes": "color-icon"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "position": {
                  "grow": 1,
                  "basis": "auto"
                },
                "props": {
                  "text": "Adhoc Trending",
                  "style": {
                    "classes": "font-title",
                    "paddingBottom": "0.5%",
                    "paddingLeft": "0.5%",
                    "paddingTop": "0.5%"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.display.icon",
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "style": {
                "classes": "color-icon container-icon adhoc-trend-faceplate-close",
                "cursor": "pointer",
                "position": "relative",
                "zIndex": 41,
                "minWidth": 36,
                "minHeight": 36,
                "padding": 4
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tfrom shared import Alerts\n\tAlerts.closeAdhocTrendConfig()\n\tsystem.perspective.closePopup('AdhocTrend')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Trend"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "path": "98_Configuration/AdhocTrend/Trend",
          "params": {
            "faceplateMode": true
          },
          "style": {
            "height": "100%",
            "width": "100%",
            "overflow": "hidden",
            "minHeight": 0,
            "minWidth": 0,
            "position": "relative",
            "zIndex": 1,
            "classes": "adhoc-trend-faceplate-embed",
            "margin": "0",
            "padding": "0"
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
