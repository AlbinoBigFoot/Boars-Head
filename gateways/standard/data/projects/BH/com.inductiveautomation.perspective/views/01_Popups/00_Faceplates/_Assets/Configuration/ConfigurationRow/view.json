{
  "custom": {
    "dataType": "",
    "isBoolean": false,
    "isMultistate": false,
    "metadata": "",
    "permDevice": "",
    "roSetpoint": true,
    "tipSetpoint": ""
  },
  "params": {
    "highlightRow": false,
    "tagPath": ""
  },
  "propConfig": {
    "custom.dataType": {
      "binding": {
        "config": {
          "expression": "if(try(isGood(tag({view.params.tagPath} + '.DataType')), false),\n   toStr(try(if(!isGood(tag({view.params.tagPath} + '.DataType')), null, tag({view.params.tagPath} + '.DataType')), null)),\n   '')"
        },
        "type": "expr",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.isBoolean": {
      "binding": {
        "config": {
          "expression": "{view.custom.dataType} = 'Boolean'"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}.Metadata"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.isMultistate": {
      "binding": {
        "config": {
          "path": "view.custom.metadata"
        },
        "transforms": [
          {
            "code": "\t# Multistate only when metadata defines states — not every Int4\n\t# (e.g. TravelTime is Int4 seconds and must use AnalogInput).\n\tif value is None or value == '':\n\t\treturn False\n\tstates = None\n\ttry:\n\t\tstates = value.get('states') if hasattr(value, 'get') else value['states']\n\texcept:\n\t\ttry:\n\t\t\tstates = value['states']\n\t\texcept:\n\t\t\tstates = None\n\treturn bool(states)",
            "type": "script"
          }
        ],
        "type": "property"
      },
      "persistent": true
    },
    "params.highlightRow": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.permDevice": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', coalesce(try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag(left(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')), lastIndexOf(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')), '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), ''))"
        }
      },
      "access": "PROTECTED"
    },
    "custom.roSetpoint": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.ReadOnly}, true) || !coalesce(coalesce(try({session.custom.Permissions}[{view.custom.permDevice}]['Setpoint'], null), try({session.custom.Permissions}[{view.custom.permDevice}]['Configuration'], null)), true)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.tipSetpoint": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!coalesce({session.custom.ReadOnly}, true) && coalesce({view.custom.roSetpoint}, false), 'Not Permitted: ' + {view.custom.permDevice} + ' / ' + if(isNull(try({session.custom.Permissions}[{view.custom.permDevice}]['Setpoint'], null)), 'Configuration', 'Setpoint') + ' (Roles & Permissions)', '')"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 36,
      "width": 704
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AnalogView"
        },
        "position": {
          "basis": "320px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{view.custom.isBoolean} && !{view.custom.isMultistate}"
              },
              "type": "expr"
            }
          },
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          },
          "props.params.permission": {
            "binding": {
              "config": {
                "expression": "!{view.custom.roSetpoint}"
              },
              "type": "expr"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tipSetpoint} != ''"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tipSetpoint}"
              }
            }
          }
        },
        "props": {
          "params": {
            "permission": true
          },
          "path": "03_Elements/00_Control/AnalogInput"
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "MultiStateView"
        },
        "position": {
          "basis": "320px",
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.custom.isMultistate} || {view.custom.isBoolean}"
              },
              "type": "expr"
            }
          },
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          },
          "props.params.permission": {
            "binding": {
              "config": {
                "expression": "!{view.custom.roSetpoint}"
              },
              "type": "expr"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tipSetpoint} != ''"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tipSetpoint}"
              }
            }
          }
        },
        "props": {
          "params": {
            "permission": true
          },
          "path": "03_Elements/00_Control/MultiStateInput"
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "props.style.background": {
        "binding": {
          "config": {
            "expression": "if ({view.params.highlightRow},\n\t'var(--neutral-50)',\n\t'var(--neutral-40)')  "
          },
          "type": "expr"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "props": {
      "alignContent": "center",
      "alignItems": "center",
      "justify": "flex-start",
      "style": {
        "classes": "faceplate-config-row",
        "gap": "8px",
        "overflow": "visible",
        "paddingLeft": "12px",
        "paddingRight": "12px",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
