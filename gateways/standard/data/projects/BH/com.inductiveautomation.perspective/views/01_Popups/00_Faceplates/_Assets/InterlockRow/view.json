{
  "custom": {
    "channel": 0,
    "nn": "00",
    "qg0": null,
    "permDevice": "",
    "roInterlocks": true,
    "tipInterlocks": "",
    "qg1": null
  },
  "params": {
    "interlockPath": "",
    "channel": 0
  },
  "propConfig": {
    "params.interlockPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.channel": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.nn": {
      "binding": {
        "config": {
          "expression": "if({view.params.channel} < 10, '0' + toStr({view.params.channel}), toStr({view.params.channel}))"
        },
        "type": "expr"
      }
    },
    "custom.qg0": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.interlockPath} + '/Cfg_CondTxt' + {view.custom.nn} + '/Value')), tag({view.params.interlockPath} + '/Cfg_CondTxt' + {view.custom.nn} + '/Value'), null), null)"
        }
      }
    },
    "custom.permDevice": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.interlockPath}, '') = '', '', coalesce(try(lookup({view.custom.qg1}, toStr(coalesce(try(tag({view.params.interlockPath} + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup({view.custom.qg1}, toStr(coalesce(try(tag(left({view.params.interlockPath}, lastIndexOf({view.params.interlockPath}, '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup({view.custom.qg1}, toStr(coalesce(try(tag(left(left({view.params.interlockPath}, lastIndexOf({view.params.interlockPath}, '/')), lastIndexOf(left({view.params.interlockPath}, lastIndexOf({view.params.interlockPath}, '/')), '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), ''))"
        }
      },
      "access": "PROTECTED"
    },
    "custom.roInterlocks": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.ReadOnly}, true) || !coalesce(try({session.custom.Permissions}[{view.custom.permDevice}]['Interlocks'], null), true)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.tipInterlocks": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!coalesce({session.custom.ReadOnly}, true) && coalesce({view.custom.roInterlocks}, false), 'Not Permitted: ' + {view.custom.permDevice} + ' / ' + 'Interlocks' + ' (Roles & Permissions)', '')"
        }
      }
    },
    "custom.qg1": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag('[default]_Config/Security/DeviceTypes')), tag('[default]_Config/Security/DeviceTypes'), null), null)"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 500
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "struct": {
              "path": "{view.params.interlockPath}",
              "ch": "{view.params.channel}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\tpath = value.get('path') or ''\n\tch = int(value.get('ch') or 0)\n\tbase = 'faceplate-interlock-row'\n\ttry:\n\t\tsts = int(system.tag.readBlocking([path + '/Sts_Intlk/Value'])[0].value or 0)\n\t\tif sts & (1 << ch):\n\t\t\treturn base + ' faceplate-interlock-fault'\n\t\treturn base + ' faceplate-interlock-ok'\n\texcept:\n\t\treturn base",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "faceplate-interlock-row",
        "gap": "8px",
        "padding": "0px 12px",
        "overflow": "auto",
        "minHeight": "40px",
        "height": "40px",
        "width": "100%",
        "boxSizing": "border-box"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "CondLbl"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "coalesce({view.custom.qg0}, 'Interlock ' + {view.custom.nn})"
              },
              "type": "expr",
              "overlayOptOut": true
            }
          }
        },
        "props": {
          "style": {
            "classes": "Fonts/Label faceplate-interlock-cond",
            "overflow": "auto"
          },
          "text": ""
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "StatusCode"
        },
        "position": {
          "basis": "56px",
          "shrink": 0,
          "grow": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "path": "{view.params.interlockPath}",
                  "ch": "{view.params.channel}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tpath = value.get('path') or ''\n\tch = int(value.get('ch') or 0)\n\ttry:\n\t\tsts = int(system.tag.readBlocking([path + '/Sts_Intlk/Value'])[0].value or 0)\n\t\tif sts & (1 << ch):\n\t\t\treturn 'FLT'\n\t\treturn 'OK'\n\texcept:\n\t\treturn '\u2014'",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Fonts/Value faceplate-interlock-sts",
            "overflow": "auto"
          },
          "text": "\u2014"
        }
      },
      {
        "type": "ia.input.checkbox",
        "meta": {
          "name": "Bypass"
        },
        "position": {
          "basis": "36px",
          "shrink": 0,
          "grow": 0
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "base": "{view.params.interlockPath}",
                  "nn": "{view.custom.nn}"
                },
                "tagPath": "{base}/MSet_Bypass{nn}/Value"
              },
              "type": "tag",
              "bidirectional": true
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "struct": {
                  "path": "{view.params.interlockPath}",
                  "ch": "{view.params.channel}",
                  "ro": "{view.custom.roInterlocks}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value.get('ro'):\n\t\treturn False\n\tpath = value.get('path') or ''\n\tch = int(value.get('ch') or 0)\n\ttry:\n\t\tcfg = int(system.tag.readBlocking([path + '/Cfg_Bypassable/Value'])[0].value or 0)\n\t\treturn bool(cfg & (1 << ch))\n\texcept:\n\t\treturn False",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "expression": "''"
              },
              "type": "expr"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tipInterlocks} != ''"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.tipInterlocks}"
              }
            }
          }
        },
        "props": {
          "text": "",
          "textPosition": "right",
          "style": {
            "classes": "faceplate-interlock-bypass",
            "overflow": "auto"
          }
        }
      }
    ],
    "events": {
      "dom": {
        "contextmenu": {
          "config": {
            "script": "\tshared.ticketLog.promptFromEvent(self, event)"
          },
          "scope": "G",
          "type": "script"
        }
      },
      "component": {
        "ticketLog": {
          "config": {
            "script": "\tshared.ticketLog.handleMessage(self, payload)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    }
  }
}
