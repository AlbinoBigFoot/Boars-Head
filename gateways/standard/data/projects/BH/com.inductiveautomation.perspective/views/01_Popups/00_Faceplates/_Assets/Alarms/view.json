{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 300,
      "width": 400
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden",
        "minHeight": 0,
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.display.alarmstatustable",
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.filters.active.conditions.source": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '' || lastIndexOf({view.params.tagPath}, ']') < 0,\n  'prov:none:/tag:__unbound__',\n  try(\n'prov:' + subString({view.params.tagPath}, 1, lastIndexOf({view.params.tagPath}, ']')) +\n':/tag:' + subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, ']') + 1) + '*',\n'prov:none:/tag:__unbound__'))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          },
          "props.enableAcknowledge": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({session.custom.Permissions.AlarmSummary.Acknowledge}, false)"
              }
            }
          }
        },
        "props": {
          "columns": {
            "active": {
              "activeTime": {
                "width": 110
              },
              "displayPath": {
                "enabled": false,
                "width": 175
              },
              "label": {
                "enabled": true,
                "order": 1
              },
              "name": {
                "enabled": false
              },
              "priority": {
                "enabled": false
              },
              "source": {
                "enabled": false
              },
              "state": {
                "width": 100
              }
            }
          },
          "enableShelve": false,
          "enableUnshelve": false,
          "filters": {
            "active": {
              "conditions": {},
              "priorities": {
                "critical": false
              },
              "states": {
                "clearUnacked": false
              }
            }
          },
          "pager": {
            "enabled": false
          },
          "responsive": {
            "enabled": true
          },
          "style": {
            "classes": "Fonts/Label",
            "marginBottom": "2px",
            "width": "100%"
          },
          "toolbar": {
            "enableConfiguration": false,
            "enablePreFilters": false,
            "enabled": false
          },
          "rowStyles": {
            "activeAcked": {
              "base": {
                "fontSize": "0.85em",
                "fontWeight": "500"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "var(--alarm-critical-ack)",
                  "classes": "alarm-row-critical-ack",
                  "color": "var(--alarm-row-fg-light)"
                },
                "high": {
                  "backgroundColor": "var(--alarm-high-ack)",
                  "classes": "alarm-row-high-ack",
                  "color": "var(--alarm-row-fg-light)"
                },
                "low": {
                  "backgroundColor": "var(--alarm-low-ack)",
                  "classes": "alarm-row-low-ack",
                  "color": "var(--alarm-row-fg-light)"
                },
                "medium": {
                  "backgroundColor": "var(--alarm-medium-ack)",
                  "classes": "alarm-row-medium-ack",
                  "color": "var(--alarm-row-fg-light)"
                }
              }
            },
            "activeUnacked": {
              "base": {
                "fontSize": "0.85em",
                "fontWeight": "500"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "var(--alarm-critical)",
                  "classes": "alarm-row-critical",
                  "color": "var(--alarm-row-fg-light)"
                },
                "high": {
                  "backgroundColor": "var(--alarm-high)",
                  "classes": "alarm-row-high",
                  "color": "var(--alarm-row-fg-light)"
                },
                "low": {
                  "backgroundColor": "var(--alarm-low)",
                  "classes": "alarm-row-low",
                  "color": "var(--alarm-row-fg-light)"
                },
                "medium": {
                  "backgroundColor": "var(--alarm-medium)",
                  "classes": "alarm-row-medium",
                  "color": "var(--alarm-row-fg-dark)"
                }
              }
            },
            "clearAcked": {
              "base": {
                "classes": "alarm-row-cleared",
                "fontSize": "0.85em"
              },
              "priorities": {
                "critical": {
                  "classes": "alarm-row-cleared"
                },
                "high": {
                  "classes": "alarm-row-cleared"
                },
                "low": {
                  "classes": "alarm-row-cleared"
                },
                "medium": {
                  "classes": "alarm-row-cleared"
                }
              }
            },
            "clearUnacked": {
              "base": {
                "classes": "alarm-row-cleared",
                "fontSize": "0.85em"
              },
              "priorities": {
                "critical": {
                  "classes": "alarm-row-cleared"
                },
                "high": {
                  "classes": "alarm-row-cleared"
                },
                "low": {
                  "classes": "alarm-row-cleared"
                },
                "medium": {
                  "classes": "alarm-row-cleared"
                }
              }
            }
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": ""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component Fonts/Value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0], 'sender': self.view.id\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct",
          "overlays": {
            "bad": false,
            "error": false,
            "pending": false,
            "stale": false,
            "unknown": false,
            "disabled": false
          }
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
