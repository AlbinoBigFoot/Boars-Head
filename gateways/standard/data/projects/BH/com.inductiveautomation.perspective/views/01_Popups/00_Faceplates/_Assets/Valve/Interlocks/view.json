{
  "custom": {
    "pax": "",
    "qg0": null,
    "qg1": null,
    "permDevice": "",
    "roInterlocks": true,
    "tipInterlocks": ""
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.pax": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', case(toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), 'Devices/Pump', 'Motor', 'Devices/Valve', 'Valve', 'Devices/Tank', 'Tank', 'Devices/Compressor', 'Comp', 'Devices/Evaporator', 'CG', 'Devices/ExhaustFan', 'EF', 'Devices/LTU', 'LTU', 'Devices/SafetyRelay', 'Relay', 'Devices/SuctionSequence', 'Seq', 'Devices/DischargeSequence', 'Dsq', 'Devices/Sensor', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AIn.Enabled')), false), false), 'AIn', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AInRef.Enabled')), false), false), 'AInRef', '')), 'Devices/DiscreteInput', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/DIn.Enabled')), false), false), 'DIn', ''), ''))"
        }
      }
    },
    "custom.qg0": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.tagPath} + '/Valve/Sts_Disabled')), tag({view.params.tagPath} + '/Valve/Sts_Disabled'), null), null)"
        }
      }
    },
    "custom.qg1": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.tagPath} + '/Valve/Sts_BypActive')), tag({view.params.tagPath} + '/Valve/Sts_BypActive'), null), null)"
        }
      }
    },
    "custom.permDevice": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', coalesce(try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag(left(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')), lastIndexOf(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')), '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), ''))"
        }
      },
      "access": "PROTECTED"
    },
    "custom.roInterlocks": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.ReadOnly}, true) || !coalesce(try({session.custom.Permissions}[{view.custom.permDevice}]['Interlocks'], null), true)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.tipInterlocks": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!coalesce({session.custom.ReadOnly}, true) && coalesce({view.custom.roInterlocks}, false), 'Not Permitted: ' + {view.custom.permDevice} + ' / ' + 'Interlocks' + ' (Roles & Permissions)', '')"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 420
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "8px",
        "overflowX": "hidden",
        "overflowY": "auto",
        "padding": "4px",
        "minHeight": 0,
        "height": "100%"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "cancel",
          "pageScope": true,
          "script": "\tpass\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "writeValue",
          "pageScope": true,
          "script": "\tpath = payload.get('tagPath') if payload else None\n\tbase = self.view.params.tagPath or ''\n\tif not path or not base:\n\t\treturn\n\tleaf = str(path).rstrip('/').split('/')\n\tcmd = leaf[-2] if len(leaf) >= 2 and leaf[-1] == 'Value' else leaf[-1]\n\tif cmd == 'Cmd_Enable':\n\t\tshared.ValveCommands.enableDevice(base)\n\telif cmd == 'Cmd_Disable':\n\t\tshared.ValveCommands.disableDevice(base)\n\telif cmd in ('Cmd_Bypass', 'Sts_BypActive'):\n\t\tval = payload.get('value') if payload else None\n\t\tshared.ValveCommands.bypassDevice(base, val)\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "DeviceBypass"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "props": {
              "text": "Device / Bypass",
              "style": {
                "classes": "faceplate-section-title Fonts/Label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Body"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "8px",
                "width": "100%",
                "overflow": "hidden"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "StatusLbl"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} != '' && coalesce(try(isNull({view.custom.qg0}), true), true), '—', if({view.params.tagPath} = '', '—',\n\tif(coalesce(try(if(isNull({view.custom.qg0}), null, {view.custom.qg0}), null), false),\n\t\t'DISABLED', 'ENABLED')))"
                      },
                      "type": "expr",
                      "overlays": {
                        "bad": false,
                        "error": false,
                        "pending": false,
                        "stale": false,
                        "unknown": false,
                        "disabled": false
                      },
                      "overlayOptOut": true
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.params.tagPath} != '' && coalesce(try(isNull({view.custom.qg0}), true), true), 'Fonts/Value value-bad', 'Fonts/Value')"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "props": {
                  "text": "ENABLED",
                  "style": {
                    "classes": "Fonts/Value"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "BypLbl"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} != '' && coalesce(try(isNull({view.custom.qg1}), true), true), '—', if({view.params.tagPath} = '', '',\n\tif(coalesce(try(if(isNull({view.custom.qg1}), null, {view.custom.qg1}), null), false),\n\t\t'BYPASS ACTIVE — interlocks skipped',\n\t\t'Interlocks in service')))"
                      },
                      "type": "expr",
                      "overlays": {
                        "bad": false,
                        "error": false,
                        "pending": false,
                        "stale": false,
                        "unknown": false,
                        "disabled": false
                      },
                      "overlayOptOut": true
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} != '' && coalesce(try(isNull({view.custom.qg1}), true), true), 'Fonts/Label value-bad', if(coalesce(try(if(isNull({view.custom.qg1}), null, {view.custom.qg1}), null), false),\n\t'Fonts/Label faceplate-bypass-banner',\n\t'Fonts/Label'))"
                      },
                      "type": "expr",
                      "overlays": {
                        "bad": false,
                        "error": false,
                        "pending": false,
                        "stale": false,
                        "unknown": false,
                        "disabled": false
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "props": {
                  "text": "Interlocks in service",
                  "style": {
                    "classes": "Fonts/Label"
                  }
                }
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "Cmds"
                },
                "props": {
                  "direction": "row",
                  "style": {
                    "gap": "6px",
                    "flexWrap": "wrap"
                  }
                },
                "children": [
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BtnEnable"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tif self.view.custom.pax:\n\t\treturn  # pax-bindings: live PLC object, read only\n\tif self.view.custom.roInterlocks:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tshared.Alerts.confirmApplyWrite(\n\t\tlabel='Enable device',\n\t\ttagPath=base + '/Valve/MCmd_Enable',\n\t\tnewValue=True,\n\t\toldValue=False,\n\t\textraPayload={'viewName': self.view.id.split('@')[0], 'skipWrite': True},\n\t)\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "(!{view.custom.roInterlocks}) && coalesce({view.custom.pax}, '') = ''"
                          },
                          "type": "expr"
                        }
                      },
                      "props.style.classes": {
                        "binding": {
                          "config": {
                            "expression": "if(coalesce(try(if(isNull({view.custom.qg0}), null, {view.custom.qg0}), null), false),\n\t'faceplate-cmd-btn Fonts/Label',\n\t'faceplate-cmd-btn faceplate-cmd-btn-active Fonts/Label')"
                          },
                          "type": "expr",
                          "overlays": {
                            "bad": false,
                            "error": false,
                            "pending": false,
                            "stale": false,
                            "unknown": false,
                            "disabled": false
                          },
                          "overlayOptOut": true
                        }
                      },
                      "meta.tooltip.enabled": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.tipInterlocks} != ''"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.tipInterlocks}"
                          }
                        }
                      }
                    },
                    "props": {
                      "text": "Enable",
                      "style": {
                        "classes": "faceplate-cmd-btn Fonts/Label",
                        "width": "100%"
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BtnDisable"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tif self.view.custom.pax:\n\t\treturn  # pax-bindings: live PLC object, read only\n\tif self.view.custom.roInterlocks:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tshared.Alerts.confirmApplyWrite(\n\t\tlabel='Disable device',\n\t\ttagPath=base + '/Valve/MCmd_Disable',\n\t\tnewValue=True,\n\t\toldValue=False,\n\t\textraPayload={'viewName': self.view.id.split('@')[0], 'skipWrite': True},\n\t)\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "(!{view.custom.roInterlocks}) && coalesce({view.custom.pax}, '') = ''"
                          },
                          "type": "expr"
                        }
                      },
                      "props.style.classes": {
                        "binding": {
                          "config": {
                            "expression": "if(coalesce(try(if(isNull({view.custom.qg0}), null, {view.custom.qg0}), null), false),\n\t'faceplate-cmd-btn faceplate-cmd-btn-active Fonts/Label',\n\t'faceplate-cmd-btn Fonts/Label')"
                          },
                          "type": "expr",
                          "overlays": {
                            "bad": false,
                            "error": false,
                            "pending": false,
                            "stale": false,
                            "unknown": false,
                            "disabled": false
                          },
                          "overlayOptOut": true
                        }
                      },
                      "meta.tooltip.enabled": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.tipInterlocks} != ''"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.tipInterlocks}"
                          }
                        }
                      }
                    },
                    "props": {
                      "text": "Disable",
                      "style": {
                        "classes": "faceplate-cmd-btn Fonts/Label",
                        "width": "100%"
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BtnBypass"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tif self.view.custom.pax:\n\t\treturn  # pax-bindings: live PLC object, read only\n\tif self.view.custom.roInterlocks:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\ton = False\n\ttry:\n\t\ton = bool(shared.ValveCommands.bypassActive(base))\n\texcept:\n\t\tpass\n\tshared.Alerts.confirmApplyWrite(\n\t\tlabel='Clear interlock bypass' if on else 'Bypass interlocks',\n\t\ttagPath=base + '/Valve/Sts_BypActive',\n\t\tnewValue=not on,\n\t\toldValue=on,\n\t\textraPayload={'viewName': self.view.id.split('@')[0], 'skipWrite': True},\n\t)\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "(!{view.custom.roInterlocks}) && coalesce({view.custom.pax}, '') = ''"
                          },
                          "type": "expr"
                        }
                      },
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "if({view.params.tagPath} != '' && coalesce(try(isNull({view.custom.qg1}), true), true), '—', if(coalesce(try(if(isNull({view.custom.qg1}), null, {view.custom.qg1}), null), false),\n\t'Bypass On',\n\t'Bypass'))"
                          },
                          "type": "expr",
                          "overlays": {
                            "bad": false,
                            "error": false,
                            "pending": false,
                            "stale": false,
                            "unknown": false,
                            "disabled": false
                          },
                          "overlayOptOut": true
                        }
                      },
                      "props.style.classes": {
                        "binding": {
                          "config": {
                            "expression": "if({view.params.tagPath} != '' && coalesce(try(isNull({view.custom.qg1}), true), true), 'faceplate-cmd-btn value-bad', if(coalesce(try(if(isNull({view.custom.qg1}), null, {view.custom.qg1}), null), false),\n\t'faceplate-cmd-btn faceplate-cmd-btn-bypass Fonts/Label',\n\t'faceplate-cmd-btn Fonts/Label'))"
                          },
                          "type": "expr",
                          "overlays": {
                            "bad": false,
                            "error": false,
                            "pending": false,
                            "stale": false,
                            "unknown": false,
                            "disabled": false
                          },
                          "overlayOptOut": true
                        }
                      },
                      "meta.tooltip.enabled": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.tipInterlocks} != ''"
                          }
                        }
                      },
                      "meta.tooltip.text": {
                        "binding": {
                          "type": "expr",
                          "config": {
                            "expression": "{view.custom.tipInterlocks}"
                          }
                        }
                      }
                    },
                    "props": {
                      "text": "Bypass",
                      "style": {
                        "classes": "faceplate-cmd-btn Fonts/Label",
                        "width": "100%"
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "OvrdPermIntlk"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.params.tagPath": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/Valve/Cfg_OvrdPermIntlk')"
                      },
                      "type": "expr",
                      "overlays": {
                        "bad": false,
                        "error": false,
                        "pending": false,
                        "stale": false,
                        "unknown": false,
                        "disabled": false
                      }
                    }
                  }
                },
                "props": {
                  "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigField",
                  "params": {
                    "inputKind": "checkbox",
                    "label": "Override checkbox: only in Override mode, skip bypassable perms/intlks",
                    "tagPath": ""
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    }
  }
}
