{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 520,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "8px",
        "overflow": "auto",
        "padding": "4px",
        "minHeight": 0,
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "DeviceEnable"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "props": {
              "text": "Device / Bypass",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Body"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "2px",
                "width": "100%"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "StatusRow"
                },
                "props": {
                  "direction": "row",
                  "style": {
                    "gap": "8px",
                    "flexWrap": "wrap"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "DisabledLbl"
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Disabled/Value'), false),\n\t\t'DISABLED', 'ENABLED'))"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "ENABLED",
                      "style": {
                        "classes": "font-value"
                      }
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "BypLbl"
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "if({view.params.tagPath} = '', '',\n\tif(coalesce(tag({view.params.tagPath} + '/Interlock/Sts_BypActive/Value'), false),\n\t\t'BYPASS ACTIVE', ''))"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "",
                      "style": {
                        "classes": "font-label"
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "Cmds"
                },
                "props": {
                  "direction": "row",
                  "style": {
                    "gap": "6px",
                    "flexWrap": "wrap"
                  }
                },
                "children": [
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BtnEnable"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tsystem.tag.writeBlocking([_r(base + '/Cmd_Enable/Value')], [True])\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "!{session.custom.ReadOnly}"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "Enable",
                      "style": {
                        "classes": "faceplate-cmd-btn font-label",
                        "width": "100%"
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BtnDisable"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tsystem.tag.writeBlocking([_r(base + '/Cmd_Disable/Value')], [True])\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "!{session.custom.ReadOnly}"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "Disable",
                      "style": {
                        "classes": "faceplate-cmd-btn font-label",
                        "width": "100%"
                      }
                    }
                  },
                  {
                    "type": "ia.input.button",
                    "meta": {
                      "name": "BtnBypass"
                    },
                    "position": {
                      "basis": "100px",
                      "shrink": 0
                    },
                    "events": {
                      "component": {
                        "onActionPerformed": {
                          "config": {
                            "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tsystem.tag.writeBlocking([_r(base + '/Cmd_Bypass/Value')], [True])\n"
                          },
                          "scope": "G",
                          "type": "script"
                        }
                      }
                    },
                    "propConfig": {
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "!{session.custom.ReadOnly}"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "Bypass",
                      "style": {
                        "classes": "faceplate-cmd-btn font-label",
                        "width": "100%"
                      }
                    }
                  }
                ]
              },
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "OvrdPermIntlk"
                },
                "props": {
                  "direction": "row",
                  "alignItems": "center",
                  "justify": "space-between",
                  "style": {
                    "gap": "8px",
                    "padding": "4px 0",
                    "width": "100%"
                  }
                },
                "children": [
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Lbl"
                    },
                    "props": {
                      "text": "In Override Mode, bypass Interlocks and Permissives that can be bypassed",
                      "style": {
                        "classes": "font-label",
                        "flex": "1"
                      }
                    },
                    "position": {
                      "grow": 1
                    }
                  },
                  {
                    "type": "ia.input.checkbox",
                    "meta": {
                      "name": "Chk"
                    },
                    "position": {
                      "basis": "28px",
                      "shrink": 0
                    },
                    "propConfig": {
                      "props.selected": {
                        "binding": {
                          "config": {
                            "mode": "indirect",
                            "tagPath": "{tagPath}/Cfg_OvrdPermIntlk/Value",
                            "bidirectional": true,
                            "fallbackDelay": 2.5,
                            "references": {
                              "tagPath": "{view.params.tagPath}"
                            }
                          },
                          "type": "tag"
                        }
                      },
                      "props.enabled": {
                        "binding": {
                          "config": {
                            "expression": "!{session.custom.ReadOnly}"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "selected": false
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "SharedInterlocks"
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Interlocks",
          "params": {
            "tagPath": ""
          },
          "style": {
            "width": "100%",
            "minHeight": "200px"
          }
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        }
      }
    ]
  }
}
