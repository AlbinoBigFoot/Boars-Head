{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 560,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "",
        "overflow": "auto",
        "padding": "4px",
        "gap": "8px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ModeSection"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "qualityOf(tag({view.params.tagPath} + '/OPER/Value')) = 'Good' || qualityOf(tag({view.params.tagPath} + '/MAINT/Value')) = 'Good' || qualityOf(tag({view.params.tagPath} + '/PROG/Value')) = 'Good'"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "ModeTitle"
            },
            "props": {
              "text": "Mode",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ModeChips"
            },
            "props": {
              "direction": "row",
              "style": {
                "gap": "6px",
                "flexWrap": "wrap"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ChipMaint"
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tclicked = 'MAINT'\n\tmodes = ['OPER', 'MAINT', 'PROG']\n\tpaths = [base + '/' + m for m in modes]\n\tvals = [m == clicked for m in modes]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if(tag({view.params.tagPath} + '/MAINT/Value'), 'faceplate-mode-chip faceplate-mode-active', 'faceplate-mode-chip')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.cursor": {
                    "binding": {
                      "config": {
                        "expression": "if(!{session.custom.ReadOnly}, 'pointer', 'not-allowed')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Maint",
                  "style": {
                    "classes": "faceplate-mode-chip"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ChipProg"
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tclicked = 'PROG'\n\tmodes = ['OPER', 'MAINT', 'PROG']\n\tpaths = [base + '/' + m for m in modes]\n\tvals = [m == clicked for m in modes]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if(tag({view.params.tagPath} + '/PROG/Value'), 'faceplate-mode-chip faceplate-mode-active', 'faceplate-mode-chip')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.cursor": {
                    "binding": {
                      "config": {
                        "expression": "if(!{session.custom.ReadOnly}, 'pointer', 'not-allowed')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Prog",
                  "style": {
                    "classes": "faceplate-mode-chip"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ChipOper"
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tclicked = 'OPER'\n\tmodes = ['OPER', 'MAINT', 'PROG']\n\tpaths = [base + '/' + m for m in modes]\n\tvals = [m == clicked for m in modes]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if(tag({view.params.tagPath} + '/OPER/Value'), 'faceplate-mode-chip faceplate-mode-active', 'faceplate-mode-chip')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.cursor": {
                    "binding": {
                      "config": {
                        "expression": "if(!{session.custom.ReadOnly}, 'pointer', 'not-allowed')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Oper",
                  "style": {
                    "classes": "faceplate-mode-chip"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "StatusSection"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "StatusTitle"
            },
            "props": {
              "text": "Status",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "StatusInd"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "path": "03_Elements/01_Status/StatusIndicator",
              "params": {
                "tagPath": ""
              }
            },
            "propConfig": {
              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/Status')"
                  },
                  "type": "expr"
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "LsCodes"
            },
            "props": {
              "direction": "row",
              "style": {
                "gap": "16px",
                "marginTop": "4px",
                "flexWrap": "wrap"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "OpenLsCode"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'OpenLS: ' + if(tag({view.params.tagPath} + '/OpenLS/Value'), 'ON', 'OFF')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "OpenLS: —"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "ClosedLsCode"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'ClosedLS: ' + if(tag({view.params.tagPath} + '/ClosedLS/Value'), 'ON', 'OFF')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "ClosedLS: —"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "FailedCode"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Failed: ' + if(tag({view.params.tagPath} + '/Failed/Value'), 'YES', 'NO')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "Failed: —"
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "CmdRow"
            },
            "props": {
              "direction": "row",
              "style": {
                "classes": "faceplate-cmd-row",
                "gap": "6px",
                "flexWrap": "wrap",
                "marginTop": "8px"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "BtnOpen"
                },
                "position": {
                  "basis": "72px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Open/Value']\n\tvals = [True]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "!{session.custom.ReadOnly}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Open",
                  "style": {
                    "classes": "faceplate-cmd-btn font-label"
                  },
                  "primary": false
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "BtnClose"
                },
                "position": {
                  "basis": "72px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Close/Value']\n\tvals = [True]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "!{session.custom.ReadOnly}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Close",
                  "style": {
                    "classes": "faceplate-cmd-btn font-label"
                  },
                  "primary": false
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "BtnReset"
                },
                "position": {
                  "basis": "72px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Reset/Value']\n\tvals = [True]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "!{session.custom.ReadOnly}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Reset",
                  "style": {
                    "classes": "faceplate-cmd-btn font-label"
                  },
                  "primary": false
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "KpiSection"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "qualityOf(tag({view.params.tagPath} + '/TravelTime/Value')) = 'Good' || qualityOf(tag({view.params.tagPath} + '/TravelTime')) = 'Good'"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "KpiTitle"
            },
            "props": {
              "text": "KPI",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "TravelTime"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "classes": "faceplate-kpi-row"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "TravelLbl"
                },
                "position": {
                  "basis": "140px",
                  "shrink": 0
                },
                "props": {
                  "text": "Travel time",
                  "style": {
                    "classes": "faceplate-kpi-label font-label"
                  }
                }
              },
              {
                "type": "ia.display.view",
                "meta": {
                  "name": "TravelVal"
                },
                "position": {
                  "grow": 1
                },
                "props": {
                  "path": "03_Elements/01_Status/AnalogValue",
                  "params": {
                    "tagPath": "",
                    "setpoint": false
                  }
                },
                "propConfig": {
                  "props.params.tagPath": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/TravelTime')"
                      },
                      "type": "expr"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "CommRow"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "classes": "faceplate-kpi-row"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "CommLbl"
                },
                "position": {
                  "basis": "140px",
                  "shrink": 0
                },
                "props": {
                  "text": "Comm",
                  "style": {
                    "classes": "faceplate-kpi-label font-label"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "CommVal"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if(tag({view.params.tagPath} + '/Comm/Value'), 'OK', 'FAULT')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "—"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
