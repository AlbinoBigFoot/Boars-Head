{
  "custom": {
    "label": "",
    "metadata": "",
    "values": {
      "temp": "",
      "status": ""
    }
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\r\n    if(\r\n        isNull({view.custom.metadata.shortDescription}) ||\r\n        {view.custom.metadata.shortDescription} = '',\r\n        if({view.params.tagPath} = '',\r\n           '',\r\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\r\n        {view.custom.metadata.shortDescription}\r\n    ),\r\n'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\r\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\r\n\ttag({view.params.tagPath} + '.Metadata'),\r\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.values.temp": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\r\n\t'',\r\n\t{view.params.tagPath} + '/Temp/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.status": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\r\n\t'',\r\n\t{view.params.tagPath} + '/Status/Value')"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 480,
      "width": 400
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#1A2329",
        "padding": "16px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.custom.label} != ''"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "#ECEFF1",
            "fontSize": "22px",
            "fontWeight": "700",
            "marginBottom": "4px"
          },
          "text": ""
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Status"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.custom.values.status}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "tagPath": ""
          },
          "path": "03_Elements/01_Status/StatusIndicator",
          "style": {
            "marginBottom": "12px"
          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "AnalogValue"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.custom.values.temp}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "spacing": {
              "center": true,
              "data": 0,
              "engUnit": 30
            },
            "tagPath": ""
          },
          "path": "03_Elements/01_Status/AnalogValue",
          "style": {
            "marginBottom": "16px"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "BodyNote"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "backgroundColor": "#263238",
            "borderColor": "#37474F",
            "borderRadius": "6px",
            "borderStyle": "solid",
            "borderWidth": "1px",
            "color": "#B0BEC5",
            "fontSize": "13px",
            "padding": "12px"
          },
          "text": "Faceplate stub \u2014 add fan, defrost controls here. Bindings use tagPath + custom.*"
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "CloseButton"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\ttagPath = str(self.view.params.tagPath)\\n\tlabel = str(self.view.custom.label)\\n\tsystem.perspective.closePopup('ev-fp-%s' % (tagPath or label))\\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "props": {
          "style": {
            "marginTop": "12px"
          },
          "text": "Close"
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
