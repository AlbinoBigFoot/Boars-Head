                "position": {
                  "grow": 1
                },
                "props": {
                  "path": "03_Elements/01_Status/AnalogValue",
                  "params": {
                    "tagPath": "",
                    "setpoint": false
                  }
                },
                "propConfig": {
                  "props.params.tagPath": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/Value')"
                      },
                      "type": "expr"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
