            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "classes": "faceplate-kpi-row"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "HiHiLimLbl"
                },
                "position": {
                  "basis": "140px",
                  "shrink": 0
                },
                "props": {
                  "text": "HiHi lim",
                  "style": {
                    "classes": "faceplate-kpi-label font-label"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "HiHiLimVal"
