                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} = '', '', numberFormat(toFloat(tag({view.params.tagPath} + '/HiHiLim/Value')), '#0.0'))"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-value"
                  },
                  "text": ""
