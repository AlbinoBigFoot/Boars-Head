{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 480,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "",
        "overflow": "auto",
        "padding": "4px",
        "gap": "8px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "StatusSection"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "StatusTitle"
            },
            "props": {
              "text": "Status",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "StatusInd"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "path": "03_Elements/01_Status/StatusIndicator",
              "params": {
                "tagPath": ""
              }
            },
            "propConfig": {
              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.tagPath} = '', '', {view.params.tagPath} + '/Status')"
                  },
                  "type": "expr"
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "LimitCodes"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "4px",
                "marginTop": "4px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "LimitBits"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.tagPath} = '', '', 'HIHI ' + if(tag({view.params.tagPath} + '/HiHi/Value'), 'ACT', 'ok') + ' | ' + 'HI ' + if(tag({view.params.tagPath} + '/Hi/Value'), 'ACT', 'ok') + ' | ' + 'LO ' + if(tag({view.params.tagPath} + '/Lo/Value'), 'ACT', 'ok') + ' | ' + 'LOLO ' + if(tag({view.params.tagPath} + '/LoLo/Value'), 'ACT', 'ok') + ' | ' + 'FAIL ' + if(tag({view.params.tagPath} + '/Fail/Value'), 'ACT', 'ok'))"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "HIHI ok | HI ok | LO ok | LOLO ok | FAIL ok"
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "CmdRow"
            },
            "props": {
              "direction": "row",
              "style": {
                "classes": "faceplate-cmd-row",
                "gap": "6px",
                "flexWrap": "wrap",
                "marginTop": "8px"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "BtnReset"
                },
                "position": {
                  "basis": "88px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tpaths = [base + '/Cmd_Reset/Value']\n\tvals = [True]\n\tsystem.tag.writeBlocking(paths, vals)"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "!{session.custom.ReadOnly}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Reset",
                  "style": {
                    "classes": "faceplate-cmd-btn font-label"
                  },
                  "primary": false
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "KpiSection"
        },
        "position": {
          "shrink": 0
        },
