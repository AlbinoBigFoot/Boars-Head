                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_FullStall/Value'), false),\n\t\t'ACTIVE', 'OK'))"
                              },
                              "type": "expr"
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_FullStall/Value'), false),\n\t\t'faceplate-fault-state faceplate-fault-active',\n\t\t'faceplate-fault-state faceplate-fault-ok'))"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "text": "OK",
                          "style": {
                            "classes": "faceplate-fault-state faceplate-fault-ok"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "ia.container.flex",
                    "meta": {
                      "name": "TransitStall"
                    },
                    "position": {
                      "basis": "120px",
                      "shrink": 0
                    },
                    "props": {
                      "direction": "column",
                      "style": {
                        "classes": "faceplate-fault-chip",
                        "gap": "2px"
                      }
                    },
                    "children": [
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "Code"
                        },
                        "props": {
                          "text": "TRANSIT STALL",
                          "style": {
                            "classes": "faceplate-fault-code font-label"
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "State"
                        },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_TransitStall/Value'), false),\n\t\t'ACTIVE', 'OK'))"
                              },
                              "type": "expr"
                            }
