                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_TransitStall/Value'), false),\n\t\t'faceplate-fault-state faceplate-fault-active',\n\t\t'faceplate-fault-state faceplate-fault-ok'))"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "text": "OK",
                          "style": {
                            "classes": "faceplate-fault-state faceplate-fault-ok"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "ia.container.flex",
                    "meta": {
                      "name": "IntlkTrip"
                    },
                    "position": {
                      "basis": "120px",
                      "shrink": 0
                    },
                    "props": {
                      "direction": "column",
                      "style": {
                        "classes": "faceplate-fault-chip",
                        "gap": "2px"
                      }
                    },
                    "children": [
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "Code"
                        },
                        "props": {
                          "text": "INTLK TRIP",
                          "style": {
                            "classes": "faceplate-fault-code font-label"
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "State"
                        },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_IntlkTrip/Value'), false),\n\t\t'ACTIVE', 'OK'))"
                              },
                              "type": "expr"
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_IntlkTrip/Value'), false),\n\t\t'faceplate-fault-state faceplate-fault-active',\n\t\t'faceplate-fault-state faceplate-fault-ok'))"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "text": "OK",
                          "style": {
                            "classes": "faceplate-fault-state faceplate-fault-ok"
                          }
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "BtnAckAll"
                },
                "position": {
                  "basis": "100px",
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tpaths = [base + '/' + n + '/Value' for n in ('Ack_IOFault','Ack_FullStall','Ack_TransitStall','Ack_IntlkTrip','Cmd_ResetAckAll')]\n\tvals = [True] * len(paths)\n\tsystem.tag.writeBlocking([_r(p) for p in paths], vals)\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "!{session.custom.ReadOnly}"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "text": "Ack / Reset",
                  "style": {
                    "classes": "faceplate-cmd-btn font-label",
                    "width": "100%"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "SharedAlarms"
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Alarms",
          "params": {
            "tagPath": ""
          },
          "style": {
            "width": "100%",
            "minHeight": "120px"
          }
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property"
            }
          }
        }
      }
    ]
  }
}
