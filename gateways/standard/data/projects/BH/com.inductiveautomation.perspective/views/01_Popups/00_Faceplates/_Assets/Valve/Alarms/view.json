{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 360,
      "width": 480
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "8px",
        "overflow": "hidden",
        "padding": "4px",
        "minHeight": 0,
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "AlarmBits"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-section faceplate-section-card",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "props": {
              "text": "Valve Alarms",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Body"
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "2px",
                "width": "100%"
              }
            },
            "children": [
              {
                "type": "ia.container.flex",
                "meta": {
                  "name": "Chips"
                },
                "props": {
                  "direction": "row",
                  "style": {
                    "gap": "8px",
                    "flexWrap": "wrap"
                  }
                },
                "children": [
                  {
                    "type": "ia.container.flex",
                    "meta": {
                      "name": "IOFault"
                    },
                    "position": {
                      "basis": "120px",
                      "shrink": 0
                    },
                    "props": {
                      "direction": "column",
                      "style": {
                        "classes": "faceplate-fault-chip",
                        "gap": "2px"
                      }
                    },
                    "children": [
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "Code"
                        },
                        "props": {
                          "text": "I/O FAULT",
                          "style": {
                            "classes": "faceplate-fault-code font-label"
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "State"
                        },
                        "propConfig": {
                          "props.text": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_IOFault/Value'), false),\n\t\t'ACTIVE', 'OK'))"
                              },
                              "type": "expr"
                            }
                          },
                          "props.style.classes": {
                            "binding": {
                              "config": {
                                "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(tag({view.params.tagPath} + '/Alm_IOFault/Value'), false),\n\t\t'faceplate-fault-state faceplate-fault-active',\n\t\t'faceplate-fault-state faceplate-fault-ok'))"
                              },
                              "type": "expr"
                            }
                          }
                        },
                        "props": {
                          "text": "OK",
                          "style": {
                            "classes": "faceplate-fault-state faceplate-fault-ok"
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "ia.container.flex",
                    "meta": {
                      "name": "FullStall"
                    },
                    "position": {
                      "basis": "120px",
                      "shrink": 0
                    },
                    "props": {
                      "direction": "column",
                      "style": {
                        "classes": "faceplate-fault-chip",
                        "gap": "2px"
                      }
                    },
                    "children": [
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "Code"
                        },
                        "props": {
                          "text": "FULL STALL",
                          "style": {
                            "classes": "faceplate-fault-code font-label"
