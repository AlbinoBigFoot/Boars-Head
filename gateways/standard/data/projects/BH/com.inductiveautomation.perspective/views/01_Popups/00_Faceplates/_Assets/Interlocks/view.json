{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 480,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "faceplate-section faceplate-interlocks",
        "gap": "8px",
        "overflow": "auto",
        "padding": "4px",
        "minHeight": "0px",
        "width": "100%",
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "justify": "flex-start",
          "style": {
            "classes": "faceplate-interlock-header",
            "gap": "8px",
            "padding": "4px 0px",
            "overflow": "auto",
            "width": "100%",
            "flexShrink": 0
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "ResetBtn"
            },
            "position": {
              "basis": "100px",
              "shrink": 0,
              "grow": 0
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tif self.session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tp = base + '/Interlock/OCmd_Reset/Value'\n\tsystem.tag.writeBlocking([p], [True])"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "!{session.custom.ReadOnly} && tag({view.params.tagPath} + '/Interlock/Rdy_Reset/Value')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "Reset",
              "style": {
                "classes": "faceplate-cmd-btn font-label",
                "width": "100%"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ColHdr"
        },
        "position": {
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "8px",
            "padding": "4px 12px",
            "classes": "faceplate-interlock-colhdr",
            "width": "100%",
            "overflow": "auto",
            "flexShrink": 0
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HCond"
            },
            "position": {
              "grow": 1,
              "basis": "0px"
            },
            "props": {
              "text": "Condition",
              "style": {
                "classes": "font-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HSts"
            },
            "position": {
              "basis": "56px",
              "shrink": 0
            },
            "props": {
              "text": "Status",
              "style": {
                "classes": "font-label",
                "textAlign": "center",
                "overflow": "auto"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HByp"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
            },
            "props": {
              "text": "Byp",
              "style": {
                "classes": "font-label",
                "textAlign": "center",
                "overflow": "auto"
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "EmptyChannels"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "tagPath": "{view.params.tagPath}",
                  "sts": "tag({view.params.tagPath} + '/Interlock/Sts_Intlk/Value')",
                  "c0": "tag({view.params.tagPath} + '/Interlock/Cfg_CondTxt00/Value')"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\tbase = value.get('tagPath') or ''\n\tif not base:\n\t\treturn False\n\tilk = base + '/Interlock'\n\ttry:\n\t\tsts = int(value.get('sts') or 0)\n\t\tc0 = value.get('c0')\n\t\tif c0 is not None and str(c0).strip() != '':\n\t\t\treturn False\n\t\tif sts:\n\t\t\treturn False\n\t\tpaths = [ilk + '/Cfg_CondTxt%02d/Value' % i for i in range(1, 16)]\n\t\tqv = system.tag.readBlocking(paths)\n\t\tfor q in qv:\n\t\t\ttxt = q.value\n\t\t\tif txt is not None and str(txt).strip() != '':\n\t\t\t\treturn False\n\t\treturn True\n\texcept:\n\t\treturn True"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "text": "No named interlock conditions configured for this device.",
          "style": {
            "classes": "font-label faceplate-config-empty",
            "padding": "8px",
            "fontStyle": "italic"
          }
        }
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "Channels"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "tagPath": "{view.params.tagPath}",
                  "sts": "tag({view.params.tagPath} + '/Interlock/Sts_Intlk/Value')",
                  "c0": "tag({view.params.tagPath} + '/Interlock/Cfg_CondTxt00/Value')"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tbase = value.get('tagPath') or ''\n\tilk = (base + '/Interlock') if base else ''\n\tinstances = []\n\tif not ilk:\n\t\treturn instances\n\ttry:\n\t\tsts = int(system.tag.readBlocking([ilk + '/Sts_Intlk/Value'])[0].value or 0)\n\texcept:\n\t\tsts = 0\n\ttry:\n\t\tpaths = [ilk + '/Cfg_CondTxt%02d/Value' % i for i in range(16)]\n\t\tqv = system.tag.readBlocking(paths)\n\texcept:\n\t\tqv = [None] * 16\n\tfor i in range(16):\n\t\ttxt = qv[i].value if qv[i] is not None else ''\n\t\tlabel_ok = bool(txt) and str(txt).strip() != ''\n\t\tbit = bool(sts & (1 << i))\n\t\tif not (bit or label_ok):\n\t\t\tcontinue\n\t\tinstances.append({\n\t\t\t'instanceStyle': {'classes': 'faceplate-interlock-instance'},\n\t\t\t'instancePosition': {'basis': '40px', 'shrink': 0, 'grow': 0},\n\t\t\t'interlockPath': ilk,\n\t\t\t'channel': i\n\t\t})\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "direction": "column",
          "path": "01_Popups/00_Faceplates/_Assets/InterlockRow",
          "elementPosition": {
            "grow": 0,
            "shrink": 0,
            "basis": "40px"
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": true,
          "style": {
            "classes": "faceplate-interlock-channels",
            "overflow": "auto",
            "minHeight": "0px",
            "width": "100%"
          }
        }
      }
    ]
  }
}
