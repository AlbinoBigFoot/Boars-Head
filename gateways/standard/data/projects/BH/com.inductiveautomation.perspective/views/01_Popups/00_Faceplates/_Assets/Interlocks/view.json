{
  "custom": {},
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 480,
      "width": 520
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "faceplate-section",
        "gap": "8px",
        "overflow": "auto",
        "padding": "4px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-interlock-header faceplate-section-card",
            "gap": "4px",
            "padding": "8px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HdrTitle"
            },
            "props": {
              "text": "Interlocks",
              "style": {
                "classes": "faceplate-section-title font-label"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "AggRow"
            },
            "props": {
              "direction": "row",
              "style": {
                "gap": "12px",
                "flexWrap": "wrap"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "OkAgg"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Intlk OK: ' + if(tag({view.params.tagPath} + '/Interlock/Sts_IntlkOK/Value'), 'Yes', 'No')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label"
                  },
                  "text": "Intlk OK: \u2014"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "NbOkAgg"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'NB OK: ' + if(tag({view.params.tagPath} + '/Interlock/Sts_NBIntlkOK/Value'), 'Yes', 'No')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label"
                  },
                  "text": "NB OK: \u2014"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "BypAgg"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'Bypass: ' + if(tag({view.params.tagPath} + '/Interlock/Sts_BypActive/Value'), 'Active', 'Off')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label"
                  },
                  "text": "Bypass: \u2014"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "FoAgg"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'FirstOut: ' + if(tag({view.params.tagPath} + '/Interlock/Sts_FirstOut/Value'), 'Yes', 'No')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label"
                  },
                  "text": "FirstOut: \u2014"
                }
              }
            ]
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "ResetBtn"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tif session.custom.ReadOnly:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tp = base + '/Interlock/OCmd_Reset/Value'\n\tsystem.tag.writeBlocking([p], [True])"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "!{session.custom.ReadOnly} && tag({view.params.tagPath} + '/Interlock/Rdy_Reset/Value')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "text": "Reset",
              "style": {
                "classes": "faceplate-cmd-btn font-label"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ColHdr"
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "8px",
            "padding": "0 8px",
            "classes": "faceplate-interlock-colhdr"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HCond"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "text": "Condition",
              "style": {
                "classes": "font-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HSts"
            },
            "position": {
              "basis": "72px"
            },
            "props": {
              "text": "Status",
              "style": {
                "classes": "font-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "HByp"
            },
            "position": {
              "basis": "28px"
            },
            "props": {
              "text": "Byp",
              "style": {
                "classes": "font-label"
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "Channels"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "tagPath": "{view.params.tagPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tbase = value.get('tagPath') or ''\n\tilk = (base + '/Interlock') if base else ''\n\tinstances = []\n\tfor i in range(16):\n\t\tinstances.append({\n\t\t\t'instanceStyle': {'classes': ''},\n\t\t\t'instancePosition': {},\n\t\t\t'interlockPath': ilk,\n\t\t\t'channel': i\n\t\t})\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "direction": "column",
          "path": "01_Popups/00_Faceplates/_Assets/InterlockRow",
          "elementPosition": {
            "grow": 0
          },
          "useDefaultViewWidth": false,
          "style": {
            "overflow": "auto"
          }
        }
      }
    ]
  }
}
