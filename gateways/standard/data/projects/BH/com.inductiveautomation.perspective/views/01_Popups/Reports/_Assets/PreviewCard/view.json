    "props": {
      "alignItems": "stretch",
      "direction": "column",
      "justify": "center",
      "style": {
        "classes": "report-kpi",
        "gap": "4px",
        "height": "100%",
        "minWidth": "0",
        "padding": "12px 16px"
      }
