{
  "custom": {},
  "params": {
    "chart": {
      "series": [],
      "title": ""
    }
  },
  "propConfig": {
    "params.chart": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 236,
      "width": 800
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "basis": "18px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.chart.title}, '')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "report-row-name",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          },
          "text": ""
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Chart"
        },
        "position": {
          "basis": "210px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.series": {
            "binding": {
              "config": {
                "path": "view.params.chart.series"
              },
              "transforms": [
                {
                  "code": "\treturn list(value or [])\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "options": {
            "chart": {
              "animations": {
                "enabled": false
              },
              "background": "transparent",
              "foreColor": "var(--neutral-90)",
              "redrawOnParentResize": true,
              "redrawOnWindowResize": true,
              "toolbar": {
                "show": false
              },
              "type": "line",
              "zoom": {
                "enabled": false
              }
            },
            "colors": [
              "#1E88E5",
              "#E9781A",
              "#2E7D32",
              "#8E24AA",
              "#C62828",
              "#00897B"
            ],
            "dataLabels": {
              "enabled": false
            },
            "grid": {
              "borderColor": "var(--neutral-40)",
              "padding": {
                "bottom": 0,
                "left": 8,
                "right": 12,
                "top": 0
              },
              "strokeDashArray": 3
            },
            "legend": {
              "fontSize": "11px",
              "position": "bottom",
              "show": true
            },
            "markers": {
              "size": 3
            },
            "noData": {
              "text": "No Data"
            },
            "stroke": {
              "curve": "straight",
              "width": 2
            },
            "tooltip": {
              "x": {
                "format": "MM/dd HH:mm"
              }
            },
            "xaxis": {
              "labels": {
                "datetimeUTC": false,
                "style": {
                  "fontSize": "10px"
                }
              },
              "tooltip": {
                "enabled": false
              },
              "type": "datetime"
            },
            "yaxis": {
              "labels": {
                "formatter": "function(v){return v == null ? '' : Math.round(v * 10) / 10;}",
                "style": {
                  "fontSize": "10px"
                }
              }
            }
          },
          "series": [],
          "style": {
            "classes": "utility-kpi-chart",
            "height": "210px",
            "minHeight": "0",
            "overflow": "hidden",
            "width": "100%"
          },
          "type": "line"
        },
        "type": "kyvislabs.display.apexchart"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "props": {
      "alignItems": "stretch",
      "direction": "column",
      "style": {
        "gap": "2px",
        "height": "100%",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}