                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'INTLK: ' + if(tag({view.params.tagPath} + '/IntlkOK/Value'), 'OK', 'TRIP')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "INTLK: —"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "PermCode"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'PERM: ' + if(tag({view.params.tagPath} + '/PermOK/Value'), 'OK', 'NO')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "PERM: —"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "OffCode"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'OFF: ' + if(tag({view.params.tagPath} + '/Off/Value'), 'YES', 'NO')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "OFF: —"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "KpiSection"
        },
        "position": {
