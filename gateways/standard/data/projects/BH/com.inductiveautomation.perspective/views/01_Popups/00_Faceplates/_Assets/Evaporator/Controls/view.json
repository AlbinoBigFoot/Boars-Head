                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "expression": "'COLD: ' + if(tag({view.params.tagPath} + '/TooCold/Value'), 'ACT', 'ok')"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "font-label faceplate-mode-code"
                  },
                  "text": "COLD: —"
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
