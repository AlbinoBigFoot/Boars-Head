                "classes": "faceplate-title font-title"
              }
            },
            "type": "ia.display.label"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\turl = str(self.view.params.webGuiUrl or '').strip()\n\tif not url:\n\t\treturn\n\tsystem.perspective.openURL(url)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "WebGui"
            },
            "position": {
              "basis": "88px",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
