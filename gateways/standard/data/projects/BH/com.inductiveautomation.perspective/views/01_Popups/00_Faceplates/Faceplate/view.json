                    "expression": "{view.params.deviceType} = 'Compressor' && len(coalesce({view.params.webGuiUrl}, '')) > 0"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "container-button font-button",
                "marginRight": "6px"
              },
              "text": "Web GUI"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tids = []\n\tpopupId = str(self.view.params.popupId or '').strip()\n\tif popupId:\n\t\tids.append(popupId)\n\ttagPath = str(self.view.params.tagPath or '')\n\tlabel = str(self.view.custom.label or '')\n\tkey = tagPath or label\n\tids.extend([\n\t\t'comp-fp-%s' % key,\n\t\t'nav-fp-%s' % key,\n\t\t'fp-%s' % key,\n\t\t'pump-fp-%s' % key,\n\t\t'valve-fp-%s' % key,\n\t\t'sensor-fp-%s' % key,\n\t\t'tank-fp-%s' % key,\n\t\t'efan-fp-%s' % key,\n\t\t'ev-fp-%s' % key,\n\t\t'ct-fp-%s' % key,\n\t\tkey,\n\t])\n\tleaf = key.split('/')[-1] if key else ''\n\tif leaf and leaf != key:\n\t\tids.extend([\n\t\t\t'comp-fp-%s' % leaf,\n\t\t\t'nav-fp-%s' % leaf,\n\t\t\t'fp-%s' % leaf,\n\t\t\tleaf,\n\t\t])\n\tseen = set()\n\tfor pid in ids:\n\t\tif not pid or pid in seen:\n\t\t\tcontinue\n\t\tseen.add(pid)\n\t\ttry:\n\t\t\tsystem.perspective.closePopup(pid)\n\t\texcept:\n\t\t\tpass\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
