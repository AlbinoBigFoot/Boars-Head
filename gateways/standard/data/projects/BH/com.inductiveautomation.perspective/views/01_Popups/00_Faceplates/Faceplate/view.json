                        "expression": "if({view.params.showAlarms} && {view.custom.tagFlags.showAlarms},\n   if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump', '68px', '64px'),\n   '0px')"
                      },
                      "type": "expr"
                    }
                  },
                  "position.grow": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.showAlarms} && {view.custom.tagFlags.showAlarms},\n   if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump', 0, 1),\n   0)"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "config": {
                        "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.display": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.showAlarms} && {view.custom.tagFlags.showAlarms}, 'flex', 'none')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "this.meta.name"
                      },
                      "type": "property"
                    }
                  },
                  "position.shrink": {
                    "binding": {
                      "config": {
                        "expression": "if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump', 0, 1)"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {},
                  "textStyle": {
                    "classes": "faceplate-tab-text"
                  }
                },
                "type": "ia.input.button"
              }
            ],
            "meta": {
              "name": "Tabs"
            },
            "position": {
              "basis": "56px",
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump',\n   'faceplate-buttons-' + {view.custom.visibleTabCount} + ' faceplate-tabs-vertical',\n   'faceplate-buttons-' + {view.custom.visibleTabCount})"
                  },
                  "type": "expr"
                }
              },
              "position.basis": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump', '144px', '56px')"
                  },
                  "type": "expr"
                }
              },
              "props.direction": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump', 'column', 'row')"
                  },
                  "type": "expr"
                }
              },
              "props.alignItems": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump', 'stretch', 'flex-end')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "overflow": "visible"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "EmbeddedView"
                },
                "position": {
                  "basis": "0px",
                  "grow": 1
                },
                "propConfig": {
                  "props.params.hiddenTags": {
                    "binding": {
                      "config": {
                        "expression": "case(\n  {view.custom.selected},\n  \"Trend\", {view.params.hiddenFromTrend},\n  \"Configuration\", {view.params.hiddenFromConfiguration},\n  \"Alarm Configuration\", {view.params.hiddenFromAlarmConfiguration},\n  \"Alarms\", {view.params.hiddenFromAlarms},\n  ''\n)"
                      },
                      "type": "expr"
                    }
                  },
                  "props.params.tagPath": {
                    "binding": {
                      "config": {
                        "path": "view.params.tagPath"
                      },
                      "type": "property",
                      "overlays": {
                        "bad": false,
                        "error": false,
                        "pending": false,
                        "stale": false,
                        "unknown": false,
                        "disabled": false
                      }
                    }
                  },
                  "props.path": {
                    "binding": {
                      "config": {
                        "expression": "case(\n  {view.custom.selected},\n  \"Controls\",\n    case({view.params.deviceType},\n      \"Compressor\", \"01_Popups/00_Faceplates/_Assets/Compressor/Controls\",\n      \"Pump\", \"01_Popups/00_Faceplates/_Assets/Pump/Controls\",\n      \"ExhaustFan\", \"01_Popups/00_Faceplates/_Assets/ExhaustFan/Controls\",\n      \"Valve\", \"01_Popups/00_Faceplates/_Assets/Valve/Controls\",\n      \"Tank\", \"01_Popups/00_Faceplates/_Assets/Tank/Controls\",\n      \"Sensor\", \"01_Popups/00_Faceplates/_Assets/Sensor/Controls\",\n      \"Evaporator\", \"01_Popups/00_Faceplates/_Assets/Evaporator/Controls\",\n      \"CoolingTower\", \"01_Popups/00_Faceplates/_Assets/CoolingTower/Controls\",\n      \"\"),\n  \"Configuration\", case({view.params.deviceType}, \"Valve\", \"01_Popups/00_Faceplates/_Assets/Valve/Configuration\", \"Pump\", \"01_Popups/00_Faceplates/_Assets/Pump/Configuration\", \"01_Popups/00_Faceplates/_Assets/Configuration/Configuration\"),\n  \"Interlocks\", case({view.params.deviceType}, \"Valve\", \"01_Popups/00_Faceplates/_Assets/Valve/Interlocks\", \"Pump\", \"01_Popups/00_Faceplates/_Assets/Pump/Interlocks\", \"01_Popups/00_Faceplates/_Assets/Interlocks\"),\n  \"Trend\", \"01_Popups/00_Faceplates/_Assets/Trend\",\n  \"Alarm Configuration\", \"01_Popups/00_Faceplates/_Assets/AlarmConfiguration\",\n  \"Alarms\", case({view.params.deviceType}, \"Valve\", \"01_Popups/00_Faceplates/_Assets/Valve/Alarms\", \"Pump\", \"01_Popups/00_Faceplates/_Assets/Pump/Alarms\", \"01_Popups/00_Faceplates/_Assets/Alarms\"),\n  \"\"\n)"
                      },
                      "type": "expr"
                    }
                  }
                },
                "props": {
                  "style": {
                    "height": "100%",
                    "minHeight": 0,
                    "overflow": "auto",
                    "width": "100%"
                  },
                  "useDefaultViewHeight": false,
                  "useDefaultViewWidth": false,
                  "params": {
                    "tagPath": "",
                    "deviceType": "",
                    "hiddenTags": ""
                  }
                },
                "type": "ia.display.view"
              }
            ],
            "meta": {
              "name": "Body"
            },
            "position": {
              "basis": "0px",
              "grow": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "faceplate-body",
                "minHeight": 0,
                "overflow": "hidden",
                "minWidth": 0
              }
            },
            "type": "ia.container.flex"
          }
        ]
      }
    ],
    "meta": {
      "contextMenu": {},
      "name": "root"
    },
    "propConfig": {
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": ""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct",
          "overlays": {
            "bad": false,
            "error": false,
            "pending": false,
            "stale": false,
            "unknown": false,
            "disabled": false
          }
        }
      },
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.params.deviceType} = 'Valve' || {view.params.deviceType} = 'Solenoid' || {view.params.deviceType} = 'SolenoidValve' || {view.params.deviceType} = 'Pump',\n   if({view.custom.selected} = 'Trend',\n      'bg-component container-card container-card-border faceplate faceplate-tabs-vertical faceplate-trend-wide',\n      'bg-component container-card container-card-border faceplate faceplate-tabs-vertical'),\n   if({view.custom.selected} = 'Trend',\n      'bg-component container-card container-card-border faceplate faceplate-trend-wide',\n      'bg-component container-card container-card-border faceplate'))"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "minHeight": 0,
        "overflow": "hidden",
        "padding": "0px",
        "width": "100%"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "type": "ia.container.flex"
  }
