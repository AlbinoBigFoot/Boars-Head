{
  "custom": {
    "label": "",
    "metadata": "",
    "selected": "Controls",
    "visibleTabCount": 0
  },
  "params": {
    "tagPath": "",
    "deviceType": "Compressor",
    "webGuiUrl": "",
    "hiddenFromTrend": "",
    "showControls": true,
    "showConfiguration": true,
    "showTrend": true,
    "showAlarmConfiguration": true,
    "showAlarms": true
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\n    if(\n        isNull({view.custom.metadata.shortDescription}) ||\n        {view.custom.metadata.shortDescription} = '',\n        if({view.params.tagPath} = '',\n           '',\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\n        {view.custom.metadata.shortDescription}\n    ),\n'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\n\ttag({view.params.tagPath} + '.Metadata'),\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.selected": {
      "persistent": true
    },
    "custom.visibleTabCount": {
      "binding": {
        "config": {
          "expression": "(if({view.params.showControls}, 1, 0) + if({view.params.showConfiguration}, 1, 0) + if({view.params.showTrend}, 1, 0) + if({view.params.showAlarmConfiguration}, 1, 0) + if({view.params.showAlarms}, 1, 0))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.deviceType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.webGuiUrl": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.hiddenFromTrend": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showControls": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showConfiguration": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showTrend": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showAlarmConfiguration": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.showAlarms": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 640,
      "width": 560
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-component container-card container-card-border faceplate",
        "overflow": "hidden",
        "height": "100%",
        "width": "100%",
        "minHeight": 0,
        "padding": "0px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "classes": "faceplate-header bg-header"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.custom.label"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "faceplate-title font-title"
              },
              "text": ""
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "WebGui"
            },
            "position": {
              "basis": "88px",
              "shrink": 0
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "len(coalesce({view.params.webGuiUrl}, '')) > 0"
                  },
                  "type": "expr"
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\turl = str(self.view.params.webGuiUrl or '').strip()\n\tif not url:\n\t\treturn\n\tsystem.perspective.openURL(url)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "props": {
              "style": {
                "classes": "container-button font-button",
                "marginRight": "6px"
              },
              "text": "Web GUI"
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "72px",
              "shrink": 0
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\ttagPath = str(self.view.params.tagPath or '')\n\tlabel = str(self.view.custom.label or '')\n\tsystem.perspective.closePopup('comp-fp-%s' % (tagPath or label))\n\ttry:\n\t\tsystem.perspective.closePopup('fp-%s' % (tagPath or label))\n\texcept:\n\t\tpass\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "props": {
              "style": {
                "classes": "container-button font-button"
              },
              "text": "Close"
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Tabs"
        },
        "position": {
          "basis": "56px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "'faceplate-buttons-' + {view.custom.visibleTabCount}"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "alignItems": "flex-end",
          "style": {
            "overflow": "visible"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Controls"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.selected = self.meta.name"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showControls}, '72px', '0px')"
                  },
                  "type": "expr"
                }
              },
              "position.grow": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showControls}, 1, 0)"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                  },
                  "type": "expr"
                }
              },
              "props.style.display": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showControls}, 'flex', 'none')"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "this.meta.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {},
              "textStyle": {
                "classes": "faceplate-tab-text"
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Configuration"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.selected = self.meta.name"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showConfiguration}, '96px', '0px')"
                  },
                  "type": "expr"
                }
              },
              "position.grow": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showConfiguration}, 1, 0)"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                  },
                  "type": "expr"
                }
              },
              "props.style.display": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showConfiguration}, 'flex', 'none')"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "this.meta.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {},
              "textStyle": {
                "classes": "faceplate-tab-text"
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Trend"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.selected = self.meta.name"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showTrend}, '64px', '0px')"
                  },
                  "type": "expr"
                }
              },
              "position.grow": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showTrend}, 1, 0)"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                  },
                  "type": "expr"
                }
              },
              "props.style.display": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showTrend}, 'flex', 'none')"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "this.meta.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {},
              "textStyle": {
                "classes": "faceplate-tab-text"
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Alarm Configuration"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.selected = self.meta.name"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showAlarmConfiguration}, '120px', '0px')"
                  },
                  "type": "expr"
                }
              },
              "position.grow": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showAlarmConfiguration}, 1, 0)"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                  },
                  "type": "expr"
                }
              },
              "props.style.display": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showAlarmConfiguration}, 'flex', 'none')"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "this.meta.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {},
              "textStyle": {
                "classes": "faceplate-tab-text"
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Alarms"
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tself.view.custom.selected = self.meta.name"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showAlarms}, '64px', '0px')"
                  },
                  "type": "expr"
                }
              },
              "position.grow": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showAlarms}, 1, 0)"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                  },
                  "type": "expr"
                }
              },
              "props.style.display": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.showAlarms}, 'flex', 'none')"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "path": "this.meta.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {},
              "textStyle": {
                "classes": "faceplate-tab-text"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Body"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "faceplate-body",
            "minHeight": 0,
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.view",
            "meta": {
              "name": "EmbeddedView"
            },
            "position": {
              "grow": 1,
              "shrink": 1,
              "basis": "0px"
            },
            "propConfig": {
              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "path": "view.params.tagPath"
                  },
                  "type": "property"
                }
              },
              "props.params.hiddenTags": {
                "binding": {
                  "config": {
                    "path": "view.params.hiddenFromTrend"
                  },
                  "type": "property"
                }
              },
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "case(\n  {view.custom.selected},\n  \"Controls\",\n    case({view.params.deviceType},\n      \"Compressor\", \"01_Popups/00_Faceplates/Compressor/Controls\",\n      \"01_Popups/00_Faceplates/Compressor/Controls\"),\n  \"Configuration\",\n    case({view.params.deviceType},\n      \"Compressor\", \"01_Popups/00_Faceplates/Compressor/Configuration\",\n      \"01_Popups/00_Faceplates/Compressor/Configuration\"),\n  \"Trend\", \"01_Popups/00_Faceplates/_Assets/Trend\",\n  \"Alarm Configuration\", \"01_Popups/00_Faceplates/_Assets/AlarmConfiguration\",\n  \"Alarms\", \"01_Popups/00_Faceplates/_Assets/Alarms\",\n  \"01_Popups/00_Faceplates/Compressor/Controls\"\n)"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "params": {
                "tagPath": "",
                "hiddenTags": ""
              },
              "style": {
                "overflow": "auto",
                "minHeight": 0,
                "height": "100%",
                "width": "100%"
              },
              "useDefaultViewHeight": false,
              "useDefaultViewWidth": false
            }
          }
        ]
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}