{
  "custom": {
    "label": "",
    "metadata": "",
    "selected": "Controls",
    "tagFlags": {
      "defaultTab": "Controls",
      "showAlarmConfiguration": false,
      "showAlarms": false,
      "showConfiguration": false,
      "showControls": true,
      "showInterlocks": false,
      "showTrend": false
    },
    "visibleTabCount": 1
  },
  "params": {
    "deviceType": "Compressor",
    "hiddenFromAlarmConfiguration": "",
    "hiddenFromAlarms": "",
    "hiddenFromConfiguration": "",
    "hiddenFromTrend": "",
    "popupId": "",
    "showAlarmConfiguration": true,
    "showAlarms": true,
    "showConfiguration": true,
    "showControls": true,
    "showInterlocks": true,
    "showTrend": true,
    "tagPath": "",
    "webGuiUrl": ""
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\n    if(\n        isNull({view.custom.metadata.shortDescription}) ||\n        {view.custom.metadata.shortDescription} = '',\n        if({view.params.tagPath} = '',\n           '',\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\n        {view.custom.metadata.shortDescription}\n    ),\n'')"
        },
        "type": "expr",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\n\t{view.params.tagPath}!='' && try(isGood(tag({view.params.tagPath} + '.Metadata')), false),\n\ttry(if(isBadOrError(tag({view.params.tagPath} + '.Metadata')), null, tag({view.params.tagPath} + '.Metadata')), null),\n\t'')"
        },
        "type": "expr",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.selected": {
      "persistent": true,
      "onChange": {
        "enabled": true,
        "script": "\t# Width is applied in stylesheet via .psc-faceplate-trend-wide on the view root.\n\t# alterPopup is not available in this Ignition version.\n\tpass\n"
      }
    },
    "custom.tagFlags": {
      "binding": {
        "config": {
          "struct": {
            "showControls": "coalesce({view.params.showControls}, false)",
            "showConfiguration": "coalesce({view.params.showConfiguration}, false)",
            "showInterlocks": "coalesce({view.params.showInterlocks}, false)",
            "showTrend": "coalesce({view.params.showTrend}, false)",
            "showAlarmConfiguration": "coalesce({view.params.showAlarmConfiguration}, false)",
            "showAlarms": "coalesce({view.params.showAlarms}, false)",
            "defaultTab": "'Controls'"
          },
          "waitOnAll": false
        },
        "type": "expr-struct",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "onChange": {
        "enabled": null,
        "script": "\tflags = currentValue.value\n\tif not flags:\n\t\treturn\n\tsel = self.custom.selected\n\tvisible = {\n\t\t'Controls': flags.get('showControls'),\n\t\t'Configuration': flags.get('showConfiguration'),\n\t\t'Interlocks': flags.get('showInterlocks'),\n\t\t'Trend': flags.get('showTrend'),\n\t\t'Alarm Configuration': flags.get('showAlarmConfiguration'),\n\t\t'Alarms': flags.get('showAlarms'),\n\t}\n\tif not visible.get(sel, False):\n\t\tself.custom.selected = flags.get('defaultTab') or 'Controls'"
      },
      "persistent": true
    },
    "custom.visibleTabCount": {
      "binding": {
        "config": {
          "expression": "(if({view.params.showControls} && {view.custom.tagFlags.showControls}, 1, 0) + if({view.params.showConfiguration} && {view.custom.tagFlags.showConfiguration}, 1, 0) + if({view.params.showInterlocks} && {view.custom.tagFlags.showInterlocks}, 1, 0) + if({view.params.showTrend} && {view.custom.tagFlags.showTrend}, 1, 0) + if({view.params.showAlarmConfiguration} && {view.custom.tagFlags.showAlarmConfiguration}, 1, 0) + if({view.params.showAlarms} && {view.custom.tagFlags.showAlarms}, 1, 0))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.deviceType": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.hiddenFromAlarmConfiguration": {
      "paramDirection": "input",
