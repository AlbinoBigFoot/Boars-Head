          "shrink": 1
        },
        "props": {
          "path": "01_Popups/00_Faceplates/_Assets/Alarms",
          "params": {
            "tagPath": ""
          },
          "style": {
            "width": "100%",
            "minHeight": "120px"
          }
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "path": "view.params.tagPath"
              },
              "type": "property",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
