              {
                "type": "ia.input.button",
                "meta": {
                  "name": "BtnAckAll"
                },
                "position": {
                  "basis": "36px",
                  "grow": 0,
                  "shrink": 0
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tif self.view.custom.pax:\n\t\treturn  # pax-bindings: live PLC object, read only\n\tif self.view.custom.roCommand:\n\t\treturn\n\tbase = self.view.params.tagPath\n\tif not base:\n\t\treturn\n\tdef _r(p):\n\t\ttry:\n\t\t\tc = system.tag.getConfiguration(p, False)[0]\n\t\t\ts = c.get('sourceTagPath')\n\t\t\treturn str(s) if s else p\n\t\texcept:\n\t\t\treturn p\n\tpaths = [base + '/' + n + '/Value' for n in ('Ack_FailToStart','Ack_FailToStop','Ack_IOFault','Ack_IntlkTrip','OCmd_ResetAckAll')]\n\tvals = [True] * len(paths)\n\tsystem.tag.writeBlocking([_r(p) for p in paths], vals)\n\tuser = ''\n\ttry:\n\t\tuser = str(self.session.props.auth.user.userName or '')\n\texcept:\n\t\tpass\n\ttry:\n\t\tshared.Alarms.acknowledgeForTag(base, user, 'Faceplate Ack / Reset')\n\texcept:\n\t\tsystem.util.getLogger('PumpAlarms').warn('Ignition alarm ack failed for %s' % base)\n\ttry:\n\t\tviewName = self.view.id.split('@')[0]\n\t\tshared.Audit.logEvent('alarm ack/reset', base, 'Ack / Reset', tagPath=base, viewName=viewName)\n\texcept:\n\t\tsystem.util.getLogger('PumpAlarms').warn('OpsAudit ack/reset failed for %s' % base)\n"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "(!{view.custom.roCommand}) && coalesce({view.custom.pax}, '') = ''"
                      },
                      "type": "expr"
                    }
