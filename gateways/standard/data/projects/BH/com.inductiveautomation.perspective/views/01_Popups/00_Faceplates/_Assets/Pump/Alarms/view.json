{
  "custom": {
    "pax": "",
    "qg0": null,
    "qg1": null,
    "qg2": null,
    "qg3": null,
    "permDevice": "",
    "roCommand": true,
    "tipCommand": ""
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.pax": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', case(toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), 'Devices/Pump', 'Motor', 'Devices/Valve', 'Valve', 'Devices/Tank', 'Tank', 'Devices/Compressor', 'Comp', 'Devices/Evaporator', 'CG', 'Devices/ExhaustFan', 'EF', 'Devices/LTU', 'LTU', 'Devices/SafetyRelay', 'Relay', 'Devices/SuctionSequence', 'Seq', 'Devices/DischargeSequence', 'Dsq', 'Devices/Sensor', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AIn.Enabled')), false), false), 'AIn', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AInRef.Enabled')), false), false), 'AInRef', '')), 'Devices/DiscreteInput', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/DIn.Enabled')), false), false), 'DIn', ''), ''))"
        }
      }
    },
    "custom.qg0": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.tagPath} + '/Motor/Alm_FailToStart')), tag({view.params.tagPath} + '/Motor/Alm_FailToStart'), null), null)"
        }
      }
    },
    "custom.qg1": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.tagPath} + '/Motor/Alm_FailToStop')), tag({view.params.tagPath} + '/Motor/Alm_FailToStop'), null), null)"
        }
      }
    },
    "custom.qg2": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.tagPath} + '/Motor/Alm_IOFault')), tag({view.params.tagPath} + '/Motor/Alm_IOFault'), null), null)"
        }
      }
    },
    "custom.qg3": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(if(isGood(tag({view.params.tagPath} + '/Motor/Alm_IntlkTrip')), tag({view.params.tagPath} + '/Motor/Alm_IntlkTrip'), null), null)"
        }
      }
    },
    "custom.permDevice": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', coalesce(try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), try(lookup(tag('[default]_Config/Security/DeviceTypes'), toStr(coalesce(try(tag(left(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')), lastIndexOf(left({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/')), '/')) + '.TypeId'), ''), '')), null, 'TypeId', 'Device'), null), ''))"
        }
      },
      "access": "PROTECTED"
    },
    "custom.roCommand": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({session.custom.ReadOnly}, true) || !coalesce(try({session.custom.Permissions}[{view.custom.permDevice}]['Command'], null), true)"
        }
      },
      "access": "PROTECTED"
    },
    "custom.tipCommand": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!coalesce({session.custom.ReadOnly}, true) && coalesce({view.custom.roCommand}, false), 'Not Permitted: ' + {view.custom.permDevice} + ' / ' + 'Command' + ' (Roles & Permissions)', '')"
        }
      }
    }
  },
