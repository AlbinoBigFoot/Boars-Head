    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "cancel",
          "pageScope": true,
          "script": "\tpath = payload.get('tagPath') if payload else None\n\tif path and path != self.view.params.tagPath:\n\t\treturn\n\ttry:\n\t\tself.getChild('Chk').refreshBinding('props.selected')\n\texcept:\n\t\tpass\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "writeValue",
          "pageScope": true,
          "script": "\tif self.view.params.readOnly:\n\t\treturn  # pax-bindings: live PLC member, read only\n\tkind = str(self.view.params.inputKind or 'checkbox').lower()\n\tif kind not in ('checkbox', 'bool', 'boolean'):\n\t\treturn\n\tpath = payload.get('tagPath') if payload else None\n\tif not path or path != self.view.params.tagPath:\n\t\treturn\n\tif payload.get('alreadyWritten'):\n\t\ttry:\n\t\t\tself.getChild('Chk').refreshBinding('props.selected')\n\t\texcept:\n\t\t\tpass\n\t\treturn\n\ttry:\n\t\tshared.Audit.writeTag(\n\t\t\tpath,\n\t\t\tpayload.get('value'),\n\t\t\tlabel=payload.get('label'),\n\t\t\tviewName=payload.get('viewName') or self.view.id.split('@')[0],\n\t\t)\n\texcept:\n\t\tsystem.tag.writeBlocking([path], [payload.get('value')])\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    }
  }
}
