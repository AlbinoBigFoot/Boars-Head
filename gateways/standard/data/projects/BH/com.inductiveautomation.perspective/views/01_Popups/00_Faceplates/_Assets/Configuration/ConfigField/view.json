      {
        "type": "ia.input.checkbox",
        "meta": {
          "name": "Chk"
        },
        "position": {
          "basis": "28px",
          "shrink": 0,
          "grow": 0,
          "display": false
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.tagPath} != '' && (lower({view.params.inputKind}) = 'checkbox' || lower({view.params.inputKind}) = 'bool' || lower({view.params.inputKind}) = 'boolean') && coalesce({view.custom.ok}, false)"
              }
            }
          },
          "props.selected": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '', false,\n\tcoalesce(try(if(!isGood(tag({view.params.tagPath})), null, tag({view.params.tagPath})), null), false))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              },
              "overlayOptOut": true
            },
            "onChange": {
              "enabled": null,
              "script": "\ttry:\n\t\tif origin != 'Browser':\n\t\t\treturn\n\t\tif (self.view.custom.roConfiguration if self.view.params.engineering else self.view.custom.roSetpoint):\n\t\t\tself.refreshBinding('props.selected')\n\t\t\treturn\n\t\ttagPath = self.view.params.tagPath\n\t\tif not tagPath:\n\t\t\tself.refreshBinding('props.selected')\n\t\t\treturn\n\t\tnewValue = bool(currentValue.value)\n\t\toldValue = bool(previousValue.value) if previousValue is not None else (not newValue)\n\t\tif newValue == oldValue:\n\t\t\treturn\n\t\tlabel = self.view.params.label or tagPath\n\t\tshared.Alerts.promptConfigWrite(self, 'props.selected', tagPath, label, newValue, oldValue)\n\texcept:\n\t\tsystem.util.getLogger('ConfigField').info('Error prompting apply write')\n\t\ttry:\n\t\t\tself.refreshBinding('props.selected')\n\t\texcept:\n\t\t\tpass\n"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "(!coalesce(if(coalesce({view.params.engineering}, false), {view.custom.roConfiguration}, {view.custom.roSetpoint}), false)) && !coalesce({view.params.readOnly}, false)"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "''"
              }
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.params.engineering}, false), {view.custom.tipConfiguration}, {view.custom.tipSetpoint}) != ''"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.params.engineering}, false), {view.custom.tipConfiguration}, {view.custom.tipSetpoint})"
              }
            }
          }
        },
        "props": {
          "selected": false,
          "text": "",
          "textPosition": "right",
          "style": {
            "overflow": "hidden"
          }
        }
      },
