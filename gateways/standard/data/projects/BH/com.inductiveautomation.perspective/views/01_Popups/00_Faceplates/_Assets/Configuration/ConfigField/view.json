            "binding": {
              "config": {
                "expression": "if(lower({view.params.inputKind}) = 'multistate', coalesce({view.params.enumPath}, ''), '')"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
