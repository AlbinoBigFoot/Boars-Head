          }
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Time"
        },
        "position": {
          "basis": "148px",
          "shrink": 0,
          "grow": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
