              "config": {
                "expression": "if(coalesce({view.params.engineering}, false), {view.custom.tipConfiguration}, {view.custom.tipSetpoint})"
              }
            }
          }
        },
        "props": {
          "path": "03_Elements/00_Control/MultiStateInput",
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false,
          "params": {
            "label": "Null",
            "permission": true,
            "tagPath": "",
            "enumPath": "",
            "confirmLabel": ""
          },
