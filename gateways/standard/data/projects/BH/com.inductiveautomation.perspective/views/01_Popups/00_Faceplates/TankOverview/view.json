                    "classes": "faceplate-tab-text"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                      }
                    }
                  },
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "this.meta.name"
                      }
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.selected = self.meta.name"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Configuration"
                },
                "position": {
                  "basis": "68px",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "style": {},
                  "textStyle": {
                    "classes": "faceplate-tab-text"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                      }
                    }
                  },
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "this.meta.name"
                      }
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.selected = self.meta.name"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Interlocks"
                },
                "position": {
                  "basis": "68px",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "style": {},
                  "textStyle": {
                    "classes": "faceplate-tab-text"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                      }
                    }
                  },
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "this.meta.name"
                      }
                    }
                  },
                  "props.style.display": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(coalesce({view.custom.hasPumps}, false), 'flex', 'none')"
                      }
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.selected = self.meta.name"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Trend"
                },
                "position": {
                  "basis": "68px",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "style": {},
                  "textStyle": {
                    "classes": "faceplate-tab-text"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.selected} = {this.meta.name},\n   'faceplate-button-selected',\n   'faceplate-button')"
                      }
                    }
                  },
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
