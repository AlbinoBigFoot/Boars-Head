                        "script": "\tself.view.custom.selected = self.meta.name"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Alarms"
                },
                "position": {
                  "basis": "68px",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "style": {},
                  "textStyle": {
                    "classes": "faceplate-tab-text"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
