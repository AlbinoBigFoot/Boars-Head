                      }
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "config": {
                        "script": "\tself.view.custom.selected = self.meta.name"
                      },
                      "scope": "G",
                      "type": "script"
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Alarm Configuration"
                },
                "position": {
                  "basis": "68px",
                  "grow": 0,
                  "shrink": 0
                },
                "props": {
                  "style": {},
