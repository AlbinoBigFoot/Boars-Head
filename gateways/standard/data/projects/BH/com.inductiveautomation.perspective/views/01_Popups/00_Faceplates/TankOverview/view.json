{
  "custom": {
    "selected": "Overview",
    "ok": null,
    "lvl": null,
    "sHH": null,
    "sH": null,
    "sL": null,
    "sLL": null,
    "sFail": null,
    "tone": null,
    "state": null,
    "hasPumps": null
  },
  "props": {
    "defaultSize": {
      "height": 760,
      "width": 1100
    }
  },
  "params": {
    "popupId": "",
    "tagPath": "",
    "title": ""
  },
  "propConfig": {
    "params.popupId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.ok": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "{view.params.tagPath} != '' && coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Val')), false), false)"
        }
      },
      "persistent": true
    },
    "custom.lvl": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Val')), false), false), toFloat(tag({view.params.tagPath} + '/LvlAIn/Val')), null)"
        }
      },
      "persistent": true
    },
    "custom.sHH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_HiHi')), false), false), toBoolean(tag({view.params.tagPath} + '/LvlAIn/Sts_HiHi')), null)"
        }
      },
      "persistent": true
    },
    "custom.sH": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_Hi')), false), false), toBoolean(tag({view.params.tagPath} + '/LvlAIn/Sts_Hi')), null)"
        }
      },
      "persistent": true
    },
    "custom.sL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_Lo')), false), false), toBoolean(tag({view.params.tagPath} + '/LvlAIn/Sts_Lo')), null)"
        }
      },
      "persistent": true
    },
    "custom.sLL": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_LoLo')), false), false), toBoolean(tag({view.params.tagPath} + '/LvlAIn/Sts_LoLo')), null)"
        }
      },
      "persistent": true
    },
    "custom.sFail": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_Fail')), false), false), toBoolean(tag({view.params.tagPath} + '/LvlAIn/Sts_Fail')), null)"
        }
      },
      "persistent": true
    },
    "custom.tone": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!coalesce({view.custom.ok}, false) || isNull({view.custom.lvl}), 'off', if(coalesce({view.custom.sHH}, false) || coalesce({view.custom.sLL}, false) || coalesce({view.custom.sFail}, false), 'alarm', if(coalesce({view.custom.sH}, false) || coalesce({view.custom.sL}, false), 'warn', 'ok')))"
        }
      },
      "persistent": true
    },
    "custom.state": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!coalesce({view.custom.ok}, false) || isNull({view.custom.lvl}), '\u2014', if(coalesce({view.custom.sFail}, false), 'Input Failure', if(coalesce({view.custom.sHH}, false), 'High-High', if(coalesce({view.custom.sLL}, false), 'Low-Low', if(coalesce({view.custom.sH}, false), 'High', if(coalesce({view.custom.sL}, false), 'Low', 'Normal'))))))"
        }
      },
      "persistent": true
    },
    "custom.hasPumps": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "lastIndexOf({view.params.tagPath}, '/Tanks/') >= 0 && coalesce(try(isGood(tag(substring({view.params.tagPath}, 0, lastIndexOf({view.params.tagPath}, '/Tanks/')) + '/Pumps/' + left(substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1), len(substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)) - 1) + 'LR-Pump 1.TypeId')), false), false)"
        }
      },
      "persistent": true
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-component container-card container-card-border faceplate faceplate-tabs-vertical",
        "height": "100%",
        "width": "100%",
        "minHeight": 0,
        "overflow": "hidden",
        "padding": "0px"
      }
    },
    "children": [
      {
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "position": {
              "basis": "auto",
              "shrink": 1
            },
            "props": {
              "text": "",
              "style": {
                "classes": "faceplate-title Fonts/Title",
                "whiteSpace": "nowrap",
                "overflow": "hidden",
                "textOverflow": "ellipsis"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(coalesce({view.params.title}, '') != '', {view.params.title}, substring({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)) + ' Tank'"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Sub"
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "text": "",
              "style": {
                "classes": "fp-title-sub",
                "paddingLeft": "10px"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "''"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "State"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "fp-pill"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'Level ' + {view.custom.state}"
                  },
                  "overlayOptOut": true
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'fp-pill fp-tone-' + case({view.custom.tone}, 'ok', 'ok', 'warn', 'warn', 'alarm', 'alarm', 'muted')"
                  },
                  "overlayOptOut": true
                }
              },
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "coalesce({view.custom.ok}, false)"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Comm"
            },
            "position": {
              "basis": "auto",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "fp-pill"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'Comm Loss'"
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'fp-pill fp-tone-' + 'alarm'"
                  }
                }
              },
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.params.tagPath} != '' && !coalesce({view.custom.ok}, false)"
                  }
                }
              }
            }
          },
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tpid = str(self.view.params.popupId or '').strip()\n\tif pid:\n\t\tsystem.perspective.closePopup(pid)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Close"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "style": {
                "classes": "color-icon container-icon faceplate-close",
                "minHeight": 36,
                "minWidth": 36,
                "zIndex": 41,
                "position": "relative"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "48px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "flex-start",
          "style": {
            "classes": "faceplate-header bg-header",
            "pointerEvents": "none",
            "zIndex": 40,
            "overflow": "hidden",
            "position": "relative",
            "gap": "8px"
          }
        },
        "type": "ia.container.flex"
      },
