      }
    },
    "events": {
      "dom": {
        "onKeyDown": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tif str(getattr(event, 'key', '')) == 'Escape':\n\t\tshared.TrendContext.close_menu()"
          }
        }
      },
      "system": {
        "onStartup": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\ttry:\n\t\tself.getChild('CopyTagPath').focus()\n\texcept:\n\t\tpass"
          }
        }
      }
    },
