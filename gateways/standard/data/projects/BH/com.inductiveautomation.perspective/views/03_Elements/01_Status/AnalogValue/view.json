{
  "custom": {
    "effectiveSpPath": ""
  },
  "params": {
    "compact": false,
    "spacing": {
      "center": true,
      "data": 0,
      "engUnit": 30,
      "textAlign": "center"
    },
    "tagPath": "",
    "spTagPath": "",
    "forceColor": ""
  },
  "propConfig": {
    "params.compact": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.spacing": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.spTagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.forceColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.effectiveSpPath": {
      "binding": {
        "config": {
          "expression": "if({view.params.spTagPath} != '',\n\t{view.params.spTagPath},\n\tif({view.params.tagPath} = '',\n\t\t'',\n\t\tif(right({view.params.tagPath}, 6) = '/Value',\n\t\t\tleft({view.params.tagPath}, len({view.params.tagPath}) - 6) + '/SP',\n\t\t\t'')))"
        },
        "type": "expr"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 80
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.justify": {
        "binding": {
          "config": {
            "expression": "if({view.params.spacing.center},\n\t'center',\n\t'flex-start')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "overflow": "visible",
        "minHeight": "0px",
        "height": "100%",
        "width": "100%"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "Numeric"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "position.grow": {
            "binding": {
              "config": {
                "expression": "if({view.params.spacing.center},\n\t0,\n\t1)"
              },
              "type": "expr"
            }
          },
          "props.params.compact": {
            "binding": {
              "config": {
                "path": "view.params.compact"
              },
              "type": "property"
            }
          },
          "props.params.spacing.center": {
            "binding": {
              "config": {
                "path": "view.params.spacing.center"
              },
              "type": "property"
            }
          },
          "props.params.spacing.data": {
            "binding": {
              "config": {
                "path": "view.params.spacing.data"
              },
              "type": "property"
            }
          },
          "props.params.spacing.engUnit": {
            "binding": {
              "config": {
                "path": "view.params.spacing.engUnit"
              },
              "type": "property"
            }
          },
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.params.tagPath}"
              },
              "type": "expr"
            }
          },
          "props.params.spTagPath": {
            "binding": {
              "config": {
                "path": "view.custom.effectiveSpPath"
              },
              "type": "property"
            }
          },
          "props.params.forceColor": {
            "binding": {
              "config": {
                "path": "view.params.forceColor"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "params": {
            "compact": false,
            "spacing": {
              "center": true,
              "data": 0,
              "engUnit": 30
            },
            "tagPath": "",
            "spTagPath": "",
            "forceColor": ""
          },
          "path": "03_Elements/01_Status/_Assets/Numeric",
          "style": {
            "overflow": "visible",
            "height": "100%",
            "width": "auto"
          },
          "useDefaultViewWidth": false,
          "useDefaultViewHeight": false
        }
      }
    ]
  }
}
