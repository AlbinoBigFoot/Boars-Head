{
  "custom": {
    "quality": "Bad_NotFound",
    "value": false
  },
  "params": {
    "label": "",
    "okValue": true,
    "tagPath": "",
    "blink": false
  },
  "propConfig": {
    "custom.quality": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'Bad_NotFound',\n\tqualityOf(tag({view.params.tagPath})))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || left({view.custom.quality}, 4) != 'Good',\n\tfalse,\n\tcoalesce(tag({view.params.tagPath}), false))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.okValue": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.blink": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 72
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "16px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.label"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "align": "center",
          "style": {
            "classes": "Fonts/Value fs-11 fw-700",
            "height": "16px",
            "lineHeight": "16px",
            "overflow": "visible",
            "textAlign": "center",
            "whiteSpace": "nowrap",
            "width": "100%"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Dot"
        },
        "position": {
          "basis": "28px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '' || left({view.custom.quality}, 4) != 'Good',\n\t'status-dot status-dot-unknown',\n\tif({view.custom.value} = {view.params.okValue},\n\t\t'status-dot status-dot-ok',\n\t\tif(coalesce({view.params.blink}, false),\n\t\t\t'status-dot status-dot-alarm status-dot-blink',\n\t\t\t'status-dot status-dot-alarm')))"
              },
              "type": "expr",
              "overlayOptOut": true
            }
          }
        },
        "props": {
          "style": {
            "alignSelf": "center",
            "flexShrink": 0
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "direction": "column",
      "style": {
        "classes": "status-dot-root",
        "gap": "2px",
        "overflow": "visible",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
