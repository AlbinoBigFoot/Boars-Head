{
  "custom": {
    "engUnit": "",
    "format": "00000.00",
    "quality": "Bad_NotFound(\"Path '[default]value.quality' not found.\")",
    "tagPath": "",
    "value": "00000.00"
  },
  "params": {
    "value": ""
  },
  "propConfig": {
    "custom.engUnit": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.EngUnit"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\"\",{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.formatString"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),'00000.00',if(indexOf({value},'#')!=-1,'00000.00',{value}))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.Quality"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t\"\",\r\n\t{value}\r\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.value"
        },
        "transforms": [
          {
            "expression": "numberFormat(forceQuality(if(isNull({value}),'',{value})),{view.custom.format})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Markdown"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "transforms": [
                {
                  "expression": "if(indexOf({value}, \".\") = -1,\r\n    concat(\r\n    \t\ttoInt({value}), \r\n\t\t\trepeat(\"&nbsp;\", 3)\r\n\t),\r\n    concat(\r\n\t\t\ttoInt(left({value}, indexOf({value}, \".\"))),\r\n\t\t\tright({value}, len({value}) - indexOf({value}, \".\")),\r\n\t\t\trepeat(\"&nbsp;\", 3 - (len({value}) - indexOf({value}, \".\")))\r\n\t)\r\n)\r\n\r\n",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "view.custom.quality"
              },
              "transforms": [
                {
                  "expression": "if({value} = \"Good\",\r\n\t'font-livedata',\r\n\t'font-baddata'\r\n\t)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden",
            "paddingRight": "4%",
            "textAlign": "right"
          }
        },
        "type": "ia.display.markdown"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "30%",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.engUnit"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label",
            "color": "--neutral-70",
            "fontSize": "11px",
            "marginTop": "1.2%"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onContextMenu": {
          "config": {
            "draggable": false,
            "id": "ContextMenu",
            "modal": false,
            "overlayDismiss": false,
            "position": {
              "relativeLocation": "bottom-right"
            },
            "positionType": "relative",
            "resizable": false,
            "showCloseIcon": false,
            "type": "toggle",
            "viewParams": {
              "discrete": "false",
              "tagPath": "{view.custom.tagPath}"
            },
            "viewPath": "01_Popups/00_Faceplates/Alerts/ContextMenu",
            "viewportBound": true
          },
          "preventDefault": true,
          "scope": "C",
          "stopPropagation": true,
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "transforms": [
            {
              "expression": "{value} != ''",
              "type": "expression"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "flex-start",
      "alignItems": "center",
      "style": {
        "cursor": "pointer",
        "minHeight": 20,
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
