{
  "custom": {
    "engUnit": "",
    "format": "00000.00",
    "quality": "Bad_NotFound(\"Path '[default]value.quality' not found.\")",
    "tagPath": "",
    "value": "00000.00",
    "valuePath": ""
  },
  "params": {
    "value": ""
  },
  "propConfig": {
    "custom.engUnit": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.valuePath}"
          },
          "tagPath": "{tagPath}.EngUnit"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\"\",{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.format": {
      "binding": {
        "config": {
          "expression": "tag({view.custom.valuePath} + '.formatString')"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),'00000.00',if(indexOf({value},'#')!=-1,'00000.00',{value}))",
            "type": "expression"
          },
          {
            "type": "expression",
            "expression": "if(coalesce(try(isGood(tag({view.custom.valuePath} + '.formatString')), false), false), {value}, null)"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "expression": "tag({view.custom.valuePath} + '.Quality')"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          },
          {
            "type": "expression",
            "expression": "if(coalesce(try(isGood(tag({view.custom.valuePath} + '.Quality')), false), false), {value}, null)"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.valuePath}"
          },
          "tagPath": "{tagPath}.value"
        },
        "transforms": [
          {
            "expression": "forceQuality(if(isNull({value}) || coalesce({view.custom.quality}, '') != 'Good' || coalesce(try(abs(toFloat({value})) >= 1e30, false), false), '—', numberFormat({value}, {view.custom.format})))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.valuePath": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(left(coalesce({view.params.value}, ''), 4) = 'pax:', substring({view.params.value}, 4), coalesce({view.params.value}, '') + '/Value')"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Markdown"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "transforms": [
                {
                  "expression": "if({value} = '—' || {value} = '', {value}, if(indexOf({value}, \".\") = -1,\n    concat(\n    \t\ttoInt({value}), \n\t\t\trepeat(\"&nbsp;\", 3)\n\t),\n    concat(\n\t\t\ttoInt(left({value}, indexOf({value}, \".\"))),\n\t\t\tright({value}, len({value}) - indexOf({value}, \".\")),\n\t\t\trepeat(\"&nbsp;\", 3 - (len({value}) - indexOf({value}, \".\")))\n\t)\n))",
                  "type": "expression"
                }
              ],
              "type": "property",
              "overlayOptOut": true
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.custom.quality}, '') = 'Good' && coalesce({view.custom.value}, '') != '—', 'Fonts/LiveData', 'Fonts/LiveData value-bad')"
              },
              "overlayOptOut": true
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden",
            "paddingRight": "4%",
            "textAlign": "right"
          }
        },
        "type": "ia.display.markdown"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "30%",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.custom.value}, '') = '—', '', coalesce({view.custom.engUnit}, ''))"
              },
              "overlayOptOut": true
            }
          }
        },
        "props": {
          "style": {
            "classes": "Fonts/Label fs-11",
            "color": "--neutral-70",
            "marginTop": "1.2%"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onContextMenu": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tshared.TrendContext.menu(self, event, '{view.custom.tagPath}')"
          },
          "preventDefault": true,
          "stopPropagation": true
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "transforms": [
            {
              "expression": "{value} != ''",
              "type": "expression"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "flex-start",
      "alignItems": "center",
      "style": {
        "cursor": "pointer",
        "minHeight": 20,
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}
