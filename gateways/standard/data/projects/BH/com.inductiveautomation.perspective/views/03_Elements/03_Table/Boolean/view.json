{
  "custom": {
    "marginRight": "0%",
    "multistates": "",
    "quality": "Bad_NotFound(\"Path '[default]value.quality' not found.\")",
    "tagPath": "",
    "textAlign": "center",
    "value": ""
  },
  "params": {
    "value": ""
  },
  "propConfig": {
    "custom.marginRight": {
      "persistent": true
    },
    "custom.multistates": {
      "binding": {
        "config": {
          "expression": "if({view.custom.tagPath} = '',\n\t'',\n\tif(!isBad(tag({view.custom.tagPath} + '/Value.Metadata')),\n\t\tif(isNull(tag({view.custom.tagPath} + '/Value.Metadata')['states']),\n\t\t\t'',\n\t\t\ttag({view.custom.tagPath} + '/Value.Metadata')['states']),\n\t\tif(!isBad(tag({view.custom.tagPath} + '/Metadata')),\n\t\t\tif(isNull(jsonGet(tag({view.custom.tagPath} + '/Metadata'), 'states')),\n\t\t\t\t'',\n\t\t\t\tjsonGet(tag({view.custom.tagPath} + '/Metadata'), 'states')),\n\t\t\t'')))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.Quality"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.textAlign": {
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.value"
        },
        "transforms": [
          {
            "expression": "forceQuality(if(isNull({value}),'',{value}))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Markdown"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "multistates": "{view.custom.multistates}",
                  "value": "{view.custom.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tfrom shared import Utilities\n\tresult = Utilities.getLabelValue(value.value, value.multistates)\n\tif result in (None, '') and value.value not in (None, ''):\n\t\ttry:\n\t\t\tv = int(value.value)\n\t\t\tfallback = {0: 'Off', 1: 'Cooling', 2: 'Defrost', 3: 'Fault', 4: 'Manual', 5: 'Idle'}\n\t\t\tresult = fallback.get(v, str(value.value))\n\t\texcept:\n\t\t\tresult = str(value.value)\n\treturn (result if result is not None else '') + \"&nbsp;\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "view.custom.quality"
              },
              "transforms": [
                {
                  "expression": "if({value} = \"Good\",\n\t'font-livedata',\n\t'font-baddata'\n\t)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.style.marginRight": {
            "binding": {
              "config": {
                "path": "view.custom.marginRight"
              },
              "type": "property"
            }
          },
          "props.style.textAlign": {
            "binding": {
              "config": {
                "path": "view.custom.textAlign"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.display.markdown"
      }
    ],
    "events": {
      "dom": {
        "onContextMenu": {
          "config": {
            "draggable": false,
            "id": "ContextMenu",
            "modal": false,
            "overlayDismiss": false,
            "position": {
              "relativeLocation": "bottom-right"
            },
            "positionType": "relative",
            "resizable": false,
            "showCloseIcon": false,
            "type": "toggle",
            "viewParams": {
              "discrete": "true",
              "tagPath": "{view.custom.tagPath}"
            },
            "viewPath": "01_Popups/00_Faceplates/Alerts/ContextMenu",
            "viewportBound": true
          },
          "preventDefault": true,
          "scope": "C",
          "stopPropagation": true,
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "transforms": [
            {
              "expression": "{value} != ''",
              "type": "expression"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "center",
      "style": {
        "cursor": "pointer",
        "minHeight": 20,
        "overflow": "hidden"
      },
      "wrap": "wrap"
    },
    "type": "ia.container.flex"
  }
}
