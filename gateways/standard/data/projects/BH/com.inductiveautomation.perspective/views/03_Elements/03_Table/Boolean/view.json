{
  "custom": {
    "marginRight": "0%",
    "multistates": "",
    "quality": "Bad_NotFound(\"Path '[default]value.quality' not found.\")",
    "tagPath": "",
    "textAlign": "center",
    "value": "",
    "valuePath": ""
  },
  "params": {
    "value": ""
  },
  "propConfig": {
    "custom.marginRight": {
      "persistent": true
    },
    "custom.multistates": {
      "binding": {
        "config": {
          "expression": "if({view.custom.tagPath} = '',\n\t'',\n\tif(isGood(tag({view.custom.valuePath} + '.Metadata')),\n\t\tif(isNull(tag({view.custom.valuePath} + '.Metadata')['states']),\n\t\t\t'',\n\t\t\ttag({view.custom.valuePath} + '.Metadata')['states']),\n\t\tif(isGood(tag({view.custom.tagPath} + '/Metadata')),\n\t\t\tif(isNull(jsonGet(tag({view.custom.tagPath} + '/Metadata'), 'states')),\n\t\t\t\t'',\n\t\t\t\tjsonGet(tag({view.custom.tagPath} + '/Metadata'), 'states')),\n\t\t\t'')))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "expression": "tag({view.custom.valuePath} + '.Quality')"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          },
          {
            "type": "expression",
            "expression": "if(coalesce(try(isGood(tag({view.custom.valuePath} + '.Quality')), false), false), {value}, null)"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.textAlign": {
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.valuePath}"
          },
          "tagPath": "{tagPath}.value"
        },
        "transforms": [
          {
            "expression": "forceQuality(if(isNull({value}) || coalesce({view.custom.quality}, '') != 'Good', '—', {value}))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.valuePath": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(left(coalesce({view.params.value}, ''), 4) = 'pax:', substring({view.params.value}, 4), coalesce({view.params.value}, '') + '/Value')"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Markdown"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "multistates": "{view.custom.multistates}",
                  "value": "{view.custom.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tfrom shared import Utilities\n\tresult = Utilities.getLabelValue(value.value, value.multistates)\n\tif result in (None, '') and value.value not in (None, ''):\n\t\ttry:\n\t\t\tv = int(value.value)\n\t\t\tfallback = {0: 'Off', 1: 'Cooling', 2: 'Defrost', 3: 'Fault', 5: 'Idle'}\n\t\t\tresult = fallback.get(v, unicode(value.value))\n\t\texcept:\n\t\t\tresult = unicode(value.value)\n\treturn (result if result is not None else '') + \"&nbsp;\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct",
              "overlayOptOut": true
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "view.custom.quality"
              },
              "transforms": [
                {
                  "expression": "if({value} = \"Good\",\n\t'Fonts/LiveData',\n\t'Fonts/LiveData value-bad'\n\t)",
                  "type": "expression"
                }
              ],
              "type": "property",
              "overlayOptOut": true
            }
          },
          "props.style.marginRight": {
            "binding": {
              "config": {
                "path": "view.custom.marginRight"
              },
              "type": "property"
            }
          },
          "props.style.textAlign": {
            "binding": {
              "config": {
                "path": "view.custom.textAlign"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.display.markdown"
      }
    ],
    "events": {
      "dom": {
        "onContextMenu": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tshared.TrendContext.menu(self, event, '{view.custom.tagPath}')"
          },
          "preventDefault": true,
          "stopPropagation": true
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "transforms": [
            {
              "expression": "{value} != ''",
              "type": "expression"
            }
          ],
          "type": "property"
        }
      }
    },
    "props": {
      "alignContent": "center",
      "style": {
        "cursor": "pointer",
        "minHeight": 20,
        "overflow": "hidden"
      },
      "wrap": "wrap"
    },
    "type": "ia.container.flex"
  }
}
