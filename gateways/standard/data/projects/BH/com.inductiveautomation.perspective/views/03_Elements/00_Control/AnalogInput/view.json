{
  "custom": {
    "edit": false,
    "primedValue": null,
    "editTimeout": {
      "durationInSecs": 15
    },
    "format": "",
    "metadata": "",
    "quality": "",
    "value": ""
  },
  "params": {
    "Basis": {
      "eu": "",
      "input": "",
      "label": ""
    },
    "faceplate": "",
    "label": "",
    "permission": true,
    "tagPath": ""
  },
  "propConfig": {
    "custom.primedValue": {
      "persistent": false
    },
    "custom.editTimeout": {
      "persistent": true
    },
    "custom.editTimeout.end": {
      "binding": {
        "config": {
          "struct": {
            "edit": "{view.custom.edit}",
            "now": "{view.custom.editTimeout.now}",
            "stop": "{view.custom.editTimeout.stop}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['stop'] != '' && {value}['edit'],\n\t{value}['now'] > {value}['stop'],\n\tFalse\n\t)\n\n",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.edit = False"
      }
    },
    "custom.editTimeout.now": {
      "binding": {
        "config": {
          "expression": "now()"
        },
        "type": "expr"
      }
    },
    "custom.editTimeout.start": {
      "binding": {
        "config": {
          "path": "view.custom.edit"
        },
        "transforms": [
          {
            "expression": "if({value},now(0),'')",
            "type": "expression"
          }
        ],
        "type": "property"
      }
    },
    "custom.editTimeout.stop": {
      "binding": {
        "config": {
          "struct": {
            "duration": "{view.custom.editTimeout.durationInSecs}",
            "start": "{view.custom.editTimeout.start}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['start'] != '' && {value}['duration'] != '' && {value}['duration'] > 0,\ndateArithmetic({value}['start'] , {value}['duration'], \"seconds\"),\n'')",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.format": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '', '#0',\n   try(tag({view.params.tagPath} + '.FormatString'), '#0'))"
        },
        "type": "expr",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}.Metadata"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "expression",
          "tagPath": "{view.params.tagPath}"
        },
        "transforms": [
          {
            "expression": "qualityOf({value})",
            "type": "expression"
          }
        ],
        "type": "tag",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '', '',\n  if(try(isGood(tag({view.params.tagPath})), false),\n     numberFormat(toFloat(try(tag({view.params.tagPath}), 0)), coalesce({view.custom.format}, '#0')),\n     ''))"
        },
        "type": "expr",
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      },
      "persistent": true
    },
    "params.Basis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.permission": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 28,
      "width": 372
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 0,
          "shrink": 1,
          "basis": "auto"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!({view.params.label} = 'Null' || {view.params.label} = null)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "metadata": "{view.custom.metadata}",
                  "tagName": "{view.params.tagPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "expression": "if({value}['metadata'] != '',\n\tif({value}['metadata']['shortDescription'] != \"\",\n\t   {value}['metadata']['shortDescription'],\n\t   if({value}['tagName'] != \"\",\n\t\t  {value}['tagName'],\n\t\t  \"\"\n\t\t )\n\t),\n\t{value}['tagName']\n)",
                  "type": "expression"
                }
              ],
              "type": "expr-struct",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label config-input-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "EditValue",
          "tooltip": {
            "text": "You do not have sufficient privelges to change this value."
          }
        },
        "position": {
          "basis": "64px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "custom.editedValue": {
            "binding": {
              "config": {
                "path": "this.props.value"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif not self.view.custom.edit:\n\t\treturn\n\tif self.session.custom.ReadOnly:\n\t\tself.view.custom.edit = False\n\t\treturn\n\ttagPath = self.view.params.tagPath\n\tif not tagPath:\n\t\treturn\n\tnewV = currentValue.value\n\toldV = self.view.custom.primedValue\n\tif oldV is None:\n\t\ttry:\n\t\t\toldV = system.tag.readBlocking([tagPath])[0].value\n\t\texcept:\n\t\t\toldV = previousValue.value\n\ttry:\n\t\tskip = shared.Audit.valuesEqual(newV, oldV)\n\texcept:\n\t\tskip = (newV == oldV)\n\tself.view.custom.edit = False\n\ttry:\n\t\tself.props.value = oldV\n\texcept:\n\t\tpass\n\tif skip:\n\t\treturn\n\tlabel = self.view.params.label\n\tif label in (None, '', 'Null'):\n\t\tlabel = str(tagPath).split('/')[-1]\n\tshared.Alerts.confirmApplyWrite(\n\t\tlabel=label,\n\t\ttagPath=tagPath,\n\t\tnewValue=newV,\n\t\toldValue=oldV,\n\t\textraPayload={'viewName': self.view.id.split('@')[0]},\n\t)\n"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "config": {
                "path": "this.props.enabled"
              },
              "transforms": [
                {
                  "expression": "!{value}",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.edit"
              },
              "type": "property"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.params.permission} && !{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          },
          "props.format": {
            "binding": {
              "config": {
                "expression": "try(tag({view.params.tagPath} + '.FormatString'),\n    '#0')"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          },
          "props.value": {
            "persistent": false
          }
        },
        "props": {
          "spinner": {
            "enabled": false
          },
          "style": {
            "classes": "font-value analog-input-edit",
            "width": "100%",
            "minWidth": "64px",
            "maxWidth": "64px",
            "height": "24px"
          }
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "64px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{view.custom.edit}"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.custom.quality} = \"Good\",\n\t'font-value',\n\t'font-value'\n\t)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "textAlign": "right",
            "width": "100%",
            "overflow": "hidden"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "EU"
        },
        "position": {
          "basis": "22px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.tagPath} = '', '',\n  if(try(isBadOrError(tag({view.params.tagPath})), false),\n     'Bad Data',\n     try(tag({view.params.tagPath} + '.EngUnit'), '')))"
              },
              "type": "expr",
              "overlays": {
                "bad": false,
                "error": false,
                "pending": false,
                "stale": false,
                "unknown": false,
                "disabled": false
              }
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif not self.view.params.permission or self.session.custom.ReadOnly:\n\t\treturn\n\teditVal = None\n\ttry:\n\t\teditVal = self.parent.getChild('EditValue')\n\texcept:\n\t\tpass\n\ttagPath = self.view.params.tagPath\n\ttagVal = None\n\ttry:\n\t\ttagVal = system.tag.readBlocking([tagPath])[0].value\n\texcept:\n\t\tpass\n\tself.view.custom.primedValue = tagVal\n\tif self.view.custom.edit:\n\t\tself.view.custom.edit = False\n\t\ttry:\n\t\t\teditVal.props.value = tagVal\n\t\texcept:\n\t\t\tpass\n\telse:\n\t\ttry:\n\t\t\teditVal.props.value = tagVal\n\t\texcept:\n\t\t\tpass\n\t\tself.view.custom.edit = True"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "EditIcon"
        },
        "position": {
          "basis": "20px"
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.permission} && !{session.custom.ReadOnly},\n   'font-value',\n   'font-label')"
              },
              "type": "expr"
            }
          },
          "props.style.cursor": {
            "binding": {
              "config": {
                "expression": "if({view.params.permission} && !{session.custom.ReadOnly},\n   'pointer',\n   'not-allowed')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "material/edit"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "flex-start",
      "style": {
        "classes": "config-input-row",
        "overflow": "visible",
        "gap": "8px",
        "width": "100%",
        "height": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "props.justify": {
        "binding": {
          "config": {
            "expression": "if({view.params.label} = 'Null' || {view.params.label} = null, 'flex-end', 'flex-start')"
          },
          "type": "expr"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct",
          "overlays": {
            "bad": false,
            "error": false,
            "pending": false,
            "stale": false,
            "unknown": false,
            "disabled": false
          }
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "cancel",
          "pageScope": true,
          "script": "\tif not self.view.params.tagPath or payload.get('tagPath') != self.view.params.tagPath:\n\t\treturn\n\tself.view.custom.edit = False\n\ttry:\n\t\tqv = system.tag.readBlocking([self.view.params.tagPath])[0].value\n\t\tself.getChild('EditValue').props.value = qv\n\texcept:\n\t\tpass\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "writeValue",
          "pageScope": true,
          "script": "\tif not self.view.params.tagPath or payload.get('tagPath') != self.view.params.tagPath:\n\t\treturn\n\tif not payload.get('alreadyWritten'):\n\t\tshared.Audit.writeTag(\n\t\t\tpayload.get('tagPath'),\n\t\t\tpayload.get('value'),\n\t\t\tlabel=payload.get('label'),\n\t\t\tviewName=payload.get('viewName') or self.view.id.split('@')[0],\n\t\t)\n\tself.view.custom.edit = False\n\ttry:\n\t\tself.getChild('EditValue').props.value = payload.get('value')\n\texcept:\n\t\tpass\n",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
