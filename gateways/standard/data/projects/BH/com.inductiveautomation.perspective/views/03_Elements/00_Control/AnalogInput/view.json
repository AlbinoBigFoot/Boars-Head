{
  "custom": {
    "edit": false,
    "editTimeout": {
      "durationInSecs": 15
    },
    "format": "",
    "metadata": "",
    "quality": "Bad_NotFound",
    "value": "0.00"
  },
  "params": {
    "Basis": {
      "eu": "",
      "input": "",
      "label": ""
    },
    "faceplate": "",
    "label": "",
    "permission": true,
    "tagPath": ""
  },
  "propConfig": {
    "custom.editTimeout": {
      "persistent": true
    },
    "custom.editTimeout.end": {
      "binding": {
        "config": {
          "struct": {
            "edit": "{view.custom.edit}",
            "now": "{view.custom.editTimeout.now}",
            "stop": "{view.custom.editTimeout.stop}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['stop'] != '' && {value}['edit'],\n\t{value}['now'] > {value}['stop'],\n\tFalse\n\t)\n\n",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.edit = False"
      }
    },
    "custom.editTimeout.now": {
      "binding": {
        "config": {
          "expression": "now()"
        },
        "type": "expr"
      }
    },
    "custom.editTimeout.start": {
      "binding": {
        "config": {
          "path": "view.custom.edit"
        },
        "transforms": [
          {
            "expression": "if({value},now(0),'')",
            "type": "expression"
          }
        ],
        "type": "property"
      }
    },
    "custom.editTimeout.stop": {
      "binding": {
        "config": {
          "struct": {
            "duration": "{view.custom.editTimeout.durationInSecs}",
            "start": "{view.custom.editTimeout.start}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['start'] != '' && {value}['duration'] != '' && {value}['duration'] > 0,\ndateArithmetic({value}['start'] , {value}['duration'], \"seconds\"),\n'')",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.format": {
      "binding": {
        "config": {
          "expression": "if({view.custom.quality} = 'Good',\n   tag({view.params.tagPath} + '.FormatString'),\n   '')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}.Metadata"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "expression",
          "tagPath": "{view.params.tagPath}"
        },
        "transforms": [
          {
            "expression": "qualityOf({value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "expression": "if({view.custom.quality} = 'Good',\n   numberFormat(toFloat(tag({view.params.tagPath})), {view.custom.format}),\n   '0.00')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.Basis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.permission": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 28,
      "width": 372
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 0,
          "shrink": 1,
          "basis": "auto"
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!({view.params.label} = 'Null' || {view.params.label} = null)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "metadata": "{view.custom.metadata}",
                  "tagName": "{view.params.tagPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "expression": "if({value}['metadata'] != '',\n\tif({value}['metadata']['shortDescription'] != \"\",\n\t   {value}['metadata']['shortDescription'],\n\t   if({value}['tagName'] != \"\",\n\t\t  {value}['tagName'],\n\t\t  \"\"\n\t\t )\n\t),\n\t{value}['tagName']\n)",
                  "type": "expression"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label config-input-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "EditValue",
          "tooltip": {
            "text": "You do not have sufficient privelges to change this value."
          }
        },
        "position": {
          "basis": "64px",
          "shrink": 0
        },
        "propConfig": {
          "custom.editedValue": {
            "binding": {
              "config": {
                "path": "this.props.value"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif currentValue.value != previousValue.value:\n\t\tif self.session.custom.ReadOnly:\n\t\t\treturn\n\t\ttagPath = self.view.params.tagPath\n\t\tif system.tag.exists(tagPath):\n\t\t\tsystem.tag.writeBlocking([tagPath], [currentValue.value])"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "config": {
                "path": "this.props.enabled"
              },
              "transforms": [
                {
                  "expression": "!{value}",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "path": "view.custom.edit"
              },
              "type": "property"
            }
          },
          "position.grow": {
            "binding": {
              "config": {
                "expression": "if({../Label.position.display},\n   0,\n   1)"
              },
              "type": "expr"
            }
          },
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.params.permission} && !{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          },
          "props.format": {
            "binding": {
              "config": {
                "expression": "try(tag({view.params.tagPath} + '.FormatString'),\n    '#0')"
              },
              "type": "expr"
            }
          },
          "props.value": {
            "onChange": {
              "enabled": null,
              "script": "\tself.view.custom.edit = False\n"
            }
          }
        },
        "props": {
          "spinner": {
            "enabled": false
          },
          "style": {
            "classes": "font-value"
          }
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "48px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!{view.custom.edit}"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.custom.quality} = \"Good\",\n\t'font-value',\n\t'font-value'\n\t)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.value"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "EU"
        },
        "position": {
          "basis": "auto",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if(isBadorError(tag({view.params.tagPath})),\n   'Bad Data',\n   try(tag({view.params.tagPath} + '.EngUnit'),\n    ''))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif self.view.params.permission and not self.session.custom.ReadOnly:\n\t\tif self.view.custom.edit:\n\t\t\tself.view.custom.edit = False\n\t\telse:\n\t\t\tself.view.custom.edit = True"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "EditIcon"
        },
        "position": {
          "basis": "20px"
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.permission} && !{session.custom.ReadOnly},\n   'font-value',\n   'font-label')"
              },
              "type": "expr"
            }
          },
          "props.style.cursor": {
            "binding": {
              "config": {
                "expression": "if({view.params.permission} && !{session.custom.ReadOnly},\n   'pointer',\n   'not-allowed')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "material/edit"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "flex-start",
      "style": {
        "classes": "config-input-row",
        "overflow": "visible",
        "gap": "8px",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
