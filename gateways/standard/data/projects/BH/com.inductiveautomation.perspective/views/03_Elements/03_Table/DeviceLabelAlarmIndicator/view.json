{
  "custom": {
    "flash": true,
    "icon": "03_Elements/01_Status/NotificationIcons/Alarms/Medium",
    "metadata": "",
    "tagName": "EV-001",
    "tagPath": "[default]Evaporators/EV-001",
    "textAlign": "left"
  },
  "params": {
    "value": "[default]Evaporators/EV-001"
  },
  "propConfig": {
    "custom.flash": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "value": "{view.params.value}"
          },
          "tagPath": "{value}/_Alarms/_Flash"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\t{value}\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.icon": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "value": "{view.params.value}"
          },
          "tagPath": "{value}/_Alarms/_Icon"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t'03_Elements/01_Status/NotificationIcons/Blank',\n\t{value}\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "expression",
          "tagPath": "tag({tagPath} + \".metadata\""
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}.Name"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.textAlign": {
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "view.custom.flash"
              },
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.custom.icon"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "metadata": "{view.custom.metadata}",
                  "tagName": "{view.custom.tagName}",
                  "tagPath": "{view.params.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "expression": "if(\n\tindexOf({value}['tagPath'], \"AppliedDigital\") >= 0 || indexOf({value}['tagPath'], \"HDB\") >= 0,\n\tconcat(\n\t\tsplit({value}['tagPath'],'/')[len(split({value}['tagPath'],'/'))-2,0],\n\t\t\"-\",\n\t\tsplit({value}['tagPath'],'/')[len(split({value}['tagPath'],'/'))-1,0]\n\t),\n\tif(\n\t\t{value}['metadata'] != '',\n\t\tif(\n\t\t\t{value}['metadata']['shortDescription'] != \"\",\n\t\t\t{value}['metadata']['shortDescription'],\n\t\t\tif(\n\t\t\t\t{value}['tagName'] != \"\",\n\t\t\t\t{value}['tagName'],\n\t\t\t\t\"\"\n\t\t\t)\n\t\t),\n\t\t{value}['tagName']\n\t)\n)",
                  "type": "expression"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.textStyle.textAlign": {
            "binding": {
              "config": {
                "path": "view.custom.textAlign"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label",
            "marginLeft": "2%",
            "marginTop": "1%"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "style": {
        "minHeight": 20,
        "overflow": "hidden",
        "paddingLeft": "5%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
