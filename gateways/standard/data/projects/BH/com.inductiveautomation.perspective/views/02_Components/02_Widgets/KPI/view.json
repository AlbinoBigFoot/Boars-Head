{
  "custom": {
    "liveNumeric": 0,
    "spark": {
      "series": [],
      "min": "—",
      "max": "—",
      "avg": "—"
    }
  },
  "params": {
    "title": "Metric",
    "category": "",
    "unit": "",
    "tagPath": "",
    "value": "—"
  },
  "propConfig": {
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.category": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.unit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.liveNumeric": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(len(coalesce({view.params.tagPath}, '')) > 0, coalesce(try(if(!isGood(tag({view.params.tagPath})), null, tag({view.params.tagPath})), null), 0), try(toFloat(replace(coalesce({view.params.value}, '0'), ',', '')), 0))"
        },
        "overlays": {
          "bad": false,
          "error": false,
          "pending": false,
          "stale": false,
          "unknown": false,
          "disabled": false
        }
      }
    },
    "custom.spark": {
      "binding": {
        "type": "property",
        "config": {
          "path": "view.custom.liveNumeric"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\t# Real data only: no historian series is wired for the KPI widget (enterprise-only views): flat No Data.\n\treturn {'series': [], 'min': u'\\u2014', 'max': u'\\u2014', 'avg': u'\\u2014'}\n"
          }
        ]
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 280,
      "width": 320
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "justify": "flex-start",
      "style": {
        "classes": "container-card container-card-border kpi-card",
        "height": "100%",
        "overflow": "hidden",
        "width": "100%"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "kpi-card-header",
            "gap": "2px",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Category"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Fonts/Label",
                "letterSpacing": "0.04em",
                "textTransform": "uppercase"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.category"
                  }
                }
              },
              "meta.visible": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "len(coalesce({view.params.category}, '')) > 0"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Metric",
              "style": {
                "classes": "Fonts/Title plant-feature-title"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.title"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "ValueRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "baseline",
          "justify": "flex-start",
          "style": {
            "gap": "8px",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "—",
              "style": {
                "classes": "Fonts/LiveDataEntry kpi-value",
                "fontSize": "1.85rem",
                "lineHeight": "1.1"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(len(coalesce({view.params.tagPath}, '')) > 0, numberFormat(coalesce(try(if(!isGood(tag({view.params.tagPath})), null, tag({view.params.tagPath})), null), 0), '#,##0.#'), coalesce({view.params.value}, '—'))"
                  },
                  "overlays": {
                    "bad": false,
                    "error": false,
                    "pending": false,
                    "stale": false,
                    "unknown": false,
                    "disabled": false
                  },
                  "overlayOptOut": true
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Unit"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Fonts/Label",
                "fontSize": "0.95rem"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.unit"
                  }
                }
              },
              "meta.visible": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "len(coalesce({view.params.unit}, '')) > 0"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "kyvislabs.display.apexchart",
        "meta": {
          "name": "Chart"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "140px"
        },
        "props": {
          "type": "line",
          "series": [],
          "options": {
            "chart": {
              "type": "line",
              "height": 140,
              "width": "100%",
              "animations": {
                "enabled": false
              },
              "toolbar": {
                "show": false
              },
              "zoom": {
                "enabled": false
              },
              "selection": {
                "enabled": false
              },
              "redrawOnParentResize": true,
              "redrawOnWindowResize": true,
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": false,
                "legendClick": false,
                "markerClick": false,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": false,
                "selection": false,
                "updated": false,
                "xAxisLabelClick": false,
                "zoomed": false
              }
            },
            "colors": [
              "#0C7BB3"
            ],
            "dataLabels": {
              "enabled": false
            },
            "fill": {
              "opacity": 0.15,
              "type": "solid"
            },
            "grid": {
              "show": false,
              "padding": {
                "top": 0,
                "right": 4,
                "bottom": 0,
                "left": 4
              }
            },
            "legend": {
              "show": false
            },
            "markers": {
              "size": 0
            },
            "stroke": {
              "curve": "stepline",
              "width": 2
            },
            "tooltip": {
              "enabled": true,
              "x": {
                "format": "HH:mm",
                "show": true
              }
            },
            "xaxis": {
              "type": "datetime",
              "labels": {
                "show": false,
                "datetimeUTC": false
              },
              "axisBorder": {
                "show": false
              },
              "axisTicks": {
                "show": false
              },
              "tooltip": {
                "enabled": false
              }
            },
            "yaxis": {
              "labels": {
                "show": false
              },
              "axisBorder": {
                "show": false
              },
              "axisTicks": {
                "show": false
              }
            },
            "noData": {
              "text": "No Data",
              "align": "center",
              "verticalAlign": "middle",
              "style": {
                "color": "#90A4AE",
                "fontSize": "14px"
              }
            }
          },
          "style": {
            "classes": "kpi-chart",
            "overflow": "hidden",
            "width": "100%",
            "height": "140px"
          }
        },
        "propConfig": {
          "props.series": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.spark.series"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn list(value or [])\n"
                }
              ],
              "overlayOptOut": true
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Metrics"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "justify": "space-between",
          "style": {
            "classes": "kpi-metrics",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Min"
            },
            "position": {
              "grow": 1,
              "basis": "0px"
            },
            "props": {
              "direction": "column",
              "alignItems": "center",
              "style": {
                "gap": "2px",
                "minWidth": "0"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "MinLabel"
                },
                "props": {
                  "text": "Min",
                  "style": {
                    "classes": "Fonts/Label",
                    "fontSize": "11px",
                    "letterSpacing": "0.04em",
                    "textAlign": "center",
                    "textTransform": "uppercase"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "MinValue"
                },
                "props": {
                  "text": "—",
                  "style": {
                    "classes": "Fonts/Value fs-13 fw-600",
                    "textAlign": "center"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.spark.min"
                      },
                      "overlayOptOut": true
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Max"
            },
            "position": {
              "grow": 1,
              "basis": "0px"
            },
            "props": {
              "direction": "column",
              "alignItems": "center",
              "style": {
                "gap": "2px",
                "minWidth": "0"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "MaxLabel"
                },
                "props": {
                  "text": "Max",
                  "style": {
                    "classes": "Fonts/Label",
                    "fontSize": "11px",
                    "letterSpacing": "0.04em",
                    "textAlign": "center",
                    "textTransform": "uppercase"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "MaxValue"
                },
                "props": {
                  "text": "—",
                  "style": {
                    "classes": "Fonts/Value fs-13 fw-600",
                    "textAlign": "center"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.spark.max"
                      },
                      "overlayOptOut": true
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Avg"
            },
            "position": {
              "grow": 1,
              "basis": "0px"
            },
            "props": {
              "direction": "column",
              "alignItems": "center",
              "style": {
                "gap": "2px",
                "minWidth": "0"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "AvgLabel"
                },
                "props": {
                  "text": "Avg",
                  "style": {
                    "classes": "Fonts/Label",
                    "fontSize": "11px",
                    "letterSpacing": "0.04em",
                    "textAlign": "center",
                    "textTransform": "uppercase"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "AvgValue"
                },
                "props": {
                  "text": "—",
                  "style": {
                    "classes": "Fonts/Value fs-13 fw-600",
                    "textAlign": "center"
                  }
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.spark.avg"
                      },
                      "overlayOptOut": true
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
