{
  "custom": {
    "label": "",
    "vertical": false
  },
  "params": {
    "tagPath": "",
    "label": "",
    "orientation": "horizontal"
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.orientation": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.label}, '') != '', {view.params.label}, if(coalesce({view.params.tagPath}, '') = '', '', subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)))"
        }
      },
      "persistent": true
    },
    "custom.vertical": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "lower(trim(coalesce({view.params.orientation}, ''))) = 'vertical'"
        }
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 160,
      "height": 80
    }
  },
  "root": {
    "type": "ia.container.coord",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "mode": "percent",
      "style": {
        "overflow": "visible"
      }
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "children": [
      {
        "type": "ia.shapes.svg",
        "meta": {
          "name": "VesselHorizontal"
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "props": {
          "viewBox": "0 0 80 40",
          "elements": [
            {
              "type": "rect",
              "name": "vessel",
              "x": 4.625,
              "y": 4.625,
              "width": 70.75,
              "height": 26.75,
              "rx": 13.375,
              "fill": {
                "paint": "var(--neutral-30)"
              },
              "stroke": {
                "paint": "var(--neutral-100)",
                "width": "1.25",
                "linecap": "butt",
                "linejoin": "miter"
              },
              "style": {}
            },
            {
              "type": "rect",
              "name": "nozzle-1",
              "fill": {
                "paint": "var(--neutral-60)"
              },
              "style": {},
              "x": 24.75,
              "y": 31.75,
              "width": 2.5,
              "height": 4.0,
              "stroke": {
                "paint": "var(--neutral-100)",
                "width": "0.5",
                "linecap": "butt",
                "linejoin": "miter"
              }
            },
            {
              "type": "rect",
              "name": "nozzle-2",
              "fill": {
                "paint": "var(--neutral-60)"
              },
              "style": {},
              "x": 52.75,
              "y": 31.75,
              "width": 2.5,
              "height": 4.0,
              "stroke": {
                "paint": "var(--neutral-100)",
                "width": "0.5",
                "linecap": "butt",
                "linejoin": "miter"
              }
            },
            {
              "type": "text",
              "name": "label",
              "text": "",
              "x": 40,
              "y": 20.8,
              "textAnchor": "middle",
              "fontSize": 8,
              "fontWeight": "600",
              "fill": {
                "paint": "var(--text)"
              },
              "stroke": {
                "paint": "none",
                "width": "0"
              },
              "style": {
                "fontFamily": "inherit",
                "userSelect": "none"
              }
            }
          ],
          "style": {
            "overflow": "hidden",
            "userSelect": "none"
          },
          "preserveAspectRatio": "xMidYMid meet"
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "!{view.custom.vertical}"
              }
            }
          },
          "props.elements[3].text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.label"
              }
            }
          },
          "props.elements[3].fontSize": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "round(min(8, 62 / (0.66 * max(len(coalesce({view.custom.label}, '')), 1))), 2)"
              }
            }
          },
          "props.elements[3].y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "round(18 + 0.35 * round(min(8, 62 / (0.66 * max(len(coalesce({view.custom.label}, '')), 1))), 2), 2)"
              }
            }
          }
        }
      },
      {
        "type": "ia.shapes.svg",
        "meta": {
          "name": "VesselVertical"
        },
        "position": {
          "x": 0,
          "y": 0,
          "width": 1,
          "height": 1
        },
        "props": {
          "viewBox": "0 0 48 84",
          "elements": [
            {
              "type": "rect",
              "name": "vessel",
              "x": 10.625,
              "y": 4.625,
              "width": 26.75,
              "height": 70.75,
              "rx": 13.375,
              "fill": {
                "paint": "var(--neutral-30)"
              },
              "stroke": {
                "paint": "var(--neutral-100)",
                "width": "1.25",
                "linecap": "butt",
                "linejoin": "miter"
              },
              "style": {}
            },
            {
              "type": "rect",
              "name": "nozzle-1",
              "fill": {
                "paint": "var(--neutral-60)"
              },
              "style": {},
              "x": 18.25,
              "y": 74.75,
              "width": 2.5,
              "height": 5.0,
              "stroke": {
                "paint": "var(--neutral-100)",
                "width": "0.5",
                "linecap": "butt",
                "linejoin": "miter"
              }
            },
            {
              "type": "rect",
              "name": "nozzle-2",
              "fill": {
                "paint": "var(--neutral-60)"
              },
              "style": {},
              "x": 27.25,
              "y": 74.75,
              "width": 2.5,
              "height": 5.0,
              "stroke": {
                "paint": "var(--neutral-100)",
                "width": "0.5",
                "linecap": "butt",
                "linejoin": "miter"
              }
            },
            {
              "type": "text",
              "name": "label",
              "text": "",
              "x": 24,
              "y": 42.8,
              "textAnchor": "middle",
              "fontSize": 8,
              "fontWeight": "600",
              "fill": {
                "paint": "var(--text)"
              },
              "stroke": {
                "paint": "none",
                "width": "0"
              },
              "style": {
                "fontFamily": "inherit",
                "userSelect": "none"
              }
            }
          ],
          "style": {
            "overflow": "hidden",
            "userSelect": "none"
          },
          "preserveAspectRatio": "xMidYMid meet"
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.vertical}"
              }
            }
          },
          "props.elements[3].text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.label"
              }
            }
          },
          "props.elements[3].fontSize": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "round(min(8, 22 / (0.66 * max(len(coalesce({view.custom.label}, '')), 1))), 2)"
              }
            }
          },
          "props.elements[3].y": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "round(40 + 0.35 * round(min(8, 22 / (0.66 * max(len(coalesce({view.custom.label}, '')), 1))), 2), 2)"
              }
            }
          }
        }
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])"
        }
      ]
    }
  }
}
