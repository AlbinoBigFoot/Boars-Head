{
  "custom": {},
  "params": {
    "tagPath": "",
    "label": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 12,
      "height": 10
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "justify": "center",
      "style": {
        "width": "100%",
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Led"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "text": "",
          "style": {
            "width": "100%",
            "height": "10px",
            "borderRadius": "2px",
            "boxSizing": "border-box"
          }
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(!(coalesce(try(isGood(tag(coalesce({view.params.tagPath}, '') + '/Faulted')), false), false) && coalesce(try(toBoolean(tag(coalesce({view.params.tagPath}, '') + '/CommOk')), false), false)), 'var(--neutral-60)', if(coalesce(try(toBoolean(tag(coalesce({view.params.tagPath}, '') + '/Faulted')), false), false), 'var(--sts-fault)', 'var(--sts-run)'))"
              },
              "overlayOptOut": true
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.label"
              }
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "true"
              }
            }
          }
        }
      }
    ]
  }
}
