{
  "custom": {
    "good": false,
    "value": null,
    "on": false,
    "ma": null,
    "unit": "",
    "cmd": false,
    "range": "",
    "cfg": "",
    "extra": "",
    "trendPath": ""
  },
  "params": {
    "tagPath": "",
    "point": 0,
    "kind": "DI",
    "description": "Not Documented"
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.point": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.kind": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.description": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.good": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.params.tagPath}, '') != '' && coalesce(try(isGood(tag({view.params.tagPath} + '/' + if(coalesce({view.params.kind}, '') = 'AI', 'Ch' + toStr(coalesce({view.params.point}, 0)) + 'Data', if(coalesce({view.params.kind}, '') = 'DO', 'ReadBack', 'Data')))) && isGood(tag({view.params.tagPath} + '/Fault')) && coalesce(toInt(tag({view.params.tagPath} + '/Fault')), -1) = 0, false), false)"
        }
      }
    },
    "custom.value": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/' + if(coalesce({view.params.kind}, '') = 'AI', 'Ch' + toStr(coalesce({view.params.point}, 0)) + 'Data', if(coalesce({view.params.kind}, '') = 'DO', 'ReadBack', 'Data')))), false), false), if({view.custom.good}, try(toInt(tag({view.params.tagPath} + '/' + if(coalesce({view.params.kind}, '') = 'AI', 'Ch' + toStr(coalesce({view.params.point}, 0)) + 'Data', if(coalesce({view.params.kind}, '') = 'DO', 'ReadBack', 'Data')))), null), null), '—')"
        }
      }
    },
    "custom.on": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce({view.params.kind}, '') != 'AI' && !isNull({view.custom.value}) && getBit(coalesce({view.custom.value}, 0), coalesce({view.params.point}, 0)) = 1"
        }
      }
    },
    "custom.ma": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if((coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'En')), false), false) || coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'Signal')), false), false)), if({view.custom.good} && coalesce({view.params.kind}, '') = 'AI' && coalesce(try(toBoolean(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'En')), true), true), try(toFloat(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'Signal')), null), null), null)"
        }
      }
    },
    "custom.unit": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'Unit')), false), false), if(coalesce({view.params.kind}, '') = 'AI', coalesce(try(toStr(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'Unit')), ''), ''), ''), null)"
        }
      }
    },
    "custom.cmd": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/Data')), false), false), if(coalesce({view.params.kind}, '') = 'DO' && {view.custom.good}, getBit(coalesce(try(toInt(tag({view.params.tagPath} + '/Data')), 0), 0), coalesce({view.params.point}, 0)) = 1, false), null)"
        }
      }
    },
    "custom.range": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if((coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'OverRange')), false), false) || coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'UnderRange')), false), false)), if(coalesce({view.params.kind}, '') != 'AI' || !{view.custom.good}, '', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'OverRange')), false), false), 'Over Range', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'UnderRange')), false), false), 'Under Range', 'In Range'))), null)"
        }
      }
    },
    "custom.cfg": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if((coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'RangeText')), false), false) || coalesce(try(isGood(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'En')), false), false)), if(coalesce({view.params.kind}, '') != 'AI' || !{view.custom.good}, '', coalesce(try(toStr(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'RangeText')), null), '?') + if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/Ch' + toStr(coalesce({view.params.point}, 0)) + 'En')), true), true), '', ' Disabled')), null)"
        }
      }
    },
    "custom.extra": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!{view.custom.good}, '', if(coalesce({view.params.kind}, '') = 'DO', 'Cmd ' + if({view.custom.cmd}, 'On', 'Off'), if(coalesce({view.params.kind}, '') = 'AI', {view.custom.range} + ' · Raw ' + toStr({view.custom.value}) + ' · ' + {view.custom.cfg}, '')))"
        }
      }
    },
    "custom.trendPath": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', {view.params.tagPath} + '/' + if(coalesce({view.params.kind}, '') = 'AI', 'Ch' + toStr(coalesce({view.params.point}, 0)) + 'Data', 'Data'))"
        }
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 520,
      "height": 24
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "gap": "8px",
        "borderBottom": "1px solid var(--neutral-30)",
        "paddingLeft": "2px",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Point"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "text": "00",
          "style": {
            "classes": "Fonts/Value fs-12 fw-600",
            "textAlign": "left",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.params.point}, 0) < 10, '0', '') + toStr(coalesce({view.params.point}, 0))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Led"
        },
        "position": {
          "basis": "10px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "width": "10px",
            "height": "10px",
            "borderRadius": "50%",
            "border": "1px solid var(--neutral-100)",
            "boxSizing": "border-box"
          }
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(!{view.custom.good}, 'var(--neutral-60)', if(coalesce({view.params.kind}, '') = 'AI', if({view.custom.range} = 'In Range', 'var(--sts-run)', 'var(--status-level-warning)'), if({view.custom.on}, 'var(--sts-run)', 'var(--neutral-60)')))"
              },
              "overlayOptOut": true
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Description"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "fs-12 fw-400",
            "textAlign": "left",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({view.params.description}, 'Not Documented')"
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.params.description}, 'Not Documented') = 'Not Documented', 'fs-12 fw-400 value-bad', 'fs-12 fw-400')"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({view.params.description}, 'Not Documented')"
              }
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "true"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "State"
        },
        "position": {
          "basis": "70px",
          "shrink": 0
        },
        "props": {
          "text": "--",
          "style": {
            "classes": "fs-12 fw-700",
            "textAlign": "left",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(!{view.custom.good}, '--', if(coalesce({view.params.kind}, '') = 'AI', if(isNull({view.custom.ma}), '--', numberFormat({view.custom.ma}, '0.00') + ' ' + {view.custom.unit}), if({view.custom.on}, 'On', 'Off')))"
              },
              "overlayOptOut": true
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.good}, 'fs-12 fw-700', 'fs-12 fw-700 value-bad')"
              },
              "overlayOptOut": true
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(!{view.custom.good}, 'var(--neutral-60)', if(coalesce({view.params.kind}, '') = 'AI', 'var(--text)', if({view.custom.on}, 'var(--sts-run)', 'var(--status-off)')))"
              },
              "overlayOptOut": true
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Extra"
        },
        "position": {
          "basis": "64px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "fs-11 fw-400 text-muted",
            "textAlign": "left",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.extra"
              },
              "overlayOptOut": true
            }
          },
          "position.basis": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.params.kind}, '') = 'AI', '200px', '64px')"
              }
            }
          },
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({view.params.kind}, '') != 'DI'"
              }
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.extra"
              }
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "true"
              }
            }
          }
        }
      }
    ],
    "events": {
      "dom": {
        "onContextMenu": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\tshared.TrendContext.menu(self, event, '{view.custom.trendPath}')"
          },
          "preventDefault": true,
          "stopPropagation": true
        }
      }
    }
  }
}
