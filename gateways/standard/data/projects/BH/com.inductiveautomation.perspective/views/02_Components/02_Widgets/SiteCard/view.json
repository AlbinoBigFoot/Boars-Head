          "config": {
            "script": "\tpage = str(self.view.params.page or '').strip()\n\tif not page:\n\t\treturn\n\tNavigation.Nav.navigate({'action': 'page', 'page': page})\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
