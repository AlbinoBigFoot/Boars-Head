          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/Status/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.analog": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/TravelTime/Value')"
        },
