{
  "custom": {
    "preview": "ok",
    "good": false,
    "fault": 0,
    "state": "bad",
    "word": 0
  },
  "params": {
    "tagPath": "",
    "slot": 0,
    "member": "",
    "selected": false,
    "state": "OK",
    "name": ""
  },
  "propConfig": {
    "custom.preview": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "lower(trim(coalesce({view.params.state}, 'ok')))"
        }
      }
    },
    "custom.good": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', {view.custom.preview} != 'bad', coalesce(try(isGood(tag({view.params.tagPath} + '/Fault')) && isGood(tag({view.params.tagPath} + '/Data')), false), false))"
        }
      }
    },
    "custom.fault": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/Fault')), false), false), if(coalesce({view.params.tagPath}, '') = '', if({view.custom.preview} = 'fault', 1, 0), coalesce(try(toInt(tag({view.params.tagPath} + '/Fault')), 0), 0)), null)"
        }
      }
    },
    "custom.state": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!{view.custom.good}, 'bad', if({view.custom.fault} = -1, 'conn', if({view.custom.fault} != 0, 'fault', 'ok')))"
        }
      }
    },
    "custom.word": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/Data')), false), false), if(coalesce({view.params.tagPath}, '') = '', if({view.custom.preview} = 'ok', 4627, 0), coalesce(try(toInt(tag({view.params.tagPath} + '/Data')), 0), 0)), null)"
        }
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.slot": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.member": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.state": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 54,
      "height": 280
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "visible",
        "cursor": "pointer",
        "width": "100%",
        "height": "100%"
      }
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      },
      "props.style.classes": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if(coalesce({view.params.member}, '') != '', 'faceplate-hover', '')"
          }
        }
      }
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# read-only rack: a click only selects the module for the detail panel (page message)\n\tmember = str(self.view.params.member or '')\n\tif member:\n\t\tsystem.perspective.sendMessage('plcRackSelect', payload={'member': member}, scope='page')\n"
          }
        },
        "onMouseEnter": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# hover popover over the rack (UI state only; the page clears it on leave)\n\tm = str(self.view.params.member or '')\n\tif m:\n\t\tsystem.perspective.sendMessage('plcRackHover', payload={'member': m, 'leave': False}, scope='page')\n"
          }
        },
        "onMouseLeave": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# hover popover over the rack (UI state only; the page clears it on leave)\n\tm = str(self.view.params.member or '')\n\tif m:\n\t\tsystem.perspective.sendMessage('plcRackHover', payload={'member': m, 'leave': True}, scope='page')\n"
          }
        }
      }
    },
