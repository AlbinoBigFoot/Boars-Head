        "onClick": {
          "config": {
            "script": "\tfaceplate = self.view.params.faceplate\n\tif faceplate is None or str(faceplate).strip() == '':\n\t\treturn\n\ttagPath = str(self.view.params.tagPath or '')\n\ttitle = str(self.view.custom.label or '')\n\tif title in (None, '', 'nn'):\n\t\ttitle = tagPath.split('/')[-1] if tagPath else self.view.name\n\t# Unified tabbed Faceplate. show* are hints; tagFlags hide empty tabs.\n\tparams = {\n\t\t'tagPath': tagPath,\n\t\t'deviceType': 'ExhaustFan',\n\t\t'webGuiUrl': '',\n\t\t'showControls': True,\n\t\t'showConfiguration': True,\n\t\t'showInterlocks': True,\n\t\t'showTrend': True,\n\t\t'showAlarmConfiguration': True,\n\t\t'showAlarms': True\n\t}\n\tNavigation.Faceplate.openFaceplate(\n\t\t'efan-fp-%s' % (tagPath or title),\n\t\ttagPath,\n\t\t'01_Popups/00_Faceplates/Faceplate',\n\t\tFalse,\n\t\ttitle,\n\t\t560,\n\t\t640,\n\t\tparams\n\t)\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "direction": "column",
      "justify": "flex-start",
      "style": {
        "gap": "2px",
        "overflow": "visible",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr-struct",
          "config": {
            "struct": {
              "ticket": "coalesce({session.custom.TicketLogAccess}, false)",
              "admin": "coalesce({session.custom.Permissions.OutOfService.Set}, false)",
              "history": "coalesce({session.custom.Permissions.OutOfService.View}, false)",
              "oos": "coalesce({view.custom.oos}, false)"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\tdef item(text, icon, msg_type, payload, scope):\n\t\treturn {\n\t\t\t\"text\": text,\n\t\t\t\"icon\": {\"path\": icon, \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": msg_type, \"payload\": payload, \"scope\": scope}\n\t\t}\n\titems = []\n\tif value['ticket']:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append(item('Ticket Logger', 'material/info', 'ticketLog',\n\t\t\t{'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, 'page'))\n\tif value['admin'] and tagPath.strip():\n\t\tif value['oos']:\n\t\t\titems.append(item('Return To Service', 'material/info', 'oosToggle', {'tagPath': tagPath, 'sender': self.view.id}, 'page'))\n\t\telse:\n\t\t\titems.append(item('Take Out Of Service', 'material/info', 'oosToggle',\n\t\t\t\t{'tagPath': tagPath, 'sender': self.view.id}, 'page'))\n\tif value['history'] and tagPath.strip():\n\t\titems.append(item('Out Of Service History', 'material/info', 'oosHistory',\n\t\t\t{'tagPath': tagPath, 'sender': self.view.id}, 'page'))\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      },
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "('device-vertical')"
          },
          "type": "expr"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "oosToggle",
          "pageScope": true,
          "script": "\t# HMI Out Of Service (OutOfService/Set permission) - memo dialog; shared.OutOfService logs + audits the change\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tif not shared.Security.allowed(self.session, 'OutOfService', 'Set'):\n\t\treturn\n\ttp = str(self.view.params.tagPath or '')\n\t# page-scoped: every component on the page hears it - only the one that was right-clicked acts\n\tif not tp or str(payload.get('tagPath') or '') != tp:\n\t\treturn\n\t# required memo (+ reason when taking it out): the dialog's Confirm calls shared.OutOfService.setOutOfService\n\tshared.OutOfService.openDialog(tp, self.view.id.split('@')[0])",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "oosHistory",
          "pageScope": true,
          "script": "\t# Out Of Service History (OutOfService/View permission) - OOS log page filtered to this device\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tif not shared.Security.allowed(self.session, 'OutOfService', 'View'):\n\t\treturn\n\ttp = str(self.view.params.tagPath or '')\n\tif not tp or str(payload.get('tagPath') or '') != tp:\n\t\treturn\n\tshared.OutOfService.openHistory(tp)",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
