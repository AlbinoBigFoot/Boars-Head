              "props.params.tagPath": {
                "binding": {
                  "config": {
                    "path": "view.params.tagPath"
                  },
                  "type": "property"
                }
              },
              "props.params.statusPath": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.values.analog"
                  }
                }
              }
            },
            "props": {
              "path": "03_Elements/01_Status/IconHeader",
              "style": {
                "classes": "icon-header",
                "height": "20px",
                "width": "20px",
                "overflow": "visible"
              },
              "useDefaultViewHeight": true,
              "useDefaultViewWidth": true,
              "params": {
                "statusPath": ""
              }
            },
            "type": "ia.display.view"
          }
        ],
        "meta": {
          "name": "NotificationHeader"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "notification-wrapper",
            "overflow": "visible",
            "gap": "4px"
          },
          "direction": "row"
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "BadgeBox"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "center",
              "style": {
                "classes": "sensor-badge-box",
                "overflow": "visible"
              }
            },
            "children": [
              {
                "meta": {
                  "name": "Badge"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.custom.label"
                      },
                      "type": "property"
                    }
                  },
                  "props.style.cursor": {
                    "binding": {
                      "config": {
                        "expression": "if(isNull({view.params.faceplate}) || {view.params.faceplate} = '',\n   '',\n   'pointer')"
                      },
                      "type": "expr"
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(coalesce({view.custom.values.commLoss}, false), 'tag-label sensor-badge Fonts/Value fs-11 fw-700 device-comm-loss', if(coalesce({view.custom.alarm.active}, false), 'tag-label sensor-badge Fonts/Value fs-11 fw-700 alarm-border alarm-priority-' + case(coalesce({view.custom.alarm.priority}, -1), 4, 'critical', 3, 'high', 2, 'medium', 1, 'low', 'low'), 'tag-label sensor-badge Fonts/Value fs-11 fw-700'))"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "props": {
                  "align": "center",
                  "style": {
                    "classes": "tag-label sensor-badge Fonts/Value fs-11 fw-700",
                    "textAlign": "center"
                  },
                  "text": "SNS"
                },
                "type": "ia.display.label"
              },
              {
                "type": "ia.display.icon",
                "meta": {
                  "name": "FaceplateIcon"
                },
                "position": {
                  "basis": "16px",
                  "shrink": 0
                },
                "props": {
                  "path": "material/fullscreen",
                  "style": {
                    "classes": "sensor-faceplate-icon sensor-faceplate-icon-side",
                    "cursor": "pointer",
                    "height": "16px",
                    "minHeight": "16px",
                    "minWidth": "16px",
                    "width": "16px"
                  }
                },
                "propConfig": {
                  "meta.visible": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "coalesce({session.custom.CanOpenFaceplates}, false) && (len(trim(coalesce({view.params.faceplate}, ''))) > 0)"
                      }
                    }
                  },
                  "props.style.opacity": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(len(trim(coalesce({view.params.faceplate}, ''))) > 0, 1, 0)"
                      }
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "'sensor-faceplate-icon ' + if((coalesce({view.params.orientation.horizontal}, false) || lower(coalesce({view.params.valuePosition}, 'auto')) = 'right' || (coalesce({view.params.orientation.horizontalReverse}, false) && lower(coalesce({view.params.valuePosition}, 'auto')) = 'auto')), if(lower(coalesce({view.params.valuePosition}, 'auto')) = 'bottom', 'sensor-faceplate-icon-raised', 'sensor-faceplate-icon-lowered'), 'sensor-faceplate-icon-side')"
                      }
                    }
                  }
                }
              },
              {
                "meta": {
                  "name": "AlarmHeader"
                },
                "position": {
                  "basis": "20px",
                  "shrink": 0,
                  "grow": 0
                },
                "propConfig": {
                  "props.params.tagPath": {
                    "binding": {
                      "config": {
                        "path": "view.params.tagPath"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "path": "03_Elements/01_Status/AlarmHeader",
                  "style": {
                    "classes": "sensor-alarm-badge",
                    "height": "20px",
                    "width": "20px",
                    "overflow": "visible",
                    "pointerEvents": "none"
                  },
                  "useDefaultViewHeight": true,
                  "useDefaultViewWidth": true
                },
                "type": "ia.display.view"
              },
              {
                "meta": {
                  "name": "BadgeValue"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.params.tagPath": {
                    "binding": {
                      "config": {
                        "expression": "{view.custom.values.analog}"
                      },
                      "type": "expr"
                    }
                  },
                  "meta.visible": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "coalesce({view.params.feedback}, true) && (lower(coalesce({view.params.valuePosition}, 'auto')) = 'top' || lower(coalesce({view.params.valuePosition}, 'auto')) = 'bottom' || lower(coalesce({view.params.valuePosition}, 'auto')) = 'left' || lower(coalesce({view.params.valuePosition}, 'auto')) = 'right')"
                      }
                    }
                  },
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "'sensor-badge-value sensor-badge-value-' + lower(coalesce({view.params.valuePosition}, 'auto'))"
                      }
                    }
                  },
                  "props.style.visibility": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(coalesce({view.custom.oos}, false), 'hidden', 'visible')"
                      }
                    }
                  }
                },
                "props": {
                  "params": {
                    "spacing": {
                      "center": true,
                      "data": 0,
                      "engUnit": 30
                    }
                  },
                  "path": "03_Elements/01_Status/AnalogValue",
                  "style": {
                    "classes": "sensor-badge-value",
                    "cursor": "pointer",
                    "height": "18px",
                    "overflow": "visible"
                  },
                  "useDefaultViewHeight": true
                },
                "type": "ia.display.view"
              }
            ],
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "(if(lower(coalesce({view.params.valuePosition}, 'auto')) = 'left', 'sensor-badge-box sensor-badge-box-value-left', 'sensor-badge-box')) + if(coalesce({view.custom.oos}, false), ' device-oos', '')"
                  }
                }
              }
            }
          },
          {
            "meta": {
              "name": "Stem"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.elements[0].d": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.orientation.vertical} || {view.params.orientation.verticalReverse},\n   'M1 0V24',\n   'M0 1H24')"
                  },
                  "type": "expr"
                }
              },
              "props.style.height": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.orientation.vertical} || {view.params.orientation.verticalReverse},\n   '24px',\n   '2px')"
                  },
                  "type": "expr"
                }
              },
              "props.style.width": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.orientation.vertical} || {view.params.orientation.verticalReverse},\n   '2px',\n   '24px')"
                  },
                  "type": "expr"
                }
              },
              "props.viewBox": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.orientation.vertical} || {view.params.orientation.verticalReverse},\n   '0 0 2 24',\n   '0 0 24 2')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "elements": [
                {
                  "name": "stem",
                  "stroke": {
                    "linecap": "butt",
                    "linejoin": "miter",
                    "paint": "var(--neutral-100)",
                    "width": "2"
                  },
                  "style": {},
                  "type": "path"
                }
              ],
              "preserveAspectRatio": "none",
              "style": {
                "alignSelf": "center",
                "classes": "stem-line",
                "margin": "0px",
                "padding": "0px"
              }
            },
            "type": "ia.shapes.svg"
          }
        ],
        "meta": {
          "name": "StemAssembly"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.direction": {
            "binding": {
              "config": {
                "expression": "if({view.params.orientation.verticalReverse},\n   'column-reverse',\n   if({view.params.orientation.horizontalReverse},\n      'row-reverse',\n      if({view.params.orientation.horizontal},\n         'row',\n         'column')))"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "'stem' + if(coalesce({session.custom.CanOpenFaceplates}, false) && (len(trim(coalesce({view.params.faceplate}, ''))) > 0), ' faceplate-hover', '')"
              }
            }
          }
        },
        "props": {
          "alignItems": "center",
          "direction": "column",
          "style": {
            "classes": "stem",
            "gap": "0px",
            "overflow": "visible"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "AnalogValue",
          "visible": true
        },
        "position": {
          "basis": "18px",
          "shrink": 0
        },
        "propConfig": {
          "props.params.tagPath": {
            "binding": {
              "config": {
                "expression": "{view.custom.values.analog}"
              },
              "type": "expr"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "coalesce({view.params.feedback}, true)"
              },
              "type": "expr"
            }
          },
          "props.style.visibility": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.custom.oos}, false), 'hidden', if((lower(coalesce({view.params.valuePosition}, 'auto')) = 'top' || lower(coalesce({view.params.valuePosition}, 'auto')) = 'bottom' || lower(coalesce({view.params.valuePosition}, 'auto')) = 'left' || lower(coalesce({view.params.valuePosition}, 'auto')) = 'right'), 'hidden', 'visible'))"
              }
            }
          }
        },
        "props": {
          "params": {
            "spacing": {
              "center": true,
              "data": 0,
              "engUnit": 30
            }
          },
          "path": "03_Elements/01_Status/AnalogValue",
          "style": {
            "classes": "value",
            "cursor": "pointer",
            "height": "18px",
            "minHeight": "18px",
            "overflow": "visible"
          },
          "useDefaultViewHeight": true
        },
        "type": "ia.display.view"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tfaceplate = self.view.params.faceplate\n\tif faceplate is None or str(faceplate).strip() == '':\n\t\treturn\n\ttagPath = str(self.view.params.tagPath or '')\n\ttitle = str(self.view.custom.label or '')\n\tif title in (None, '', 'nn', 'SNS'):\n\t\ttitle = tagPath.split('/')[-1] if tagPath else self.view.name\n\t# Unified tabbed Faceplate. show* are hints; tagFlags hide empty tabs.\n\tparams = {\n\t\t'tagPath': tagPath,\n\t\t'deviceType': 'Sensor',\n\t\t'webGuiUrl': '',\n\t\t'showControls': True,\n\t\t'showConfiguration': True,\n\t\t'showInterlocks': False,   # P_AIn has no interlocks\n\t\t'showTrend': True,\n\t\t'showAlarmConfiguration': True,\n\t\t'showAlarms': True\n\t}\n\tNavigation.Faceplate.openFaceplate(\n\t\t'sensor-fp-%s' % (tagPath or title),\n\t\ttagPath,\n\t\t'01_Popups/00_Faceplates/Faceplate',\n\t\tFalse,\n\t\ttitle,\n\t\t560,\n\t\t640,\n\t\tparams\n\t)\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.alignContent": {
        "binding": {
          "config": {
            "expression": "if({view.params.orientation.verticalReverse},\n   'flex-start',\n   'flex-end')"
          },
          "type": "expr"
        }
      },
      "props.justify": {
        "binding": {
          "config": {
            "expression": "if({view.params.orientation.vertical} || {view.params.orientation.verticalReverse},\n   'center',\n   if({view.params.orientation.horizontalReverse},\n      'flex-start',\n      'flex-end'))"
          },
          "type": "expr"
        }
      },
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "((if({view.params.orientation.horizontal},\n   'sensor-horizontal sensor-component',\n   if({view.params.orientation.horizontalReverse},\n      'sensor-horizontal-reverse sensor-component',\n      if({view.params.orientation.vertical},\n         'sensor-vertical sensor-component',\n         'sensor-vertical-reverse sensor-component'))))) + if(coalesce({view.custom.values.commLoss}, false) || indexOf(case(coalesce({view.custom.orientation}, 'vertical'), 'horizontal', '', 'horizontal-reverse', '', 'vertical-reverse', ',left,right,top,', ',left,right,bottom,'), ',' + lower(coalesce({view.params.valuePosition}, 'auto')) + ',') >= 0, ' sensor-value-away', if(lower(coalesce({view.params.valuePosition}, 'auto')) = 'bottom' && indexOf(coalesce({view.custom.orientation}, 'vertical'), 'horizontal') = 0, ' sensor-value-under', ''))"
          },
          "type": "expr",
          "overlayOptOut": true
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr-struct",
          "config": {
            "struct": {
              "ticket": "coalesce({session.custom.TicketLogAccess}, false)",
              "admin": "coalesce({session.custom.Permissions.OutOfService.Set}, false)",
              "history": "coalesce({session.custom.Permissions.OutOfService.View}, false)",
              "oos": "coalesce({view.custom.oos}, false)"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\tdef item(text, icon, msg_type, payload, scope):\n\t\treturn {\n\t\t\t\"text\": text,\n\t\t\t\"icon\": {\"path\": icon, \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": msg_type, \"payload\": payload, \"scope\": scope}\n\t\t}\n\titems = []\n\tif value['ticket']:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append(item('Ticket Logger', 'material/info', 'ticketLog',\n\t\t\t{'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, 'page'))\n\tif value['admin'] and tagPath.strip():\n\t\tif value['oos']:\n\t\t\titems.append(item('Return To Service', 'material/info', 'oosToggle', {'tagPath': tagPath, 'sender': self.view.id}, 'page'))\n\t\telse:\n\t\t\titems.append(item('Take Out Of Service', 'material/info', 'oosToggle',\n\t\t\t\t{'tagPath': tagPath, 'sender': self.view.id}, 'page'))\n\tif value['history'] and tagPath.strip():\n\t\titems.append(item('Out Of Service History', 'material/info', 'oosHistory',\n\t\t\t{'tagPath': tagPath, 'sender': self.view.id}, 'page'))\n\treturn items"
            }
