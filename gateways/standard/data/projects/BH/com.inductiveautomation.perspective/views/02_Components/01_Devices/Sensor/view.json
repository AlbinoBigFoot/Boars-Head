{
  "custom": {
    "label": "",
    "metadata": "",
    "orientation": "vertical",
    "values": {},
    "alarm": {
      "active": false,
      "priority": 10,
      "unack": false
    },
    "oos": false,
    "pax": ""
  },
  "params": {
    "faceplate": null,
    "tagPath": "",
    "orientation": {
      "horizontal": false,
      "horizontalReverse": false,
      "vertical": true,
      "verticalReverse": false
    },
    "feedback": true,
    "label": "SNS",
    "valuePosition": "auto"
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "if({view.params.label} != '',\n\t{view.params.label},\n\tif({view.params.tagPath} = '',\n\t\t'',\n\t\tsubString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1))\n)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\n\ttag({view.params.tagPath} + '.Metadata'),\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.orientation": {
      "binding": {
        "config": {
          "expression": "if({view.params.orientation.horizontal},\n   'horizontal',\n   if({view.params.orientation.horizontalReverse},\n      'horizontal-reverse',\n      if({view.params.orientation.verticalReverse},\n         'vertical-reverse',\n         'vertical')))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "custom.values.status": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/AIn/Val_Fault')"
        },
        "type": "expr"
      }
    },
    "custom.values.analog": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/AIn/Val')"
        },
        "type": "expr"
      }
    },
    "custom.values.commLoss": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '' || coalesce({view.custom.oos}, false),\n\tfalse,\n\t!isGood(tag({view.params.tagPath} + '/AIn/Val')))"
        }
      }
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.orientation": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.orientation.horizontal": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.orientation.horizontalReverse = False\n\t\tself.params.orientation.vertical = False\n\t\tself.params.orientation.verticalReverse = False\n\telif not self.params.orientation.vertical and not self.params.orientation.horizontalReverse and not self.params.orientation.verticalReverse:\n\t\tself.params.orientation.vertical = True"
      }
    },
    "params.orientation.horizontalReverse": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.orientation.horizontal = False\n\t\tself.params.orientation.vertical = False\n\t\tself.params.orientation.verticalReverse = False\n\telif not self.params.orientation.vertical and not self.params.orientation.horizontal and not self.params.orientation.verticalReverse:\n\t\tself.params.orientation.vertical = True"
      }
    },
    "params.orientation.vertical": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.orientation.horizontal = False\n\t\tself.params.orientation.horizontalReverse = False\n\t\tself.params.orientation.verticalReverse = False\n\telif not self.params.orientation.horizontalReverse and not self.params.orientation.horizontal and not self.params.orientation.verticalReverse:\n\t\tself.params.orientation.horizontal = True"
      }
    },
    "params.orientation.verticalReverse": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.orientation.horizontalReverse = False\n\t\tself.params.orientation.horizontal = False\n\t\tself.params.orientation.vertical = False\n\telif not self.params.orientation.vertical and not self.params.orientation.horizontalReverse and not self.params.orientation.horizontal:\n\t\tself.params.orientation.vertical = True"
      }
    },
    "custom.alarm": {
      "persistent": true
    },
    "custom.alarm.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Active"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\tif(typeof({value}) = 'java.lang.Boolean',\n\t\t{value},\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarm.unack": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Unack"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\tif(typeof({value}) = 'java.lang.Boolean',\n\t\t{value},\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarm.priority": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_ActiveHighPriority"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t10,\n\t{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.feedback": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.valuePosition": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.oos": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', false, !coalesce(try(toBoolean(tag({view.params.tagPath} + '.Enabled')), true), true))"
        }
      },
      "persistent": true
    },
    "custom.pax": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', case(toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), 'Devices/Pump', 'Motor', 'Devices/Valve', 'Valve', 'Devices/Tank', 'Tank', 'Devices/Compressor', 'Comp', 'Devices/Evaporator', 'CG', 'Devices/ExhaustFan', 'EF', 'Devices/LTU', 'LTU', 'Devices/SafetyRelay', 'Relay', 'Devices/SuctionSequence', 'Seq', 'Devices/DischargeSequence', 'Dsq', 'Devices/Sensor', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AIn.Enabled')), false), false), 'AIn', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AInRef.Enabled')), false), false), 'AInRef', '')), 'Devices/DiscreteInput', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/DIn.Enabled')), false), false), 'DIn', ''), ''))"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 160
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "IconHeader"
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
