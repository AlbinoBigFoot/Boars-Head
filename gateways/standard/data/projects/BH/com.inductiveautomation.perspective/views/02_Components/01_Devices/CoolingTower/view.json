{
  "custom": {
    "label": "",
    "metadata": "",
    "values": {},
    "alarm": {
      "active": false,
      "priority": 10,
      "unack": false
    },
    "oos": false
  },
  "params": {
    "faceplate": null,
    "tagPath": ""
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\n    if(\n        isNull({view.custom.metadata.shortDescription}) ||\n        {view.custom.metadata.shortDescription} = '',\n        if({view.params.tagPath} = '',\n           '',\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\n        {view.custom.metadata.shortDescription}\n    ),\n'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\n\ttag({view.params.tagPath} + '.Metadata'),\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "custom.values.status": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/Status/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.analog": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/SPD_FBK/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.running": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || !isGood(tag({view.params.tagPath} + '/Status/Value')),\n\tfalse,\n\ttag({view.params.tagPath} + '/Status/Value') = 1)"
        },
        "type": "expr"
      }
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.values.commLoss": {
      "binding": {
        "config": {
          "expression": "if(coalesce({view.custom.oos}, false),\n\tfalse,\n\t(if({view.params.tagPath} = '',\n\tfalse,\n\t!isGood(tag({view.params.tagPath} + '/Status/Value')))))"
        },
        "type": "expr"
      }
    },
    "custom.alarm": {
      "persistent": true
    },
    "custom.alarm.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Active"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\tif(typeof({value}) = 'java.lang.Boolean',\n\t\t{value},\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarm.unack": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Unack"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\tif(typeof({value}) = 'java.lang.Boolean',\n\t\t{value},\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarm.priority": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_ActiveHighPriority"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t10,\n\t{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.oos": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', false, !coalesce(try(toBoolean(tag({view.params.tagPath} + '.Enabled')), true), true))"
        }
      },
      "persistent": true
    }
  },
