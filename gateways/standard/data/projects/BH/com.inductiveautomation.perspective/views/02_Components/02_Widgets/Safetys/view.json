          }
        },
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1,
              "shrink": 0,
              "basis": "0px"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.title"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "align": "center",
              "style": {
                "classes": "Fonts/Value safetys-title fs-12 fw-700",
                "height": "18px",
                "letterSpacing": "0.04em",
                "textAlign": "left",
                "textDecoration": "underline",
                "width": "auto",
                "alignSelf": "flex-start"
              }
            },
            "type": "ia.display.label"
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "AlarmButtons"
            },
            "position": {
              "basis": "84px",
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "2px",
                "overflow": "visible"
              }
            },
            "children": [
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Reset"
                },
                "position": {
                  "basis": "24px",
                  "shrink": 0
                },
                "props": {
                  "text": "Reset",
                  "style": {
                    "classes": "faceplate-cmd-btn safetys-alarm-btn safetys-reset",
                    "height": "24px",
                    "width": "84px"
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.params.resetTagPath} != '' && !coalesce({session.custom.ReadOnly}, false) && coalesce({session.custom.Permissions.AlarmSummary.Acknowledge}, false)"
                      }
                    }
                  },
                  "props.style.visibility": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(coalesce(try(isGood(tag({view.params.lightTagPath})), false), false), if({view.params.lightTagPath} != '' && coalesce(try(toBoolean(tag({view.params.lightTagPath})), false), false), 'visible', 'hidden'), 'hidden')"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\ttp = str(self.view.params.resetTagPath or '')\n\tif not tp or self.session.custom.ReadOnly:\n\t\treturn\n\tif not shared.PlcWriteLock.writeAllowed(tp, 'Machine Room Alarm Reset'):\n\t\tshared.Alerts.showAlert(state='warning', title='PLC Writes Locked', message='This command goes to the RCP1 controller (production PLC) and PLC writes are locked.', showCloseBtn=True, overlayDismiss=True)\n\t\treturn\n\tshared.Audit.writeTag(tp, True, 'Machine Room Alarm Reset', self.view.id.split('@')[0])\n"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.input.button",
                "meta": {
                  "name": "Silence"
                },
                "position": {
                  "basis": "24px",
                  "shrink": 0
                },
                "props": {
                  "text": "Silence",
                  "style": {
                    "classes": "faceplate-cmd-btn safetys-alarm-btn",
                    "height": "24px",
                    "width": "84px"
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "{view.params.silenceTagPath} != '' && !coalesce({session.custom.ReadOnly}, false) && coalesce({session.custom.Permissions.AlarmSummary.Acknowledge}, false)"
                      }
                    }
                  },
                  "props.style.visibility": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if(coalesce(try(isGood(tag({view.params.circuitTagPath})), false), false), if({view.params.circuitTagPath} != '' && coalesce(try(toBoolean(tag({view.params.circuitTagPath})), false), false), 'visible', 'hidden'), 'hidden')"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "events": {
                  "component": {
                    "onActionPerformed": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\ttp = str(self.view.params.silenceTagPath or '')\n\tif not tp or self.session.custom.ReadOnly:\n\t\treturn\n\tif not shared.PlcWriteLock.writeAllowed(tp, 'Machine Room Alarm Silence'):\n\t\tshared.Alerts.showAlert(state='warning', title='PLC Writes Locked', message='This command goes to the RCP1 controller (production PLC) and PLC writes are locked.', showCloseBtn=True, overlayDismiss=True)\n\t\treturn\n\tshared.Audit.writeTag(tp, True, 'Machine Room Alarm Silence', self.view.id.split('@')[0])\n"
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
