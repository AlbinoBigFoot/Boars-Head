{
  "custom": {
    "alarm": {
      "active": false,
      "priority": 10,
      "unack": false
    },
    "label": "",
    "metadata": "",
    "selectedSp": "",
    "values": {},
    "oos": false,
    "pax": ""
  },
  "params": {
    "faceplate": null,
    "orientation": {
      "reverse": false,
      "standard": true
    },
    "tagPath": ""
  },
  "propConfig": {
    "custom.alarm": {
      "persistent": true
    },
    "custom.alarm.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Active"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\tif(typeof({value}) = 'java.lang.Boolean',\n\t\t{value},\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarm.priority": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_ActiveHighPriority"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t10,\n\t{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.alarm.unack": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Unack"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\tFalse,\n\tif(typeof({value}) = 'java.lang.Boolean',\n\t\t{value},\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\n    if(\n        isNull({view.custom.metadata.shortDescription}) ||\n        {view.custom.metadata.shortDescription} = '',\n        if({view.params.tagPath} = '',\n           '',\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\n        {view.custom.metadata.shortDescription}\n    ),\n'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\n\ttag({view.params.tagPath} + '.Metadata'),\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.selectedSp": {
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "custom.values.analog": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\tif({view.custom.selectedSp} = '',\n\t\t{view.params.tagPath} + '/LvlAIn/Val',\n\t\t{view.params.tagPath} + '/LvlAIn/' + case({view.custom.selectedSp}, 'HH', 'Val_HiHiLim', 'H', 'Val_HiLim', 'L', 'Val_LoLim', 'LL', 'Val_LoLoLim', 'Val')))"
        },
        "type": "expr"
      }
    },
    "custom.values.analogForceColor": {
      "binding": {
        "config": {
          "expression": "if(coalesce({view.custom.values.hh}, false) || coalesce({view.custom.values.ll}, false),\n\t'critical',\n\tif(coalesce({view.custom.values.h}, false) || coalesce({view.custom.values.l}, false),\n\t\t'warning',\n\t\t''))"
        },
        "type": "expr"
      }
    },
    "custom.values.commLoss": {
      "binding": {
        "config": {
          "expression": "if(coalesce({view.custom.oos}, false),\n\tfalse,\n\t(if({view.params.tagPath} = '',\n\tfalse,\n\t!isGood(tag({view.params.tagPath} + '/LvlAIn/Val_Fault')))))"
        },
        "type": "expr"
      }
    },
    "custom.values.h": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || !isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_Hi')),\n\tfalse,\n\tcoalesce(tag({view.params.tagPath} + '/LvlAIn/Sts_Hi'), false))"
        },
        "type": "expr"
      }
    },
    "custom.values.hh": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || !isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_HiHi')),\n\tfalse,\n\tcoalesce(tag({view.params.tagPath} + '/LvlAIn/Sts_HiHi'), false))"
        },
        "type": "expr"
      }
    },
    "custom.values.l": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || !isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_Lo')),\n\tfalse,\n\tcoalesce(tag({view.params.tagPath} + '/LvlAIn/Sts_Lo'), false))"
        },
        "type": "expr"
      }
    },
    "custom.values.level": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || !isGood(tag({view.params.tagPath} + '/LvlAIn/Val')),\n\t0,\n\tcoalesce(tag({view.params.tagPath} + '/LvlAIn/Val'), 0))"
        },
        "type": "expr"
      }
    },
    "custom.values.ll": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || !isGood(tag({view.params.tagPath} + '/LvlAIn/Sts_LoLo')),\n\tfalse,\n\tcoalesce(tag({view.params.tagPath} + '/LvlAIn/Sts_LoLo'), false))"
        },
        "type": "expr"
      }
    },
    "custom.values.status": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/LvlAIn/Val_Fault')"
        },
        "type": "expr"
      }
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.orientation": {
      "paramDirection": "inout",
      "persistent": true
    },
    "params.orientation.reverse": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.orientation.standard = False\n\telif not self.params.orientation.standard:\n\t\tself.params.orientation.standard = True"
      }
    },
    "params.orientation.standard": {
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue.value:\n\t\tself.params.orientation.reverse = False\n\telif not self.params.orientation.reverse:\n\t\tself.params.orientation.reverse = True"
      }
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.oos": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', false, !coalesce(try(toBoolean(tag({view.params.tagPath} + '.Enabled')), true), true))"
        }
      },
      "persistent": true
    },
    "custom.pax": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', case(toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), 'Devices/Pump', 'Motor', 'Devices/Valve', 'Valve', 'Devices/Tank', 'Tank', 'Devices/Compressor', 'Comp', 'Devices/Evaporator', 'CG', 'Devices/ExhaustFan', 'EF', 'Devices/LTU', 'LTU', 'Devices/SafetyRelay', 'Relay', 'Devices/SuctionSequence', 'Seq', 'Devices/DischargeSequence', 'Dsq', 'Devices/Sensor', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AIn.Enabled')), false), false), 'AIn', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AInRef.Enabled')), false), false), 'AInRef', '')), 'Devices/DiscreteInput', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/DIn.Enabled')), false), false), 'DIn', ''), ''))"
        }
      }
    }
  },
