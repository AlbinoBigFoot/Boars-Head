{
  "custom": {
    "preview": "normal",
    "conn": false,
    "statusGood": false,
    "run": false,
    "major": false,
    "mode": "NO COMM",
    "catalog": "1769-L36ERM",
    "state": "bad",
    "ip": "",
    "name": ""
  },
  "params": {
    "tagPath": "",
    "member": "Controller",
    "selected": false,
    "state": "Normal",
    "label": "BoarsHead",
    "name": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.member": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.state": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.ip": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/IPAddress')), false), false), if(coalesce({view.params.tagPath}, '') = '', '10.80.31.60', coalesce(try(toStr(tag({view.params.tagPath} + '/IPAddress')), null), '')), null)"
        }
      }
    },
    "custom.name": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce(try(isGood(tag({view.params.tagPath} + '/ControllerName')), false), false), if(coalesce({view.params.name}, '') != '', {view.params.name}, if(coalesce({view.params.tagPath}, '') = '', coalesce({view.params.label}, 'BoarsHead'), coalesce(try(toStr(tag({view.params.tagPath} + '/ControllerName')), null), ''))), null)"
        }
      }
    },
    "custom.preview": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "lower(trim(coalesce({view.params.state}, 'normal')))"
        }
      }
    },
    "custom.conn": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', {view.custom.preview} != 'comm loss', coalesce(try(isGood(tag({view.params.tagPath} + '/Connected')), false), false) && coalesce(try(toBoolean(tag({view.params.tagPath} + '/Connected')), false), false))"
        }
      }
    },
    "custom.statusGood": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', {view.custom.conn}, {view.custom.conn} && coalesce(try(isGood(tag({view.params.tagPath} + '/Status')), false), false))"
        }
      }
    },
    "custom.run": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', {view.custom.preview} = 'normal', {view.custom.statusGood} && coalesce(try(toBoolean(tag({view.params.tagPath} + '/Run')), false), false))"
        }
      }
    },
    "custom.major": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', {view.custom.preview} = 'fault', {view.custom.statusGood} && coalesce(try(toBoolean(tag({view.params.tagPath} + '/MajorFault')), false), false))"
        }
      }
    },
    "custom.mode": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!{view.custom.conn}, 'NO COMM', if(coalesce({view.params.tagPath}, '') = '', if({view.custom.major}, 'MAJOR FAULT', 'REMOTE RUN'), if(!{view.custom.statusGood}, 'NO DATA', upper(coalesce(try(toStr(tag({view.params.tagPath} + '/Mode')), null), 'Unknown')))))"
        }
      }
    },
    "custom.catalog": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce(if(coalesce({view.params.tagPath}, '') = '', null, try(if(isGood(tag({view.params.tagPath} + '/ProductName')) && len(trim(toStr(tag({view.params.tagPath} + '/ProductName')))) > 0, split(trim(toStr(tag({view.params.tagPath} + '/ProductName'))), ' ')[0, 0], null), null)), if(coalesce({view.params.tagPath}, '') = '', null, try(toStr(tag({view.params.tagPath} + '/CatalogNumber')), null)), '1769-L36ERM')"
        }
      }
    },
    "custom.state": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(!{view.custom.conn}, 'bad', if({view.custom.major}, 'fault', if({view.custom.statusGood}, 'ok', 'bad')))"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 114,
      "height": 280
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "visible",
        "cursor": "pointer",
        "width": "100%",
        "height": "100%"
      }
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      },
      "props.style.classes": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if(coalesce({view.params.member}, '') != '', 'faceplate-hover', '')"
          }
        }
      }
    },
    "events": {
      "dom": {
        "onClick": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# read-only rack: a click only selects the module for the detail panel (page message)\n\tmember = str(self.view.params.member or '')\n\tif member:\n\t\tsystem.perspective.sendMessage('plcRackSelect', payload={'member': member}, scope='page')\n"
          }
        },
        "onMouseEnter": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# hover popover over the rack (UI state only; the page clears it on leave)\n\tm = str(self.view.params.member or '')\n\tif m:\n\t\tsystem.perspective.sendMessage('plcRackHover', payload={'member': m, 'leave': False}, scope='page')\n"
          }
        },
        "onMouseLeave": {
          "type": "script",
          "scope": "G",
          "config": {
            "script": "\t# hover popover over the rack (UI state only; the page clears it on leave)\n\tm = str(self.view.params.member or '')\n\tif m:\n\t\tsystem.perspective.sendMessage('plcRackHover', payload={'member': m, 'leave': True}, scope='page')\n"
          }
        }
      }
    },
