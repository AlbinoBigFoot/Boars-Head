          "props.elements[10].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.major}, 'var(--sts-fault)', if({view.custom.conn}, 'var(--sts-run)', 'var(--neutral-60)'))"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[12].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.conn}, 'var(--sts-run)', 'var(--neutral-60)')"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[14].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.conn}, 'var(--sts-run)', 'var(--neutral-60)')"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[19].text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.mode}"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[19].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.run}, 'var(--sts-run)', if({view.custom.major} || !{view.custom.conn}, 'var(--sts-fault)', if({view.custom.statusGood}, 'var(--text)', 'var(--neutral-60)')))"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[19].style.fontStyle": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.conn} && !{view.custom.statusGood}, 'italic', 'normal')"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[26].text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.ip}"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[27].text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.custom.name}"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[28].text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "case({view.custom.state}, 'ok', if({view.custom.run}, 'RUN', 'NOT RUN'), 'fault', 'MAJOR FAULT', if({view.custom.conn}, 'NO DATA', 'COMM LOSS'))"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[28].fill.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "case({view.custom.state}, 'ok', if({view.custom.run}, 'var(--sts-run)', 'var(--status-off)'), 'fault', 'var(--sts-fault)', if({view.custom.conn}, 'var(--neutral-60)', 'var(--sts-fault)'))"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[28].style.fontStyle": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.conn} && {view.custom.state} = 'bad', 'italic', 'normal')"
              },
              "overlayOptOut": true
            }
          },
          "props.elements[29].stroke.paint": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.params.selected}, false), 'var(--sts-run)', 'none')"
              }
            }
          }
        }
      }
    ],
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])"
        }
      ]
    }
  }
}
