        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\r\n\t{view.params.tagPath}!\u003d\u0027\u0027 \u0026\u0026 isGood(tag({view.params.tagPath} + \u0027.Metadata\u0027)),\r\n\ttag({view.params.tagPath} + \u0027.Metadata\u0027),\r\n\t\u0027\u0027)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "custom.values.analog": {
