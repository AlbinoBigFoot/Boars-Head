    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tfaceplate = self.view.params.faceplate\n\tif faceplate is None:\n\t\treturn\n\ttagPath = str(self.view.params.tagPath or '')\n\ttitle = str(self.view.custom.label or '')\n\tif title in (None, '', 'nn'):\n\t\ttitle = tagPath.split('/')[-1] if tagPath else self.view.name\n\tif faceplate == '':\n\t\tview = '01_Popups/00_Faceplates/' + self.view.name\n\telse:\n\t\tview = '01_Popups/00_Faceplates/' + str(faceplate)\n\tsystem.perspective.openPopup(\n\t\t'comp-fp-%s' % (tagPath or title),\n\t\tview,\n\t\tparams={'tagPath': tagPath},\n\t\ttitle=title,\n\t\tshowCloseIcon=True,\n\t\tdraggable=True,\n\t\tresizable=True,\n\t\tmodal=False,\n\t\tviewportBound=True,\n\t\tposition={'width': 420, 'height': 520}\n\t)\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
