{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 300,
      "height": 212
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "domId": "oneshot-contact",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "account-popup bg-component container-card integrator-contact",
        "padding": "12px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Top"
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "alignItems": "flex-start"
        },
        "children": [
          {
            "type": "ia.display.view",
            "meta": {
              "name": "Logo"
            },
            "position": {
              "basis": "184px",
              "shrink": 0
            },
            "props": {
              "path": "00_Pages/00_Docked/_Assets/IntegratorLogo",
              "params": {
                "collapsible": false
              },
              "style": {
                "height": "44px"
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Spacer"
            },
            "position": {
              "grow": 1
            }
          },
          {
            "type": "ia.display.icon",
            "meta": {
              "name": "Close",
              "domId": "oneshot-contact-close",
              "tooltip": {
                "enabled": true,
                "text": "Close",
                "width": "80px",
                "delay": 0,
                "sustain": 3000,
                "location": "bottom",
                "tail": true,
                "style": {
                  "backgroundColor": "var(--surface-card)",
                  "borderColor": "var(--border)",
                  "borderRadius": 4,
                  "borderStyle": "solid",
                  "borderWidth": 1,
                  "color": "var(--text)",
                  "fontSize": "12px",
                  "padding": "6px 10px"
                }
              }
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
            "props": {
              "path": "material/close",
              "color": "var(--icon)",
              "style": {
                "classes": "color-icon",
                "cursor": "pointer",
                "height": "20px",
                "width": "20px"
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "type": "popup",
                  "scope": "C",
                  "config": {
                    "id": "integratorContact",
                    "type": "close",
                    "viewPath": "00_Pages/00_Docked/_Assets/IntegratorContact",
                    "viewParams": {},
                    "positionType": "exact",
                    "position": {
                      "top": 56,
                      "right": 350,
                      "width": 300,
                      "height": 212
                    },
                    "modal": false,
                    "overlayDismiss": true,
                    "showCloseIcon": false,
                    "draggable": false,
                    "resizable": false,
                    "viewportBound": true
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Tagline"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Controls Integration And Support",
          "style": {
            "classes": "Fonts/Label text-muted",
            "marginTop": "6px"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Rule"
        },
        "position": {
          "basis": "1px",
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "integrator-divider",
            "marginTop": "10px",
            "marginBottom": "4px"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Name"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Tylor Slack, President & CEO",
          "style": {
            "classes": "Fonts/Value fw-600",
            "marginTop": "6px"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Phone"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "marginTop": "6px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Label"
            },
            "position": {
              "shrink": 0,
              "basis": "52px"
            },
            "props": {
              "text": "Phone",
              "style": {
                "classes": "Fonts/Label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0,
              "grow": 1
            },
            "props": {
              "text": "610-504-6065",
              "style": {
                "classes": "Fonts/Value"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Email"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "marginTop": "6px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Label"
            },
            "position": {
              "shrink": 0,
              "basis": "52px"
            },
            "props": {
              "text": "Email",
              "style": {
                "classes": "Fonts/Label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0,
              "grow": 1
            },
            "props": {
              "text": "sales@oneshotautomation.net",
              "style": {
                "classes": "Fonts/Value"
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Web"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "marginTop": "6px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Label"
            },
            "position": {
              "shrink": 0,
              "basis": "52px"
            },
            "props": {
              "text": "Web",
              "style": {
                "classes": "Fonts/Label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Value"
            },
            "position": {
              "shrink": 0,
              "grow": 1
            },
            "props": {
              "text": "www.oneshotautomation.net",
              "style": {
                "classes": "Fonts/Value"
              }
            }
          }
        ]
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
