{
  "custom": {
    "metrics": {}
  },
  "params": {
    "unitId": "VD"
  },
  "propConfig": {
    "params.unitId": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.metrics": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "struct": {
            "tick": "now(60000)",
            "unitId": "{view.params.unitId}",
            "U_Rate": "if(coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Rate/Value')), false), false), try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Rate/Value')), null), null)",
            "U_OEE": "if(coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/OEE/Value')), false), false), try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/OEE/Value')), null), null)",
            "U_Reject": "if(coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Reject/Value')), false), false), try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Reject/Value')), null), null)",
            "U_Status": "if(coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Status/Value')), false), false), try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Status/Value')), null), null)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "type": "script",
            "code": "\t# FCM KPIs: shared.ProductionMetrics.l3 (body = _METRICS_L3 in scripts/_build_groveport_production_overview.py;\n\t# the custom report engine shared.Reports uses the same functions)\n\treturn shared.ProductionMetrics.l3(value)\n"
          },
          {
            "type": "expression",
            "expression": "if((coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Rate/Value')), false), false) || coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/OEE/Value')), false), false) || coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Reject/Value')), false), false) || coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/' + {view.params.unitId} + '/Status/Value')), false), false)), {value}, null)"
          }
        ]
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 1016,
      "width": 500
    }
  },
