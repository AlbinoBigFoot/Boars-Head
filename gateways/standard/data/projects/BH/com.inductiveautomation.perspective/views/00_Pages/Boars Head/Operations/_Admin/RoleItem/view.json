{
  "custom": {},
  "params": {
    "badge1": "",
    "badge2": "",
    "full": false,
    "msg": "rpRoleSelect",
    "name": "",
    "selected": false,
    "sub": ""
  },
  "propConfig": {
    "params.badge1": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.badge2": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.full": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.msg": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sub": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 62,
      "width": 330
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "18px",
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.full}, 'material/verified_user', 'material/assignment_ind')"
                  },
                  "type": "expr"
                }
              },
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.params.selected}, 'admin-avatar-selected', 'admin-ico-on')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "path": "material/assignment_ind",
              "style": {
                "classes": "admin-ico-on"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "IconBox"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.selected}, 'admin-avatar admin-avatar-selected', 'admin-avatar')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "justify": "center",
          "style": {
            "borderRadius": "6px",
            "height": "30px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Name"
                },
                "position": {
                  "shrink": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.name"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "admin-item-title",
                    "minWidth": "0"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Badge1"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "len({view.params.badge1}) > 0"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.badge1"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "admin-chip"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Badge2"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "position.display": {
                    "binding": {
                      "config": {
                        "expression": "len({view.params.badge2}) > 0"
                      },
                      "type": "expr"
                    }
                  },
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.badge2"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "admin-chip"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "L1"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "direction": "row",
              "style": {
                "gap": "6px",
                "minWidth": "0"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Sub"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.sub"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-desc"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Text"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "alignItems": "stretch",
          "direction": "column",
          "style": {
            "gap": "3px",
            "minWidth": "0"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Chevron"
        },
        "position": {
          "basis": "18px",
          "shrink": 0
        },
        "props": {
          "path": "material/chevron_right",
          "style": {
            "classes": "admin-ico-muted"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.sendMessage(self.view.params.msg, payload={'name': self.view.params.name}, scope='page')\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.params.selected}, 'admin-list-item admin-list-item-selected', 'admin-list-item')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "gap": "10px",
        "minWidth": "0",
        "paddingLeft": "12px",
        "paddingRight": "12px"
      }
    },
    "type": "ia.container.flex"
  }
}
