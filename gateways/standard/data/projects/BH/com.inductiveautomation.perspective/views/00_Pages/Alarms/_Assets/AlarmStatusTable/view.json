{
  "custom": {},
  "params": {
    "sourceFilter": "*"
  },
  "propConfig": {
    "params.sourceFilter": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 960
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.filters.active.conditions.source": {
            "binding": {
              "config": {
                "path": "view.params.sourceFilter"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "activeSortOrder": [
            "isAcked",
            "priority",
            "activeTime"
          ],
          "columns": {
            "active": {
              "activeTime": {
                "sort": "descending",
                "width": 140
              },
              "displayPath": {
                "enabled": false,
                "width": 200
              },
              "label": {
                "enabled": true,
                "order": 3,
                "width": 280
              },
              "name": {
                "enabled": false
              },
              "priority": {
                "enabled": true,
                "order": 1,
                "width": 90
              },
              "source": {
                "enabled": false
              },
              "state": {
                "enabled": true,
                "order": 2,
                "width": 130
              }
            }
          },
          "filters": {
            "active": {
              "conditions": {
                "source": "*"
              },
              "states": {
                "clearUnacked": false
              }
            }
          },
          "responsive": {
            "breakpoint": 700,
            "enabled": true
          },
          "rowStyles": {
            "activeAcked": {
              "base": {
                "fontSize": "0.85em",
                "fontWeight": "500"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "#8B1519",
                  "classes": "alarm-row-critical-ack",
                  "color": "#FFFFFF"
                },
                "high": {
                  "backgroundColor": "#9A5619",
                  "classes": "alarm-row-high-ack",
                  "color": "#FFFFFF"
                },
                "low": {
                  "backgroundColor": "#5A3F6C",
                  "classes": "alarm-row-low-ack",
                  "color": "#FFFFFF"
                },
                "medium": {
                  "backgroundColor": "#9E9012",
                  "classes": "alarm-row-medium-ack",
                  "color": "#FFFFFF"
                }
              }
            },
            "activeUnacked": {
              "base": {
                "fontSize": "0.85em",
                "fontWeight": "500"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "#E22028",
                  "classes": "alarm-row-critical",
                  "color": "#FFFFFF"
                },
                "high": {
                  "backgroundColor": "#EC8629",
                  "classes": "alarm-row-high",
                  "color": "#FFFFFF"
                },
                "low": {
                  "backgroundColor": "#916AAD",
                  "classes": "alarm-row-low",
                  "color": "#FFFFFF"
                },
                "medium": {
                  "backgroundColor": "#F5E11B",
                  "classes": "alarm-row-medium",
                  "color": "#212121"
                }
              }
            },
            "clearAcked": {
              "base": {
                "classes": "alarm-row-cleared",
                "fontSize": "0.85em"
              },
              "priorities": {
                "critical": {
                  "classes": "alarm-row-cleared"
                },
                "high": {
                  "classes": "alarm-row-cleared"
                },
                "low": {
                  "classes": "alarm-row-cleared"
                },
                "medium": {
                  "classes": "alarm-row-cleared"
                }
              }
            },
            "clearUnacked": {
              "base": {
                "classes": "alarm-row-cleared",
                "fontSize": "0.85em"
              },
              "priorities": {
                "critical": {
                  "classes": "alarm-row-cleared"
                },
                "high": {
                  "classes": "alarm-row-cleared"
                },
                "low": {
                  "classes": "alarm-row-cleared"
                },
                "medium": {
                  "classes": "alarm-row-cleared"
                }
              }
            }
          },
          "style": {
            "classes": "font-label",
            "height": "100%",
            "width": "100%"
          },
          "toolbar": {
            "enableConfiguration": false,
            "enabled": true
          }
        },
        "type": "ia.display.alarmstatustable"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "width": "100%"
      }
    },
    "type": "ia.container.flex"
  }
}
