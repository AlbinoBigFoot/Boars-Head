{
  "custom": {},
  "params": {
    "canEdit": false,
    "i": 0,
    "type": "email",
    "value": ""
  },
  "propConfig": {
    "params.canEdit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.i": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.type": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 600
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Type"
        },
        "position": {
          "basis": "130px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.canEdit"
              },
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.type"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif origin == 'Browser' or origin == 'browser':\n\t\tsystem.perspective.sendMessage('umContactSet', payload={'i': self.view.params.i, 'field': 'type', 'value': currentValue.value}, scope='page')\n"
            }
          }
        },
        "props": {
          "dropdownOptionStyle": {
            "classes": "form-check"
          },
          "options": [
            {
              "label": "Email",
              "value": "email"
            },
            {
              "label": "Phone",
              "value": "phone"
            },
            {
              "label": "SMS",
              "value": "sms"
            }
          ],
          "search": {
            "enabled": false
          },
          "showClearIcon": false,
          "style": {
            "classes": "form-input",
            "height": "32px",
            "minWidth": "0"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "meta": {
          "name": "Value"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "path": "view.params.canEdit"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif origin == 'Browser' or origin == 'browser':\n\t\tsystem.perspective.sendMessage('umContactSet', payload={'i': self.view.params.i, 'field': 'value', 'value': currentValue.value}, scope='page')\n"
            }
          }
        },
        "props": {
          "placeholder": "Address Or Number",
          "style": {
            "classes": "form-input",
            "height": "32px",
            "minWidth": "0"
          }
        },
        "type": "ia.input.text-field"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.sendMessage('umContactRemove', payload={'i': self.view.params.i}, scope='page')\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Remove"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "path": "view.params.canEdit"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/delete_outline",
          "style": {
            "classes": "admin-ico-muted",
            "cursor": "pointer"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "gap": "8px",
        "minWidth": "0"
      }
    },
    "type": "ia.container.flex"
  }
}
