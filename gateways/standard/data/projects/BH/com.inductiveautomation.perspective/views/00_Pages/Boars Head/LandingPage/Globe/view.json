{
  "custom": {
    "theme": "",
    "hoverPage": "",
    "hoverSeq": 0
  },
  "params": {},
  "propConfig": {
    "custom.theme": {
      "binding": {
        "config": {
          "path": "session.props.theme"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.hoverPage": {
      "persistent": true
    },
    "custom.hoverSeq": {
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1600
    }
  },
  "root": {
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Map"
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "height": "100%",
            "minWidth": "0",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "meta": {
              "name": "IFrame"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.src": {
                "binding": {
                  "config": {
                    "struct": {
                      "theme": "{view.custom.theme}",
                      "sessionId": "{session.props.id}",
                      "pageId": "{page.props.pageId}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "code": "\treturn shared.Globe.iframeSrc(value['theme'], value['sessionId'], value['pageId'])",
                      "type": "script"
                    }
                  ],
                  "type": "expr-struct"
                }
              }
            },
            "props": {
              "allowFullScreen": true,
              "style": {
                "height": "100%",
                "width": "100%"
              }
            },
            "type": "ia.display.iframe"
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "SiteRail"
        },
        "position": {
          "basis": "320px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "themed-scroll site-rail",
            "gap": "10px",
            "height": "100%",
            "minHeight": "0",
            "overflowY": "auto",
            "padding": "12px 8px 12px 44px",
            "overflowX": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.display.view",
            "meta": {
              "name": "Site_Groveport"
            },
            "position": {
              "basis": "196px",
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "path": "02_Components/02_Widgets/SiteCard",
              "params": {
                "siteName": "Groveport",
                "region": "Ohio",
                "page": "/plants/groveport",
                "tagRoot": "[default]KPI/Groveport/Site"
              },
              "style": {
                "height": "196px",
                "maxHeight": "196px",
                "minHeight": "196px",
                "marginBottom": "4px",
                "overflow": "visible",
                "width": "100%"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(coalesce({view.custom.hoverPage}, '') = '', '', if({view.custom.hoverPage} = '/plants/groveport', 'site-rail-card--hot', 'site-rail-card--dim'))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "Site_NewCastle"
            },
            "position": {
              "basis": "196px",
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "path": "02_Components/02_Widgets/SiteCard",
              "params": {
                "siteName": "New Castle",
                "region": "Indiana",
                "page": "/plants/new-castle",
                "tagRoot": "[default]KPI/NewCastle/Site"
              },
              "style": {
                "height": "196px",
                "maxHeight": "196px",
                "minHeight": "196px",
                "marginBottom": "4px",
                "overflow": "visible",
                "width": "100%"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(coalesce({view.custom.hoverPage}, '') = '', '', if({view.custom.hoverPage} = '/plants/new-castle', 'site-rail-card--hot', 'site-rail-card--dim'))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "Site_ForrestCity"
            },
            "position": {
              "basis": "196px",
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "path": "02_Components/02_Widgets/SiteCard",
              "params": {
                "siteName": "Forrest City",
                "region": "Arkansas",
                "page": "/plants/forrest-city",
                "tagRoot": "[default]KPI/ForrestCity/Site"
              },
              "style": {
                "height": "196px",
                "maxHeight": "196px",
                "minHeight": "196px",
                "marginBottom": "4px",
                "overflow": "visible",
                "width": "100%"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(coalesce({view.custom.hoverPage}, '') = '', '', if({view.custom.hoverPage} = '/plants/forrest-city', 'site-rail-card--hot', 'site-rail-card--dim'))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "Site_Petersburg"
            },
            "position": {
              "basis": "196px",
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "path": "02_Components/02_Widgets/SiteCard",
              "params": {
                "siteName": "Petersburg",
                "region": "Virginia",
                "page": "/plants/petersburg",
                "tagRoot": "[default]KPI/Petersburg/Site"
              },
              "style": {
                "height": "196px",
                "maxHeight": "196px",
                "minHeight": "196px",
                "marginBottom": "4px",
                "overflow": "visible",
                "width": "100%"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(coalesce({view.custom.hoverPage}, '') = '', '', if({view.custom.hoverPage} = '/plants/petersburg', 'site-rail-card--hot', 'site-rail-card--dim'))"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.view",
            "meta": {
              "name": "Site_Holland"
            },
            "position": {
              "basis": "196px",
              "shrink": 0,
              "grow": 0
            },
            "props": {
              "path": "02_Components/02_Widgets/SiteCard",
              "params": {
                "siteName": "Holland",
                "region": "Michigan",
                "page": "/plants/holland",
                "tagRoot": "[default]KPI/Holland/Site"
              },
              "style": {
                "height": "196px",
                "maxHeight": "196px",
                "minHeight": "196px",
                "marginBottom": "4px",
                "overflow": "visible",
                "width": "100%"
              }
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if(coalesce({view.custom.hoverPage}, '') = '', '', if({view.custom.hoverPage} = '/plants/holland', 'site-rail-card--hot', 'site-rail-card--dim'))"
                  }
                }
              }
            }
          }
        ],
        "custom": {
          "hoverPage": ""
        },
        "propConfig": {
          "custom.hoverPage": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.hoverPage"
              }
            },
            "onChange": {
              "enabled": null,
              "script": "\tpage = currentValue.value\n\tif page is None or str(page).strip() == '':\n\t\treturn\n\tjs = \"(function(){\\n  var tryScroll = function(n){\\n    var el = document.querySelector('.psc-site-rail .psc-site-rail-card--hot');\\n    var rail = document.querySelector('.psc-site-rail');\\n    if (el && rail) {\\n      el.scrollIntoView({behavior: 'smooth', block: 'nearest', inline: 'nearest'});\\n      var er = el.getBoundingClientRect();\\n      var rr = rail.getBoundingClientRect();\\n      if (er.bottom > rr.bottom + 2 || er.top < rr.top - 2) {\\n        rail.scrollTop += (er.top - rr.top) - Math.max(0, (rr.height - er.height) / 2);\\n      }\\n      return;\\n    }\\n    if (n > 0) setTimeout(function(){ tryScroll(n - 1); }, 50);\\n  };\\n  tryScroll(30);\\n})();\"\n\ttry:\n\t\tif hasattr(system.perspective, 'runJavaScriptAsync'):\n\t\t\tsystem.perspective.runJavaScriptAsync(js)\n\t\telif hasattr(system.perspective, 'runJavaScript'):\n\t\t\tsystem.perspective.runJavaScript(js)\n\texcept:\n\t\tpass\n"
            },
            "persistent": true
          }
        }
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "row",
      "style": {
        "classes": "bg-page",
        "height": "100%",
        "overflow": "hidden",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component Fonts/Value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0], 'sender': self.view.id\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "globeHover",
          "pageScope": true,
          "script": "\t# Per-session globe hover: shared.Globe.relay sends this to this page only (docs/globe-hover.md).\n\t# Requests can arrive out of order; the newest seq (iframe Date.now()) wins.\n\ttry:\n\t\tseq = float(payload.get('seq') or 0)\n\texcept:\n\t\tseq = 0.0\n\ttry:\n\t\tlast = float(self.view.custom.hoverSeq or 0)\n\texcept:\n\t\tlast = 0.0\n\tif seq and seq < last:\n\t\treturn\n\tself.view.custom.hoverSeq = seq\n\tself.view.custom.hoverPage = payload.get('page') or ''",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "globeNavigate",
          "pageScope": true,
          "script": "\t# Per-session globe marker click (route already checked by shared.Globe.relay)\n\tpage = payload.get('page') or ''\n\tif page:\n\t\tNavigation.Nav.navigate({'action': 'page', 'page': page})",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}