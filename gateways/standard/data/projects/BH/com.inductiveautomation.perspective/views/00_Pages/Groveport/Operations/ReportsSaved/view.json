{
  "custom": {
    "model": {
      "counts": {
        "mine": 0,
        "runs": 0,
        "shared": 0
      },
      "owners": [],
      "rows": [],
      "sources": [],
      "total": 0
    },
    "msg": "",
    "owner": null,
    "refresh": 0,
    "search": "",
    "source": null,
    "tab": "mine"
  },
  "params": {},
  "propConfig": {
    "custom.model": {
      "binding": {
        "config": {
          "struct": {
            "ok": "coalesce({session.custom.Permissions.Reports.Use}, false)",
            "owner": "{view.custom.owner}",
            "refresh": "{view.custom.refresh}",
            "search": "{view.custom.search}",
            "source": "{view.custom.source}",
            "tab": "{view.custom.tab}"
          },
          "waitOnAll": false
        },
        "transforms": [
          {
            "code": "\tif not value.ok:\n\t\treturn {'rows': [], 'owners': [], 'sources': [], 'total': 0,\n\t\t\t'counts': {'mine': 0, 'shared': 0, 'runs': 0}}\n\treturn shared.Reports.savedModel(self.session, value.tab or 'mine', value.source or '',\n\t\tvalue.owner or '', value.search or '')\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 1000,
      "width": 1600
    }
  },
