{
  "custom": {
    "rest": "",
    "slug": "",
    "domain": "epms",
    "area": "Freezer"
  },
  "params": {},
  "propConfig": {
    "custom.rest": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(substring(coalesce({page.props.path}, ''), 18), '')"
        }
      },
      "persistent": true
    },
    "custom.slug": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(substring({view.custom.rest}, 0, indexOf({view.custom.rest}, '/')), '')"
        }
      },
      "persistent": true
    },
    "custom.domain": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "try(lower(substring({view.custom.rest}, indexOf({view.custom.rest}, '/') + 1)), 'epms')"
        }
      },
      "persistent": true
    },
    "custom.area": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "case(coalesce({view.custom.slug}, ''), 'freezer', 'Freezer', 'superchill', 'SuperChill', 'club', 'Club', 'palletizing', 'Palletizing', 'east-ph', 'East PH', 'west-ph', 'West PH', 'dock', 'Dock', 'machine-room', 'Machine Room', 'Freezer')"
        }
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 800,
      "width": 1400
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-page kpi-dashboard-page",
        "height": "100%",
        "overflow": "hidden",
        "padding": "16px 20px",
        "width": "100%"
      }
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "DomainBody"
        },
        "position": {
          "basis": "0px",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "path": "00_Pages/Groveport/Domains/EPMS",
          "params": {
            "area": "Freezer"
          },
          "style": {
            "height": "100%",
            "minHeight": "0",
            "overflow": "auto",
            "width": "100%"
          }
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce({view.custom.domain}, '') = 'production', '00_Pages/Groveport/Domains/Production', '00_Pages/Groveport/Domains/EPMS')"
              }
            }
          },
          "props.params.area": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.area"
              }
            }
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
