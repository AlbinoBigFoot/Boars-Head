{
  "custom": {
    "payload": {
      "series": [],
      "statusHrsMainCategories": [
        "CLG",
        "DFT",
        "IDLE",
        "STOP",
        "FLT"
      ],
      "statusHrsMain": [
        0,
        0,
        0,
        0,
        0
      ],
      "statusHrsDftCategories": [
        "DFT",
        "DFT PD",
        "DFT HG",
        "DFT BLD",
        "DFT FD"
      ],
      "statusHrsDft": [
        0,
        0,
        0,
        0,
        0
      ],
      "rows": []
    },
    "pax": ""
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "custom.payload": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "tick": "now(60000)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\n\tout = {'series': [], 'statusHrsMainCategories': ['CLG', 'DFT', 'IDLE', 'STOP', 'FLT'],\n\t\t'statusHrsMain': [0, 0, 0, 0, 0], 'statusHrsDftCategories': ['DFT', 'DFT PD', 'DFT HG', 'DFT BLD', 'DFT FD'],\n\t\t'statusHrsDft': [0, 0, 0, 0, 0], 'rows': []}\n\ttry:\n\t\ttagPath = str(value.get('tagPath') or '').strip()\n\texcept:\n\t\ttagPath = ''\n\tif not tagPath:\n\t\treturn out\n\ttry:\n\t\treturn shared.UtilityMetrics.cg(tagPath, 12)\n\texcept:\n\t\treturn out\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.pax": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(coalesce({view.params.tagPath}, '') = '', '', case(toStr(coalesce(try(tag({view.params.tagPath} + '.TypeId'), ''), '')), 'Devices/Pump', 'Motor', 'Devices/Valve', 'Valve', 'Devices/Tank', 'Tank', 'Devices/Compressor', 'Comp', 'Devices/Evaporator', 'CG', 'Devices/ExhaustFan', 'EF', 'Devices/LTU', 'LTU', 'Devices/SafetyRelay', 'Relay', 'Devices/SuctionSequence', 'Seq', 'Devices/DischargeSequence', 'Dsq', 'Devices/Sensor', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AIn.Enabled')), false), false), 'AIn', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/AInRef.Enabled')), false), false), 'AInRef', '')), 'Devices/DiscreteInput', if(coalesce(try(toBoolean(tag({view.params.tagPath} + '/DIn.Enabled')), false), false), 'DIn', ''), ''))"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 487,
      "height": 1057
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "props": {
              "style": {
                "classes": "Fonts/Title plant-feature-title",
                "fontSize": "14px"
              },
              "text": "Zone Air Temp \u2014 Last 12h"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "ZatChart"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.series": {
                "binding": {
                  "config": {
                    "struct": {
                      "payload": "{view.custom.payload}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\tp = value.get('payload') if hasattr(value, 'get') else None\n\tif not p:\n\t\treturn []\n\tout = []\n\tfor item in (p.get('series') or []):\n\t\tdata = item.get('data')\n\t\tif isinstance(data, (list, tuple)) or hasattr(data, '__len__') and not hasattr(data, 'getRowCount'):\n\t\t\tpts = [[a[0], a[1]] for a in data if a is not None and len(a) >= 2]\n\t\t\tif pts:\n\t\t\t\tout.append({'name': item.get('name', 'Zone Air Temp'), 'data': pts})\n\t\t\tcontinue\n\t\ttry:\n\t\t\tcols = list(data.getColumnNames())\n\t\texcept:\n\t\t\tcontinue\n\t\tt_idx = cols.index('t_stamp') if 't_stamp' in cols else 0\n\t\tv_idx = cols.index('Temp') if 'Temp' in cols else (1 if len(cols) > 1 else -1)\n\t\tif v_idx < 0:\n\t\t\tcontinue\n\t\tpts = []\n\t\tfor r in range(data.getRowCount()):\n\t\t\tts = data.getValueAt(r, t_idx)\n\t\t\tv = data.getValueAt(r, v_idx)\n\t\t\tif ts is None or v is None:\n\t\t\t\tcontinue\n\t\t\ttry:\n\t\t\t\tpts.append([system.date.toMillis(ts), round(float(v), 2)])\n\t\t\texcept:\n\t\t\t\tpass\n\t\tif pts:\n\t\t\tout.append({'name': item.get('name', 'Zone Air Temp'), 'data': pts})\n\treturn out\n"
                    }
                  ],
                  "type": "expr-struct",
                  "overlayOptOut": true
                }
              }
            },
