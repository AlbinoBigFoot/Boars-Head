{
  "custom": {},
  "params": {
    "label": "",
    "title": "",
    "color": "#1E88E5",
    "pct": 50,
    "hours": 0
  },
  "propConfig": {
    "label": {
      "paramDirection": "input",
      "persistent": true
    },
    "title": {
      "paramDirection": "input",
      "persistent": true
    },
    "color": {
      "paramDirection": "input",
      "persistent": true
    },
    "pct": {
      "paramDirection": "input",
      "persistent": true
    },
    "hours": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 28,
      "width": 440
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "gap": "8px",
        "width": "100%",
        "height": "100%"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Lbl"
        },
        "position": {
          "basis": "48px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.label"
              }
            }
          }
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Fonts/Label fs-12 fw-700"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Track"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "direction": "row",
          "style": {
            "backgroundColor": "var(--neutral-20)",
            "borderRadius": "4px",
            "height": "18px",
            "width": "100%",
            "overflow": "hidden"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Fill"
            },
            "propConfig": {
              "position.basis": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "string({view.params.pct}) + '%'"
                  }
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.color"
                  }
                }
              }
            },
            "props": {
              "style": {
                "height": "100%",
                "borderRadius": "4px",
                "backgroundColor": "#1E88E5"
              }
            },
            "position": {
              "basis": "50%",
              "shrink": 0,
              "grow": 0
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Hrs"
        },
        "position": {
          "basis": "52px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "numberFormat({view.params.hours}, '0.00') + 'h'"
              }
            }
          }
        },
        "props": {
          "text": "0h",
          "style": {
            "classes": "Fonts/Label fs-11",
            "textAlign": "right"
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
