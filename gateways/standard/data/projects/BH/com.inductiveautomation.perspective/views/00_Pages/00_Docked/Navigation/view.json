      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 720,
      "width": 260
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Brand"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "nav-brand"
          },
          "text": "BH \u00b7 Plant"
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onItemClicked": {
              "config": {
                "script": "\tdata = event.data\n\tif data is None:\n\t\treturn\n\tNavigation.Nav.navigate(data)\n\t# Mark click so selection sync does not collapse expansion\n\tclickedPath = '/'.join(map(str, event.itemPath))\n\tself.view.custom.lastClickPath = clickedPath\n\tself.props.selection = [clickedPath]\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Tree"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "custom.itemPath": {
            "binding": {
              "config": {
                "struct": {
                  "data": "{page.props.path}",
                  "items": "{this.props.items}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\titemPath = None\n\t# value.data here is the current page path string (page.props.path)\n\tpagePath = value.data\n\tif pagePath is not None and len(value.items) > 0:\n\t\tresult = Navigation.Nav.findItemIndex(value.items, page=str(pagePath))\n\t\tif result is not None:\n\t\t\titemPath = '/'.join(map(str, result))\n\treturn itemPath\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif origin == \"Binding\" and currentValue.value is not None:\n\t\tif self.view.custom.lastClickPath:\n\t\t\tself.view.custom.lastClickPath = ''\n\t\t\treturn\n\t\tif currentValue.value != self.props.selection[0]:\n\t\t\tselection = currentValue.value\n\t\t\titems = self.props.items\n\t\t\tif selection is not None:\n\t\t\t\ttry:\n\t\t\t\t\tself.props.selection[0] = selection\n\t\t\t\t\tindexes = selection.split('/')\n\t\t\t\t\tfor index in indexes:\n\t\t\t\t\t\titem = items[int(index)]\n\t\t\t\t\t\titem.expanded = True\n\t\t\t\t\t\titems = item.items\n\t\t\t\texcept IndexError:\n\t\t\t\t\tpass"
            }
