        "children": [
          {
            "type": "ia.input.text-field",
            "meta": {
              "name": "TextField"
            },
            "position": {
              "basis": "120px",
              "grow": 1
            },
            "props": {
              "deferUpdates": false,
              "placeholder": "Search nav\u2026",
              "style": {
                "classes": "nav-search-field"
              }
            },
            "propConfig": {
              "props.text": {
                "persistent": true,
                "onChange": {
                  "enabled": null,
                  "script": "\ttext = currentValue.value\n\tif text is None:\n\t\ttext = ''\n\ttext = str(text)\n\ttree = self.parent.parent.getChild(\"Tree\")\n\tcountLbl = self.getSibling(\"Count\")\n\n\tif text.strip() == '':\n\t\ttree.refreshBinding(\"props.items\")\n\t\tcountLbl.props.text = ''\n\t\treturn\n\n\tdef _label(it):\n\t\ttry:\n\t\t\treturn str(it.label) if it.label is not None else ''\n\t\texcept:\n\t\t\treturn ''\n\n\tdef _children(it):\n\t\ttry:\n\t\t\treturn it.items if it.items is not None else []\n\t\texcept:\n\t\t\treturn []\n\n\tdef _norm(s):\n\t\t# Alphanumeric-only so \"efan01\" matches \"EFAN-01\".\n\t\tout = []\n\t\tfor ch in str(s).lower():\n\t\t\tif (\"a\" <= ch <= \"z\") or (\"0\" <= ch <= \"9\"):\n\t\t\t\tout.append(ch)\n\t\treturn \"\".join(out)\n\n\tdef _matches(label, query):\n\t\tnq = _norm(query)\n\t\tif not nq:\n\t\t\treturn False\n\t\treturn nq in _norm(label)\n\n\tdef _count(items, query):\n\t\tn = 0\n\t\tfor it in items:\n\t\t\tif _matches(_label(it), query):\n\t\t\t\tn += 1\n\t\t\tn += _count(_children(it), query)\n\t\treturn n\n\n\t# Always reset before applying a new query so stale highlights cannot linger.\n\ttree.refreshBinding(\"props.items\")\n\n\tif _count(tree.props.items, text) == 0:\n\t\tcountLbl.props.text = 'no results'\n\t\treturn\n\n\tfoundCount = [0]\n\n\tdef containsText(items, query):\n\t\tfound = False\n\t\tfor item in items:\n\t\t\tlabel = _label(item)\n\t\t\tkids = _children(item)\n\t\t\tmatched = _matches(label, query)\n\n\t\t\tif matched:\n\t\t\t\titem.icon = {\n\t\t\t\t\t\"path\": \"material/search\",\n\t\t\t\t\t\"color\": \"var(--info)\",\n\t\t\t\t\t\"style\": {\"classes\": \"nav-search-hit\", \"height\": \"18px\", \"width\": \"18px\"}\n\t\t\t\t}\n\t\t\t\tfound = True\n\t\t\t\tfoundCount[0] += 1\n\n\t\t\tif kids and len(kids) > 0:\n\t\t\t\tif containsText(kids, query):\n\t\t\t\t\tfound = True\n\t\t\t\t\titem.expanded = True\n\t\t\t\telse:\n\t\t\t\t\titem.expanded = False\n\t\t\telif not matched:\n\t\t\t\titem.expanded = False\n\t\treturn found\n\n\tcontainsText(tree.props.items, text)\n\tn = foundCount[0]\n\tif n <= 0:\n\t\tcountLbl.props.text = 'no results'\n\telif n == 1:\n\t\tcountLbl.props.text = '1 result'\n\telse:\n\t\tcountLbl.props.text = '%s results' % n\n"
                }
              }
            }
