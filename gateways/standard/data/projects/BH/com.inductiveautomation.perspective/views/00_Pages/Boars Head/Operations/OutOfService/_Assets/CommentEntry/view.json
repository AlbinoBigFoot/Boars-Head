{
  "custom": {},
  "params": {
    "id": 0,
    "display_name": "",
    "username": "",
    "created_text": "",
    "status": "",
    "comment": ""
  },
  "propConfig": {
    "params.id": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.display_name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.username": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.created_text": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.status": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.comment": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 70,
      "width": 440
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "oos-comment",
        "gap": "2px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Head"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "8px"
          },
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Name"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Fonts/Value fw-700"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "coalesce({view.params.display_name}, '') + if(coalesce({view.params.username}, '') != '', ' (' + {view.params.username} + ')', '')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Status"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "oos-chip fs-11 fw-700"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.status"
                  }
                }
              },
              "props.style.classes": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "'oos-chip fs-11 fw-700 ' + case(coalesce({view.params.status}, ''), 'Returned', 'oos-chip-returned', 'In Progress', 'oos-chip-progress', 'Ready To Return', 'oos-chip-ready', 'Awaiting Parts', 'oos-chip-waiting', 'On Hold', 'oos-chip-waiting', '')"
                  }
                }
              },
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "coalesce({view.params.status}, '') != ''"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Time"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "Fonts/Label fs-11 text-muted",
                "marginLeft": "auto"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.created_text"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Comment"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "Fonts/Value oos-memo"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.comment"
              }
            }
          }
        }
      }
    ]
  }
}
