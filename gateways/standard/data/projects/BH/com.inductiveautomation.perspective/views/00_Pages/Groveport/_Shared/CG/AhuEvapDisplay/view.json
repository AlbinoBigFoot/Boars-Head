              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Cycle the CG pages in Utility Overview order (wraps around)\n\torder = [str(c).upper() for c in (self.view.custom.cgOrder or [])]\n\tcur = str(self.view.params.label or '').upper()\n\tif cur not in order:\n\t\treturn\n\tnxt = order[(order.index(cur) + -1) % len(order)]\n\tsystem.perspective.navigate('/' + nxt.lower())"
                  }
                }
              }
            }
          },
