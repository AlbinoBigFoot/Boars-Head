{
  "custom": {},
  "params": {
    "canEdit": false,
    "name": "",
    "on": false,
    "sub": ""
  },
  "propConfig": {
    "params.canEdit": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.on": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sub": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 54,
      "width": 178
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Check"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({view.params.on}, 'material/check_box', 'material/check_box_outline_blank')"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.on}, 'admin-ico-on', 'admin-ico-off')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "material/check_box_outline_blank",
          "style": {
            "classes": "admin-ico-off"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Name"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-row-label",
                "minWidth": "0"
              },
              "text": ""
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Sub"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.sub"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-desc"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Text"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "alignItems": "stretch",
          "direction": "column",
          "style": {
            "gap": "1px",
            "minWidth": "0"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tif self.view.params.canEdit:\n\t\tsystem.perspective.sendMessage('umRoleToggle', payload={'name': self.view.params.name}, scope='page')\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.params.on}, 'admin-option admin-option-on', 'admin-option')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "gap": "8px",
        "margin": "0 8px 8px 0",
        "minWidth": "0",
        "padding": "6px 10px"
      }
    },
    "type": "ia.container.flex"
  }
}
