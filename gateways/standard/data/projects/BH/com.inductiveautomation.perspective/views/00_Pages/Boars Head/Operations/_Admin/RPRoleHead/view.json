{
  "custom": {},
  "params": {
    "base": "",
    "full": false,
    "name": "",
    "users": 0
  },
  "propConfig": {
    "params.base": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.full": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.users": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Lock"
            },
            "position": {
              "basis": "12px",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "{view.params.full}"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "path": "material/lock",
              "style": {
                "classes": "admin-ico-muted"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Link"
            },
            "position": {
              "basis": "13px",
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "len({view.params.base}) > 0"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "path": "material/link",
              "style": {
                "classes": "admin-ico-muted"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Name"
            },
            "position": {
              "shrink": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.name"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-role-name",
                "minWidth": "0"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "NameRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "justify": "center",
          "style": {
            "gap": "3px",
            "minWidth": "0"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Sub"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "if({view.params.full}, 'Always All', toStr({view.params.users}) + if({view.params.users} = 1, ' User', ' Users'))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "classes": "admin-head-sub",
            "textAlign": "center"
          },
          "text": ""
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "meta.tooltip.enabled": {
        "binding": {
          "config": {
            "expression": "len(coalesce(if({view.params.full}, {view.params.name} + ' is a full permission role (_Config/Security/FullPermissionRoles): it always has every permission, so its column cannot be changed here.', if(len({view.params.base}) > 0, {view.params.name} + ' also gets every permission of ' + {view.params.base} + ' (_Config/Security/RoleInherits).', '')), '')) > 0"
          },
          "type": "expr"
        }
      },
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "expression": "if({view.params.full}, {view.params.name} + ' is a full permission role (_Config/Security/FullPermissionRoles): it always has every permission, so its column cannot be changed here.', if(len({view.params.base}) > 0, {view.params.name} + ' also gets every permission of ' + {view.params.base} + ' (_Config/Security/RoleInherits).', ''))"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "column",
      "justify": "center",
      "style": {
        "gap": "1px",
        "height": "100%",
        "minWidth": "0"
      }
    },
    "type": "ia.container.flex"
  }
}
