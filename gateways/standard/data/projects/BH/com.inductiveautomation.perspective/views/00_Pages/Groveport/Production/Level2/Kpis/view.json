{
  "custom": {
    "metrics": {}
  },
  "params": {
    "zone": "Prep"
  },
  "propConfig": {
    "params.zone": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.metrics": {
      "binding": {
        "type": "expr-struct",
        "config": {
          "struct": {
            "tick": "now(60000)",
            "zone": "{view.params.zone}",
            "Z_Rate": "if(coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/Zones/' + {view.params.zone} + '/Rate/Value')), false), false), try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/Zones/' + {view.params.zone} + '/Rate/Value')), null), null)",
            "Z_OEE": "if(coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/Zones/' + {view.params.zone} + '/OEE/Value')), false), false), try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/Zones/' + {view.params.zone} + '/OEE/Value')), null), null)",
            "U_VD_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/VD/OEE/Value')), null)",
            "U_VD_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/VD/Status/Value')), null)",
            "U_HOP_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/HOP/OEE/Value')), null)",
            "U_HOP_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/HOP/Status/Value')), null)",
            "U_HND_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/HND/OEE/Value')), null)",
            "U_HND_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/HND/Status/Value')), null)",
            "U_LDR_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/LDR/OEE/Value')), null)",
            "U_LDR_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/LDR/Status/Value')), null)",
            "U_RSM_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/RSM/OEE/Value')), null)",
            "U_RSM_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/RSM/Status/Value')), null)",
            "U_ST_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/ST/OEE/Value')), null)",
            "U_ST_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/ST/Status/Value')), null)",
            "U_LS_OEE": "try(toFloat(tag('[default]Boars_Head/GrovePort/Production/FCM/LS/OEE/Value')), null)",
            "U_LS_Status": "try(toInt(tag('[default]Boars_Head/GrovePort/Production/FCM/LS/Status/Value')), null)"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "type": "script",
            "code": "\t# FCM KPIs: shared.ProductionMetrics.l2 (body = _METRICS_L2 in scripts/_build_groveport_production_overview.py;\n\t# the custom report engine shared.Reports uses the same functions)\n\treturn shared.ProductionMetrics.l2(value)\n"
          },
          {
            "type": "expression",
            "expression": "if((coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/Zones/' + {view.params.zone} + '/Rate/Value')), false), false) || coalesce(try(isGood(tag('[default]Boars_Head/GrovePort/Production/FCM/Zones/' + {view.params.zone} + '/OEE/Value')), false), false)), {value}, null)"
          }
        ]
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 1016,
      "width": 500
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "container-card container-card-border utility-kpi-rail",
        "height": "100%",
        "width": "100%",
        "padding": "10px 12px",
        "gap": "8px",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "RailTitle"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "'Zone KPIs \u2014 ' + {view.params.zone}"
              }
            }
          }
        },
        "props": {
          "text": "Zone KPIs",
          "style": {
            "classes": "Fonts/Title fs-14 fw-700"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "KpiGrid"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "flexWrap": "wrap",
            "gap": "8px",
            "width": "100%"
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ZoneRate"
            },
            "position": {
              "basis": "48%",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "container-card",
                "padding": "10px 12px",
                "gap": "4px",
                "minHeight": "72px",
                "borderRadius": "6px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Zone Rate",
                  "style": {
                    "classes": "Fonts/Label fs-11 fw-600 text-muted"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Value"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "numberFormat(coalesce({view.custom.metrics.zoneRate}, 0), '#,##0') + ' lb/hr'"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "props": {
                  "text": "--",
                  "style": {
                    "classes": "Fonts/Value fs-20 fw-700"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ZoneOEE"
            },
            "position": {
              "basis": "48%",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "container-card",
                "padding": "10px 12px",
                "gap": "4px",
                "minHeight": "72px",
                "borderRadius": "6px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Zone OEE",
                  "style": {
                    "classes": "Fonts/Label fs-11 fw-600 text-muted"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Value"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "numberFormat(coalesce({view.custom.metrics.zoneOee}, 0), '#,##0') + ' %'"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "props": {
                  "text": "--",
                  "style": {
                    "classes": "Fonts/Value fs-20 fw-700"
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "ZoneDT"
            },
            "position": {
              "basis": "48%",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "direction": "column",
              "style": {
                "classes": "container-card",
                "padding": "10px 12px",
                "gap": "4px",
                "minHeight": "72px",
                "borderRadius": "6px"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Title"
                },
                "props": {
                  "text": "Zone Downtime",
                  "style": {
                    "classes": "Fonts/Label fs-11 fw-600 text-muted"
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "Value"
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "numberFormat(coalesce({view.custom.metrics.zoneDowntime}, 0), '#,##0') + ' min'"
                      },
                      "overlayOptOut": true
                    }
                  }
                },
                "props": {
                  "text": "--",
                  "style": {
                    "classes": "Fonts/Value fs-20 fw-700"
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "UnitTitle"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Units In Zone",
          "style": {
            "classes": "Fonts/Label fs-11 fw-600"
          }
        }
      },
      {
        "type": "ia.display.table",
        "meta": {
          "name": "UnitTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.data": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.metrics.units"
              },
              "overlayOptOut": true
            }
          }
        },
        "events": {
          "component": {
            "onRowClick": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\n\trow = event.row\n\tif not row:\n\t\treturn\n\tuid = str(row.get('UnitId') or '')\n\tif not uid:\n\t\treturn\n\troutes = {'VD': '/plants/groveport/production/vat-dumper', 'HOP': '/plants/groveport/production/hopper', 'HND': '/plants/groveport/production/handtman', 'LDR': '/plants/groveport/production/loaders', 'RSM': '/plants/groveport/production/roll-stock', 'ST': '/plants/groveport/production/shrink-tunnel', 'LS': '/plants/groveport/production/lazy-susan'}\n\tr = routes.get(uid)\n\tif r:\n\t\tsystem.perspective.navigate(page=r)\n"
              }
            }
          }
        },
        "props": {
          "columns": [
            {
              "field": "Unit",
              "header": {
                "title": "Unit"
              },
              "width": "30%"
            },
            {
              "field": "Status",
              "header": {
                "title": "Status"
              },
              "width": "18%"
            },
            {
              "field": "Rate",
              "header": {
                "title": "Rate"
              },
              "width": "18%"
            },
            {
              "field": "OEE",
              "header": {
                "title": "OEE (%)"
              },
              "width": "16%"
            },
            {
              "field": "Alarms",
              "header": {
                "title": "Alarms"
              },
              "width": "18%"
            }
          ],
          "pager": {
            "enabled": false
          },
          "style": {
            "height": "100%",
            "classes": "utility-kpi-table Fonts/Label"
          },
          "emptyMessage": {
            "noData": {
              "text": "No Data"
            }
          }
        }
      }
    ],
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "type": "script",
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\tview_name = self.view.id.split('@')[0]\n\titems = []\n\tif value:\n\t\tlogged = tagPath if tagPath.strip() else 'No TagPath: ' + view_name.split('/')[-1]\n\t\titems.append({\n\t\t\t\"text\": 'Ticket Logger',\n\t\t\t\"icon\": {\"path\": 'material/info', \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": 'ticketLog', \"payload\": {'tagPath': logged, 'viewName': view_name, 'sender': self.view.id}, \"scope\": 'page'}\n\t\t})\n\treturn items"
            }
          ]
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "len({this.meta.contextMenu.items}) > 0"
          }
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
