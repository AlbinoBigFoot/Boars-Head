{
  "custom": {},
  "params": {
    "value": ""
  },
  "propConfig": {
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 44,
      "width": 180
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "justify": "center",
      "style": {
        "gap": "1px",
        "paddingLeft": "8px",
        "minWidth": "0",
        "overflow": "hidden"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Line1"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "form-row-label",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "minWidth": "0"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce(try(split(coalesce({view.params.value}, ''), ';;')[0, 0], ''), '')"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Line2"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "classes": "form-hint",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "textOverflow": "ellipsis",
            "minWidth": "0"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce(try(split(coalesce({view.params.value}, ''), ';;')[1, 0], ''), '')"
              }
            }
          }
        }
      }
    ]
  }
}
