      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender \u003d payload.get(\u0027sender\u0027)\n\tif sender and sender !\u003d self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload[\u0027tagPath\u0027], payload[\u0027viewName\u0027])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
