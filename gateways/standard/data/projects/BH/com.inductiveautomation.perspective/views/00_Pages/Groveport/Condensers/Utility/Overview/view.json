        "binding": {
          "config": {
            "expression": "coalesce({session.custom.TicketLogAccess}, false)"
          },
          "transforms": [
            {
              "code": "\ttagPath \u003d \u0027\u0027\n\ttry:\n\t\ttagPath \u003d str(self.view.params.tagPath or \u0027\u0027)\n\texcept:\n\t\tpass\n\tview_name \u003d self.view.id.split(\u0027@\u0027)[0]\n\titems \u003d []\n\tif value:\n\t\tlogged \u003d tagPath if tagPath.strip() else \u0027No TagPath: \u0027 + view_name.split(\u0027/\u0027)[-1]\n\t\titems.append({\n\t\t\t\"text\": \u0027Ticket Logger\u0027,\n\t\t\t\"icon\": {\"path\": \u0027material/info\u0027, \"color\": \"--neutral-80\", \"style\": {}},\n\t\t\t\"style\": {\"classes\": \"bg-component Fonts/Value\", \"height\": 24, \"width\": 170},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\"type\": \u0027ticketLog\u0027, \"payload\": {\u0027tagPath\u0027: logged, \u0027viewName\u0027: view_name, \u0027sender\u0027: self.view.id}, \"scope\": \u0027page\u0027}\n\t\t})\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr"
        }
      }
    },
