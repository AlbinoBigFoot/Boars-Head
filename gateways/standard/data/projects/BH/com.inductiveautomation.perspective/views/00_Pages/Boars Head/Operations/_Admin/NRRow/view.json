{
  "custom": {},
  "params": {
    "desc": "",
    "key": "",
    "label": "",
    "on": false,
    "sub": ""
  },
  "propConfig": {
    "params.desc": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.key": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.on": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.sub": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 700
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Check"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({view.params.on}, 'material/check_box', 'material/check_box_outline_blank')"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.on}, 'admin-ico-on', 'admin-ico-off')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "material/check_box",
          "style": {
            "classes": "admin-ico-on"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "Label"
                },
                "position": {
                  "shrink": 1
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.label"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "admin-row-label",
                    "minWidth": "0"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              },
              {
                "meta": {
                  "name": "Key"
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.text": {
                    "binding": {
                      "config": {
                        "path": "view.params.key"
                      },
                      "type": "property"
                    }
                  }
                },
                "props": {
                  "style": {
                    "classes": "admin-key"
                  },
                  "text": ""
                },
                "type": "ia.display.label"
              }
            ],
            "meta": {
              "name": "Line1"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "alignItems": "center",
              "direction": "row",
              "style": {
                "gap": "8px",
                "minWidth": "0"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "Desc"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "{view.params.sub} + if(len(trim(coalesce({view.params.desc}, ''))) > 0 && {view.params.desc} != {view.params.label}, ' · ' + {view.params.desc}, '')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-desc",
                "minWidth": "0"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Text"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "alignItems": "stretch",
          "direction": "column",
          "justify": "center",
          "style": {
            "gap": "2px",
            "minWidth": "0"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.sendMessage('nrToggle', payload={'key': self.view.params.key}, scope='page')\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "meta.tooltip.enabled": {
        "binding": {
          "config": {
            "expression": "len(coalesce({view.params.desc}, '')) > 0"
          },
          "type": "expr"
        }
      },
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "expression": "{view.params.desc}"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "classes": "admin-row",
        "cursor": "pointer",
        "gap": "10px",
        "minWidth": "0",
        "paddingLeft": "44px",
        "paddingRight": "12px"
      }
    },
    "type": "ia.container.flex"
  }
}
