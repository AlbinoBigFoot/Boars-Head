                  },
                  "type": "expr"
                }
              },
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "len(trim(coalesce({view.custom.name}, ''))) > 0"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "image": {
                "height": 16,
                "icon": {
                  "path": "material/arrow_forward"
                },
                "position": "right",
                "width": 16
              },
              "primary": true,
              "style": {
                "classes": "form-btn-primary",
                "height": "36px"
              },
              "text": "Next: Permissions"
