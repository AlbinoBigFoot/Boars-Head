        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.search": {
      "persistent": true
    },
    "custom.sel": {
      "persistent": true
    },
    "custom.step": {
      "persistent": true
    },
    "params.userSource": {
      "paramDirection": "input",
      "persistent": true
    }
