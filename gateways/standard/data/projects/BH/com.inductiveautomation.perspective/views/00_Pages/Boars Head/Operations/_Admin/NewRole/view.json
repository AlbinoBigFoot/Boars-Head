            "script": "\tif not shared.PermissionMatrix.mayCreate(self.session):\n\t\tsystem.perspective.closePopup(shared.PermissionMatrix.WIZARD_ID)\n\t\treturn\n\tm = shared.PermissionMatrix.wizardModel(self.view.params.userSource or 'default', self.session.props.auth.user.roles)\n\tself.view.custom.model = m\n\tself.view.custom.sel = list(m['defaults'])\n\tself.view.custom.open = dict((str(g['name']), i == 0) for i, g in enumerate(m['groups']))\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
