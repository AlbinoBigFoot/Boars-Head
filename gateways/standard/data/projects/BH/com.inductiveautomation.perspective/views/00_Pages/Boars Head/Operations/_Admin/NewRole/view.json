        "backgroundColor": "var(--surface-card)",
        "height": "100%",
        "minWidth": "0",
        "overflow": "hidden"
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "nrToggle",
          "pageScope": true,
          "script": "\tsel = [str(k) for k in (self.view.custom.sel or [])]\n\tk = str(payload['key'])\n\tif k in sel:\n\t\tsel.remove(k)\n\telse:\n\t\tsel.append(k)\n\tself.view.custom.sel = sel\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "nrBulk",
          "pageScope": true,
          "script": "\tsel = [str(k) for k in (self.view.custom.sel or [])]\n\tkeys = [str(k) for k in (payload['keys'] or [])]\n\tif payload['grant']:\n\t\tsel += [k for k in keys if k not in sel]\n\telse:\n\t\tsel = [k for k in sel if k not in keys]\n\tself.view.custom.sel = sel\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "nrGroupToggle",
          "pageScope": true,
          "script": "\to = dict(self.view.custom.open or {})\n\tn = str(payload['name'])\n\to[n] = not bool(o.get(n))\n\tself.view.custom.open = o\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "nrExpand",
          "pageScope": true,
          "script": "\tself.view.custom.open = dict((str(g['name']), bool(payload['open'])) for g in (self.view.custom.model['groups'] or []))\n",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "nrCreateConfirmed",
          "pageScope": true,
          "script": "\tres = shared.PermissionMatrix.createRole(self.session, self.view.params.userSource or 'default', payload['name'], [str(k) for k in (payload['grants'] or [])], payload.get('copyFrom') or '')\n\tif not res['ok']:\n\t\tshared.Alerts.showAlert(state='error', title='Cannot Create Role', message=res['message'], btnTextPrimary='OK')\n\t\treturn\n\tsystem.perspective.closePopup(shared.PermissionMatrix.WIZARD_ID)\n\tsystem.perspective.sendMessage('nrCreated', payload={'name': str(payload['name']).strip()}, scope='page')\n\tshared.Alerts.showAlert(state='success', title='Role Created', message=res['message'] + ' Assign it to users on User Management > Users.', btnTextPrimary='OK')\n",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
