      "binding": {
        "config": {
          "expression": "forEach({view.custom.groups}, asMap('name', it()['name'], 'icon', it()['icon'], 'desc', it()['desc'], 'rows', it()['rows'], 'open', it()['open'], 'instancePosition', asMap('basis', toStr(44 + if(it()['open'], len(it()['rows']) * 48, 0)) + 'px', 'grow', 0, 'shrink', 0)))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.groups": {
      "binding": {
        "config": {
          "expression": "where(forEach(coalesce(try({view.custom.model}['groups'], asList()), asList()), asMap('name', it()['name'], 'icon', it()['icon'], 'desc', it()['desc'], 'rows', forEach(where(it()['rows'], len({view.custom.q}) = 0 || indexOf(lower(it()['label'] + ' ' + it()['key'] + ' ' + it()['desc'] + ' ' + it()['sub']), {view.custom.q}) >= 0), asMap('key', it()['key'], 'label', it()['label'], 'desc', it()['desc'], 'sub', it()['sub'], 'on', len(where({view.custom.sel}, it() = it(1)['key'])) > 0)), 'open', len({view.custom.q}) > 0 || coalesce(try({view.custom.open}[it()['name']], false), false))), len(it()['rows']) > 0)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.model": {
      "persistent": true
    },
    "custom.name": {
      "persistent": true
    },
    "custom.open": {
      "persistent": true
    },
    "custom.q": {
      "binding": {
