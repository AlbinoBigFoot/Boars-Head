            }
          }
        },
        "children": [
          {
            "type": "ia.display.icon",
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "32px",
              "shrink": 0
            },
            "props": {
              "path": "equipment/trending",
              "style": {
                "classes": "color-icon header-icon-trend",
                "height": "32px",
                "width": "32px"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Badge"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "trend-badge"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toStr(coalesce(try(len({session.custom.AdhocTrend.tags}), 0), 0))"
                  }
                }
              },
              "meta.visible": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "coalesce(try(len({session.custom.AdhocTrend.tags}), 0), 0) > 0"
                  }
                }
              }
            }
          }
        ],
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce(try(len({session.custom.AdhocTrend.tags}), 0), 0) > 0, 'Trending (' + toStr(len({session.custom.AdhocTrend.tags})) + ' Pens)', 'Trending')"
              }
            }
          }
        }
      },
      {
        "meta": {
          "name": "UserSettings"
        },
        "position": {
          "basis": "36px",
          "shrink": 0
        },
        "props": {
          "path": "00_Pages/00_Docked/_Assets/UserSettings",
          "style": {
            "height": "36px",
            "overflow": "hidden",
            "width": "36px"
          }
        },
        "type": "ia.display.view"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\t# Stock light/dark omit BH tokens; always land on *-cool / *-warm aliases.\n\ttry:\n\t\tt = str(self.session.props.theme or '').strip().lower()\n\t\tif t == 'light' or t == '':\n\t\t\tself.session.props.theme = 'light-cool'\n\t\telif t == 'dark':\n\t\t\tself.session.props.theme = 'dark-cool'\n\texcept:\n\t\tpass\n\tenabled = True\n\ttry:\n\t\tenabled = bool(self.session.props.animations)\n\texcept:\n\t\tenabled = True\n\ttry:\n\t\tjs = (\"document.documentElement.classList.remove('animations-off');\" if enabled else \"document.documentElement.classList.add('animations-off');\")\n\t\tif hasattr(system.perspective, 'runJavaScriptAsync'):\n\t\t\tsystem.perspective.runJavaScriptAsync(js)\n\t\telif hasattr(system.perspective, 'runJavaScript'):\n\t\t\tsystem.perspective.runJavaScript(js)\n\texcept:\n\t\tpass"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "flex-end",
      "style": {
        "overflow": "hidden",
        "padding": "6px 12px"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if(coalesce({session.props.animations}, true), 'app-header', 'app-header animations-off')"
          },
          "type": "expr"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component Fonts/Value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0], 'sender': self.view.id\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  },
  "propConfig": {
    "custom.localRouteGuard": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(toBoolean(coalesce(try(tag('[default]_Config/DemoEnterpriseNav'), true), true)), '',\n  if(indexOf('|/|/enterprise|/plants/groveport|/plants/groveport/classic|/plants/groveport/executive|/plants/new-castle|/plants/forrest-city|/plants/petersburg|/plants/holland|/plants/groveport/production-overview|/plants/groveport/production/level-2/prep|/plants/groveport/production/level-2/forming|/plants/groveport/production/level-2/packaging|/plants/groveport/production/vat-dumper|/plants/groveport/production/hopper|/plants/groveport/production/handtman|/plants/groveport/production/loaders|/plants/groveport/production/roll-stock|/plants/groveport/production/shrink-tunnel|/plants/groveport/production/lazy-susan|/plants/groveport/freezer/epms|/plants/groveport/freezer/production|/plants/groveport/superchill/epms|/plants/groveport/superchill/production|/plants/groveport/club/epms|/plants/groveport/club/production|/plants/groveport/palletizing/epms|/plants/groveport/palletizing/production|/plants/groveport/east-ph/epms|/plants/groveport/east-ph/production|/plants/groveport/west-ph/epms|/plants/groveport/west-ph/production|/plants/groveport/dock/epms|/plants/groveport/dock/production|/plants/groveport/machine-room/epms|/plants/groveport/machine-room/production|', '|' + coalesce({page.props.path}, '') + '|') >= 0, '/plants/groveport/utility-overview', ''))"
        }
      },
      "onChange": {
        "enabled": null,
        "script": "\t# local-groveport-mode: the expression is the Utility Overview while [default]_Config/DemoEnterpriseNav is off and the\n\t# page is '/' or an enterprise-only route ('' otherwise); navigate is a one-shot command.\n\ttarget = currentValue.value if currentValue is not None else None\n\tif target and str(self.page.props.path or '') != str(target):\n\t\tsystem.perspective.navigate(page=str(target))\n"
      }
    }
  }
}
