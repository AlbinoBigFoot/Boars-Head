      {
        "type": "ia.container.flex",
        "meta": {
          "name": "TrendButton",
          "tooltip": {
            "enabled": true,
            "text": "Trending"
          }
        },
        "position": {
          "basis": "36px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "classes": "nav-menu-btn header-icon",
            "cursor": "pointer",
            "height": "36px",
            "width": "36px",
            "marginRight": "8px",
            "position": "relative",
            "overflow": "visible"
          }
