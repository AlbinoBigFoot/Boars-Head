{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 1200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Spacer"
        },
        "position": {
          "grow": 1
        },
        "props": {
          "style": {
            "minWidth": "8px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
            "propConfig": {
              "props.path": {
                "binding": {
                  "config": {
                    "path": "session.custom.ReadOnly"
                  },
                  "transforms": [
                    {
                      "expression": "if({value}, 'material/lock', 'material/lock_open')",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "color": "var(--icon)",
              "path": "material/lock_open",
              "style": {
                "classes": "color-icon",
                "height": "20px",
                "width": "20px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "PermBadge",
          "tooltip": {
            "enabled": true,
            "location": "bottom",
            "style": {
              "backgroundColor": "var(--surface-card)",
              "borderColor": "var(--border)",
              "borderRadius": 4,
              "borderStyle": "solid",
              "borderWidth": 1,
              "color": "var(--text)",
              "fontSize": "12px",
              "padding": "6px 10px"
            },
            "text": "Roles: (none)",
            "width": "240px"
          }
        },
        "position": {
          "basis": "36px",
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "session.props.auth.authenticated"
              },
              "type": "property"
            }
          },
          "meta.tooltip.enabled": {
            "binding": {
              "config": {
                "path": "session.props.auth.authenticated"
              },
              "type": "property"
            }
          },
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "session.props.auth.user.roles"
              },
              "transforms": [
                {
                  "code": "\troles = []\n\tif value is not None:\n\t\ttry:\n\t\t\troles = [str(r) for r in value]\n\t\texcept:\n\t\t\troles = [str(value)]\n\tif not roles:\n\t\treturn 'Roles: (none)'\n\treturn 'Roles: ' + ', '.join(roles)",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "session.custom.ReadOnly"
              },
              "transforms": [
                {
                  "expression": "if({value}, 'perm-badge perm-badge-read', 'perm-badge perm-badge-write')",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "alignItems": "center",
          "justify": "center",
          "style": {
            "classes": "perm-badge perm-badge-write",
            "cursor": "help",
            "height": "36px",
            "marginRight": "8px",
            "overflow": "visible",
            "width": "36px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "User"
        },
        "position": {
          "basis": "auto",
          "shrink": 0
        },
        "props": {
          "path": "00_Pages/00_Docked/_Assets/User",
          "style": {
            "height": "36px",
            "marginRight": "8px",
            "minWidth": "110px",
            "overflow": "hidden"
          }
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "UserSettings"
        },
        "position": {
          "basis": "36px",
          "shrink": 0
        },
        "props": {
          "path": "00_Pages/00_Docked/_Assets/UserSettings",
          "style": {
            "height": "36px",
            "overflow": "hidden",
            "width": "36px"
          }
        },
        "type": "ia.display.view"
      }
    ],
    "events": {
      "system": {
        "onStartup": {
          "config": {
            "script": "\tenabled = True\n\ttry:\n\t\tenabled = bool(self.session.props.animations)\n\texcept:\n\t\tenabled = True\n\ttry:\n\t\tjs = (\"document.documentElement.classList.remove('animations-off');\" if enabled else \"document.documentElement.classList.add('animations-off');\")\n\t\tif hasattr(system.perspective, 'runJavaScriptAsync'):\n\t\t\tsystem.perspective.runJavaScriptAsync(js)\n\t\telif hasattr(system.perspective, 'runJavaScript'):\n\t\t\tsystem.perspective.runJavaScript(js)\n\texcept:\n\t\tpass"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "flex-end",
      "style": {
        "overflow": "hidden",
        "padding": "6px 12px"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if(coalesce({session.props.animations}, true), 'app-header', 'app-header animations-off')"
          },
          "type": "expr"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
