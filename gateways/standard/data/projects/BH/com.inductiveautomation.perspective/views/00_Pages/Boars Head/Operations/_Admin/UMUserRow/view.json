{
  "custom": {},
  "params": {
    "display": "",
    "initials": "",
    "more": "",
    "role1": "",
    "selected": false,
    "username": ""
  },
  "propConfig": {
    "params.display": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.initials": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.more": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.role1": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.selected": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.username": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 360
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Avatar"
        },
        "position": {
          "basis": "32px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.selected}, 'admin-avatar admin-avatar-selected', 'admin-avatar')"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.initials"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "admin-avatar",
            "height": "32px",
            "justifyContent": "center",
            "lineHeight": "32px"
          },
          "text": ""
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Name"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.display"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-item-title",
                "minWidth": "0"
              },
              "text": ""
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "User"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.username"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "admin-desc"
              },
              "text": ""
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Text"
        },
        "position": {
          "basis": "0",
          "grow": 1,
          "shrink": 1
        },
        "props": {
          "alignItems": "stretch",
          "direction": "column",
          "style": {
            "gap": "2px",
            "minWidth": "0"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Role"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "len({view.params.role1}) > 0"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.role1"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "admin-chip"
          },
          "text": ""
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "More"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "len({view.params.more}) > 0"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.more"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "admin-chip"
          },
          "text": ""
        },
        "type": "ia.display.label"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tsystem.perspective.sendMessage('umSelect', payload={'name': self.view.params.username}, scope='page')\n"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "propConfig": {
      "props.style.classes": {
        "binding": {
          "config": {
            "expression": "if({view.params.selected}, 'admin-list-item admin-list-item-selected', 'admin-list-item')"
          },
          "type": "expr"
        }
      }
    },
    "props": {
      "alignItems": "center",
      "direction": "row",
      "style": {
        "gap": "10px",
        "minWidth": "0",
        "paddingLeft": "12px",
        "paddingRight": "12px"
      }
    },
    "type": "ia.container.flex"
  }
}
