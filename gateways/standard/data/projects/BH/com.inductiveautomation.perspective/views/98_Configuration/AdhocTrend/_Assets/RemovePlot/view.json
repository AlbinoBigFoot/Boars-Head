{
  "custom": {
    "plotId": ""
  },
  "params": {},
  "props": {
    "defaultSize": {
      "height": 220,
      "width": 360
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "adhoc-trend-save-title",
            "marginLeft": "10px",
            "marginTop": "10px"
          },
          "text": "Remove Plot"
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "adhoc-trend-save-label"
              },
              "text": "Select plot to remove"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Dropdown"
            },
            "position": {
              "basis": "32px"
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "config": {
                    "path": "session.custom.AdhocTrend.plots"
                  },
                  "transforms": [
                    {
                      "code": "\treturn shared.AdhocTrend.remove_plot_dropdown_options(self.session.custom.AdhocTrend)\n",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              },
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "view.custom.plotId"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "placeholder": "Choose a plot…",
              "style": {
                "classes": "bg-component font-value"
              },
              "options": []
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "name": "PlotSelect"
        },
        "position": {
          "basis": "70px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "marginLeft": "10px",
            "marginRight": "10px",
            "marginTop": "15px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tshared.AdhocTrend.close_remove_plot_popup()\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Cancel"
            },
            "props": {
              "style": {
                "classes": "container-button font-button",
                "width": 120
              },
              "text": "Cancel"
            },
            "type": "ia.input.button"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tfrom shared import Alerts\n\n\tok, msg, plots, penPlots = shared.AdhocTrend.confirm_remove_plot(\n\t\tself.session.custom.AdhocTrend,\n\t\tself.view.custom.plotId\n\t)\n\tif not ok:\n\t\tAlerts.showAlert(\n\t\t\tstate=\"warning\",\n\t\t\ttitle=\"Cannot Remove Plot\",\n\t\t\tmessage=msg,\n\t\t\tshowCloseBtn=True,\n\t\t\tbtnTextPrimary=\"OK\",\n\t\t\tbtnActionPrimary=\"closeAlert\"\n\t\t)\n\t\treturn\n\tself.session.custom.AdhocTrend.plots = plots\n\tself.session.custom.AdhocTrend.penPlots = penPlots\n\tshared.AdhocTrend.close_remove_plot_popup()\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Confirm"
            },
            "props": {
              "style": {
                "classes": "container-button font-button",
                "width": 120
              },
              "text": "Remove"
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Buttons"
        },
        "position": {
          "align": "auto",
          "basis": "32px",
          "shrink": 0
        },
        "props": {
          "justify": "space-around",
          "style": {
            "marginTop": "16px",
            "marginBottom": "10px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "adhoc-trend-save-dialog"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
