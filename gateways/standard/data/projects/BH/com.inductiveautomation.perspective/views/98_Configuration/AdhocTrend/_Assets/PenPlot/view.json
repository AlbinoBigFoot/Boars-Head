{
  "custom": {},
  "params": {
    "row": 0,
    "rowData": {}
  },
  "propConfig": {
    "params.row": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.rowData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 28,
      "width": 96
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "style": {
        "width": "100%",
        "maxWidth": "96px",
        "minWidth": 0,
        "height": "28px",
        "maxHeight": "28px",
        "minHeight": "28px",
        "overflow": "hidden",
        "backgroundColor": "transparent",
        "padding": "0px",
        "margin": "0px",
        "classes": "adhoc-trend-pen-plot-wrap"
      },
      "justify": "center"
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "children": [
      {
        "type": "ia.input.dropdown",
        "meta": {
          "name": "Plot"
        },
        "position": {
          "grow": 0,
          "shrink": 1,
          "basis": "96px"
        },
        "props": {
          "allowCustomOptions": false,
          "style": {
            "classes": "font-value adhoc-trend-pen-plot-select",
            "minWidth": 0,
            "maxWidth": "96px",
            "width": "96px",
            "height": "28px",
            "maxHeight": "28px",
            "minHeight": "28px",
            "overflow": "hidden",
            "backgroundColor": "transparent",
            "margin": "0px",
            "padding": "0px"
          },
          "options": [],
          "dropdownOptionStyle": {
            "classes": "font-value",
            "fontSize": "12px",
            "padding": "4px 6px",
            "minHeight": "24px"
          }
        },
        "propConfig": {
          "props.options": {
            "binding": {
              "config": {
                "path": "session.custom.AdhocTrend.plots"
              },
              "transforms": [
                {
                  "code": "\treturn shared.AdhocTrend.plot_dropdown_options(value)\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.rowData.plotId"
              },
              "transforms": [
                {
                  "code": "\treturn str(value) if value not in (None, '') else 'p0'\n",
                  "type": "script"
                }
              ],
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif currentValue.value in (None, ''):\n\t\treturn\n\tcfg = self.session.custom.AdhocTrend\n\trow = self.view.params.rowData\n\tkey = None\n\ttry:\n\t\tkey = row.tagPath\n\texcept:\n\t\tpass\n\tif key in (None, ''):\n\t\ttry:\n\t\t\tkey = row.alias\n\t\texcept:\n\t\t\tkey = self.view.params.row\n\tpenPlots = shared.AdhocTrend.move_pen(cfg, key, currentValue.value)\n\tself.session.custom.AdhocTrend.penPlots = penPlots\n"
            }
          }
        }
      }
    ]
  }
}
