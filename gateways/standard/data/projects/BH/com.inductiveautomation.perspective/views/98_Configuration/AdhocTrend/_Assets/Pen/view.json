{
  "custom": {},
  "params": {
    "color": "",
    "justify": "flex-start",
    "penName": ""
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.justify": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.penName": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 24,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "view.params.color"
              },
              "type": "property"
            },
            "persistent": true
          }
        },
        "props": {
          "path": "material/show_chart"
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.penName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Fonts/Value",
            "marginLeft": "1%",
            "overflowWrap": "normal"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "propConfig": {
      "props.justify": {
        "binding": {
          "config": {
            "path": "view.params.justify"
          },
          "type": "property"
        }
      }
    },
    "type": "ia.container.flex"
  }
}