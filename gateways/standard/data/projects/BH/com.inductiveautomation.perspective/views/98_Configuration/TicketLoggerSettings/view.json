{
  "custom": {
    "tab": "Destinations",
    "rev": 0,
    "data": null
  },
  "params": {},
  "propConfig": {
    "custom.data": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript('shared.TicketLogger.routingForView', 0, {view.custom.rev})"
        }
      }
    },
    "custom.tab": {
      "persistent": false
    },
    "custom.rev": {
      "persistent": false
    }
  },
  "props": {
    "defaultSize": {
      "width": 552,
      "height": 660
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {
      "shrink": 0
    },
    "props": {
      "direction": "column",
      "style": {
        "overflow": "hidden",
        "padding": "2px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Denied"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Ticket Logger Settings Needs The Ticket Logger Settings Permission (OneShot).",
          "style": {
            "classes": "form-note",
            "whiteSpace": "normal",
            "lineHeight": "1.35"
          }
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "!(coalesce({session.custom.TicketLogSettings}, false))"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1,
          "basis": "0",
          "shrink": 1
        },
        "props": {
          "direction": "column",
          "style": {
            "gap": "10px"
          }
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({session.custom.TicketLogSettings}, false)"
              }
            }
          }
        },
        "children": [
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Tabs"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "style": {
                "classes": "admin-tabs"
              }
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "TabDestinations"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Destinations",
                  "style": {
                    "classes": "admin-tab"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.tab} = 'Destinations', 'admin-tab admin-tab-active', 'admin-tab')"
                      }
                    }
                  }
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tself.view.custom.tab = 'Destinations'\n"
                      }
                    }
                  }
                }
              },
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "TabRouting"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Routing",
                  "style": {
                    "classes": "admin-tab"
                  }
                },
                "propConfig": {
                  "props.style.classes": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "if({view.custom.tab} = 'Routing', 'admin-tab admin-tab-active', 'admin-tab')"
                      }
                    }
                  }
                },
                "events": {
                  "dom": {
                    "onClick": {
                      "type": "script",
                      "scope": "G",
                      "config": {
                        "script": "\tself.view.custom.tab = 'Routing'\n"
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "Destinations"
            },
            "position": {
              "grow": 1,
              "basis": "0",
              "shrink": 1
            },
            "props": {
              "direction": "column",
              "style": {
                "gap": "10px"
              }
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{view.custom.tab} = 'Destinations'"
                  }
                }
              }
            },
            "children": [
              {
