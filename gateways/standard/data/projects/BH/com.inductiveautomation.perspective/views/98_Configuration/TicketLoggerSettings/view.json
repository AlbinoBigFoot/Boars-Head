                        },
                        "position": {
                          "shrink": 0
                        },
                        "props": {
                          "text": "Oracle",
                          "style": {
                            "classes": "form-section-title"
                          }
                        }
                      },
                      {
                        "type": "ia.display.label",
                        "meta": {
                          "name": "Sub"
                        },
                        "position": {
                          "shrink": 0
                        },
                        "props": {
                          "text": "Client Ticketing",
                          "style": {
                            "classes": "form-hint"
                          }
                        }
                      },
                      {
                        "type": "ia.container.flex",
                        "meta": {
                          "name": "Spacer"
                        },
                        "position": {
                          "grow": 1,
