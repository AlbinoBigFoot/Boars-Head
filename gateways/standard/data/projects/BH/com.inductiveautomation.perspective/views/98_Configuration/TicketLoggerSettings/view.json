                },
                "children": [
                  {
                    "type": "ia.container.flex",
                    "meta": {
                      "name": "Head"
                    },
                    "position": {
                      "shrink": 0
                    },
                    "props": {
                      "direction": "row",
                      "style": {
                        "gap": "8px"
                      },
                      "alignItems": "center"
                    },
                    "children": [
                      {
                        "type": "ia.display.label",
                        "meta": {
