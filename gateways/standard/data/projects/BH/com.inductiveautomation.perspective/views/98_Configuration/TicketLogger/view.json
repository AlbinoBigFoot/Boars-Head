{
  "custom": {
    "mode": "ticket",
    "type": "Issue",
    "fieldKeys": "",
    "types": null,
    "fields": null,
    "route": ""
  },
  "params": {
    "tagPath": "",
    "viewName": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.viewName": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.types": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "direct",
          "tagPath": "[default]_Config/TicketLogger/Types",
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.fields": {
      "binding": {
        "type": "tag",
        "config": {
          "mode": "direct",
          "tagPath": "[default]_Config/TicketLogger/Fields",
          "fallbackDelay": 2.5
        }
      }
    },
    "custom.fieldKeys": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "',' + replace(coalesce(try(lookup({view.custom.types}, {view.custom.type}, '', 'Type', 'Fields'), ''), ''), ' ', '') + ','"
        }
      }
    },
    "custom.mode": {
      "persistent": false
    },
    "custom.route": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "coalesce(try(runScript('shared.TicketLogger.routeLabel', 0, {view.custom.type}, {view.params.tagPath}), ''), '')"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 740,
      "width": 580
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Icon"
            },
            "position": {
              "basis": "30px"
            },
            "props": {
              "path": "material/info",
              "style": {
                "classes": "color-icon"
              }
            },
            "type": "ia.display.icon"
          },
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "style": {
                "classes": "Fonts/Title",
                "paddingBottom": "0.5%",
                "paddingLeft": "0.5%",
                "paddingTop": "0.5%"
              },
              "text": "Ticket Logger"
            },
            "type": "ia.display.label",
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.mode} = 'settings', 'Ticket Logger Settings', 'Ticket Logger')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.icon",
            "meta": {
              "name": "Settings",
              "tooltip": {
                "enabled": true,
                "text": "Integrations"
              }
            },
            "position": {
              "basis": "32px",
              "shrink": 0
            },
            "props": {
              "path": "material/settings",
              "style": {
                "classes": "color-icon ticket-logger-gear",
                "height": "32px",
                "width": "32px",
                "alignSelf": "center",
                "marginRight": "-2px"
              }
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "session.custom.TicketLogSettings"
                  }
                }
              },
              "props.path": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.mode} = 'settings', 'material/close', 'material/settings')"
                  }
                }
              },
              "meta.tooltip.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.mode} = 'settings', 'Back To Ticket', 'Ticket Logger Settings')"
                  }
                }
              }
            },
            "events": {
              "dom": {
                "onClick": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tif not self.session.custom.TicketLogSettings:\n\t\treturn\n\tself.view.custom.mode = 'ticket' if self.view.custom.mode == 'settings' else 'settings'\n"
                  }
                }
              }
            }
