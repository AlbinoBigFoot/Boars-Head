      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tfrom shared import TicketLogger\n\tfrom shared import Alerts\n\n\troot = self.parent.parent\n\texpectedResult = root.getChild(\"Results\").getChild(\"ExpectedResult\").getChild(\"TextBox\").props.text or \"\"\n\tactualResult = root.getChild(\"Results\").getChild(\"ActualResult\").getChild(\"TextBox\").props.text or \"\"\n\tstepsToRecreate = root.getChild(\"Results\").getChild(\"StepsToRecreate\").getChild(\"TextBox\").props.text or \"\"\n\tpriority = root.getChild(\"IssueData\").getChild(\"IssueTimePriority\").getChild(\"IssuePriority\").getChild(\"PriorityDropdown\").props.value\n\trequestType = root.getChild(\"IssueData\").getChild(\"IssueTimePriority\").getChild(\"IssueType\").getChild(\"TypeRow\").getChild(\"TypeDropdown\").props.value\n\n\terrors = []\n\tif priority is None or priority == \"\" or priority == 0:\n\t\terrors.append(\"Select a Priority\")\n\tif len(str(expectedResult).strip()) < 3:\n\t\terrors.append(\"Expected Result (min 3 characters)\")\n\tif len(str(actualResult).strip()) < 3:\n\t\terrors.append(\"Actual Result (min 3 characters)\")\n\tif len(str(stepsToRecreate).strip()) < 3:\n\t\terrors.append(\"Steps to Recreate (min 3 characters)\")\n\n\tif errors:\n\t\tAlerts.showAlert(\n\t\t\tstate=\"warning\",\n\t\t\ttitle=\"Incomplete Ticket\",\n\t\t\tmessage=\"Please fix:\\n- \" + \"\\n- \".join(errors),\n\t\t\tshowCloseBtn=True,\n\t\t\tbtnTextPrimary=\"OK\",\n\t\t\tbtnTextSecondary=\"\",\n\t\t\tbtnActionPrimary=\"closeAlert\",\n\t\t\tbtnActionSecondary=\"\",\n\t\t\tpayload={}\n\t\t)\n\telse:\n\t\ttitle = root.getChild(\"TagPathContainer\").getChild(\"TagPath\").props.text\n\t\tviewName = root.getChild(\"ViewName\").getChild(\"Name\").props.text\n\t\tissuerName = root.getChild(\"IssueData\").getChild(\"IssueTimePriority\").getChild(\"IssuerName\").getChild(\"Name\").props.text\n\t\tif not requestType:\n\t\t\trequestType = \"Issue\"\n\t\temail = None\n\t\ttry:\n\t\t\temail = self.session.props.auth.user.email\n\t\texcept:\n\t\t\tpass\n\t\ttry:\n\t\t\tresult = TicketLogger.createTicket(\n\t\t\t\ttitle=title,\n\t\t\t\tviewName=viewName,\n\t\t\t\treporter=issuerName,\n\t\t\t\tpriority=priority,\n\t\t\t\texpectedResult=str(expectedResult).strip(),\n\t\t\t\tactualResult=str(actualResult).strip(),\n\t\t\t\tstepsToRecreate=str(stepsToRecreate).strip(),\n\t\t\t\temail=email,\n\t\t\t\trequestType=requestType,\n\t\t\t)\n\t\t\tmsg = \"Ticket log successful!\"\n\t\t\tif result and result.get(\"url\"):\n\t\t\t\tmsg = \"Ticket log successful!\\n\" + str(result.get(\"url\"))\n\t\t\tAlerts.showAlert(state=\"success\",title=\"Success\",message=msg,showCloseBtn=False,btnTextPrimary=\"Okay\",btnTextSecondary=\"\",btnActionPrimary=\"commitTicketLog\",btnActionSecondary=\"\",payload={})\n\t\texcept Exception as e:\n\t\t\tAlerts.showAlert(state=\"error\",title=\"Ticket Logger\",message=str(e),showCloseBtn=True,btnTextPrimary=\"OK\",btnTextSecondary=\"\",btnActionPrimary=\"closeAlert\",btnActionSecondary=\"\",payload={})\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
