      {
        "children": [
          {
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tfrom shared import TicketLogger\n\tfrom shared import Alerts\n\n\t# ticket-routing: every user with TicketLogger/Use submits; shared.TicketLogger.send routes the ticket by its\n\t# selection (Type + the Area of its tag path) to Monday or the Oracle outbox (or records it in a dry run)\n\troot = self.parent.parent\n\tview = self.view\n\tpriority = root.getChild(\"IssueData\").getChild(\"IssueTimePriority\").getChild(\"IssuePriority\").getChild(\"PriorityDropdown\").props.value\n\trequestType = view.custom.type or \"Issue\"\n\tkeys = [k for k in str(view.custom.fieldKeys or \"\").split(\",\") if k]\n\tdefs = {}\n\tif view.custom.fields is not None:\n\t\tfor r in system.dataset.toPyDataSet(view.custom.fields):\n\t\t\tdefs[r[\"Key\"]] = (r[\"Label\"], int(r[\"MinLength\"] or 0))\n\n\terrors = []\n\tif priority is None or priority == \"\" or priority == 0:\n\t\terrors.append(\"Select a Priority\")\n\tif not keys:\n\t\terrors.append(\"Select a Type\")\n\tsections = []\n\tfor k in keys:\n\t\tlabel, minLen = defs.get(k, (k, 0))\n\t\ttext = str(root.getChild(\"Results\").getChild(\"Field_\" + k).getChild(\"TextBox\").props.text or \"\").strip()\n\t\tif len(text) < minLen:\n\t\t\terrors.append(\"%s (min %d characters)\" % (label, minLen))\n\t\tsections.append((label, text))\n\n\tif errors:\n\t\tAlerts.showAlert(state=\"warning\", title=\"Incomplete Ticket\", message=\"Please fix:\\n- \" + \"\\n- \".join(errors),\n\t\t\tshowCloseBtn=True, btnTextPrimary=\"OK\", btnTextSecondary=\"\", btnActionPrimary=\"closeAlert\",\n\t\t\tbtnActionSecondary=\"\", payload={})\n\t\treturn\n\ttitle = root.getChild(\"TagPathContainer\").getChild(\"TagPath\").props.text\n\tviewName = root.getChild(\"ViewName\").getChild(\"Name\").props.text\n\tissuerName = root.getChild(\"IssueData\").getChild(\"IssueTimePriority\").getChild(\"IssuerName\").getChild(\"Name\").props.text\n\temail = None\n\tusername = \"\"\n\ttry:\n\t\temail = self.session.props.auth.user.email\n\t\tusername = self.session.props.auth.user.userName\n\texcept:\n\t\tpass\n\tticket = {\"title\": title, \"tagPath\": view.params.tagPath or title, \"viewName\": viewName, \"reporter\": issuerName,\n\t\t\"username\": username, \"email\": email, \"priority\": priority, \"type\": requestType, \"sections\": sections}\n\ttry:\n\t\tresult = TicketLogger.send(ticket)\n\t\tAlerts.showAlert(state=\"success\", title=\"Dry Run\" if result.get(\"dryRun\") else \"Ticket Logged\",\n\t\t\tmessage=result.get(\"message\") or \"Ticket Logged\", showCloseBtn=False, btnTextPrimary=\"Okay\",\n\t\t\tbtnTextSecondary=\"\", btnActionPrimary=\"commitTicketLog\", btnActionSecondary=\"\", payload={})\n\texcept Exception as e:\n\t\tAlerts.showAlert(state=\"error\", title=\"Ticket Logger\", message=str(e), showCloseBtn=True, btnTextPrimary=\"OK\",\n\t\t\tbtnTextSecondary=\"\", btnActionPrimary=\"closeAlert\", btnActionSecondary=\"\", payload={})\n"
                  },
                  "scope": "G",
