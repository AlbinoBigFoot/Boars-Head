{
  "custom": {
    "aggregate": "",
    "dataset": null,
    "endDate": null,
    "historicalDataset": null,
    "key": [],
    "pens": null,
    "pointCount": 120,
    "realTime": true,
    "realTimeDataset": null,
    "startDate": null,
    "timeRange": 1
  },
  "params": {
    "chartHeight": 400,
    "layoutKey": "e",
    "plotCount": 1,
    "plotId": "p0",
    "plotKind": "analog",
    "plotTitle": "Default",
    "showToolbar": true,
    "canRemove": false
  },
  "propConfig": {
    "params.chartHeight": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.layoutKey": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotCount": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotKind": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotTitle": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.aggregate": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.aggregate"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.pointCount": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.pointCount"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.realTime": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.realtime"
        },
        "type": "property"
      },
      "persistent": true,
      "onChange": {
        "enabled": null,
        "script": "\tif currentValue is not None and currentValue.value and previousValue is not None and not previousValue.value:\n\t\tfor name in ('apexchart', 'apexchartPan'):\n\t\t\ttry:\n\t\t\t\tself.rootContainer.getChild(name).resetSeries(True, True)\n\t\t\texcept:\n\t\t\t\tpass"
      }
    },
    "custom.timeRange": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.timeRange"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.startDate": {
      "binding": {
        "config": {
          "struct": {
            "realTime": "{view.custom.realTime}",
            "startDate": "{session.custom.AdhocTrend.startDate}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "{value}['startDate']",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.endDate": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.endDate"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.pens": {
      "binding": {
        "config": {
          "struct": {
            "cfg": "{session.custom.AdhocTrend}",
            "plotId": "{view.params.plotId}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value is None:\n\t\treturn shared.AdhocTrend.build_pens([], [])\n\tcfg = getattr(value, \"cfg\", None)\n\tplotId = getattr(value, \"plotId\", None)\n\tif cfg is None:\n\t\treturn shared.AdhocTrend.build_pens([], [])\n\ttags = shared.AdhocTrend._cfg_get(cfg, \"tags\", [])\n\tcolors = shared.AdhocTrend._cfg_get(cfg, \"colors\", shared.AdhocTrend.DEFAULT_COLORS)\n\tpenPlots = shared.AdhocTrend.plain_pen_plots(cfg)\n\tplots = shared.AdhocTrend.plain_plots(cfg)\n\tdisabled = shared.AdhocTrend.plain_disabled_pens(cfg)\n\tfirstId = plots[0][\"id\"] if plots else \"p0\"\n\tpens = shared.AdhocTrend.build_pens(tags, colors, penPlots, plots, disabled)\n\treturn shared.AdhocTrend.pens_for_plot(pens, penPlots, plotId, firstId)\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.key": {
      "binding": {
        "config": {
          "struct": {
            "aggregate": "{view.custom.aggregate}",
            "pens": "{view.custom.pens}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value is None:\n\t\treturn []\n\tpens = getattr(value, \"pens\", None)\n\taggregate = getattr(value, \"aggregate\", \"\") or \"\"\n\treturn shared.AdhocTrend.build_key(pens, aggregate)\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.realTimeDataset": {
      "binding": {
        "config": {
          "aggregate": "Average",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "{view.custom.timeRange}",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "5"
          },
          "preventInterpolation": false,
          "returnFormat": "Tall",
          "returnSize": {
            "numRows": "{view.custom.pointCount}",
            "type": "FIXED"
          },
          "tags": "{view.custom.key}",
          "valueFormat": "DATASET"
        },
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.historicalDataset": {
      "binding": {
        "config": {
          "aggregate": "Average",
          "avoidScanClassValidation": true,
          "dateRange": {
            "startDate": "{view.custom.startDate}",
            "endDate": "{view.custom.endDate}"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "preventInterpolation": false,
          "returnFormat": "Tall",
          "returnSize": {
            "numRows": "{view.custom.pointCount}",
            "type": "FIXED"
          },
          "tags": "{view.custom.key}",
          "valueFormat": "DATASET"
        },
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.dataset": {
      "binding": {
        "config": {
          "struct": {
            "historicalDataset": "{view.custom.historicalDataset}",
            "realTime": "{view.custom.realTime}",
            "realTimeDataset": "{view.custom.realTimeDataset}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['realTime'],\n\t{value}['realTimeDataset'],\n\t{value}['historicalDataset']\n)",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.showToolbar": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.canRemove": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 2000,
      "width": 800
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "adhoc-trend-plot-slot",
        "height": "100%",
        "width": "100%",
        "minHeight": 0,
        "maxHeight": "none",
        "flex": "1 1 0",
        "minWidth": 0,
        "overflow": "hidden",
        "margin": "0",
        "padding": "0",
        "marginBottom": "0px",
        "paddingBottom": "0px"
      }
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component Fonts/Value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0], 'sender': self.view.id\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\t# page-scoped: every view on the page hears it - only the view whose menu was clicked acts\n\tsender = payload.get('sender')\n\tif sender and sender != self.view.id:\n\t\treturn\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        },
        {
          "messageType": "trendZoomReset",
          "pageScope": true,
          "sessionScope": false,
          "viewScope": false,
          "script": "\t# trend-context: Reset Zoom / double-click on any plot -> every plot drops its own value (XY) zoom too\n\tfor name in ('apexchart', 'apexchartPan'):\n\t\ttry:\n\t\t\tself.getChild(name).resetSeries(True, True)\n\t\texcept:\n\t\t\tpass\n"
        }
      ]
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "position": {
          "grow": 0,
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "classes": "adhoc-trend-plot-header",
            "paddingLeft": "8px",
            "paddingRight": "8px",
            "overflow": "hidden",
            "height": "30px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "Fonts/Label adhoc-trend-plot-title"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr-struct",
                  "config": {
                    "struct": {
                      "title": "{view.params.plotTitle}",
                      "pens": "{view.custom.pens}"
                    },
                    "waitOnAll": true
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\ttry:\n\t\tn = value.pens.getRowCount()\n\texcept:\n\t\tn = 0\n\treturn u'%s \\u00b7 %d Pen%s' % (value.title or 'Default', n, '' if n == 1 else 's')"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "RemovePlot",
              "tooltip": {
                "enabled": true,
                "text": "Remove this plot (its pens move to Default)"
              }
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "text": "Remove Plot",
              "primary": false,
              "style": {
                "classes": "trend-tool-btn trend-tool-compact"
              },
              "image": {
                "icon": {
                  "path": "material/close"
                },
                "position": "left",
                "width": 16,
                "height": 16
              }
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "coalesce({view.params.canRemove}, false)"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tcfg = self.session.custom.AdhocTrend\n\tok, msg, plots, penPlots = shared.AdhocTrend.remove_plot(cfg, self.view.params.plotId)\n\tif ok:\n\t\tcfg.plots = plots\n\t\tcfg.penPlots = penPlots"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "kyvislabs.display.apexchart",
        "meta": {
          "name": "apexchart"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "options": {
            "chart": {
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": true,
                "legendClick": false,
                "markerClick": true,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": true,
                "selection": false,
                "updated": false,
                "xAxisLabelClick": false,
                "zoomed": true
              },
              "fontFamily": "sans-serif",
              "height": "100%",
              "redrawOnParentResize": true,
              "redrawOnWindowResize": true,
              "stacked": false,
              "toolbar": {
                "export": {
                  "csv": {
                    "categoryFormatter": "function (x) {return new Date(x)}",
                    "filename": "export"
                  }
                },
                "show": true,
                "offsetX": 0,
                "offsetY": 0,
                "autoSelected": "zoom",
                "tools": {
                  "download": true,
                  "selection": false,
                  "zoom": true,
                  "zoomin": false,
                  "zoomout": false,
                  "pan": true,
                  "reset": false
                }
              },
              "type": "line",
              "zoom": {
                "enabled": true,
                "type": "x",
                "autoScaleYaxis": false,
                "allowMouseWheelZoom": true
              },
              "offsetY": 0,
              "id": "",
              "width": "100%",
              "selection": {
                "enabled": false
              },
              "animations": {
                "enabled": false
              }
            },
            "dataLabels": {
              "enabled": false
            },
            "fill": {
              "opacity": 1
            },
            "grid": {
              "show": false,
              "padding": {
                "bottom": 0,
                "top": 0,
                "left": 8,
                "right": 8
              }
            },
            "legend": {
              "labels": {
                "useSeriesColors": false,
                "colors": "var(--neutral-90)"
              },
              "position": "top",
              "show": true,
              "showForSingleSeries": true,
              "horizontalAlign": "left",
              "fontSize": "11px",
              "onItemClick": {
                "toggleDataSeries": true
              },
              "onItemHover": {
                "highlightDataSeries": true
              }
            },
            "markers": {
              "size": 0
            },
            "stroke": {
              "curve": "straight",
              "width": 1.2
            },
            "tooltip": {
              "enabled": true,
              "style": {
                "fontFamily": "sans-serif",
                "fontSize": "12px"
              },
              "x": {
                "format": "dd MMM yyyy HH:mm:ss",
                "show": true
              },
              "shared": true,
              "intersect": false,
              "followCursor": false
            },
            "xaxis": {
              "axisBorder": {
                "offsetY": 0,
                "show": true
              },
              "labels": {
                "datetimeFormatter": {
                  "day": "dd MMM",
                  "hour": "HH:mm",
                  "month": "MMM yy",
                  "year": "yyyy"
                },
                "datetimeUTC": false,
                "offsetY": 0,
                "style": {
                  "colors": "var(--neutral-90)",
                  "fontFamily": "sans-serif",
                  "fontSize": "12px"
                }
              },
              "type": "datetime",
              "crosshairs": {
                "show": true,
                "width": 1,
                "position": "back",
                "opacity": 0.9,
                "stroke": {
                  "color": "#b6b6b6",
                  "width": 1,
                  "dashArray": 0
                }
              }
            },
            "yaxis": {
              "axisBorder": {
                "show": false
              },
              "labels": {
                "formatter": "function(val) { return val == null ? '-' : val.toLocaleString(); }",
                "style": {
                  "colors": "var(--neutral-90)",
                  "fontFamily": "sans-serif",
                  "fontSize": "12px"
                },
                "minWidth": 48,
                "maxWidth": 48
              },
              "title": {
                "text": ""
              }
            },
            "colors": [
              "#008FFB",
              "#34C759",
              "#FFA726",
              "#FF4560",
              "#775DD0",
              "#1C4E80",
              "#008080",
              "#26C6DA",
              "#4F4F4F",
              "#6C757D"
            ],
            "noData": {
              "text": "No Data",
              "align": "center",
              "verticalAlign": "middle",
              "style": {
                "color": "#90A4AE",
                "fontSize": "14px"
              }
            }
          },
          "style": {
            "classes": "adhoc-trend-apex trend-chart",
            "overflow": "hidden",
            "height": "100%",
            "width": "100%",
            "minHeight": 0,
            "maxHeight": "none",
            "minWidth": 0,
            "marginBottom": "0px",
            "paddingBottom": "0px"
          },
          "series": []
        },
        "propConfig": {
          "props.series": {
            "binding": {
              "config": {
                "struct": {
                  "dataset": "{view.custom.dataset}",
                  "pens": "{view.custom.pens}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value is None:\n\t\treturn []\n\tdataset = getattr(value, \"dataset\", None)\n\tpens = getattr(value, \"pens\", None)\n\treturn shared.AdhocTrend.build_series(dataset, pens)\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct",
              "overlayOptOut": true
            }
          },
          "props.type": {
            "binding": {
              "config": {
                "path": "session.custom.AdhocTrend.chartType"
              },
              "type": "property"
            }
          },
          "props.options.tooltip.theme": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "type": "property"
            }
          },
          "props.options.chart.id": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "'adhoc-trend-' + coalesce({view.params.plotId}, 'p0')"
              }
            }
          },
          "props.options.stroke.curve": {
            "binding": {
              "config": {
                "path": "view.params.plotKind"
              },
              "transforms": [
                {
                  "expression": "if({value} = 'discrete', 'stepline', 'straight')",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.options.chart.height": {
            "binding": {
              "config": {
                "path": "view.params.chartHeight"
              },
              "transforms": [
                {
                  "code": "\ttry:\n\t\th = int(value)\n\texcept:\n\t\th = 400\n\tif h < 120:\n\t\th = 120\n\treturn h\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.style.height": {
            "binding": {
              "config": {
                "path": "view.params.chartHeight"
              },
              "transforms": [
                {
                  "code": "\ttry:\n\t\th = int(value)\n\texcept:\n\t\th = 400\n\tif h < 120:\n\t\th = 120\n\treturn str(h) + 'px'\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.options.colors": {
            "binding": {
              "config": {
                "path": "view.custom.pens"
              },
              "transforms": [
                {
                  "code": "\treturn shared.AdhocTrend.series_color_list(value)\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.options.chart.zoom.type": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(if(coalesce(try({session.custom.trendTools.dragMode}, 'time'), 'time') = 'area', 'area', if(coalesce(try({session.custom.trendTools.dragMode}, 'time'), 'time') = 'pan', 'pan', 'time')) = 'area', 'xy', 'x')"
              }
            }
          },
          "props.options.chart.zoom.autoScaleYaxis": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce(try({session.custom.trendTools.autoScaleY}, false), false)"
              }
            }
          },
          "meta.visible": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{this.props.options.chart.id} = 'adhoc-trend-' + coalesce({view.params.plotId}, 'p0')"
              }
            }
          },
          "props.options.xaxis.min": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce(try({session.custom.trendTools.zoomKind}, ''), '') = 'area' && coalesce(try({session.custom.trendTools.zoomSrc}, ''), '') = coalesce({view.params.plotId}, 'p0'), try({session.custom.trendTools.zoomHoldMin}, null), coalesce(try({session.custom.trendTools.zoomMin}, null), if(coalesce({view.custom.realTime}, false), toMillis(addHours(now(5000), -coalesce({view.custom.timeRange}, 1))), toMillis({view.custom.startDate}))))"
              }
            }
          },
          "props.options.xaxis.max": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(coalesce(try({session.custom.trendTools.zoomKind}, ''), '') = 'area' && coalesce(try({session.custom.trendTools.zoomSrc}, ''), '') = coalesce({view.params.plotId}, 'p0'), try({session.custom.trendTools.zoomHoldMax}, null), coalesce(try({session.custom.trendTools.zoomMax}, null), if(coalesce({view.custom.realTime}, false), toMillis(now(5000)), toMillis({view.custom.endDate}))))"
              }
            }
