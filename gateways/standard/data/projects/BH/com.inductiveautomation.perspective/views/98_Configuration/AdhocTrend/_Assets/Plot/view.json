{
  "custom": {
    "aggregate": "",
    "dataset": null,
    "endDate": null,
    "historicalDataset": null,
    "key": [],
    "pens": null,
    "pointCount": 120,
    "realTime": true,
    "realTimeDataset": null,
    "startDate": null,
    "timeRange": 1
  },
  "params": {
    "plotCount": 1,
    "plotId": "p0",
    "plotKind": "analog",
    "plotTitle": "Plot 1"
  },
  "propConfig": {
    "params.plotCount": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotKind": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotTitle": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.aggregate": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.aggregate"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.pointCount": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.pointCount"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.realTime": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.realtime"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.timeRange": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.timeRange"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.startDate": {
      "binding": {
        "config": {
          "struct": {
            "realTime": "{view.custom.realTime}",
            "startDate": "{session.custom.AdhocTrend.startDate}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['realTime'],\n\tdateArithmetic(now(1000), -if(isNull({session.custom.AdhocTrend.timeRange}) || {session.custom.AdhocTrend.timeRange}<=0, 1, {session.custom.AdhocTrend.timeRange}), 'hour'),\n\t{value}['startDate']\n)",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.endDate": {
      "binding": {
        "config": {
          "path": "session.custom.AdhocTrend.endDate"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.pens": {
      "binding": {
        "config": {
          "struct": {
            "cfg": "{session.custom.AdhocTrend}",
            "plotId": "{view.params.plotId}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value is None:\n\t\treturn shared.AdhocTrend.build_pens([], [])\n\tcfg = getattr(value, \"cfg\", None)\n\tplotId = getattr(value, \"plotId\", None)\n\tif cfg is None:\n\t\treturn shared.AdhocTrend.build_pens([], [])\n\ttags = shared.AdhocTrend._cfg_get(cfg, \"tags\", [])\n\tcolors = shared.AdhocTrend._cfg_get(cfg, \"colors\", shared.AdhocTrend.DEFAULT_COLORS)\n\tpenPlots = shared.AdhocTrend.plain_pen_plots(cfg)\n\tplots = shared.AdhocTrend.plain_plots(cfg)\n\tfirstId = plots[0][\"id\"] if plots else \"p0\"\n\tpens = shared.AdhocTrend.build_pens(tags, colors, penPlots, plots)\n\treturn shared.AdhocTrend.pens_for_plot(pens, penPlots, plotId, firstId)\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.key": {
      "binding": {
        "config": {
          "struct": {
            "aggregate": "{view.custom.aggregate}",
            "pens": "{view.custom.pens}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value is None:\n\t\treturn []\n\tpens = getattr(value, \"pens\", None)\n\taggregate = getattr(value, \"aggregate\", \"\") or \"\"\n\treturn shared.AdhocTrend.build_key(pens, aggregate)\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.realTimeDataset": {
      "binding": {
        "config": {
          "aggregate": "Average",
          "avoidScanClassValidation": true,
          "dateRange": {
            "mostRecent": "{view.custom.timeRange}",
            "mostRecentUnits": "HOUR"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "polling": {
            "enabled": true,
            "rate": "5"
          },
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "numRows": "{view.custom.pointCount}",
            "type": "FIXED"
          },
          "tags": "{view.custom.key}",
          "valueFormat": "DATASET"
        },
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.historicalDataset": {
      "binding": {
        "config": {
          "aggregate": "Average",
          "avoidScanClassValidation": true,
          "dateRange": {
            "endDate": "{view.custom.endDate}",
            "startDate": "{view.custom.startDate}"
          },
          "enableValueCache": true,
          "ignoreBadQuality": false,
          "preventInterpolation": false,
          "returnFormat": "Wide",
          "returnSize": {
            "numRows": "{view.custom.pointCount}",
            "type": "FIXED"
          },
          "tags": "{view.custom.key}",
          "valueFormat": "DATASET"
        },
        "type": "tag-history"
      },
      "persistent": true
    },
    "custom.dataset": {
      "binding": {
        "config": {
          "struct": {
            "historicalDataset": "{view.custom.historicalDataset}",
            "realTime": "{view.custom.realTime}",
            "realTimeDataset": "{view.custom.realTimeDataset}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['realTime'],\n\t{value}['realTimeDataset'],\n\t{value}['historicalDataset']\n)",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 480,
      "width": 800
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "adhoc-trend-plot-slot",
        "height": "100%",
        "width": "100%",
        "minHeight": 0,
        "flex": "1 1 0"
      }
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "28px",
          "shrink": 0,
          "grow": 0
        },
        "props": {
          "alignItems": "center",
          "justify": "space-between",
          "style": {
            "classes": "adhoc-trend-plot-header",
            "paddingLeft": "8px",
            "paddingRight": "8px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "Title"
            },
            "position": {
              "grow": 1
            },
            "props": {
              "style": {
                "classes": "font-label adhoc-trend-plot-title"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "view.params.plotTitle"
                  },
                  "type": "property"
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "RemovePlot"
            },
            "position": {
              "basis": "90px",
              "shrink": 0
            },
            "props": {
              "text": "Remove",
              "style": {
                "classes": "font-button adhoc-trend-action-btn adhoc-trend-action-btn-outline"
              }
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "path": "view.params.plotCount"
                  },
                  "transforms": [
                    {
                      "expression": "coalesce({value}, 1) > 1",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tfrom shared import Alerts\n\tcfg = self.session.custom.AdhocTrend\n\tok, msg = shared.AdhocTrend.remove_plot(cfg, self.view.params.plotId)\n\tif not ok:\n\t\tAlerts.showAlert(state=\"warning\", title=\"Cannot Remove Plot\", message=msg, showCloseBtn=True, btnTextPrimary=\"OK\", btnActionPrimary=\"closeAlert\")\n\telse:\n\t\tself.session.custom.AdhocTrend.plots = shared.AdhocTrend.plain_plots(cfg)\n"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            }
          }
        ]
      },
      {
        "type": "kyvislabs.display.apexchart",
        "meta": {
          "name": "apexchart"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0px"
        },
        "props": {
          "options": {
            "chart": {
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": true,
                "legendClick": false,
                "markerClick": true,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": false,
                "selection": false,
                "updated": false,
                "xAxisLabelClick": false,
                "zoomed": false
              },
              "fontFamily": "sans-serif",
              "height": "100%",
              "stacked": false,
              "toolbar": {
                "export": {
                  "csv": {
                    "categoryFormatter": "function (x) {return new Date(x)}",
                    "filename": "export"
                  }
                },
                "show": true
              },
              "type": "line",
              "zoom": {
                "autoScaleYaxis": false,
                "enabled": true,
                "type": "x"
              },
              "offsetY": -4,
              "id": "adhoc-trend-plot",
              "group": "adhoc-trend"
            },
            "dataLabels": {
              "enabled": false
            },
            "fill": {
              "opacity": 1
            },
            "grid": {
              "show": false,
              "padding": {
                "bottom": 56,
                "top": 10,
                "left": 10,
                "right": 10
              }
            },
            "legend": {
              "labels": {
                "colors": "#808080",
                "useSeriesColors": false
              },
              "position": "top",
              "show": false
            },
            "markers": {
              "size": 0
            },
            "stroke": {
              "curve": "straight",
              "width": 1.2
            },
            "tooltip": {
              "enabled": true,
              "style": {
                "fontFamily": "sans-serif",
                "fontSize": "12px"
              },
              "x": {
                "format": "dd MMM yyyy HH:mm:ss",
                "show": true
              }
            },
            "xaxis": {
              "axisBorder": {
                "offsetY": 5,
                "show": true
              },
              "labels": {
                "datetimeFormatter": {
                  "day": "dd MMM",
                  "hour": "HH:mm",
                  "month": "MMM yy",
                  "year": "yyyy"
                },
                "datetimeUTC": false,
                "style": {
                  "colors": "var(--neutral-90)",
                  "fontFamily": "sans-serif",
                  "fontSize": "12px"
                }
              },
              "type": "datetime"
            },
            "yaxis": {
              "axisBorder": {
                "show": false
              },
              "labels": {
                "formatter": "function(val) { return val.toLocaleString(); }",
                "style": {
                  "colors": "var(--neutral-90)",
                  "fontFamily": "sans-serif",
                  "fontSize": "12px"
                }
              },
              "title": {
                "text": ""
              }
            }
          },
          "style": {
            "classes": "adhoc-trend-apex",
            "overflow": "visible",
            "height": "100%",
            "width": "100%",
            "minHeight": 0
          }
        },
        "propConfig": {
          "props.series": {
            "binding": {
              "config": {
                "struct": {
                  "dataset": "{view.custom.dataset}",
                  "pens": "{view.custom.pens}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tif value is None:\n\t\treturn []\n\tdataset = getattr(value, \"dataset\", None)\n\tpens = getattr(value, \"pens\", None)\n\treturn shared.AdhocTrend.build_series(dataset, pens)\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.type": {
            "binding": {
              "config": {
                "path": "session.custom.AdhocTrend.chartType"
              },
              "type": "property"
            }
          },
          "props.options.tooltip.theme": {
            "binding": {
              "config": {
                "path": "session.props.theme"
              },
              "type": "property"
            }
          },
          "props.options.chart.id": {
            "binding": {
              "config": {
                "path": "view.params.plotId"
              },
              "transforms": [
                {
                  "code": "\treturn 'adhoc-trend-' + str(value or 'p0')\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.options.stroke.curve": {
            "binding": {
              "config": {
                "path": "view.params.plotKind"
              },
              "transforms": [
                {
                  "expression": "if({value} = 'discrete', 'stepline', 'straight')",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        }
      }
    ]
  }
}
