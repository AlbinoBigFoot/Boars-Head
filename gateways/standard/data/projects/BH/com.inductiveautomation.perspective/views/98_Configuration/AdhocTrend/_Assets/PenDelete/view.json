              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Button"
        },
        "position": {
          "basis": "120px",
          "grow": 1
        },
        "props": {
          "image": {
            "height": 20,
            "width": 20
          },
