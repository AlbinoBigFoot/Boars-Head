    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "paddingBottom": "4%",
        "paddingLeft": "2%",
        "paddingRight": "2%",
        "paddingTop": "4%"
      }
    },
    "type": "ia.container.flex"
  }
