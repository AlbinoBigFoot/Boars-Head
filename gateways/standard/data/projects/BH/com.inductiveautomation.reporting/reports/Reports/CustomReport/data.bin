<objects framework.version="8.3.7">
<o cls="com.inductiveautomation.reporting.common.resource.ReportResource"><o-c m="setDataConfig" s="1;com.inductiveautomation.reporting.common.resource.ReportDataConfiguration"><o cls="com.inductiveautomation.reporting.common.resource.ReportDataConfiguration"><o-c m="setDatasources" s="1;java.util.List"><arraylist len="1"><o cls="com.inductiveautomation.reporting.common.resource.DataSourceConfig"><o-c m="setConfigObject" s="1;java.io.Serializable"><o cls="com.inductiveautomation.reporting.common.data.ScriptReportDataObject"><o-c m="setName" s="1;java.lang.String"><str>reportData</str></o-c><o-c m="setScript" s="1;java.lang.String"><str>	# Custom report (shared.Reports): the run result arrives as JSON in the 'payload' parameter, already
	# permission-checked by shared.Reports.output; this turns it into nested QueryResults for the layout.
	shared.Reports.reportData(data)
</str></o-c></o></o-c><o-c m="setDataSourceId" s="1;java.lang.String"><str>com.ia.reporting.script-data-type</str></o-c></o></arraylist></o-c><o-c m="setParameters" s="1;java.util.List"><arraylist len="1"><o cls="com.inductiveautomation.reporting.common.resource.ReportParameter"><o-c m="setDefaultValue" s="1;java.lang.String"><str>{}</str></o-c><o-c m="setName" s="1;java.lang.String"><str>payload</str></o-c><o-c m="setType" s="1;java.lang.Class"><class>java.lang.String</class></o-c></o></arraylist></o-c></o></o-c><o-c m="setDescription" s="1;java.lang.String"><str>Generic custom report (Production KPIs, Alarms, any source in the shared.Reports catalog). Parameter payload = JSON from shared.Reports.run; built by .cursor/tasks/report-builder.</str></o-c><o-c m="setTemplate" s="1;com.inductiveautomation.reporting.common.resource.PageTemplate"><o cls="com.inductiveautomation.reporting.common.resource.PageTemplate"><o-c m="setSerializedRMDocument" s="1;java.lang.String"><str></str></o-c></o></o-c><o-c m="setTitle" s="1;java.lang.String"><str>Custom Report</str></o-c></o>
</objects>
