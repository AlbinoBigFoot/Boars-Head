{
  "custom": {
    "marginRight": "0%",
    "multistates": "",
    "quality": "Bad_NotFound(\"Path '[default]value.quality' not found.\")",
    "tagPath": "",
    "textAlign": "center",
    "value": ""
  },
  "params": {
    "value": ""
  },
  "propConfig": {
    "custom.marginRight": {
      "persistent": true
    },
    "custom.multistates": {
      "binding": {
        "config": {
          "expression": "if({view.custom.tagPath} = '',\r\n\t'',\r\n\tif(!isBad(tag({view.custom.tagPath} + '/Value.Metadata')),\r\n\t\tif(isNull(tag({view.custom.tagPath} + '/Value.Metadata')['states']),\r\n\t\t\t'',\r\n\t\t\ttag({view.custom.tagPath} + '/Value.Metadata')['states']),\r\n\t\tif(!isBad(tag({view.custom.tagPath} + '/Metadata')),\r\n\t\t\tif(isNull(jsonGet(tag({view.custom.tagPath} + '/Metadata'), 'states')),\r\n\t\t\t\t'',\r\n\t\t\t\tjsonGet(tag({view.custom.tagPath} + '/Metadata'), 'states')),\r\n\t\t\t'')))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.Quality"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t\"\",\r\n\t{value}\r\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.textAlign": {
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.value"
        },
        "transforms": [
          {
            "expression": "forceQuality(if(isNull({value}),'',{value}))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 100
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Markdown"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.source": {
            "binding": {
              "config": {
                "struct": {
                  "multistates": "{view.custom.multistates}",
                  "value": "{view.custom.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tfrom shared import Utilities\n\tresult = Utilities.getLabelValue(value.value, value.multistates)\n\tif result in (None, '') and value.value not in (None, ''):\n\t\ttry:\n\t\t\tv = int(value.value)\n\t\t\tfallback = {0: 'Off', 1: 'Cooling', 2: 'Defrost', 3: 'Fault', 4: 'Manual', 5: 'Idle'}\n\t\t\tresult = fallback.get(v, str(value.value))\n\t\texcept:\n\t\t\tresult = str(value.value)\n\treturn (result if result is not None else '') + \"&nbsp;\"",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "view.custom.quality"
              },
              "transforms": [
                {
                  "expression": "if({value} = \"Good\",\r\n\t'font-livedata',\r\n\t'font-baddata'\r\n\t)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.style.marginRight": {
            "binding": {
              "config": {
                "path": "view.custom.marginRight"
              },
              "type": "property"
            }
          },
          "props.style.textAlign": {
            "binding": {
              "config": {
                "path": "view.custom.textAlign"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "overflow": "hidden"
          }
        },
        "type": "ia.display.markdown"
      }
    ],
    "events": {
      "dom": {
        "onContextMenu": {
          "config": {
            "draggable": false,
            "id": "ContextMenu",
            "modal": false,
            "overlayDismiss": false,
            "position": {
              "relativeLocation": "bottom-right"
            },
            "positionType": "relative",
            "resizable": false,
            "showCloseIcon": false,
            "type": "toggle",
            "viewParams": {
              "discrete": "true",
              "tagPath": "{view.custom.tagPath}"
            },
            "viewPath": "01_Popups/00_Faceplates/Alerts/ContextMenu",
            "viewportBound": true
          },
          "preventDefault": true,
          "scope": "C",
          "stopPropagation": true,
          "type": "popup"
        }
      }
    },
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "meta.visible": {
        "binding": {
          "config": {
            "path": "view.params.value"
          },
          "transforms": [
            {
              "expression": "{value} != ''",
              "type": "expression"
            }
          ],
          "type": "property"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "props": {
      "alignContent": "center",
      "style": {
        "cursor": "pointer",
        "minHeight": 20,
        "overflow": "hidden"
      },
      "wrap": "wrap"
    },
    "type": "ia.container.flex",
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
