/* Direct stylesheet authoring is an advanced feature. Knowledge of CSS required.
 *
 * PROJECT RULE — CSS is the only styling system for BH Perspective.
 * Do NOT create or extend Designer Style Classes (Styles → Colors / Container / Fonts).
 * Put fonts, colors, motion, and theme tokens here. Bind views with simple class names
 * (e.g. fan-spin, alarm-flash). Perspective prefixes them as .psc-* automatically.
 *
 * Refrigeration status — ISA-101 / High Performance HMI aligned
 * -------------------------------------------------------------------------------
 * - Normal process states use grayscale (color reserved for attention/abnormal)
 * - Tokens live on :root so faceplates/icons can reuse them
 * - Never rely on color alone: pair with text (button label includes status code)
 *
 * Apply classes:  Refridgeration_STS sts-<TOKEN>
 * Tokens (uppercase): COOLING | DEFROST | FAULT | MANUAL | IDLE | OFF | UNKNOWN
 *
 * Refs: ISA-101, Rockwell Process HMI Style Guide, ScoutMotors stylesheet patterns
 */

:root {
	/* Alarm / attention (saturated — use sparingly) */
	--sts-fault: #c62828;
	--sts-defrost: #ef6c00;
	--sts-manual: #9c27b0;

	/* Alarm Status Table / icon priority palette (match equipment/alarm_* icons) */
	--alarm-critical: #e22028;
	--alarm-high: #ec8629;
	--alarm-medium: #f5e11b;
	--alarm-low: #916aad;
	/* Active + acknowledged — darker versions of the same hues */
	--alarm-critical-ack: #8b1519;
	--alarm-high-ack: #9a5619;
	--alarm-medium-ack: #9e9012;
	--alarm-low-ack: #5a3f6c;
	--alarm-row-fg-light: #ffffff;
	--alarm-row-fg-dark: #212121;

	/* Normal / grayscale (Scout-like device fills) */
	--sts-cooling-bg: #eceff1;
	--sts-cooling-fg: #212121;
	--sts-idle-bg: #90a4ae;
	--sts-idle-fg: #212121;
	--sts-off-bg: #546e7a;
	--sts-off-fg: #eceff1;
	--sts-unknown-bg: #607d8b;
	--sts-unknown-fg: #ffffff;

	--sts-border: rgba(0, 0, 0, 0.35);
	--sts-accent-width: 4px;
}

/* Base marker class for refrigeration status chips */
.psc-Refridgeration_STS {
	border: 1px solid var(--sts-border) !important;
	border-radius: 4px;
	font-weight: 700;
	background-color: var(--sts-unknown-bg);
	color: var(--sts-unknown-fg);
	box-shadow: none;
}

/* --- Normal: Cooling (running as expected) — light gray, not green/blue --- */
.psc-Refridgeration_STS.psc-sts-COOLING {
	background-color: var(--sts-cooling-bg);
	color: var(--sts-cooling-fg);
}

/* --- Normal: Idle / standby — mid gray --- */
.psc-Refridgeration_STS.psc-sts-IDLE {
	background-color: var(--sts-idle-bg);
	color: var(--sts-idle-fg);
}

/* --- Normal: Off / stopped — darker gray --- */
.psc-Refridgeration_STS.psc-sts-OFF {
	background-color: var(--sts-off-bg);
	color: var(--sts-off-fg);
}

/* --- Attention: Defrost (expected mode, still warrants notice) — amber + left accent --- */
.psc-Refridgeration_STS.psc-sts-DEFROST {
	background-color: var(--sts-defrost);
	color: #ffffff;
	border-left: var(--sts-accent-width) solid #bf360c !important;
}

/* --- Abnormal: Fault / alarm — red + left accent --- */
.psc-Refridgeration_STS.psc-sts-FAULT {
	background-color: var(--sts-fault);
	color: #ffffff;
	border-left: var(--sts-accent-width) solid #7f0000 !important;
}

/* --- Abnormal: Manual / override — magenta (ISA-101 operator-intervention convention) + accent --- */
.psc-Refridgeration_STS.psc-sts-MANUAL {
	background-color: var(--sts-manual);
	color: #ffffff;
	border-left: var(--sts-accent-width) solid #4a148c !important;
}

/* --- Fallback --- */
.psc-Refridgeration_STS.psc-sts-UNKNOWN {
	background-color: var(--sts-unknown-bg);
	color: var(--sts-unknown-fg);
	border-style: dashed !important;
}

/* --- Evaporator overview fan: counter-clockwise spin when Cooling/Running --- */
@keyframes fan-spin-ccw {
	from {
		transform: rotate(0deg);
	}
	to {
		transform: rotate(-360deg);
	}
}

.psc-fan-spin {
	transform-origin: center center !important;
	animation: fan-spin-ccw 1.25s linear infinite;
}

/* --- Alarm badge blink (1 Hz) when active AND unacknowledged --- */
@keyframes alarm-flash {
	0%,
	49% {
		opacity: 1;
	}
	50%,
	100% {
		opacity: 0;
	}
}

.psc-alarm-flash {
	animation: alarm-flash 1s steps(1, end) infinite;
}


/* =============================================================================
 * Migrated from Designer Style Classes (Colors / Container / Fonts)
 * Bind with these simple names — Perspective applies them as .psc-<name>
 * ============================================================================= */

/* --- Background / color utility --- */
.psc-bg-page {
	background-color: var(--neutral-10);
}
.psc-bg-baddata {
	background-color: var(--neutral-60);
}
.psc-bg-component {
	background-color: var(--neutral-20);
}
.psc-bg-container {
	background-color: var(--neutral-30);
}
.psc-bg-disabled {
	background-color: var(--neutral-40);
}
.psc-bg-header {
	background-color: var(--neutral-30);
}
.psc-color-icon {
	color: var(--neutral-90);
}
.psc-color-icon-disabled {
	color: var(--neutral-40);
}

/* --- Container chrome --- */
.psc-container-button {
	background-color: var(--neutral-60);
	border-style: none;
	box-shadow: var(--boxShadow1);
}
.psc-container-button:hover {
	background-color: var(--neutral-50);
}
.psc-container-button:active {
	color: var(--neutral-30);
}

.psc-container-card {
	border: 1px solid var(--neutral-30);
	border-radius: 0.5rem;
	box-shadow: var(--boxShadow1);
	margin: 2px;
	outline-style: none;
}

.psc-container-card-border {
	border: 1px solid var(--neutral-50);
	border-radius: 0.5rem;
	margin: 2px;
}

@keyframes container-fade-in {
	from {
		opacity: 0;
	}
	to {
		opacity: 1;
	}
}
.psc-container-fade-in {
	animation: container-fade-in 1s 1s normal 1;
}

.psc-container-header {
	border-bottom: 1px solid var(--neutral-30);
}

.psc-container-icon:hover {
	background-color: var(--neutral-50);
	border-style: none;
	border-radius: var(--borderRadius);
	box-shadow: var(--boxShadow1);
}

.psc-container-item {
	padding-left: 2px;
	padding-right: 2px;
}

.psc-container-item-border {
	border-bottom: 1px solid var(--neutral-30);
}

/* --- Typography --- */
.psc-font-baddata {
	color: var(--neutral-60);
	font-family: sans-serif;
	font-size: 0.9em;
	font-style: italic;
	font-weight: 500;
}
.psc-font-button {
	color: var(--neutral-10);
	font-family: sans-serif;
	font-size: 0.8rem;
	font-weight: normal;
}
.psc-font-header {
	color: var(--neutral-80);
	font-family: sans-serif;
	font-size: 0.9rem;
	font-weight: 500;
	text-indent: 2px;
}
.psc-font-label {
	color: var(--neutral-90);
	font-family: sans-serif;
	font-size: 0.8rem;
	font-weight: 500;
	text-indent: 2px;
}
.psc-font-livedata {
	color: var(--callToAction);
	font-family: sans-serif;
	font-size: 0.9rem;
	font-weight: 500;
}
.psc-font-livedata-entry {
	color: var(--qual-7);
	font-family: Roboto-Mono, monospace;
	font-size: 0.85rem;
	font-weight: bold;
}
.psc-font-title {
	color: var(--neutral-80);
	font-family: sans-serif;
	font-size: 1rem;
	font-weight: 400;
	text-indent: 2px;
}
.psc-font-value {
	color: var(--neutral-100);
	font-family: sans-serif;
	font-size: 0.8rem;
	font-weight: normal;
}

/* =============================================================================
 * Alarm Status Table row fills
 * Bind via rowStyles.*.priorities.*.classes (e.g. alarm-row-critical)
 * Unack = full icon color; Ack = darker variant
 * ============================================================================= */

.psc-alarm-row-critical {
	background-color: var(--alarm-critical) !important;
	color: var(--alarm-row-fg-light) !important;
}
.psc-alarm-row-critical-ack {
	background-color: var(--alarm-critical-ack) !important;
	color: var(--alarm-row-fg-light) !important;
}

.psc-alarm-row-high {
	background-color: var(--alarm-high) !important;
	color: var(--alarm-row-fg-light) !important;
}
.psc-alarm-row-high-ack {
	background-color: var(--alarm-high-ack) !important;
	color: var(--alarm-row-fg-light) !important;
}

.psc-alarm-row-medium {
	background-color: var(--alarm-medium) !important;
	color: var(--alarm-row-fg-dark) !important;
}
.psc-alarm-row-medium-ack {
	background-color: var(--alarm-medium-ack) !important;
	color: var(--alarm-row-fg-light) !important;
}

.psc-alarm-row-low {
	background-color: var(--alarm-low) !important;
	color: var(--alarm-row-fg-light) !important;
}
.psc-alarm-row-low-ack {
	background-color: var(--alarm-low-ack) !important;
	color: var(--alarm-row-fg-light) !important;
}

.psc-alarm-row-cleared {
	background-color: var(--neutral-20, #eceff1) !important;
	color: var(--neutral-90, #424242) !important;
}
