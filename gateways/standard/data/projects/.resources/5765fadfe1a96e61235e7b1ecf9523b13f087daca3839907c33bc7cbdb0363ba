{
  "custom": {},
  "params": {
    "row": "",
    "rowData": "",
    "value": true
  },
  "propConfig": {
    "params.row": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.rowData": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 30
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.sendMessage(\u0027AdhocTrendDisableRow\u0027,payload\u003d{\u0027row\u0027:self.view.params.row,\u0027penName\u0027:self.view.params.rowData.penName},scope\u003d\"page\")\n\t"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "persistent": true
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.value"
              },
              "transforms": [
                {
                  "expression": "if({value},\r\n\t\u0027material/check_box\u0027,\r\n\t\u0027material/check_box_outline_blank\u0027\r\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Colors/Icon",
            "cursor": "pointer"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "type": "ia.container.flex"
  }
}