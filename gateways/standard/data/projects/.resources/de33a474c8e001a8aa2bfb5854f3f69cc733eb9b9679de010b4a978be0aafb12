                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "State"
                    },
                    "propConfig": {
                      "props.text": {
                        "binding": {
                          "config": {
                            "expression": "if({view.params.tagPath} = '', '\u2014',\n\tif(coalesce(tag({view.params.tagPath} + '/Failed/Value'), false),\n\t\t'ACTIVE', 'OK'))"
                          },
                          "type": "expr"
