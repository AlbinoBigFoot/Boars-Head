                      "type": "script"
                    }
                  }
                },
                "propConfig": {
                  "props.enabled": {
                    "binding": {
                      "config": {
                        "expression": "!{session.custom.ReadOnly} && coalesce(tag({view.params.tagPath} + '/OPER/Value'), false)"
