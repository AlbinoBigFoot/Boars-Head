                          "config": {
                            "expression": "if({view.params.tagPath} = '', 'faceplate-fault-state',\n\tif(coalesce(tag({view.params.tagPath} + '/Failed/Value'), false),\n\t\t'faceplate-fault-state faceplate-fault-active',\n\t\t'faceplate-fault-state faceplate-fault-ok'))"
                          },
                          "type": "expr"
                        }
                      }
                    },
                    "props": {
                      "text": "OK",
                      "style": {
                        "classes": "faceplate-fault-state faceplate-fault-ok"
                      }
                    }
