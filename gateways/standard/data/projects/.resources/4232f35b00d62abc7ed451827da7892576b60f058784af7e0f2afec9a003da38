{
  "custom": {
    "tags": [
      "[Blythe]00700/HW/HWP001/VFD/MAN_DSBL",
      "[Blythe]00700/HW/HWP001/VFD/RT",
      "[Blythe]00700/HW/HWP001/VFD/STRT_NUM",
      "[Blythe]00700/HW/HWP001/VFD/YAR_RST"
    ]
  },
  "params": {
    "hiddenTags": "",
    "tagPath": ""
  },
  "propConfig": {
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "hiddenTags": "{view.params.hiddenTags}",
            "tagPath": "{view.params.tagPath}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\thiddenTagsInput = value.get('hiddenTags', '')\n\thidden_set = set()\n\ttry:\n\t\ttext = str(hiddenTagsInput or '')\n\t\tif text:\n\t\t\ttext = text.replace(';', ',')\n\t\t\tfor item in text.split(','):\n\t\t\t\titem = item.strip()\n\t\t\t\tif item:\n\t\t\t\t\thidden_set.add(item)\n\texcept Exception:\n\t\tpass\n\t\n\tdef isHidden(fullPath):\n\t\tif not hidden_set:\n\t\t\treturn False\n\t\tstripped = fullPath.split(']', 1)[-1] if ']' in fullPath else fullPath\n\t\tnorm = stripped.replace(chr(92), '/')\n\t\tif fullPath in hidden_set or stripped in hidden_set or norm in hidden_set:\n\t\t\treturn True\n\t\tnorm_slash = '/' + norm.strip('/') + '/'\n\t\tfor h in hidden_set:\n\t\t\thh = str(h).replace(chr(92), '/')\n\t\t\tif hh.endswith('/'):\n\t\t\t\tseg = hh.strip('/')\n\t\t\t\tif not seg:\n\t\t\t\t\tcontinue\n\t\t\t\tif ('/' + seg + '/') in norm_slash:\n\t\t\t\t\treturn True\n\t\t\t\tif norm.strip('/') == seg or norm.strip('/').startswith(seg + '/'):\n\t\t\t\t\treturn True\n\t\t\telse:\n\t\t\t\tif norm.endswith('/' + hh) or norm.split('/')[-1] == hh:\n\t\t\t\t\treturn True\n\t\treturn False\n\t\n\tconfig_tags = []\n\ttry:\n\t\tresults = system.tag.browse(path=value['tagPath'], filter={'recursive': True}).getResults()\n\texcept:\n\t\treturn []\n\tcandidates = [str(t['fullPath']) for t in results if str(t['tagType']) == 'AtomicTag' and not isHidden(str(t['fullPath']))]\n\tif not candidates:\n\t\treturn []\n\t# Config option = WRITABLE (.readOnly False) AND NOT alarmed (.AlarmEvalEnabled not True).\n\t# Alarmed tags belong on the Alarm Configuration tab.\n\tro = system.tag.readBlocking([p + '.readOnly' for p in candidates])\n\tae = system.tag.readBlocking([p + '.AlarmEvalEnabled' for p in candidates])\n\ten = system.tag.readBlocking([p + '.Enabled' for p in candidates])\n\tfor path, r, a, e in zip(candidates, ro, ae, en):\n\t\tif e.value == True and r.value == False and a.value != True:\n\t\t\tconfig_tags.append(path)\n\treturn config_tags",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.hiddenTags": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 300,
      "width": 400
    }
  },
  "root": {
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "EmptyState"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "len({view.custom.tags}) = 0"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "text": "No writable configuration tags for this device.",
          "style": {
            "classes": "font-label faceplate-config-empty",
            "padding": "12px",
            "color": "var(--text-muted)"
          }
        }
      },
      {
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "basis": "348px"
        },
        "propConfig": {
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "tags": "{view.custom.tags}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tinstances = []\n\tfor tag in value['tags']:\n\t\ttagPath = tag\n\t\tinstance = {\n\t\t\t\t\t\"instanceStyle\": {\n\t\t\t\t\t\t\"classes\":\"\"\n\t\t\t\t\t},\n\t\t\t\t\t\"instancePosition\": {},\n\t\t\t\t\t\"highlightRow\": len(instances) % 2 == 1,  # True for odd indices (every other row)\n\t\t\t\t\t\"tagPath\": tag\n\t\t\t\t\t}\n\t\tinstances.append(instance)\n\treturn instances",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "expression": "len({view.custom.tags}) > 0"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "grow": 0
          },
          "path": "01_Popups/00_Faceplates/_Assets/Configuration/ConfigurationRow",
          "style": {
            "background": "var(--neutral-40)",
            "overflow": "visible"
          },
          "useDefaultViewWidth": false
        },
        "type": "ia.display.flex-repeater"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "overflowX": "hidden",
        "classes": "faceplate-section"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
