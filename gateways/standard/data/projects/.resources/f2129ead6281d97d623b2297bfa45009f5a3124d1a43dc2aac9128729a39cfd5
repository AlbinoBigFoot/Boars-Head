        "transforms": [
          {
            "code": "\trows = []\n\theaders = [\"penEnabled\", \"tagPath\", \"penName\", \"alias\", \"engUnit\", \"penColor\", \"penAction\"]\n\tif value is None:\n\t\treturn system.dataset.toDataSet(headers, rows)\n\ttags = value.tags if hasattr(value, \"tags\") else None\n\tcolors = value.colors if hasattr(value, \"colors\") else None\n\tif tags is None or colors is None:\n\t\treturn system.dataset.toDataSet(headers, rows)\n\n\tdef _as_dict(obj):\n\t\tif obj in (None, \"\"):\n\t\t\treturn {}\n\t\ttry:\n\t\t\treturn dict(obj)\n\t\texcept:\n\t\t\ttry:\n\t\t\t\treturn {\n\t\t\t\t\t\"longDescription\": getattr(obj, \"longDescription\", None),\n\t\t\t\t\t\"shortDescription\": getattr(obj, \"shortDescription\", None),\n\t\t\t\t}\n\t\t\texcept:\n\t\t\t\treturn {}\n\n\tdef _pen_name(tag, name_val):\n\t\tmeta = {}\n\t\ttry:\n\t\t\treads = system.tag.readBlocking([tag + \"/Metadata\", tag + \"/Value.Metadata\", tag + \".Metadata\"])\n\t\t\tfor qv in reads:\n\t\t\t\tif qv.value not in (None, \"\"):\n\t\t\t\t\tmeta = _as_dict(qv.value)\n\t\t\t\t\tif meta:\n\t\t\t\t\t\tbreak\n\t\texcept:\n\t\t\tmeta = {}\n\t\treturn meta.get(\"longDescription\") or meta.get(\"shortDescription\") or name_val\n\n\tif len(tags) > 0 and len(colors) > 0:\n\t\tfor i, tag in enumerate(tags):\n\t\t\tif tag != \"\":\n\t\t\t\ttag = str(tag)\n\t\t\t\t# Avoid .../Value/Value when session tags already include /Value\n\t\t\t\thistPath = tag if tag.endswith(\"/Value\") else (tag + \"/Value\")\n\t\t\t\tbase = tag[:-6] if tag.endswith(\"/Value\") else tag\n\t\t\t\tread = system.tag.readBlocking([base + \".Name\", histPath + \".EngUnit\", tag + \".Name\"])\n\t\t\t\tname_val = read[0].value\n\t\t\t\tif name_val in (None, \"\"):\n\t\t\t\t\tname_val = read[2].value\n\t\t\t\tif name_val in (None, \"\"):\n\t\t\t\t\tname_val = base.split(\"/\")[-1] if \"/\" in base else base\n\t\t\t\tpenName = _pen_name(base, name_val)\n\t\t\t\talias = base.split(\"]\")[1].replace(\"/\", \"-\") if len(base.split(\"]\")) > 1 else str(base).replace(\"/\", \"-\")\n\t\t\t\talias = alias.replace(\" \", \"_\")\n\t\t\t\tengUnit = read[1].value if read[1].value not in (None, \"\") else \"\"\n\t\t\t\tpenColor = colors[i] if i < len(colors) else colors[0]\n\t\t\t\trows.append([True, histPath, penName, alias, engUnit, penColor, \"\"])\n\treturn system.dataset.toDataSet(headers, rows)\n",
            "type": "script"
          }
