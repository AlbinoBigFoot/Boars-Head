  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "try(\n    if(\n        isNull({view.custom.metadata.shortDescription}) ||\n        {view.custom.metadata.shortDescription} = '',\n        if({view.params.tagPath} = '',\n           '',\n           subString({view.params.tagPath}, lastIndexOf({view.params.tagPath}, '/') + 1)),\n        {view.custom.metadata.shortDescription}\n    ),\n'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "expression": "if(\n\t{view.params.tagPath}!='' && isGood(tag({view.params.tagPath} + '.Metadata')),\n\ttag({view.params.tagPath} + '.Metadata'),\n\t'')"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.values": {
      "persistent": true
    },
    "custom.values.status": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/Status/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.analog": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'',\n\t{view.params.tagPath} + '/Temp/Value')"
        },
        "type": "expr"
      }
    },
    "custom.values.running": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || isBad(tag({view.params.tagPath} + '/Status/Value')),\n\tfalse,\n\ttag({view.params.tagPath} + '/Status/Value') = 1)"
        },
        "type": "expr"
      }
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.values.commLoss": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\tfalse,\n\tisBad(tag({view.params.tagPath} + '/Status/Value')))"
        },
        "type": "expr"
      }
    },
    "custom.alarm.active": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || isBad(tag({view.params.tagPath} + '/_Alarms/_Active')),\n\tfalse,\n\ttag({view.params.tagPath} + '/_Alarms/_Active'))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.alarm.unack": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || isBad(tag({view.params.tagPath} + '/_Alarms/_Unack')),\n\tfalse,\n\ttag({view.params.tagPath} + '/_Alarms/_Unack'))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.alarm.priority": {
