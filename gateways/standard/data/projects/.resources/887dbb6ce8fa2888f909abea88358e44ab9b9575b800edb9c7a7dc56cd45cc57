{
  "custom": {
    "edit": false,
    "editTimeout": {
      "durationInSecs": 15
    },
    "metadata": ""
  },
  "params": {
    "Basis": {
      "eu": "",
      "input": "",
      "label": ""
    },
    "faceplate": "",
    "label": "",
    "permission": true,
    "tagPath": ""
  },
  "propConfig": {
    "custom.editTimeout": {
      "persistent": true
    },
    "custom.editTimeout.end": {
      "binding": {
        "config": {
          "struct": {
            "edit": "{view.custom.edit}",
            "now": "{view.custom.editTimeout.now}",
            "stop": "{view.custom.editTimeout.stop}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['stop'] != '' && {value}['edit'],\n\t{value}['now'] > {value}['stop'],\n\tFalse\n\t)",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\tself.custom.edit = False"
      }
    },
    "custom.editTimeout.now": {
      "binding": {
        "config": {
          "expression": "now()"
        },
        "type": "expr"
      }
    },
    "custom.editTimeout.start": {
      "binding": {
        "config": {
          "path": "view.custom.edit"
        },
        "transforms": [
          {
            "expression": "if({value},now(0),'')",
            "type": "expression"
          }
        ],
        "type": "property"
      }
    },
    "custom.editTimeout.stop": {
      "binding": {
        "config": {
          "struct": {
            "duration": "{view.custom.editTimeout.durationInSecs}",
            "start": "{view.custom.editTimeout.start}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "expression": "if({value}['start'] != '' && {value}['duration'] != '' && {value}['duration'] > 0,\ndateArithmetic({value}['start'] , {value}['duration'], \"seconds\"),\n'')",
            "type": "expression"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}.Metadata"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t\"\",\n\t{value}\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.Basis": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.faceplate": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.permission": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 28,
      "width": 372
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "!({view.params.label} = 'Null' || {view.params.label} = null)"
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "metadata": "{view.custom.metadata}",
                  "tagName": "{view.params.tagPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "expression": "if({value}['metadata'] != '',\n\tif({value}['metadata']['shortDescription'] != \"\",\n\t   {value}['metadata']['shortDescription'],\n\t   if({value}['tagName'] != \"\",\n\t\t  {value}['tagName'],\n\t\t  \"\"\n\t\t )\n\t),\n\t{value}['tagName']\n)",
                  "type": "expression"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label"
          }
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\ttagPath = self.view.params.tagPath\n\tvalue = self.props.value\n\tself.view.custom.edit = False\n\tif session.custom.ReadOnly:\n\t\treturn\n\tif value is None or not system.tag.exists(tagPath):\n\t\treturn\n\tsystem.tag.writeBlocking([tagPath], [value])"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "StateSelect"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.enabled": {
            "binding": {
              "config": {
                "expression": "{view.custom.edit} && {view.params.permission} && !{session.custom.ReadOnly}"
              },
              "type": "expr"
            }
          },
          "props.options": {
            "binding": {
              "config": {
                "struct": {
                  "metadata": "{view.custom.metadata}",
                  "tagPath": "{view.params.tagPath}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tmd = value.get('metadata')\n\tstates = None\n\tif md and isinstance(md, dict):\n\t\tstates = md.get('states')\n\tif states:\n\t\tout = []\n\t\tfor s in states:\n\t\t\tout.append({\n\t\t\t\t'label': s.get('label', str(s.get('value'))),\n\t\t\t\t'value': s.get('value')\n\t\t\t})\n\t\treturn out\n\ttry:\n\t\tdt = str(system.tag.readBlocking([value['tagPath'] + '.DataType'])[0].value)\n\texcept:\n\t\tdt = ''\n\tif dt == 'Boolean':\n\t\treturn [\n\t\t\t{'label': 'Off', 'value': False},\n\t\t\t{'label': 'On', 'value': True}\n\t\t]\n\treturn [{'label': '0', 'value': 0}, {'label': '1', 'value': 1}]",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagPath": "{view.params.tagPath}"
                },
                "tagPath": "{tagPath}"
              },
              "type": "tag"
            }
          }
        },
        "props": {
          "dropdownOptionStyle": {
            "classes": "font-label"
          },
          "placeholder": {
            "text": "Select"
          },
          "style": {
            "backgroundColor": "#FAFAFA",
            "borderBottomLeftRadius": 4,
            "borderBottomRightRadius": 4,
            "borderColor": "#5E5E5E",
            "borderTopLeftRadius": 4,
            "borderTopRightRadius": 4,
            "borderWidth": 1,
            "font-size": "10px",
            "fontFamily": "monospace",
            "height": "25px",
            "marginRight": "4px",
            "width": "130px"
          }
        },
        "type": "ia.input.dropdown"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif self.view.params.permission and not session.custom.ReadOnly:\n\t\tif self.view.custom.edit:\n\t\t\tself.view.custom.edit = False\n\t\telse:\n\t\t\tself.view.custom.edit = True"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "EditIcon"
        },
        "position": {
          "basis": "20px"
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.params.permission} && !{session.custom.ReadOnly},\n   'font-value',\n   'font-label')"
              },
              "type": "expr"
            }
          },
          "props.style.cursor": {
            "binding": {
              "config": {
                "expression": "if({view.params.permission} && !{session.custom.ReadOnly},\n   'pointer',\n   'not-allowed')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "material/edit"
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "overflow": "visible"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "{view.params.tagPath}"
            },
            "waitOnAll": false
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = 'No TagPath: ' + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t{\n\t\t\t\"text\": \"Ticket Logger\",\n\t\t\t\"icon\": {\n\t\t\t\t\"path\": \"material/info\",\n\t\t\t\t\"color\": \"--neutral-80\",\n\t\t\t\t\"style\": {}\n\t\t\t},\n\t\t\t\"style\": {\n\t\t\t\t\"classes\": \"bg-component font-value\",\n\t\t\t\t\"height\": 24,\n\t\t\t\t\"width\": 120\n\t\t\t},\n\t\t\t\"type\": \"message\",\n\t\t\t\"children\": [],\n\t\t\t\"link\": {\"url\": \"\", \"target\": \"self\"},\n\t\t\t\"method\": {\"name\": \"\", \"params\": {}},\n\t\t\t\"message\": {\n\t\t\t\t\"type\": \"ticketLog\",\n\t\t\t\t\"payload\": {\n\t\t\t\t\t\"tagPath\": tagPath,\n\t\t\t\t\t\"viewName\": self.view.id.split('@')[0]\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
