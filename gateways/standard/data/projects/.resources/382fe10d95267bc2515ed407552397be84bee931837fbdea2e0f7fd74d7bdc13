          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\timport system\n\n\tresult \u003d {\n\t\t\u0027showControls\u0027: False,\n\t\t\u0027showConfiguration\u0027: False,\n\t\t\u0027showInterlocks\u0027: False,\n\t\t\u0027showTrend\u0027: False,\n\t\t\u0027showAlarmConfiguration\u0027: False,\n\t\t\u0027showAlarms\u0027: False,\n\t\t\u0027defaultTab\u0027: \u0027Controls\u0027\n\t}\n\n\tdef parseHidden(text):\n\t\ts \u003d set()\n\t\ttry:\n\t\t\tt \u003d str(text or \u0027\u0027)\n\t\t\tif t:\n\t\t\t\tt \u003d t.replace(\u0027;\u0027, \u0027,\u0027)\n\t\t\t\tfor item in t.split(\u0027,\u0027):\n\t\t\t\t\titem \u003d item.strip()\n\t\t\t\t\tif item:\n\t\t\t\t\t\ts.add(item)\n\t\texcept Exception:\n\t\t\tpass\n\t\treturn s\n\n\tdef isHidden(fullPath, hidden_set):\n\t\tif not hidden_set:\n\t\t\treturn False\n\t\tif fullPath in hidden_set:\n\t\t\treturn True\n\t\tstripped \u003d fullPath.split(\u0027]\u0027, 1)[-1] if \u0027]\u0027 in fullPath else fullPath\n\t\tif stripped in hidden_set:\n\t\t\treturn True\n\t\treturn False\n\n\ttagPath \u003d value.get(\u0027tagPath\u0027, \u0027\u0027) if hasattr(value, \u0027get\u0027) else \u0027\u0027\n\tdeviceType \u003d value.get(\u0027deviceType\u0027, \u0027\u0027) if hasattr(value, \u0027get\u0027) else \u0027\u0027\n\tcallerControls \u003d value.get(\u0027showControls\u0027, True) if hasattr(value, \u0027get\u0027) else True\n\tcallerConfiguration \u003d value.get(\u0027showConfiguration\u0027, True) if hasattr(value, \u0027get\u0027) else True\n\tcallerInterlocks \u003d value.get(\u0027showInterlocks\u0027, True) if hasattr(value, \u0027get\u0027) else True\n\tcallerTrend \u003d value.get(\u0027showTrend\u0027, True) if hasattr(value, \u0027get\u0027) else True\n\tcallerAlarmCfg \u003d value.get(\u0027showAlarmConfiguration\u0027, True) if hasattr(value, \u0027get\u0027) else True\n\tcallerAlarms \u003d value.get(\u0027showAlarms\u0027, True) if hasattr(value, \u0027get\u0027) else True\n\thidTrend \u003d parseHidden(value.get(\u0027hiddenFromTrend\u0027, \u0027\u0027) if hasattr(value, \u0027get\u0027) else \u0027\u0027)\n\thidCfg \u003d parseHidden(value.get(\u0027hiddenFromConfiguration\u0027, \u0027\u0027) if hasattr(value, \u0027get\u0027) else \u0027\u0027)\n\thidAlarmCfg \u003d parseHidden(value.get(\u0027hiddenFromAlarmConfiguration\u0027, \u0027\u0027) if hasattr(value, \u0027get\u0027) else \u0027\u0027)\n\thidAlarms \u003d parseHidden(value.get(\u0027hiddenFromAlarms\u0027, \u0027\u0027) if hasattr(value, \u0027get\u0027) else \u0027\u0027)\n\n\t# Controls: device types that have a Controls asset\n\thasControlsAsset \u003d str(deviceType or \u0027\u0027) in (\u0027Compressor\u0027, \u0027Pump\u0027, \u0027ExhaustFan\u0027, \u0027Valve\u0027, \u0027Tank\u0027, \u0027Sensor\u0027, \u0027Evaporator\u0027, \u0027CoolingTower\u0027, \u0027\u0027)\n\tresult[\u0027showControls\u0027] \u003d bool(callerControls) and hasControlsAsset\n\n\t# Interlocks: Interlock folder usable\n\tshowIlk \u003d False\n\tif tagPath and callerInterlocks:\n\t\ttry:\n\t\t\tq \u003d system.tag.readBlocking([tagPath + \u0027/Interlock/Sts_IntlkOK/Value\u0027])[0]\n\t\t\tif str(q.quality) \u003d\u003d \u0027Good\u0027 or (hasattr(q.quality, \u0027isGood\u0027) and q.quality.isGood()):\n\t\t\t\tshowIlk \u003d True\n\t\texcept Exception:\n\t\t\tpass\n\t\tif not showIlk:\n\t\t\ttry:\n\t\t\t\ttxt \u003d system.tag.readBlocking([tagPath + \u0027/Interlock/Cfg_CondTxt00\u0027])[0]\n\t\t\t\tif str(txt.quality) \u003d\u003d \u0027Good\u0027 or (hasattr(txt.quality, \u0027isGood\u0027) and txt.quality.isGood()):\n\t\t\t\t\tif txt.value and str(txt.value).strip():\n\t\t\t\t\t\tshowIlk \u003d True\n\t\t\texcept Exception:\n\t\t\t\tpass\n\t\tif not showIlk:\n\t\t\ttry:\n\t\t\t\tsts \u003d system.tag.readBlocking([tagPath + \u0027/Interlock/Sts_Intlk/Value\u0027])[0]\n\t\t\t\tif str(sts.quality) \u003d\u003d \u0027Good\u0027 or (hasattr(sts.quality, \u0027isGood\u0027) and sts.quality.isGood()):\n\t\t\t\t\tshowIlk \u003d True\n\t\t\texcept Exception:\n\t\t\t\tpass\n\tresult[\u0027showInterlocks\u0027] \u003d showIlk\n\n\t# Browse leaves for Trend / Configuration / Alarm flags\n\tshowTrend \u003d False\n\tshowCfg \u003d False\n\tshowAlarmCfg \u003d False\n\tshowAlarms \u003d False\n\tif tagPath:\n\t\ttry:\n\t\t\tresults \u003d system.tag.browse(path\u003dtagPath, filter\u003d{\u0027recursive\u0027: True}).getResults()\n\t\texcept Exception:\n\t\t\tresults \u003d []\n\t\tleaves \u003d []\n\t\tfor t in results or []:\n\t\t\ttry:\n\t\t\t\tif str(t[\u0027tagType\u0027]) !\u003d \u0027AtomicTag\u0027:\n\t\t\t\t\tcontinue\n\t\t\t\tfp \u003d str(t[\u0027fullPath\u0027])\n\t\t\t\tleaves.append(fp)\n\t\t\texcept Exception:\n\t\t\t\tpass\n\t\tfor leaf in leaves:\n\t\t\ttry:\n\t\t\t\tcfgs \u003d system.tag.getConfiguration(leaf, False)\n\t\t\t\tif not cfgs:\n\t\t\t\t\tcontinue\n\t\t\t\tcfg \u003d cfgs[0]\n\t\t\t\talarms \u003d cfg.get(\u0027alarms\u0027) or []\n\t\t\t\thasAlarms \u003d len(alarms) \u003e 0\n\t\t\t\treadOnly \u003d cfg.get(\u0027readOnly\u0027, False)\n\t\t\t\thist \u003d cfg.get(\u0027historyEnabled\u0027, False)\n\t\t\t\tdt \u003d str(cfg.get(\u0027dataType\u0027) or \u0027\u0027)\n\t\t\t\tanalog \u003d dt in (\u0027Float4\u0027, \u0027Float8\u0027, \u0027Int1\u0027, \u0027Int2\u0027, \u0027Int4\u0027, \u0027Int8\u0027, \u0027Double\u0027)\n\t\t\t\tif hist and analog and not isHidden(leaf, hidTrend):\n\t\t\t\t\tshowTrend \u003d True\n\t\t\t\tif (not readOnly) and (not hasAlarms) and dt and not isHidden(leaf, hidCfg):\n\t\t\t\t\tshowCfg \u003d True\n\t\t\t\tif hasAlarms and not isHidden(leaf, hidAlarmCfg):\n\t\t\t\t\tshowAlarmCfg \u003d True\n\t\t\t\tif hasAlarms and not isHidden(leaf, hidAlarms):\n\t\t\t\t\tshowAlarms \u003d True\n\t\t\texcept Exception:\n\t\t\t\tpass\n\n\tresult[\u0027showTrend\u0027] \u003d bool(callerTrend) and showTrend\n\tresult[\u0027showConfiguration\u0027] \u003d bool(callerConfiguration) and showCfg\n\tresult[\u0027showAlarmConfiguration\u0027] \u003d bool(callerAlarmCfg) and showAlarmCfg\n\tresult[\u0027showAlarms\u0027] \u003d bool(callerAlarms) and showAlarms\n\n\t# BH Controls-first default tab order\n\torder \u003d [\n\t\t(\u0027showControls\u0027, \u0027Controls\u0027),\n\t\t(\u0027showConfiguration\u0027, \u0027Configuration\u0027),\n\t\t(\u0027showInterlocks\u0027, \u0027Interlocks\u0027),\n\t\t(\u0027showTrend\u0027, \u0027Trend\u0027),\n\t\t(\u0027showAlarmConfiguration\u0027, \u0027Alarm Configuration\u0027),\n\t\t(\u0027showAlarms\u0027, \u0027Alarms\u0027),\n\t]\n\tresult[\u0027defaultTab\u0027] \u003d \u0027Controls\u0027\n\tfor key, name in order:\n\t\tif result.get(key):\n\t\t\tresult[\u0027defaultTab\u0027] \u003d name\n\t\t\tbreak\n\treturn result\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "onChange": {
        "enabled": null,
        "script": "\tflags \u003d currentValue.value\n\tif not flags:\n\t\treturn\n\tsel \u003d self.custom.selected\n\tvisible \u003d {\n\t\t\u0027Controls\u0027: flags.get(\u0027showControls\u0027),\n\t\t\u0027Configuration\u0027: flags.get(\u0027showConfiguration\u0027),\n\t\t\u0027Interlocks\u0027: flags.get(\u0027showInterlocks\u0027),\n\t\t\u0027Trend\u0027: flags.get(\u0027showTrend\u0027),\n\t\t\u0027Alarm Configuration\u0027: flags.get(\u0027showAlarmConfiguration\u0027),\n\t\t\u0027Alarms\u0027: flags.get(\u0027showAlarms\u0027),\n\t}\n\tif not visible.get(sel, False):\n\t\tself.custom.selected \u003d flags.get(\u0027defaultTab\u0027) or \u0027Controls\u0027"
