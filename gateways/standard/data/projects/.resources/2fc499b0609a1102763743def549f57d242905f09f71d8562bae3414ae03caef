/* Direct stylesheet authoring is an advanced feature. Knowledge of CSS required.
 *
 * PROJECT RULE — CSS is the only styling system for BH Perspective.
 * Do NOT create or extend Designer Style Classes (Styles → Colors / Container / Fonts).
 * Put fonts, colors, motion, and theme tokens here. Bind views with simple class names
 * (e.g. fan-spin, alarm-flash). Perspective prefixes them as .psc-* automatically.
 *
 * =============================================================================
 * THEME SYSTEM — light/dark × cool/warm (Lightspeed)
 * =============================================================================
 * Perspective applies themes by loading gateway theme CSS for session.props.theme.
 * It does NOT set [data-theme] on the DOM. Advanced Stylesheet loads AFTER themes,
 * so this file must NOT redefine --neutral-* (that stomped every theme to light-cool).
 *
 * Valid session.props.theme values (ChangeTheme writes these):
 *   light-cool  = light + cool  (preferred; stock light/dark omit BH tokens)
 *   dark-cool   = dark + cool
 *   light-warm  = light + warm
 *   dark-warm   = dark + warm
 * Legacy aliases still accepted in UI bindings: light / dark (= cool).
 *
 * Neutrals / callToAction come from gateway themes under
 *   data/config/.../themes/<name>/variables.css
 * This stylesheet only builds semantic aliases on top of --neutral-*.
 * --ct-water is also defined here as a safety net when stock light/dark load.
 *
 * STABLE TOKENS (use these in nav / login / views — do not hardcode hex)
 * ---------------------------------------------------------------------
 * Surfaces:  --surface  --surface-raised  --surface-sunken  --surface-component
 *            --surface-header  --surface-container  --surface-card
 *            --surface-disabled  --surface-nav  --surface-nav-hover
 *            --surface-nav-selected  --surface-page
 * Text:      --text  --text-secondary  --text-muted  --text-subtle
 *            --text-inverse  --text-nav  --text-nav-muted  --text-on-accent
 * Icons:     --icon  --icon-muted  --icon-disabled  --icon-nav
 * Borders:   --border  --border-strong  --border-nav
 * Accents:   --accent  --accent-warm  --accent-cold  --callToAction
 * Nav aliases (compat): --nav-bg --nav-border --nav-text --nav-text-muted
 *            --nav-brand --nav-icon --nav-hover --nav-selected
 * Neutrals:  --neutral-10 … --neutral-100  (owned by gateway theme)
 * Chrome:    --borderRadius  --boxShadow1
 *
 * Alarm tokens and component status colors are theme-independent (Figma Dev Jam).
 * Comm Loss fill (--deviceFill-commLoss) and analog-over-SP are fixed red —
 * never remapped per theme.
 *
 * StatusIndicator TEXT colors (Figma --status-*): Idle green, Cooling blue,
 * Defrost pink, Off gray. Device BODY fills stay grayscale except Comm Loss.
 *
 * Apply classes:  Refridgeration_STS sts-<TOKEN>
 * Tokens (uppercase): COOLING | DEFROST | FAULT | IDLE | OFF | UNKNOWN | COMMLOSS
 * (Manual is not a displayed status code.)
 *
 * Device fill: ONLY device-comm-loss (Bad Status/Value quality). No fills for
 * Idle / Cooling / Defrost / Off / Fault / Manual.
 *
 * Refs: Figma Q8EmmXokQsiX91aPMtLm2w, ISA-101 (alarms), ScoutMotors / Lightspeed themes
 */

:root {
	/* Named palette anchors (reference only — gateway themes own --neutral-*) */
	--cool-10: #f2f4f8;
	--cool-20: #dde1e6;
	--cool-30: #c1c7cd;
	--cool-40: #a2a9b0;
	--cool-50: #878d96;
	--cool-60: #697077;
	--cool-70: #4d5358;
	--cool-80: #343a3f;
	--cool-90: #21272a;
	--cool-100: #121619;

	--warm-10: #f7f3f2;
	--warm-20: #e5e0df;
	--warm-30: #cac5c4;
	--warm-40: #ada8a8;
	--warm-50: #8f8b8b;
	--warm-60: #736f6f;
	--warm-70: #565151;
	--warm-80: #3c3838;
	--warm-90: #272525;
	--warm-100: #171414;

	/* Accent families — --callToAction / --accent owned by gateway theme */
	--accent-cold: #114599; /* Figma light-cool fallback only */
	--accent-warm: #c45c26; /* Figma light-warm fallback only */
	--accent: var(--callToAction, var(--accent-cold));
	--text-on-accent: #ffffff;

	/* Cooling tower water — identical bright blue in every theme.
	 * Stock light/dark bundles do not include disk --ct-water; keep this
	 * fallback so basin/spray never resolve to invalid → black. */
	--ct-water: #5BC0EB;

	/* Semantic surfaces — resolve against theme --neutral-* at computed time */
	--surface: var(--neutral-10);
	--surface-page: var(--neutral-10);
	--surface-raised: var(--neutral-20);
	--surface-component: var(--neutral-30);
	--surface-card: var(--neutral-20);
	--surface-sunken: var(--neutral-30);
	--surface-header: var(--neutral-30);
	--surface-container: var(--neutral-30);
	--surface-disabled: var(--neutral-40);
	--surface-nav: var(--neutral-20);
	--surface-nav-hover: var(--neutral-30);
	--surface-nav-selected: var(--neutral-40);

	/* Semantic text / icons / borders */
	--text: var(--neutral-100);
	--text-secondary: var(--neutral-80);
	--text-muted: var(--neutral-60);
	--text-subtle: var(--neutral-50);
	--text-inverse: var(--neutral-10);
	--text-nav: var(--neutral-90);
	--text-nav-muted: var(--neutral-60);
	--icon: var(--neutral-90);
	--icon-muted: var(--neutral-60);
	--icon-disabled: var(--neutral-40);
	--icon-nav: var(--neutral-70);
	--border: var(--neutral-30);
	--border-strong: var(--neutral-50);
	--border-nav: var(--neutral-30);

	/* Nav aliases */
	--nav-bg: var(--surface-nav);
	--nav-border: var(--border-nav);
	--nav-text: var(--text-nav);
	--nav-text-muted: var(--text-nav-muted);
	--nav-brand: var(--text-secondary);
	--nav-icon: var(--icon-nav);
	--nav-hover: var(--surface-nav-hover);
	--nav-selected: var(--surface-nav-selected);

	/* Chrome fallbacks (Ignition theme may also define these) */
	--borderRadius: 4px;
	--boxShadow1: 0 1px 3px rgba(0, 0, 0, 0.12);

	/* Alarm / attention (saturated — theme-independent) */
	--sts-fault: #c62828;
	/* Comm Loss fill — fixed red in every theme (same family as --sts-fault) */
	--deviceFill-commLoss: #c62828;
	/* AnalogValue over setpoint — theme-invariant red (same family as Comm Loss) */
	--analog-over-sp: #c62828;

	/*
	 * StatusIndicator text colors (Figma Dev Jam Light — theme-invariant).
	 * Idle #228b22 | Cooling #1e88e5 | Defrost #ec407a | Off #9e9e9e
	 * NOT used for device body fills (those stay grayscale except Comm Loss).
	 */
	--status-idle: #228b22;
	--status-cooling: #1e88e5;
	--status-defrost: #ec407a;
	--status-off: #9e9e9e;
	--sts-defrost: var(--status-defrost);

	/* Compressor CP/SV mode text (operator cues — may change later) */
	--comp-mode-auto: #2e7d32;
	--comp-mode-manual: #FF9800;
	--comp-mode-remote: #00bcd4;

	/* Tank level marks + float switches (Figma Dev Jam — theme-invariant) */
	--status-level-critical: #c62828;
	--status-level-warning: #fbc02d;
	--tank-float: #767676;
	--tank-float-active: var(--status-idle);
	--tank-float-stroke: #161616;

	/* Alarm Status Table / icon priority palette */
	--alarm-critical: #e22028;
	--alarm-high: #ec8629;
	--alarm-medium: #f5e11b;
	--alarm-low: #916aad;
	--alarm-critical-ack: #8b1519;
	--alarm-high-ack: #9a5619;
	--alarm-medium-ack: #9e9012;
	--alarm-low-ack: #5a3f6c;
	--alarm-row-fg-light: #ffffff;
	--alarm-row-fg-dark: #212121;

	/* Status chip fills — colored component states (Figma) */
	--sts-cooling-bg: var(--status-cooling);
	--sts-cooling-fg: #ffffff;
	--sts-idle-bg: var(--status-idle);
	--sts-idle-fg: #ffffff;
	--sts-off-bg: var(--status-off);
	--sts-off-fg: #ffffff;
	--sts-unknown-bg: var(--neutral-60);
	--sts-unknown-fg: var(--neutral-10);
	--sts-border: var(--neutral-50);
	--sts-accent-width: 4px;

	/* Default housing fills — grayscale; only Comm Loss overrides via class */
	--deviceFill-running: var(--neutral-10);
	--deviceFill-stopped: var(--neutral-60);
	--deviceFill-faulted: var(--neutral-100);
	/* --deviceFill-commLoss defined above with alarm colors (theme-invariant) */
}

/* Base marker class for refrigeration status chips */
.psc-Refridgeration_STS {
	border: 1px solid var(--sts-border) !important;
	border-radius: 4px;
	font-weight: 700;
	background-color: var(--sts-unknown-bg);
	color: var(--sts-unknown-fg);
	box-shadow: none;
}

/* --- Cooling — Figma blue --- */
.psc-Refridgeration_STS.psc-sts-COOLING,
.psc-Refridgeration_STS.psc-sts-CLG {
	background-color: var(--sts-cooling-bg);
	color: var(--sts-cooling-fg);
}

/* --- Idle / standby — Figma green --- */
.psc-Refridgeration_STS.psc-sts-IDLE {
	background-color: var(--sts-idle-bg);
	color: var(--sts-idle-fg);
}

/* --- Off / stopped — Figma gray --- */
.psc-Refridgeration_STS.psc-sts-OFF,
.psc-Refridgeration_STS.psc-sts-STOP {
	background-color: var(--sts-off-bg);
	color: var(--sts-off-fg);
}

/* --- Defrost — Figma pink --- */
.psc-Refridgeration_STS.psc-sts-DEFROST,
.psc-Refridgeration_STS.psc-sts-DFT {
	background-color: var(--sts-defrost);
	color: #ffffff;
	border-left: var(--sts-accent-width) solid #ad1457 !important;
}

/* --- Abnormal: Fault / alarm — red + left accent --- */
.psc-Refridgeration_STS.psc-sts-FAULT {
	background-color: var(--sts-fault);
	color: #ffffff;
	border-left: var(--sts-accent-width) solid #7f0000 !important;
}

/* --- Abnormal: Comm Loss (tag quality Bad) — theme-invariant red + accent --- */
.psc-Refridgeration_STS.psc-sts-COMMLOSS {
	background-color: var(--deviceFill-commLoss);
	color: #ffffff;
	border-left: var(--sts-accent-width) solid #7f0000 !important;
}

/* --- Fallback --- */
.psc-Refridgeration_STS.psc-sts-UNKNOWN {
	background-color: var(--sts-unknown-bg);
	color: var(--sts-unknown-fg);
	border-style: dashed !important;
}

/* Compressor CP/SV mode labels (overview bottom strip) */
.psc-comp-mode {
	font-size: 11px;
	font-weight: 700;
	line-height: 1.1;
	margin: 0;
	padding: 0;
	text-align: left;
	color: var(--neutral-60);
}

.psc-comp-mode-auto {
	color: var(--text) !important;
}

.psc-comp-mode-manual {
	color: var(--text-muted) !important;
}

.psc-comp-mode-remote {
	color: var(--text) !important;
}

/*
 * Device graphic Comm Loss fill — the ONLY colored device body fill.
 * Apply style.classes = device-comm-loss on Graphic when Status/Value quality
 * is Bad. Idle/Cooling/Defrost/Off/Fault/Manual stay grayscale SVG defaults.
 */
.psc-device-comm-loss,
.psc-device-comm-loss path,
.psc-device-comm-loss circle,
.psc-device-comm-loss ellipse,
.psc-device-comm-loss rect,
.psc-device-comm-loss polygon {
	fill: var(--deviceFill-commLoss) !important;
}

/* AnalogValue text when PV > SP — theme-invariant (text only, not device fill) */
.psc-analog-over-sp {
	color: var(--analog-over-sp) !important;
}

.psc-analog-level-warning {
	color: var(--status-level-warning) !important;
}

/* Accent text matching AnalogValue Numeric value color (optional helpers) */
.psc-analog-label {
	color: var(--accent);
}

/* Compressor FLA/SVP strip — same 11px metrics as CP:/SV: mode labels; normal weight (not bold) */
.psc-comp-analog {
	font-size: 11px;
	font-weight: 400;
	line-height: 1.1;
	margin: 0;
	padding: 0;
	color: var(--accent);
}

.psc-comp-analog-eu {
	font-size: 11px;
	font-weight: 400;
	line-height: 1.1;
	margin: 0;
	padding: 0;
	color: var(--neutral-60);
}

/* --- Evaporator overview fan: counter-clockwise spin when Cooling/Running --- */
@keyframes fan-spin-ccw {
	from {
		transform: rotate(0deg);
	}
	to {
		transform: rotate(-360deg);
	}
}

.psc-fan-spin {
	transform-origin: center center !important;
	animation: fan-spin-ccw 1.25s linear infinite;
}

/*
 * Cooling tower side-profile fan: foreshortening pulse (scaleX), not Z-rotation.
 * Reads as blades going edge-on / face-on when the shaft axis points at the viewer.
 */
@keyframes ct-fan-side-spin {
	0%,
	100% {
		transform: scaleX(1) scaleY(1);
		opacity: 1;
	}
	25% {
		transform: scaleX(0.12) scaleY(1.12);
		opacity: 0.72;
	}
	50% {
		transform: scaleX(1) scaleY(1);
		opacity: 1;
	}
	75% {
		transform: scaleX(0.12) scaleY(1.12);
		opacity: 0.72;
	}
}

.psc-ct-fan-side-spin {
	transform-origin: center center !important;
	animation: ct-fan-side-spin 0.4s ease-in-out infinite;
}

/* Spray droplets fall when tower is running.
 * Opacity stays high for the whole cycle so animated spray is at least as
 * visible as the static (animations-off) droplets — do not fade to 0. */
@keyframes ct-spray-fall {
	0% {
		transform: translateY(0);
		opacity: 1;
	}
	100% {
		transform: translateY(8px);
		opacity: 0.9;
	}
}

.psc-ct-spray-run {
	animation: ct-spray-fall 0.85s ease-in infinite;
}

/* --- Alarm badge blink (1 Hz) when active AND unacknowledged --- */
@keyframes alarm-flash {
	0%,
	49% {
		opacity: 1;
	}
	50%,
	100% {
		opacity: 0;
	}
}

.psc-alarm-flash {
	animation: alarm-flash 1s steps(1, end) infinite;
}

/*
 * Master animations toggle (ChangeTheme → Animations On/Off).
 * session.props.animations (default true) drives Header class `animations-off`.
 * body:has(...) covers main page + docks; html.animations-off covers optional JS sync.
 */
html.animations-off .psc-fan-spin,
html.animations-off .fan-spin,
html.animations-off .psc-ct-fan-side-spin,
html.animations-off .ct-fan-side-spin,
html.animations-off .psc-ct-spray-run,
html.animations-off .ct-spray-run,
html.animations-off .psc-alarm-flash,
html.animations-off .alarm-flash,
html.animations-off .psc-container-fade-in,
html.animations-off .container-fade-in,
body:has(.psc-animations-off) .psc-fan-spin,
body:has(.psc-animations-off) .fan-spin,
body:has(.psc-animations-off) .psc-ct-fan-side-spin,
body:has(.psc-animations-off) .ct-fan-side-spin,
body:has(.psc-animations-off) .psc-ct-spray-run,
body:has(.psc-animations-off) .ct-spray-run,
body:has(.psc-animations-off) .psc-alarm-flash,
body:has(.psc-animations-off) .alarm-flash,
body:has(.psc-animations-off) .psc-container-fade-in,
body:has(.psc-animations-off) .container-fade-in {
	animation: none !important;
}


/* =============================================================================
 * Migrated from Designer Style Classes (Colors / Container / Fonts)
 * Bind with these simple names — Perspective applies them as .psc-<name>
 * ============================================================================= */

/* --- Background / color utility (theme semantic tokens) --- */
.psc-bg-page {
	background-color: var(--surface-page);
}
.psc-bg-baddata {
	background-color: var(--text-muted);
}
.psc-bg-component {
	background-color: var(--surface-component);
}
.psc-bg-container {
	background-color: var(--surface-container);
}
.psc-bg-disabled {
	background-color: var(--surface-disabled);
}
.psc-bg-header {
	background-color: var(--surface-header);
}
.psc-color-icon {
	color: var(--icon);
}
.psc-color-icon-disabled {
	color: var(--icon-disabled);
}

/* --- Container chrome --- */
.psc-container-button {
	background-color: var(--text-muted);
	border-style: none;
	box-shadow: var(--boxShadow1);
}
.psc-container-button:hover {
	background-color: var(--text-subtle);
}
.psc-container-button:active {
	color: var(--surface-sunken);
}

.psc-container-card {
	background-color: var(--surface-card);
	border: 1px solid var(--border);
	border-radius: 0.5rem;
	box-shadow: var(--boxShadow1);
	margin: 2px;
	outline-style: none;
}

/* Device-type Unit Overview: 3-column wrap of unit cards */
.psc-unit-overview-grid {
	display: flex;
	flex-wrap: wrap;
	align-items: stretch;
	gap: 12px;
	width: 100%;
	min-width: 0;
	overflow-x: hidden;
	/* Themed vertical scrollbars (Firefox); Chromium via ::-webkit-* below */
	scrollbar-width: thin;
	scrollbar-color: var(--neutral-50) var(--neutral-20);
}

/* Cards / embeds: allow flex shrink inside hosts; hide H-scroll chrome */
.psc-unit-overview-grid .view-parent,
.psc-unit-overview-grid .ia_embeddedView,
.psc-unit-overview-host,
.psc-unit-overview-host .ia_tableComponent,
.psc-unit-overview-table {
	min-width: 0 !important;
	max-width: 100%;
}

.psc-unit-overview-grid > .flex-container {
	max-width: 100%;
}

.psc-unit-overview-grid > .flex-container,
.psc-unit-overview-grid .view-parent,
.psc-unit-overview-grid .ia_embeddedView,
.psc-unit-overview-grid .psc-container-card,
.psc-unit-overview-host,
.psc-unit-overview-host .ia_tableComponent,
.psc-unit-overview-host .ia_table__headContainer,
.psc-unit-overview-host .ia_table__body {
	overflow-x: hidden !important;
}

/* Keep vertical scroll when many rows; only suppress horizontal bars */
.psc-unit-overview-host .ia_tableComponent,
.psc-unit-overview-host .ia_table__body {
	overflow-y: auto;
}

.psc-unit-overview-grid .ia_table__head,
.psc-unit-overview-grid .ia_table__body,
.psc-unit-overview-host .ia_table__head,
.psc-unit-overview-host .ia_table__body {
	width: 100% !important;
	max-width: 100% !important;
}

/* Themed scrollbars — Perspective client is Chromium; also Firefox */
.psc-unit-overview-grid ::-webkit-scrollbar,
.psc-unit-overview-host ::-webkit-scrollbar,
.psc-themed-scroll ::-webkit-scrollbar {
	width: 8px;
	height: 8px;
}
.psc-unit-overview-grid ::-webkit-scrollbar:horizontal,
.psc-unit-overview-host ::-webkit-scrollbar:horizontal,
.psc-themed-scroll ::-webkit-scrollbar:horizontal {
	height: 0 !important;
}
.psc-unit-overview-grid ::-webkit-scrollbar-thumb,
.psc-unit-overview-host ::-webkit-scrollbar-thumb,
.psc-themed-scroll ::-webkit-scrollbar-thumb {
	background: var(--neutral-50);
	border-radius: 4px;
}
.psc-unit-overview-grid ::-webkit-scrollbar-thumb:hover,
.psc-unit-overview-host ::-webkit-scrollbar-thumb:hover,
.psc-themed-scroll ::-webkit-scrollbar-thumb:hover {
	background: var(--accent, var(--neutral-60));
}
.psc-unit-overview-grid ::-webkit-scrollbar-track,
.psc-unit-overview-host ::-webkit-scrollbar-track,
.psc-themed-scroll ::-webkit-scrollbar-track {
	background: var(--neutral-20);
}
.psc-unit-overview-host,
.psc-themed-scroll {
	scrollbar-width: thin;
	scrollbar-color: var(--neutral-50) var(--neutral-20);
}

.psc-unit-overview-table {
	min-width: 0 !important;
	max-width: 100% !important;
	overflow-x: hidden !important;
	width: 100% !important;
}

.psc-container-card-border {
	border: 1px solid var(--border-strong);
	border-radius: 0.5rem;
	margin: 2px;
}

@keyframes container-fade-in {
	from {
		opacity: 0;
	}
	to {
		opacity: 1;
	}
}
.psc-container-fade-in {
	animation: container-fade-in 1s 1s normal 1;
}

.psc-container-header {
	border-bottom: 1px solid var(--border);
}

.psc-container-icon:hover {
	background-color: var(--text-subtle);
	border-style: none;
	border-radius: var(--borderRadius);
	box-shadow: var(--boxShadow1);
}

.psc-container-item {
	padding-left: 2px;
	padding-right: 2px;
}

.psc-container-item-border {
	border-bottom: 1px solid var(--border);
}

/* --- Typography --- */
.psc-font-baddata {
	color: var(--text-muted);
	font-family: sans-serif;
	font-size: 0.9em;
	font-style: italic;
	font-weight: 500;
}
.psc-font-button {
	color: var(--text-inverse);
	font-family: sans-serif;
	font-size: 0.8rem;
	font-weight: normal;
}
.psc-font-header {
	color: var(--text-secondary);
	font-family: sans-serif;
	font-size: 0.9rem;
	font-weight: 500;
	text-indent: 2px;
}
.psc-font-label {
	color: var(--icon);
	font-family: sans-serif;
	font-size: 0.8rem;
	font-weight: 500;
	text-indent: 2px;
}
.psc-font-livedata {
	color: var(--callToAction);
	font-family: sans-serif;
	font-size: 0.9rem;
	font-weight: 500;
}
.psc-font-livedata-entry {
	color: var(--qual-7, var(--accent));
	font-family: Roboto-Mono, monospace;
	font-size: 0.85rem;
	font-weight: bold;
}
.psc-font-title {
	color: var(--text-secondary);
	font-family: sans-serif;
	font-size: 1rem;
	font-weight: 400;
	text-indent: 2px;
}
.psc-font-value {
	color: var(--text);
	font-family: sans-serif;
	font-size: 0.8rem;
	font-weight: normal;
}

/* =============================================================================
 * Alarm Status Table row fills
 * Bind via rowStyles.*.priorities.*.classes (e.g. alarm-row-critical)
 * Unack = full icon color; Ack = darker variant
 * ============================================================================= */

.psc-alarm-row-critical {
	background-color: var(--alarm-critical) !important;
	color: var(--alarm-row-fg-light) !important;
}
.psc-alarm-row-critical-ack {
	background-color: var(--alarm-critical-ack) !important;
	color: var(--alarm-row-fg-light) !important;
}

.psc-alarm-row-high {
	background-color: var(--alarm-high) !important;
	color: var(--alarm-row-fg-light) !important;
}
.psc-alarm-row-high-ack {
	background-color: var(--alarm-high-ack) !important;
	color: var(--alarm-row-fg-light) !important;
}

