}

.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__node__icon [stroke]:not([stroke='none']),
.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__expandIcon [stroke]:not([stroke='none']),
.psc-nav-tree .ia_treeComponent__node--selected .expand-icon [stroke]:not([stroke='none']),
