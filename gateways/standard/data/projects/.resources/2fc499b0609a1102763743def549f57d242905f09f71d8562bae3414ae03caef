}

/*
 * Tree icons / expand arrows — theme via --icon-nav.
 * Do NOT set `fill` on the SVG root: Material icons include a full-canvas
 * path with fill="none"; inherited/!important fill paints that as a dark square
 * (especially material/arrow_right on collapsed nodes).
 */
.psc-nav-tree .ia_treeComponent__node__icon,
.psc-nav-tree .ia_treeComponent__node__icon--expanded,
.psc-nav-tree .ia_treeComponent__node__icon--selected,
.psc-nav-tree .ia_treeComponent__expandIcon,
.psc-nav-tree .ia_treeComponent__expandIcon--selected,
.psc-nav-tree .ia_treeComponent__terminalExpandIcon,
.psc-nav-tree .label-wrapper-icon svg,
.psc-nav-tree .expand-icon,
.psc-nav-icon {
	color: var(--icon-nav);
	height: 18px;
	width: 18px;
	/* keep SVG fill unset so fill="none" clearing rects stay transparent */
	fill: initial;
}

.psc-nav-tree .ia_treeComponent__node__icon path:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node__icon rect:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node__icon circle:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node__icon ellipse:not([fill='none']),
.psc-nav-tree .ia_treeComponent__expandIcon path:not([fill='none']),
.psc-nav-tree .ia_treeComponent__terminalExpandIcon path:not([fill='none']),
.psc-nav-tree .label-wrapper-icon svg path:not([fill='none']),
.psc-nav-tree .label-wrapper-icon svg rect:not([fill='none']),
.psc-nav-tree .label-wrapper-icon svg circle:not([fill='none']),
.psc-nav-tree .label-wrapper-icon svg ellipse:not([fill='none']),
.psc-nav-tree .expand-icon path:not([fill='none']),
.psc-nav-icon path:not([fill='none']),
.psc-nav-icon rect:not([fill='none']),
.psc-nav-icon circle:not([fill='none']),
.psc-nav-icon ellipse:not([fill='none']) {
	fill: var(--icon-nav) !important;
}

.psc-nav-tree .ia_treeComponent__node__icon path[fill='none'],
.psc-nav-tree .ia_treeComponent__node__icon rect[fill='none'],
.psc-nav-tree .ia_treeComponent__node__icon circle[fill='none'],
.psc-nav-tree .ia_treeComponent__node__icon ellipse[fill='none'],
.psc-nav-tree .ia_treeComponent__expandIcon path[fill='none'],
.psc-nav-tree .ia_treeComponent__terminalExpandIcon path[fill='none'],
.psc-nav-tree .label-wrapper-icon svg path[fill='none'],
.psc-nav-tree .expand-icon path[fill='none'],
.psc-nav-icon path[fill='none'],
.psc-nav-icon rect[fill='none'],
.psc-nav-icon circle[fill='none'],
.psc-nav-icon ellipse[fill='none'] {
	fill: none !important;
}

.psc-nav-tree .ia_treeComponent__node__icon [stroke]:not([stroke='none']),
.psc-nav-tree .ia_treeComponent__expandIcon [stroke]:not([stroke='none']),
.psc-nav-tree .ia_treeComponent__terminalExpandIcon [stroke]:not([stroke='none']),
.psc-nav-tree .label-wrapper-icon svg [stroke]:not([stroke='none']),
.psc-nav-tree .expand-icon [stroke]:not([stroke='none']),
.psc-nav-icon [stroke]:not([stroke='none']) {
	stroke: var(--icon-nav) !important;
}

.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__node__icon,
.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__expandIcon,
.psc-nav-tree .ia_treeComponent__node--selected .expand-icon {
	color: var(--icon);
	fill: initial;
}

.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__node__icon path:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__node__icon rect:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__node__icon circle:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__node__icon ellipse:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .ia_treeComponent__expandIcon path:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .expand-icon path:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .label-wrapper-icon svg path:not([fill='none']),
.psc-nav-tree .ia_treeComponent__node--selected .label-wrapper-icon svg rect:not([fill='none']) {
