/* ----------------------------------------------------------------------------------------------------------------------------------------------------------------
 * Popups — hide Perspective chrome header (empty white bar when showCloseIcon=False).
 * Ticket Logger / Alerts / AdhocTrend supply their own in-view header rows.
 *
 * Drag is NOT via .ia_popup__header. Working BH faceplates (Pump, Evaporator, …)
 * drag via Perspective's sibling .popup-drag strip (cursor: grab), even while the
 * chrome header stays display:none. Never overlay chrome on top of .popup-drag.
 * ---------------------------------------------------------------------------------------------------------------------------------------------------------------- */

#popup-alertDialog,
#popup-AdhocTrend {
	background-color: transparent;
	border: none;
	box-shadow: none;
	overflow: hidden !important;
	scrollbar-width: none;
}

/* Config: overflow visible so date-time calendars are not clipped.
   Drag still uses sibling .popup-drag (unchanged). */
#popup-AdhocTrendConfig {
	background-color: transparent;
	border: none;
	box-shadow: none;
	overflow: visible !important;
	scrollbar-width: none;
}

#popup-AdhocTrend::-webkit-scrollbar,
#popup-AdhocTrendConfig::-webkit-scrollbar {
	width: 0 !important;
	height: 0 !important;
	display: none !important;
}

/* Popup shell fills openPopup size — do NOT force nested embeds to 100% height
   (that painted Trend/config body over the custom faceplate header / close X). */
#popup-AdhocTrend > .body-wrapper,
#popup-AdhocTrend > .ia_popup__content,
#popup-AdhocTrend > .body-wrapper > .view-parent,
#popup-AdhocTrend > .ia_popup__content > .view-parent {
	height: 100% !important;
	width: 100% !important;
	min-height: 0 !important;
	min-width: 0 !important;
	max-height: 100% !important;
	max-width: 100% !important;
	overflow: hidden !important;
}

#popup-AdhocTrendConfig > .body-wrapper,
#popup-AdhocTrendConfig > .ia_popup__content,
#popup-AdhocTrendConfig > .body-wrapper > .view-parent,
#popup-AdhocTrendConfig > .ia_popup__content > .view-parent {
	height: 100% !important;
	width: 100% !important;
	min-height: 0 !important;
	min-width: 0 !important;
	max-height: none !important;
	max-width: 100% !important;
	overflow: visible !important;
}

#popup-AdhocTrend .psc-adhoc-trend-faceplate {
	height: 100% !important;
	width: 100% !important;
	min-height: 0 !important;
	min-width: 0 !important;
	overflow: hidden !important;
}

#popup-AdhocTrendConfig .psc-adhoc-trend-config-faceplate {
	height: 100% !important;
	width: 100% !important;
	min-height: 0 !important;
	min-width: 0 !important;
	overflow: visible !important;
}

/* Date-time picker calendar must paint above config chrome / siblings */
#popup-AdhocTrendConfig .ia_dateTimeInputComponent,
#popup-AdhocTrendConfig [data-component="ia.input.date-time-input"] {
	overflow: visible !important;
	position: relative;
	z-index: 60;
}

#popup-alertDialog .popup-header,
#popup-alertDialog .ia_popup__header {
	display: none !important;
}

/*
 * AdhocTrend / Config: match device faceplates — drag via .popup-drag.
 * Cover the custom 40px title bar; inset right so the in-view close X stays clickable.
 */
#popup-AdhocTrend > .popup-drag,
#popup-AdhocTrendConfig > .popup-drag {
	z-index: 100;
	top: 0;
	left: 0;
	right: 44px;
	width: auto;
	height: 40px;
	cursor: grab;
	pointer-events: auto;
}

#popup-AdhocTrend > .popup-drag:active,
#popup-AdhocTrendConfig > .popup-drag:active {
	cursor: grabbing;
}

.client-root .popup {
	box-shadow: none;
	background: transparent;
	border: none;
}

.ia_popup {
	box-shadow: none;
	background: transparent;
	border: none;
}

.ia_popup:focus {
	outline: none;
}

.ia_popup__header,
.popup-header {
	display: none !important;
	height: 0 !important;
	min-height: 0 !important;
	padding: 0 !important;
	margin: 0 !important;
	border: none !important;
	overflow: hidden !important;
}


