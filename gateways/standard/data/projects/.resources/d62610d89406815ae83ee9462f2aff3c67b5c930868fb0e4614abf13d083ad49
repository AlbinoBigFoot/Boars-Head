{
  "custom": {
    "active": false,
    "priority": 10,
    "unack": false
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "custom.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Active"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\tFalse,\r\n\tif(typeof({value}) = 'java.lang.Boolean',\r\n\t\t{value},\r\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.unack": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_Unack"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\tFalse,\r\n\tif(typeof({value}) = 'java.lang.Boolean',\r\n\t\t{value},\r\n\t\t{value} = True || {value} = 1 || {value} = 'true' || {value} = 'True'))",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.priority": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/_Alarms/_ActiveHighPriority"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t10,\r\n\t{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 20
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "case(\r\n\t{view.custom.priority},\r\n\t1, 'equipment/alarm_critical',\r\n\t2, 'equipment/alarm_high',\r\n\t3, 'equipment/alarm_medium',\r\n\t4, 'equipment/alarm_low',\r\n\t'equipment/alarm_critical'\r\n)"
              },
              "type": "expr"
            }
          },
          "meta.visible": {
            "binding": {
              "config": {
                "expression": "{view.custom.active}"
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "expression": "if({view.custom.active} && {view.custom.unack},\r\n\t'alarm-flash',\r\n\t'')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "equipment/alarm_critical",
          "style": {
            "height": "20px",
            "minHeight": "20px",
            "minWidth": "20px",
            "width": "20px"
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "height": "20px",
        "width": "20px"
      }
    },
    "type": "ia.container.flex"
  }
}
