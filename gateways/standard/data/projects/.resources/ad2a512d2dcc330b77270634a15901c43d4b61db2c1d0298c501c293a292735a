            "showControls": "{view.params.showControls}",
            "showInterlocks": "{view.params.showInterlocks}",
            "showTrend": "{view.params.showTrend}",
            "tagPath": "{view.params.tagPath}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\timport system\n\n\tresult = {\n\t\t'showControls': False,\n\t\t'showConfiguration': False,\n\t\t'showInterlocks': False,\n\t\t'showTrend': False,\n\t\t'showAlarmConfiguration': False,\n\t\t'showAlarms': False,\n\t\t'defaultTab': 'Controls'\n\t}\n\n\tdef parseHidden(text):\n\t\ts = set()\n\t\ttry:\n\t\t\tt = str(text or '')\n\t\t\tif t:\n\t\t\t\tt = t.replace(';', ',')\n\t\t\t\tfor item in t.split(','):\n\t\t\t\t\titem = item.strip()\n\t\t\t\t\tif item:\n\t\t\t\t\t\ts.add(item)\n\t\texcept Exception:\n\t\t\tpass\n\t\treturn s\n\n\tdef isHidden(fullPath, hidden_set):\n\t\tif not hidden_set:\n\t\t\treturn False\n\t\tif fullPath in hidden_set:\n\t\t\treturn True\n\t\tstripped = fullPath.split(']', 1)[-1] if ']' in fullPath else fullPath\n\t\tif stripped in hidden_set:\n\t\t\treturn True\n\t\treturn False\n\n\ttagPath = value.get('tagPath', '') if hasattr(value, 'get') else ''\n\tdeviceType = value.get('deviceType', '') if hasattr(value, 'get') else ''\n\tcallerControls = value.get('showControls', True) if hasattr(value, 'get') else True\n\tcallerConfiguration = value.get('showConfiguration', True) if hasattr(value, 'get') else True\n\tcallerInterlocks = value.get('showInterlocks', True) if hasattr(value, 'get') else True\n\tcallerTrend = value.get('showTrend', True) if hasattr(value, 'get') else True\n\tcallerAlarmCfg = value.get('showAlarmConfiguration', True) if hasattr(value, 'get') else True\n\tcallerAlarms = value.get('showAlarms', True) if hasattr(value, 'get') else True\n\thidTrend = parseHidden(value.get('hiddenFromTrend', '') if hasattr(value, 'get') else '')\n\thidCfg = parseHidden(value.get('hiddenFromConfiguration', '') if hasattr(value, 'get') else '')\n\thidAlarmCfg = parseHidden(value.get('hiddenFromAlarmConfiguration', '') if hasattr(value, 'get') else '')\n\thidAlarms = parseHidden(value.get('hiddenFromAlarms', '') if hasattr(value, 'get') else '')\n\n\t# Controls: device types that have a Controls asset\n\thasControlsAsset = str(deviceType or '') in ('Compressor', 'Pump', 'ExhaustFan', 'Valve', 'Tank', 'Sensor', 'Evaporator', 'CoolingTower', '')\n\tresult['showControls'] = bool(callerControls) and hasControlsAsset\n\n\t# Interlocks: Interlock folder usable\n\tshowIlk = False\n\tif tagPath and callerInterlocks:\n\t\ttry:\n\t\t\tq = system.tag.readBlocking([tagPath + '/Interlock/Sts_IntlkOK/Value'])[0]\n\t\t\tif str(q.quality) == 'Good' or (hasattr(q.quality, 'isGood') and q.quality.isGood()):\n\t\t\t\tshowIlk = True\n\t\texcept Exception:\n\t\t\tpass\n\t\tif not showIlk:\n\t\t\ttry:\n\t\t\t\ttxt = system.tag.readBlocking([tagPath + '/Interlock/Cfg_CondTxt00'])[0]\n\t\t\t\tif str(txt.quality) == 'Good' or (hasattr(txt.quality, 'isGood') and txt.quality.isGood()):\n\t\t\t\t\tif txt.value and str(txt.value).strip():\n\t\t\t\t\t\tshowIlk = True\n\t\t\texcept Exception:\n\t\t\t\tpass\n\t\tif not showIlk:\n\t\t\ttry:\n\t\t\t\tsts = system.tag.readBlocking([tagPath + '/Interlock/Sts_Intlk/Value'])[0]\n\t\t\t\tif str(sts.quality) == 'Good' or (hasattr(sts.quality, 'isGood') and sts.quality.isGood()):\n\t\t\t\t\tshowIlk = True\n\t\t\texcept Exception:\n\t\t\t\tpass\n\tresult['showInterlocks'] = showIlk\n\n\t# Browse leaves for Trend / Configuration / Alarm flags\n\tshowTrend = False\n\tshowCfg = False\n\tshowAlarmCfg = False\n\tshowAlarms = False\n\tif tagPath:\n\t\ttry:\n\t\t\tresults = system.tag.browse(path=tagPath, filter={'recursive': True}).getResults()\n\t\texcept Exception:\n\t\t\tresults = []\n\t\tleaves = []\n\t\tfor t in results or []:\n\t\t\ttry:\n\t\t\t\tif str(t['tagType']) != 'AtomicTag':\n\t\t\t\t\tcontinue\n\t\t\t\tfp = str(t['fullPath'])\n\t\t\t\tleaves.append(fp)\n\t\t\texcept Exception:\n\t\t\t\tpass\n\t\tfor leaf in leaves:\n\t\t\ttry:\n\t\t\t\tcfgs = system.tag.getConfiguration(leaf, False)\n\t\t\t\tif not cfgs:\n\t\t\t\t\tcontinue\n\t\t\t\tcfg = cfgs[0]\n\t\t\t\talarms = cfg.get('alarms') or []\n\t\t\t\thasAlarms = len(alarms) > 0\n\t\t\t\treadOnly = cfg.get('readOnly', False)\n\t\t\t\thist = cfg.get('historyEnabled', False)\n\t\t\t\tdt = str(cfg.get('dataType') or '')\n\t\t\t\tanalog = dt in ('Float4', 'Float8', 'Int1', 'Int2', 'Int4', 'Int8', 'Double')\n\t\t\t\tif hist and analog and not isHidden(leaf, hidTrend):\n\t\t\t\t\tshowTrend = True\n\t\t\t\tif (not readOnly) and (not hasAlarms) and dt and not isHidden(leaf, hidCfg):\n\t\t\t\t\tshowCfg = True\n\t\t\t\tif hasAlarms and not isHidden(leaf, hidAlarmCfg):\n\t\t\t\t\tshowAlarmCfg = True\n\t\t\t\tif hasAlarms and not isHidden(leaf, hidAlarms):\n\t\t\t\t\tshowAlarms = True\n\t\t\texcept Exception:\n\t\t\t\tpass\n\n\tresult['showTrend'] = bool(callerTrend) and showTrend\n\tresult['showConfiguration'] = bool(callerConfiguration) and showCfg\n\tresult['showAlarmConfiguration'] = bool(callerAlarmCfg) and showAlarmCfg\n\tresult['showAlarms'] = bool(callerAlarms) and showAlarms\n\n\t# BH Controls-first default tab order\n\torder = [\n\t\t('showControls', 'Controls'),\n\t\t('showConfiguration', 'Configuration'),\n\t\t('showInterlocks', 'Interlocks'),\n\t\t('showTrend', 'Trend'),\n\t\t('showAlarmConfiguration', 'Alarm Configuration'),\n\t\t('showAlarms', 'Alarms'),\n\t]\n\tresult['defaultTab'] = 'Controls'\n\tfor key, name in order:\n\t\tif result.get(key):\n\t\t\tresult['defaultTab'] = name\n\t\t\tbreak\n\treturn result\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
