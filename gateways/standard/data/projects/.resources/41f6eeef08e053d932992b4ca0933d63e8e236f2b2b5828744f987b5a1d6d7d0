{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "font-title",
            "color": "#000000",
            "fontSize": "20px",
            "fontWeight": "700",
            "marginBottom": "4px"
          },
          "text": "Alarm Journal"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Subtitle"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "classes": "font-label",
            "color": "#000000",
            "fontSize": "13px",
            "marginBottom": "12px"
          },
          "text": "Historical alarm events. Multi-select Device Type filters by tag folder (OR). Empty selection shows all."
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "DeviceTypeLabel"
            },
            "position": {
              "basis": "90px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "font-label",
                "alignItems": "center",
                "display": "flex",
                "fontWeight": "600"
              },
              "text": "Device Type"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "DeviceTypeDropdown"
            },
            "position": {
              "basis": "360px",
              "grow": 0,
              "shrink": 0
            },
            "props": {
              "dropdownOptionStyle": {
                "classes": "bg-component font-value"
              },
              "multiSelect": true,
              "options": [
                {
                  "label": "Evaporators",
                  "value": "Evaporators"
                },
                {
                  "label": "Compressors",
                  "value": "Compressors"
                },
                {
                  "label": "Pumps",
                  "value": "Pumps"
                },
                {
                  "label": "Exhaust Fans",
                  "value": "ExhaustFans"
                },
                {
                  "label": "Cooling Towers",
                  "value": "CoolingTowers"
                }
              ],
              "placeholder": {
                "text": "All device types"
              },
              "search": {
                "enabled": false
              },
              "style": {
                "classes": "bg-component container-card font-value",
                "height": "32px",
                "minWidth": "280px"
              },
              "value": null,
              "wrapMultiSelectValues": true
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "name": "Filters"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "style": {
            "gap": "8px",
            "marginBottom": "12px",
            "overflow": "visible"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "AlarmJournalTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.params.sourceFilter": {
            "binding": {
              "config": {
                "expression": "{../Filters/DeviceTypeDropdown.props.value}"
              },
              "transforms": [
                {
                  "code": "\treturn shared.Alarms.deviceTypeSourceFilter(value)",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          }
        },
        "props": {
          "params": {
            "sourceFilter": "*"
          },
          "path": "00_Pages/Alarms/_Assets/AlarmJournalTable",
          "style": {
            "height": "100%",
            "minHeight": "480px",
            "width": "100%"
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#D8D8D8",
        "height": "100%",
        "padding": "16px",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
