{
  "custom": {
    "label": "Fault",
    "metadata": {
      "longDescription": "evaporator status",
      "shortDescription": "status",
      "states": [
        {
          "label": "Off",
          "value": 0
        },
        {
          "label": "Cooling",
          "value": 1
        },
        {
          "label": "Defrost",
          "value": 2
        },
        {
          "label": "Fault",
          "value": 3
        },
        {
          "label": "Idle",
          "value": 5
        }
      ]
    },
    "quality": "Good",
    "states": [
      {
        "label": "Off",
        "value": 0
      },
      {
        "label": "Cooling",
        "value": 1
      },
      {
        "label": "Defrost",
        "value": 2
      },
      {
        "label": "Fault",
        "value": 3
      },
      {
        "label": "Idle",
        "value": 5
      }
    ],
    "value": 3,
    "tooltip": ""
  },
  "params": {
    "tagPath": "[default]Evaporators/EV-01/Status/Value"
  },
  "propConfig": {
    "custom.label": {
      "binding": {
        "config": {
          "expression": "if(isNull({view.custom.states}),\n\t{view.custom.value},\n\t{view.custom.value})"
        },
        "transforms": [
          {
            "code": "\tif value is None:\n\t\ttag_path = ''\n\t\ttry:\n\t\t\ttag_path = self.view.params.tagPath or ''\n\t\texcept:\n\t\t\tpass\n\t\tif str(tag_path).strip() == '':\n\t\t\treturn ''\n\t\tq = ''\n\t\ttry:\n\t\t\tq = str(self.custom.quality or '')\n\t\texcept:\n\t\t\tpass\n\t\tif q.startswith('Bad'):\n\t\t\treturn 'COMM LOSS'\n\t\treturn ''\n\ttry:\n\t\tv = int(value)\n\texcept:\n\t\treturn ''\n\t# Evaporator: stages inline beside DFT (DFT PD / HG / BLD / FD)\n\tcodes_evap = {\n\t\t0: 'STOP', 1: 'CLG', 2: 'DFT', 3: 'FLT', 5: 'IDLE',\n\t\t6: 'DFT PD', 7: 'DFT HG', 8: 'DFT BLD', 9: 'DFT FD'\n\t}\n\tcodes_run = {0: 'STOP', 1: 'RUN', 2: 'FLT', 4: 'IDLE'}\n\tstage_alias = {\n\t\t'PUMP DOWN': 'DFT PD', '1.PD': 'DFT PD', 'PD': 'DFT PD',\n\t\t'HOT GAS': 'DFT HG', '2.HG': 'DFT HG', 'HG': 'DFT HG',\n\t\t'BLEED': 'DFT BLD', '3.BLD': 'DFT BLD', 'BLD': 'DFT BLD',\n\t\t'FAN DELAY': 'DFT FD', '3.FD': 'DFT FD', 'FD': 'DFT FD'\n\t}\n\tstates = self.custom.states\n\tif states:\n\t\ttry:\n\t\t\tfor s in states:\n\t\t\t\tsv = s['value'] if hasattr(s, '__getitem__') else getattr(s, 'value', None)\n\t\t\t\tsl = s['label'] if hasattr(s, '__getitem__') else getattr(s, 'label', None)\n\t\t\t\tif sv is not None and int(sv) == v and sl not in (None, ''):\n\t\t\t\t\tkey = str(sl).strip().upper()\n\t\t\t\t\tif key in stage_alias:\n\t\t\t\t\t\treturn stage_alias[key]\n\t\t\t\t\talias = {\n\t\t\t\t\t\t'OFF': 'STOP', 'STOP': 'STOP', 'STOPPED': 'STOP',\n\t\t\t\t\t\t'COOLING': 'CLG', 'CLG': 'CLG',\n\t\t\t\t\t\t'DEFROST': 'DFT', 'DFT': 'DFT',\n\t\t\t\t\t\t'FAULT': 'FLT', 'ALARM': 'FLT', 'FLT': 'FLT',\n\t\t\t\t\t\t'IDLE': 'IDLE', 'STANDBY': 'IDLE', 'IDL': 'IDLE',\n\t\t\t\t\t\t'RUN': 'RUN', 'RUNNING': 'RUN', 'ON': 'RUN',\n\t\t\t\t\t\t'COMM LOSS': 'COMM LOSS', 'COMMLOSS': 'COMM LOSS', 'COMM': 'COMM LOSS'\n\t\t\t\t\t}\n\t\t\t\t\tif key in ('MANUAL', 'MAN') or v == 4:\n\t\t\t\t\t\treturn ''\n\t\t\t\t\treturn alias.get(key, key)\n\t\texcept:\n\t\t\tpass\n\tif v == 4:\n\t\treturn ''\n\ttag_path = ''\n\ttry:\n\t\ttag_path = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\ttp = tag_path.upper()\n\tif 'EVAPORATOR' in tp or '/EV-' in tp:\n\t\treturn codes_evap.get(v, '')\n\tif v == 1:\n\t\treturn 'RUN'\n\treturn codes_run.get(v, codes_evap.get(v, ''))\n",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}.Metadata"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\n\t'',\n\t{value})",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '',\n\t'Bad',\n\tqualityOf(tag({view.params.tagPath})))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.states": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || isBad(tag({view.params.tagPath})),\n\tnull,\n\tif(isBad(tag({view.params.tagPath} + '.Metadata')),\n\t\tnull,\n\t\ttag({view.params.tagPath} + '.Metadata')['states']))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "expression": "if({view.params.tagPath} = '' || isBad(tag({view.params.tagPath})),\n\tnull,\n\ttag({view.params.tagPath}))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.tooltip": {
      "binding": {
        "config": {
          "expression": "{view.custom.label}"
        },
        "transforms": [
          {
            "code": "\tcode = str(value or '').strip().upper()\n\ttips = {\n\t\t'CLG': 'Cooling',\n\t\t'COOLING': 'Cooling',\n\t\t'RUN': 'Running',\n\t\t'RUNNING': 'Running',\n\t\t'DFT': 'Defrost',\n\t\t'DEFROST': 'Defrost',\n\t\t'DFT PD': 'Defrost - Pump Down',\n\t\t'DFT HG': 'Defrost - Hot Gas',\n\t\t'DFT BLD': 'Defrost - Bleed',\n\t\t'DFT FD': 'Defrost - Fan Delay',\n\t\t'1.PD': 'Defrost - Pump Down',\n\t\t'2.HG': 'Defrost - Hot Gas',\n\t\t'3.BLD': 'Defrost - Bleed',\n\t\t'3.FD': 'Defrost - Fan Delay',\n\t\t'IDLE': 'Idle - Achieved Temp Setpoint',\n\t\t'STOP': 'Off - Unit disabled',\n\t\t'OFF': 'Off - Unit disabled',\n\t\t'FLT': 'Fault',\n\t\t'FAULT': 'Fault',\n\t\t'COMM LOSS': 'Communication loss',\n\t\t'COMMLOSS': 'Communication loss',\n\t\t'COMM': 'Communication loss'\n\t}\n\treturn tips.get(code, '')\n",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 22,
      "width": 96
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "StatusLabel"
        },
        "position": {
          "shrink": 0,
          "basis": "auto"
        },
        "propConfig": {
          "props.style.color": {
            "binding": {
              "config": {
                "expression": "{view.custom.label}"
              },
              "transforms": [
                {
                  "code": "\ts = str(value).strip().upper()\n\tif not s:\n\t\treturn 'transparent'\n\t# Match DFT with optional stage suffix (DFT PD / DFT HG / ...)\n\tif s == 'DFT' or s.startswith('DFT '):\n\t\treturn '#EC407A'\n\tcolors = {\n\t\t'COOLING': '#1E88E5',\n\t\t'CLG': '#1E88E5',\n\t\t'RUN': '#1E88E5',\n\t\t'RUNNING': '#1E88E5',\n\t\t'ON': '#1E88E5',\n\t\t'DEFROST': '#EC407A',\n\t\t'FAULT': '#C62828',\n\t\t'ALARM': '#C62828',\n\t\t'FLT': '#C62828',\n\t\t'COMM LOSS': '#C62828',\n\t\t'COMMLOSS': '#C62828',\n\t\t'COMM': '#C62828',\n\t\t'IDLE': '#228B22',\n\t\t'STANDBY': '#228B22',\n\t\t'IDL': '#228B22',\n\t\t'OFF': '#9E9E9E',\n\t\t'STOP': '#9E9E9E',\n\t\t'STOPPED': '#9E9E9E'\n\t}\n\treturn colors.get(s, '#607D8B')\n",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.custom.label"
              },
              "type": "property"
            }
          },
          "props.style.opacity": {
            "binding": {
              "config": {
                "expression": "if({view.custom.label} = '',\n   0,\n   1)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "fontSize": "12px",
            "fontWeight": "700",
            "minHeight": "16px",
            "textAlign": "center",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "center",
      "style": {
        "cursor": "pointer",
        "gap": "0px",
        "overflow": "visible",
        "minHeight": "22px",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.tooltip.text": {
        "binding": {
          "config": {
            "path": "view.custom.tooltip"
          },
          "type": "property"
        }
      },
      "meta.tooltip.enabled": {
        "binding": {
          "config": {
            "expression": "if(coalesce({view.custom.tooltip}, '') = '',\n\tfalse,\n\ttrue)"
          },
          "type": "expr"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
