{
  "custom": {},
  "params": {
    "tagPath": "[default]Evaporators"
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onRowClick": {
              "config": {
                "script": "\t# Device drill-down navigation can be wired later (no Navigation.Nav in BH yet).\n\tselectedData \u003d self.props.selection.data[0]\n\tif \u0027tagPath\u0027 in selectedData.keys() and selectedData[\u0027tagPath\u0027] !\u003d \u0027\u0027:\n\t\tpass"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Table"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.columns": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagPath": "{view.params.tagPath}"
                },
                "tagPath": "{tagPath}/Overview/Instances/Value[\"columns\"]"
              },
              "transforms": [
                {
                  "expression": "if(isNull({value}),\u0027\u0027,{value})",
                  "type": "expression"
                }
              ],
              "type": "tag"
            }
          },
          "props.data": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "tagPath": "{view.params.tagPath}"
                },
                "tagPath": "{tagPath}/Overview/Instances/Value[\"data\"]"
              },
              "transforms": [
                {
                  "expression": "if(isNull({value}),\u0027\u0027,{value})",
                  "type": "expression"
                }
              ],
              "type": "tag"
            }
          }
        },
        "props": {
          "bodyStyle": {
            "classes": "Fonts/Value"
          },
          "filter": {
            "enabled": true,
            "style": {
              "classes": "Fonts/Title"
            }
          },
          "headerStyle": {
            "classes": "Colors/Header Fonts/Label"
          },
          "pager": {
            "bottom": false
          },
          "rows": {
            "height": "30px",
            "style": {
              "borderBottomColor": "--neutral-30",
              "borderBottomStyle": "solid",
              "borderBottomWidth": "1.5px",
              "classes": "Colors/Component Fonts/Value",
              "cursor": "pointer"
            }
          },
          "style": {
            "borderStyle": "none"
          }
        },
        "type": "ia.display.table"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Colors/Container Container/Card"
      }
    },
    "type": "ia.container.flex"
  }
}