def doPost(request, session):
	data = request['data']
	# Site-rail hover highlight: {"__hover": true, "page": "/plants/groveport"}
	try:
		isHover = data is not None and data.get('__hover') == True
	except:
		isHover = False
	if isHover:
		page = ''
		try:
			page = str(data.get('page') or '')
		except:
			page = ''
		system.tag.writeBlocking(['[default]_Config/MapMarkerHover'], [page])
		return

	# GeoJSON FeatureCollection updates markers.
	try:
		isGeo = data is not None and data['type'] == 'FeatureCollection'
	except:
		isGeo = False
	if isGeo:
		system.tag.writeBlocking(['[default]_Config/MapMarkerGeoJson'], [data])
		return

	# Navigation document write: {"__nav": true, "items": [...]}
	try:
		isNav = data is not None and data.get('__nav') == True and data.get('items') is not None
	except:
		isNav = False
	if isNav:
		system.tag.writeBlocking(['[default]_Config/Navigation'], [{'items': data['items']}])
		try:
			Navigation.Nav.flushCache()
		except:
			pass
		return

	system.tag.writeBlocking(['[default]_Config/MapMarkerNavigation'], [data])
