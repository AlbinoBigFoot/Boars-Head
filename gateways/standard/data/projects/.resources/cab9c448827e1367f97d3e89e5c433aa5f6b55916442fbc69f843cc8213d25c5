                "color": "var(--text-on-accent)",
                "textAlign": "center"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Count"
        },
        "position": {
          "height": 0.56,
          "width": 0.56,
          "x": -0.04,
          "y": -0.04
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "session.custom.AdhocTrend.tags"
