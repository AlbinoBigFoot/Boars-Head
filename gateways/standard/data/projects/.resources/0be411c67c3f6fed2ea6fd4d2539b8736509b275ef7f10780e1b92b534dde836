{
  "custom": {
    "flash": true,
    "icon": "03_Elements/01_Status/NotificationIcons/Alarms/Medium",
    "metadata": "",
    "tagName": "EV-001",
    "tagPath": "[default]Evaporators/EV-001",
    "textAlign": "left"
  },
  "params": {
    "value": "[default]Evaporators/EV-001"
  },
  "propConfig": {
    "custom.flash": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "value": "{view.params.value}"
          },
          "tagPath": "{value}/_Alarms/_Flash"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\tFalse,\r\n\t{value}\r\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.icon": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "value": "{view.params.value}"
          },
          "tagPath": "{value}/_Alarms/_Icon"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t\u002703_Elements/01_Status/NotificationIcons/Blank\u0027,\r\n\t{value}\r\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.metadata": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "expression",
          "tagPath": "tag({tagPath} + \".metadata\""
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t\"\",\r\n\t{value}\r\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagName": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}.Name"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t\"\",\r\n\t{value}\r\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.textAlign": {
      "persistent": true
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 30,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "view.custom.flash"
              },
              "type": "property"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.custom.icon"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.view"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "metadata": "{view.custom.metadata}",
                  "tagName": "{view.custom.tagName}",
                  "tagPath": "{view.params.value}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "expression": "if(\r\n\tindexOf({value}[\u0027tagPath\u0027], \"AppliedDigital\") \u003e\u003d 0 || indexOf({value}[\u0027tagPath\u0027], \"HDB\") \u003e\u003d 0,\r\n\tconcat(\r\n\t\tsplit({value}[\u0027tagPath\u0027],\u0027/\u0027)[len(split({value}[\u0027tagPath\u0027],\u0027/\u0027))-2,0],\r\n\t\t\"-\",\r\n\t\tsplit({value}[\u0027tagPath\u0027],\u0027/\u0027)[len(split({value}[\u0027tagPath\u0027],\u0027/\u0027))-1,0]\r\n\t),\r\n\tif(\r\n\t\t{value}[\u0027metadata\u0027] !\u003d \u0027\u0027,\r\n\t\tif(\r\n\t\t\t{value}[\u0027metadata\u0027][\u0027shortDescription\u0027] !\u003d \"\",\r\n\t\t\t{value}[\u0027metadata\u0027][\u0027shortDescription\u0027],\r\n\t\t\tif(\r\n\t\t\t\t{value}[\u0027tagName\u0027] !\u003d \"\",\r\n\t\t\t\t{value}[\u0027tagName\u0027],\r\n\t\t\t\t\"\"\r\n\t\t\t)\r\n\t\t),\r\n\t\t{value}[\u0027tagName\u0027]\r\n\t)\r\n)",
                  "type": "expression"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.textStyle.textAlign": {
            "binding": {
              "config": {
                "path": "view.custom.textAlign"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "font-label",
            "marginLeft": "2%",
            "marginTop": "1%"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "minHeight": 20,
        "overflow": "hidden",
        "paddingLeft": "5%"
      }
    },
    "type": "ia.container.flex"
  }
}