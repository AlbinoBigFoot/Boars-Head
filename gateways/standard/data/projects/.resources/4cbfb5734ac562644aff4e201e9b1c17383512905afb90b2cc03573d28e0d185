{
  "custom": {},
  "params": {
    "tagPath": "[default]Evaporators",
    "typeId": ""
  },
  "propConfig": {
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.typeId": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {},
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onRowClick": {
              "config": {
                "script": "\tselectedData = self.props.selection.data[0]\n\tif 'tagPath' not in selectedData.keys() or not selectedData['tagPath']:\n\t\treturn\n\ttagPath = str(selectedData['tagPath'])\n\ttypeId = ''\n\ttry:\n\t\tcfg = system.tag.getConfiguration(tagPath, False)\n\t\tif cfg:\n\t\t\ttypeId = str(cfg[0].get('typeId') or '')\n\texcept:\n\t\ttypeId = ''\n\tfaceplate = typeId.split('/')[-1] if typeId else ''\n\tif not faceplate:\n\t\trel = tagPath.split(']', 1)[-1].lstrip('/')\n\t\tfolder = rel.split('/')[0] if rel else ''\n\t\tfaceplates = {\n\t\t\t'Evaporators': 'Evaporator',\n\t\t\t'CoolingTowers': 'CoolingTower',\n\t\t\t'Compressors': 'Compressor',\n\t\t\t'Pumps': 'Pump',\n\t\t\t'ExhaustFans': 'ExhaustFan',\n\t\t\t'Tanks': 'Tank',\n\t\t}\n\t\tfaceplate = faceplates.get(folder, '')\n\tif not faceplate:\n\t\treturn\n\tviewPath = '01_Popups/00_Faceplates/' + faceplate\n\ttitle = tagPath.split('/')[-1]\n\tNavigation.Faceplate.openFaceplate('unit-ov-%s' % tagPath, tagPath, viewPath, False, title)\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Table"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.columns": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "struct": {
                  "tagPath": "{view.params.tagPath}",
                  "typeId": "{view.params.typeId}",
                  "instances": "tag(toString({view.params.tagPath}) + '/Overview/Instances/Value')"
                },
                "waitOnAll": false
              },
              "transforms": [
                {
                  "code": "\ttagPath = value.get('tagPath')\n\ttypeId = value.get('typeId') or ''\n\tinstances = value.get('instances')\n\tif typeId:\n\t\tpayload = shared.Overview.buildInstancesPayloadForType(tagPath, typeId)\n\telif instances is not None:\n\t\tpayload = instances\n\telse:\n\t\tpayload = shared.Overview.buildInstancesPayload(tagPath)\n\tif not payload:\n\t\treturn []\n\ttry:\n\t\treturn payload.get('columns', [])\n\texcept:\n\t\treturn payload['columns'] if payload else []\n",
                  "type": "script"
                }
              ]
            }
          },
          "props.data": {
            "binding": {
              "type": "expr-struct",
              "config": {
                "struct": {
                  "tagPath": "{view.params.tagPath}",
                  "typeId": "{view.params.typeId}",
                  "instances": "tag(toString({view.params.tagPath}) + '/Overview/Instances/Value')"
                },
                "waitOnAll": false
              },
              "transforms": [
                {
                  "code": "\ttagPath = value.get('tagPath')\n\ttypeId = value.get('typeId') or ''\n\tinstances = value.get('instances')\n\tif typeId:\n\t\tpayload = shared.Overview.buildInstancesPayloadForType(tagPath, typeId)\n\telif instances is not None:\n\t\tpayload = instances\n\telse:\n\t\tpayload = shared.Overview.buildInstancesPayload(tagPath)\n\tif not payload:\n\t\treturn []\n\ttry:\n\t\treturn payload.get('data', [])\n\texcept:\n\t\treturn payload['data'] if payload else []\n",
                  "type": "script"
                }
              ]
            }
          }
        },
        "props": {
          "bodyStyle": {
            "classes": "font-value"
          },
          "filter": {
            "enabled": true,
            "style": {
              "classes": "font-title"
            }
          },
          "headerStyle": {
            "classes": "bg-header font-label"
          },
          "pager": {
            "bottom": false
          },
          "rows": {
            "height": "30px",
            "style": {
              "borderBottomColor": "--neutral-30",
              "borderBottomStyle": "solid",
              "borderBottomWidth": "1.5px",
              "classes": "bg-component font-value",
              "cursor": "pointer"
            }
          },
          "selection": {
            "data": [
              {
                "Pressure": "[default]Evaporators/EV-04/Pressure",
                "Status": "[default]Evaporators/EV-04/Status",
                "Temp": "[default]Evaporators/EV-04/Temp",
                "tagPath": "[default]Evaporators/EV-04"
              }
            ],
            "selectedColumn": "tagPath",
            "selectedRow": 6
          },
          "style": {
            "borderStyle": "none",
            "classes": "unit-overview-table",
            "minWidth": 0,
            "maxWidth": "100%",
            "overflowX": "hidden",
            "width": "100%"
          }
        },
        "type": "ia.display.table"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-container container-card unit-overview-host",
        "minWidth": 0,
        "overflowX": "hidden",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
