{
  "custom": {},
  "params": {
    "sourceFilter": "*"
  },
  "propConfig": {
    "params.sourceFilter": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 600,
      "width": 960
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AlarmJournalTable"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.filter.conditions.source": {
            "binding": {
              "config": {
                "path": "view.params.sourceFilter"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "columns": {
            "ackNotes": {
              "enabled": false
            },
            "displayPath": {
              "enabled": false,
              "width": 200
            },
            "eventId": {
              "enabled": false
            },
            "eventState": {
              "enabled": true,
              "order": 3,
              "width": 100
            },
            "eventTime": {
              "sort": "descending",
              "width": 150
            },
            "eventValue": {
              "enabled": false
            },
            "label": {
              "enabled": true,
              "order": 4,
              "width": 280
            },
            "priority": {
              "enabled": true,
              "order": 1,
              "width": 90
            },
            "source": {
              "enabled": false
            },
            "state": {
              "enabled": true,
              "order": 2,
              "width": 160
            }
          },
          "dateFormat": "YYYY-MM-DD HH:mm:ss",
          "enableDetails": true,
          "filter": {
            "conditions": {
              "source": "*"
            },
            "events": {
              "acked": true,
              "active": true,
              "cleared": true
            },
            "priorities": {
              "critical": true,
              "high": true,
              "low": true,
              "medium": true
            }
          },
          "name": "MSSQL",
          "pager": {
            "enabled": true
          },
          "responsive": {
            "breakpoint": 700,
            "enabled": true
          },
          "rowStyles": {
            "acked": {
              "base": {
                "fontSize": "0.85em",
                "fontWeight": "500"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "var(--alarm-critical-ack)",
                  "classes": "alarm-row-critical-ack",
                  "color": "var(--alarm-row-fg-light)"
                },
                "high": {
                  "backgroundColor": "var(--alarm-high-ack)",
                  "classes": "alarm-row-high-ack",
                  "color": "var(--alarm-row-fg-light)"
                },
                "low": {
                  "backgroundColor": "var(--alarm-low-ack)",
                  "classes": "alarm-row-low-ack",
                  "color": "var(--alarm-row-fg-light)"
                },
                "medium": {
                  "backgroundColor": "var(--alarm-medium-ack)",
                  "classes": "alarm-row-medium-ack",
                  "color": "var(--alarm-row-fg-light)"
                }
              }
            },
            "active": {
              "base": {
                "fontSize": "0.85em",
                "fontWeight": "500"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "var(--alarm-critical)",
                  "classes": "alarm-row-critical",
                  "color": "var(--alarm-row-fg-light)"
                },
                "high": {
                  "backgroundColor": "var(--alarm-high)",
                  "classes": "alarm-row-high",
                  "color": "var(--alarm-row-fg-light)"
                },
                "low": {
                  "backgroundColor": "var(--alarm-low)",
                  "classes": "alarm-row-low",
                  "color": "var(--alarm-row-fg-light)"
                },
                "medium": {
                  "backgroundColor": "var(--alarm-medium)",
                  "classes": "alarm-row-medium",
                  "color": "var(--alarm-row-fg-dark)"
                }
              }
            },
            "cleared": {
              "base": {
                "classes": "alarm-row-cleared",
                "fontSize": "0.85em"
              },
              "priorities": {
                "critical": {
                  "classes": "alarm-row-cleared"
                },
                "high": {
                  "classes": "alarm-row-cleared"
                },
                "low": {
                  "classes": "alarm-row-cleared"
                },
                "medium": {
                  "classes": "alarm-row-cleared"
                }
              }
            }
          },
          "style": {
            "classes": "font-label",
            "height": "100%",
            "width": "100%"
          },
          "toolbar": {
            "enableConfiguration": false,
            "enableDateRange": true,
            "enableFilter": true,
            "enablePreFilters": true,
            "enabled": true
          }
        },
        "type": "ia.display.alarmjournaltable"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "height": "100%",
        "width": "100%"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
