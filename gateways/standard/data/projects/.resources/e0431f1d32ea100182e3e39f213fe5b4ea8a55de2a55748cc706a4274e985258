        "transforms": [
          {
            "code": "\tif value is None:\n\t\t# Priority: Comm Loss (Bad quality) wins over Fault/other Status enum\n\t\t# Bad quality means PLC bits cannot be trusted.\n\t\ttag_path = ''\n\t\ttry:\n\t\t\ttag_path = self.view.params.tagPath or ''\n\t\texcept:\n\t\t\tpass\n\t\tif str(tag_path).strip() == '':\n\t\t\treturn ''\n\t\tq = ''\n\t\ttry:\n\t\t\tq = str(self.custom.quality or '')\n\t\texcept:\n\t\t\tpass\n\t\tif q.startswith('Bad'):\n\t\t\treturn 'Comm Loss'\n\t\treturn ''\n\ttry:\n\t\tv = int(value)\n\texcept:\n\t\treturn ''\n\t# Operator display codes (Monday 12654167899): COOL/DEF/OFF/IDLE/Operator + defrost steps.\n\t# Prefer tag metadata.states labels; never force CLG for value 1 (breaks Run devices).\n\talias = {\n\t\t'OFF': 'OFF', 'STOP': 'OFF', 'STOPPED': 'OFF',\n\t\t'COOLING': 'COOL', 'COOL': 'COOL', 'CLG': 'COOL',\n\t\t'DEFROST': 'DEF', 'DEF': 'DEF', 'DFT': 'DEF',\n\t\t'FAULT': 'FLT', 'ALARM': 'FLT', 'FLT': 'FLT',\n\t\t'IDLE': 'IDLE', 'STANDBY': 'IDLE', 'IDL': 'IDLE',\n\t\t'RUN': 'RUN', 'RUNNING': 'RUN', 'ON': 'RUN',\n\t\t'MANUAL': 'Operator', 'MAN': 'Operator', 'OPERATOR': 'Operator',\n\t\t'PUMP DOWN': '1.PD', '1.PD': '1.PD', 'PD': '1.PD',\n\t\t'HOT GAS': '2.HG', '2.HG': '2.HG', 'HG': '2.HG',\n\t\t'BLEED': '3.BLD', '3.BLD': '3.BLD', 'BLD': '3.BLD',\n\t\t'FAN DELAY': '3.FD', '3.FD': '3.FD', 'FD': '3.FD',\n\t\t'COMM LOSS': 'Comm Loss', 'COMMLOSS': 'Comm Loss', 'COMM': 'Comm Loss'\n\t}\n\t# Evaporator-shaped numeric fallback (0-9)\n\tcodes_evap = {0: 'OFF', 1: 'COOL', 2: 'DEF', 3: 'FLT', 4: 'Operator', 5: 'IDLE', 6: '1.PD', 7: '2.HG', 8: '3.BLD', 9: '3.FD'}\n\t# Non-EV Run-shaped numeric fallback\n\tcodes_run = {0: 'OFF', 1: 'RUN', 2: 'FLT', 3: 'Operator', 4: 'IDLE'}\n\tstates = self.custom.states\n\tif states:\n\t\ttry:\n\t\t\tfor s in states:\n\t\t\t\tsv = s['value'] if hasattr(s, '__getitem__') else getattr(s, 'value', None)\n\t\t\t\tsl = s['label'] if hasattr(s, '__getitem__') else getattr(s, 'label', None)\n\t\t\t\tif sv is not None and int(sv) == v and sl not in (None, ''):\n\t\t\t\t\tkey = str(sl).strip().upper()\n\t\t\t\t\treturn alias.get(key, codes_evap.get(v, key))\n\t\texcept:\n\t\t\tpass\n\ttag_path = ''\n\ttry:\n\t\ttag_path = str(self.view.params.tagPath or '')\n\texcept:\n\t\tpass\n\ttp = tag_path.upper()\n\tif 'EVAPORATOR' in tp or '/EV-' in tp:\n\t\treturn codes_evap.get(v, '')\n\treturn codes_run.get(v, codes_evap.get(v, ''))\n",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    },
