            "code": "\tcode = str(value or '').strip().upper()\n\ttips = {\n\t\t'COOL': 'Cooling',\n\t\t'COOLING': 'Cooling',\n\t\t'CLG': 'Cooling',\n\t\t'DEF': 'Defrost w. step indication',\n\t\t'DEFROST': 'Defrost w. step indication',\n\t\t'DFT': 'Defrost w. step indication',\n\t\t'1.PD': 'Pump Down',\n\t\t'2.HG': 'Hot Gas',\n\t\t'3.BLD': 'Bleed',\n\t\t'3.FD': 'Fan Delay',\n\t\t'IDLE': 'Achieved Temp Setpoint',\n\t\t'OFF': 'Unit disabled',\n\t\t'STOP': 'Unit disabled',\n\t\t'OPERATOR': 'Any object in manual/operator mode for the equipment',\n\t\t'MANUAL': 'Any object in manual/operator mode for the equipment',\n\t\t'MAN': 'Any object in manual/operator mode for the equipment',\n\t\t'FLT': 'Fault',\n\t\t'FAULT': 'Fault',\n\t\t'RUN': 'Running',\n\t\t'COMM LOSS': 'Communication loss',\n\t\t'COMMLOSS': 'Communication loss'\n\t}\n\treturn tips.get(code, '')\n",
            "type": "script"
          }
        ],
        "type": "expr"
      },
      "persistent": true
    }
