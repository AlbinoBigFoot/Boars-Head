{
  "custom": {},
  "params": {
    "rowData": ""
  },
  "propConfig": {
    "params.rowData": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 180
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tfrom shared import Alerts\n\timport Navigation\n\n\trow = self.view.params.rowData\n\tif not row:\n\t\tAlerts.showAlert(\n\t\t\tstate=\"warning\",\n\t\t\ttitle=\"Cannot Load\",\n\t\t\tmessage=\"Missing trend row data.\",\n\t\t\tshowCloseBtn=True,\n\t\t\tbtnTextPrimary=\"OK\",\n\t\t\tbtnActionPrimary=\"closeAlert\"\n\t\t)\n\t\treturn\n\n\tdefaults = {\n\t\t\"tags\": [],\n\t\t\"colors\": [\"#008FFB\", \"#34C759\", \"#FFA726\", \"#FF4560\", \"#775DD0\", \"#1C4E80\", \"#008080\", \"#26C6DA\", \"#4F4F4F\", \"#6C757D\"],\n\t\t\"realtime\": True,\n\t\t\"timeRange\": 1,\n\t\t\"pointCount\": 120,\n\t\t\"chartType\": \"line\",\n\t\t\"aggregate\": \"Average\",\n\t\t\"trendId\": \"\",\n\t\t\"trendName\": \"\",\n\t\t\"username\": \"\",\n\t\t\"isShared\": True,\n\t\t\"startDate\": system.date.addHours(system.date.now(), -8),\n\t\t\"endDate\": system.date.now()\n\t}\n\tloaded_config = system.util.jsonDecode(row.trend_config)\n\tfor key in [\"startDate\", \"endDate\"]:\n\t\tif key in loaded_config:\n\t\t\ttry:\n\t\t\t\tloaded_config[key] = system.date.parse(loaded_config[key])\n\t\t\texcept:\n\t\t\t\tloaded_config[key] = system.date.parse(loaded_config[key], \"MMM d, yyyy, h:mm:ss a\")\n\n\tmerged = dict(defaults)\n\tmerged.update(loaded_config)\n\tmerged.update({\n\t\t\"trendId\": row.id,\n\t\t\"trendName\": row.trend_name,\n\t\t\"username\": row.username,\n\t\t\"isShared\": row.is_shared\n\t})\n\tself.session.custom.AdhocTrend = merged\n\tNavigation.Nav.navigate({\"viewPath\": \"98_Configuration/AdhocTrend/Trend\"})\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "LoadButton"
        },
        "position": {
          "basis": "78px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "image": {
            "height": 16,
            "icon": {
              "path": "material/show_chart"
            },
            "width": 16
          },
          "style": {
            "classes": "Container/Button Fonts/Button adhoc-trend-load-delete-btn",
            "minHeight": "28px",
            "minWidth": "72px",
            "paddingLeft": "6px",
            "paddingRight": "8px"
          },
          "text": "Load"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tfrom shared import Alerts\n\n\trow = self.view.params.rowData\n\tif not row:\n\t\treturn\n\tpayload_data = {\"trendId\": row.id}\n\tAlerts.showAlert(\n\t\tstate=\"info\",\n\t\ttitle=\"Confirm Deletion\",\n\t\tmessage=\"Are you sure you want to permanently delete this custom trend?\",\n\t\tshowCloseBtn=False,\n\t\tbtnTextPrimary=\"Delete\",\n\t\tbtnIconPrimary=\"material/delete\",\n\t\tbtnActionPrimary=\"TrendDeleteConfirm\",\n\t\tbtnTextSecondary=\"Cancel\",\n\t\tbtnIconSecondary=\"material/cancel\",\n\t\tbtnActionSecondary=\"TrendDeleteCancel\",\n\t\tpayload=payload_data\n\t)\n"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "DeleteButton"
        },
        "position": {
          "basis": "84px",
          "grow": 0,
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "struct": {
                  "rowData": "{view.params.rowData}",
                  "username": "{session.props.auth.user.userName}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\t# Unauthenticated sessions report blank userName; saves use \"anonymous\".\n\tif value.rowData and \"username\" in value.rowData:\n\t\tsession_user = value.username if value.username else \"anonymous\"\n\t\treturn session_user == value.rowData[\"username\"]\n\treturn False\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "image": {
            "height": 16,
            "icon": {
              "path": "material/delete"
            },
            "width": 16
          },
          "style": {
            "classes": "Container/Button Fonts/Button adhoc-trend-load-delete-btn",
            "marginLeft": "8px",
            "minHeight": "28px",
            "minWidth": "78px",
            "paddingLeft": "6px",
            "paddingRight": "8px"
          },
          "text": "Delete"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "alignItems": "center",
      "justify": "flex-start",
      "style": {
        "classes": "adhoc-trend-load-delete-row",
        "overflow": "visible",
        "paddingBottom": "2px",
        "paddingLeft": "4px",
        "paddingRight": "4px",
        "paddingTop": "2px"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
