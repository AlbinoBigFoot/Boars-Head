        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "dropdownOptionStyle": {
            "classes": "font-label"
          },
          "options": [
            {
              "label": "2 Hours",
              "value": 2
            },
            {
              "label": "4 Hours",
              "value": 4
            },
            {
              "label": "8 Hours",
              "value": 8
            },
            {
              "label": "24 Hours",
              "value": 24
            }
          ],
          "search": {
            "enabled": false
          },
          "style": {
            "background": "var(--neutral-30)",
            "borderBottomLeftRadius": "var(--radius-xxs, 2px)",
            "borderBottomRightRadius": "var(--radius-xxs, 2px)",
            "borderColor": "#161616",
            "borderTopLeftRadius": "var(--radius-xxs, 2px)",
            "borderTopRightRadius": "var(--radius-xxs, 2px)",
            "borderWidth": 1,
            "classes": "font-label",
            "cursor": "pointer",
            "height": "24px",
            "marginLeft": "2px",
            "marginTop": "2px",
            "width": "100px"
          },
          "value": 2
        },
        "type": "ia.input.dropdown"
      },
      {
        "meta": {
          "name": "AnalogChart"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "props.series": {
            "binding": {
              "config": {
                "struct": {
                  "chartData": "{view.custom.chartDataAnalog}",
                  "sensors": "{view.custom.sensors.analog}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tsensors = value.get('sensors') or []\n\tdata = value.get('chartData')\n\tseries = []\n\n\tif data is None:\n\t\treturn series\n\n\ttry:\n\t\trow_count = data.getRowCount()\n\texcept:\n\t\trow_count = 0\n\tif row_count <= 0:\n\t\treturn series\n\n\ttry:\n\t\tcol_names = list(data.getColumnNames())\n\texcept:\n\t\ttry:\n\t\t\tcol_names = [data.getColumnName(i) for i in range(data.getColumnCount())]\n\t\texcept:\n\t\t\treturn series\n\n\tdef add_series(name, column):\n\t\tif column not in col_names or column == 't_stamp':\n\t\t\treturn\n\t\ttry:\n\t\t\tfiltered = system.dataset.filterColumns(data, ['t_stamp', column])\n\t\texcept:\n\t\t\treturn\n\t\tseries.append({'name': name or column, 'data': filtered})\n\n\tused = set()\n\tfor s in sensors:\n\t\talias = s.get('alias', '') if hasattr(s, 'get') else ''\n\t\tpath = s.get('path', '') if hasattr(s, 'get') else ''\n\t\tcol = None\n\t\tif alias and alias in col_names:\n\t\t\tcol = alias\n\t\telif path and path in col_names:\n\t\t\tcol = path\n\t\telse:\n\t\t\tleaf = (path or '').rsplit('/', 1)[-1]\n\t\t\tfor n in col_names:\n\t\t\t\tif n == 't_stamp':\n\t\t\t\t\tcontinue\n\t\t\t\tif n == leaf or n.endswith('/' + leaf) or (alias and (n == alias or n.endswith('/' + alias))):\n\t\t\t\t\tcol = n\n\t\t\t\t\tbreak\n\t\tif col and col not in used:\n\t\t\tadd_series(alias or col, col)\n\t\t\tused.add(col)\n\n\tif not series:\n\t\tfor column in col_names:\n\t\t\tif column != 't_stamp':\n\t\t\t\tadd_series(column, column)\n\n\treturn series",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.style.display": {
            "binding": {
              "config": {
                "expression": "if(len({view.custom.sensors.analog}) > 0, 'block', 'none')"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "options": {
            "chart": {
              "events": {
                "animationEnd": false,
                "beforeMount": false,
                "beforeResetZoom": false,
                "beforeZoom": false,
                "brushScrolled": false,
                "click": false,
                "dataPointMouseEnter": false,
                "dataPointMouseLeave": false,
                "dataPointSelection": false,
                "legendClick": false,
                "markerClick": false,
                "mounted": false,
                "mouseLeave": false,
                "mouseMove": false,
                "scrolled": false,
                "selection": false,
                "updated": false,
                "xAxisLabelClick": false,
                "zoomed": false
              },
              "height": 350,
              "stacked": false,
              "toolbar": {
                "show": true
              },
              "type": "line"
            },
            "dataLabels": {
              "enabled": false
            },
            "fill": {
              "opacity": 1
            },
            "legend": {
              "position": "bottom",
              "show": true,
              "showForSingleSeries": true
            },
            "markers": {
              "size": 0
            },
            "stroke": {
              "width": 1
            },
            "tooltip": {
              "enabled": true,
              "x": {
                "format": "HH:mm:ss",
                "show": true
              }
            },
            "xaxis": {
              "labels": {
                "datetimeFormatter": {
                  "day": "dd MMM",
                  "hour": "hh:mm",
                  "minute": "hh:mm:ss",
                  "month": "MMM YY",
                  "year": "yyyy"
                },
                "datetimeUTC": false,
                "show": true
              },
              "type": "datetime"
            },
            "yaxis": [
              {
                "decimalsInFloat": 1,
                "opposite": false,
                "title": {
                  "style": {
                    "fontFamily": "Poppins",
                    "fontWeight": 400
                  },
                  "text": ""
                }
              }
            ]
          },
          "style": {
            "background": "var(--neutral-40)"
          }
        },
        "type": "kyvislabs.display.apexchart"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "4px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
