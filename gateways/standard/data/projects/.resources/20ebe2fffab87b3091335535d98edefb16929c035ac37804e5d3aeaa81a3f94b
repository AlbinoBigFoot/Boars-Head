{
  "custom": {
    "chartDataAnalog": null,
    "sensors": {
      "analog": []
    }
  },
  "params": {
    "hiddenTags": "",
    "tagPath": ""
  },
  "propConfig": {
    "custom.chartDataAnalog": {
      "binding": {
        "config": {
          "struct": {
            "hours": "{view.root.children.Dropdown.props.value}",
            "sensors": "{view.custom.sensors.analog}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tresult = None\n\tsensors = value.get('sensors') or []\n\thours = value.get('hours')\n\tif not sensors:\n\t\treturn result\n\n\ttry:\n\t\thours = int(hours) if hours is not None else 2\n\texcept:\n\t\thours = 2\n\tif hours <= 0:\n\t\thours = 2\n\n\tpaths = []\n\taliases = []\n\tfor s in sensors:\n\t\tif not hasattr(s, 'get'):\n\t\t\tcontinue\n\t\tpath = s.get('path')\n\t\tif not path:\n\t\t\tcontinue\n\t\tpaths.append(str(path))\n\t\talias = s.get('alias')\n\t\taliases.append(str(alias) if alias else str(path).rsplit('/', 1)[-1])\n\n\tif not paths:\n\t\treturn result\n\n\tend = system.date.now()\n\tstart = system.date.addHours(end, -hours)\n\n\ttry:\n\t\tresult = system.tag.queryTagHistory(\n\t\t\tpaths=paths,\n\t\t\tstartDate=start,\n\t\t\tendDate=end,\n\t\t\treturnSize=100,\n\t\t\taggregationMode='Average',\n\t\t\treturnFormat='Wide',\n\t\t\tcolumnNames=aliases\n\t\t)\n\texcept:\n\t\tresult = None\n\n\treturn result",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "custom.sensors": {
      "binding": {
        "config": {
          "struct": {
            "hiddenTags": "{view.params.hiddenTags}",
            "tagPath": "{view.params.tagPath}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tresult = {'analog': []}\n\ttrend_key = value.get('trendKey', '')\n\ttag_path = value.get('tagPath', '')\n\thiddenTagsInput = value.get('hiddenTags', '')\n\tif tag_path:\n\t\ttag_path = tag_path.rstrip('/')\n\tif not tag_path:\n\t\treturn result\n\n\t# Parse hiddenTags\n\thidden_set = set()\n\ttry:\n\t\ttext = str(hiddenTagsInput or '')\n\t\tif text:\n\t\t\ttext = text.replace(';', ',')\n\t\t\tfor item in text.split(','):\n\t\t\t\titem = item.strip()\n\t\t\t\tif item:\n\t\t\t\t\thidden_set.add(item)\n\texcept Exception:\n\t\tpass\n\n\tdef isHidden(fullPath):\n\t\tif not hidden_set:\n\t\t\treturn False\n\t\tif fullPath in hidden_set:\n\t\t\treturn True\n\t\t# Accept a provider-stripped form (no leading [provider])\n\t\tstripped = fullPath.split(']', 1)[-1] if ']' in fullPath else fullPath\n\t\tif stripped in hidden_set:\n\t\t\treturn True\n\t\treturn False\n\n\tcandidates = []\n\n\ttry:\n\t\tbrowse = system.tag.browse(path=tag_path, filter={'recursive': True}).getResults()\n\texcept:\n\t\tbrowse = []\n\tfor entry in browse:\n\t\ttry:\n\t\t\ttag_type = str(entry['tagType'])\n\t\texcept:\n\t\t\ttag_type = ''\n\t\tif tag_type in ('Folder', 'UdtType', 'UdtInstance', 'Property'):\n\t\t\tcontinue\n\t\tfull_path = str(entry['fullPath'])\n\t\t# Skip meta-property references (tag.Value, tag.Enabled, etc.)\n\t\tif '.' in full_path.rsplit('/', 1)[-1]:\n\t\t\tcontinue\n\t\tif isHidden(full_path):\n\t\t\tcontinue\n\t\tcandidates.append(full_path)\n\n\tif not candidates:\n\t\ttry:\n\t\t\texists = system.tag.exists(tag_path)\n\t\texcept:\n\t\t\texists = False\n\t\tif exists and not isHidden(tag_path):\n\t\t\tcandidates.append(tag_path)\n\n\tif not candidates:\n\t\treturn result\n\n\tall_paths = []\n\tfor p in candidates:\n\t\tall_paths.append(p + '.Enabled')\n\t\tall_paths.append(p + '.HistoryEnabled')\n\t\tall_paths.append(p + '.DataType')\n\ttry:\n\t\tall_values = system.tag.readBlocking(all_paths)\n\texcept:\n\t\treturn result\n\n\tfor i, full_path in enumerate(candidates):\n\t\tenabled_qv = all_values[i * 3]\n\t\the_qv      = all_values[i * 3 + 1]\n\t\tdt_qv      = all_values[i * 3 + 2]\n\n\t\ttry:\n\t\t\tif not enabled_qv.value:\n\t\t\t\tcontinue\n\t\texcept:\n\t\t\tcontinue\n\n\t\ttry:\n\t\t\tif not he_qv.value:\n\t\t\t\tcontinue\n\t\texcept:\n\t\t\tcontinue\n\n\t\ttry:\n\t\t\tdt_raw = dt_qv.value if dt_qv is not None else ''\n\t\t\tif hasattr(dt_raw, 'name'):\n\t\t\t\tdt = str(dt_raw.name).lower()\n\t\t\telse:\n\t\t\t\tdt = str(dt_raw).lower()\n\t\t\tif '.' in dt:\n\t\t\t\tdt = dt.rsplit('.', 1)[-1]\n\t\texcept:\n\t\t\tdt = ''\n\n\t\tif 'string' in dt or 'date' in dt or 'bool' in dt:\n\t\t\tcontinue\n\n\t\tparts = full_path.split('/')\n\t\tleaf_name = parts[-1] if parts else full_path\n\t\tif len(parts) >= 2 and leaf_name.upper() == 'VALUE':\n\t\t\talias = parts[-2]\n\t\telse:\n\t\t\talias = leaf_name\n\n\t\tsensor = {\n\t\t\t'path': full_path,\n\t\t\t'alias': alias,\n\t\t\t'aggregate': 'Average'\n\t\t}\n\n\t\tresult['analog'].append(sensor)\n\n\treturn result",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.hiddenTags": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 360,
      "width": 500
    }
  },
  "root": {
