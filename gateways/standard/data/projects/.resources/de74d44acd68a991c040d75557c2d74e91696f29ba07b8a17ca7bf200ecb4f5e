{
  "custom": {
    "tags": []
  },
  "params": {
    "hiddenTags": "",
    "tagPath": ""
  },
  "propConfig": {
    "params.hiddenTags": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.tags": {
      "binding": {
        "config": {
          "struct": {
            "hiddenTags": "{view.params.hiddenTags}",
            "tagPath": "{view.params.tagPath}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\thiddenTagsInput = value.get('hiddenTags', '') if hasattr(value, 'get') else ''\n\ttagPath = value.get('tagPath', '') if hasattr(value, 'get') else ''\n\ttry:\n\t\treturn shared.AlarmConfig.listAlarms(tagPath, hiddenTagsInput)\n\texcept Exception:\n\t\treturn []\n",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 320,
      "width": 500
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "gap": "6px",
        "overflow": "hidden",
        "minHeight": 0,
        "height": "100%",
        "padding": "4px"
      }
    },
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "AcTitle"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "struct": {
                  "tags": "{view.custom.tags}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\ttags = value.get('tags') or []\n\tn = len(tags)\n\treturn 'Alarm configuration (%d)' % n\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "faceplate-section-title font-label"
          },
          "text": "Alarm configuration (0)"
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "AcEmpty"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "tags": "{view.custom.tags}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\ttags = value.get('tags') or []\n\treturn len(tags) == 0\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "style": {
            "classes": "faceplate-stub font-label"
          },
          "text": "No configured alarms found under this device."
        }
      },
      {
        "type": "ia.display.flex-repeater",
        "meta": {
          "name": "FlexRepeater"
        },
        "position": {
          "basis": "0px",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "struct": {
                  "tags": "{view.custom.tags}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\ttags = value.get('tags') or []\n\treturn len(tags) > 0\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.instances": {
            "binding": {
              "config": {
                "struct": {
                  "alarms": "{view.custom.tags}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "code": "\tinstances = []\n\talarms = value.get('alarms') or []\n\tfor i, item in enumerate(alarms):\n\t\tinstances.append({\n\t\t\t'instanceStyle': {'classes': ''},\n\t\t\t'instancePosition': {},\n\t\t\t'highlightRow': i % 2 == 1,\n\t\t\t'tagPath': item.get('tagPath', ''),\n\t\t\t'alarmName': item.get('alarmName', 'Alarm'),\n\t\t\t'label': item.get('label', ''),\n\t\t\t'isDigital': bool(item.get('isDigital')),\n\t\t\t'hasSetpoint': bool(item.get('hasSetpoint'))\n\t\t})\n\treturn instances\n",
                  "type": "script"
                }
              ],
              "type": "expr-struct"
            }
          }
        },
        "props": {
          "direction": "column",
          "elementPosition": {
            "grow": 0,
            "shrink": 0
          },
          "path": "01_Popups/00_Faceplates/_Assets/AlarmConfigurationRow",
          "style": {
            "classes": "faceplate-alarm-list",
            "gap": "1px",
            "minHeight": "0",
            "overflow": "auto"
          },
          "useDefaultViewWidth": false
        }
      }
    ]
  }
}
