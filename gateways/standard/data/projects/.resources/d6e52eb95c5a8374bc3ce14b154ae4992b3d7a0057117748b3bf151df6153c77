{
  "custom": {
    "overviewMode": "details"
  },
  "params": {},
  "props": {
    "defaultSize": {
      "height": 900,
      "width": 1280
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Plant Devices \u2014 Level 3",
          "style": {
            "classes": "font-title",
            "fontSize": "20px",
            "fontWeight": "700",
            "marginBottom": "4px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Subtitle"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Choose Details (unit overview tables) or Design (stub P&ID). Row / device click opens the faceplate.",
          "style": {
            "classes": "font-label",
            "marginBottom": "12px",
            "maxWidth": "900px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "children": [
              {
                "meta": {
                  "name": "DetailsLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Details",
                  "style": {
                    "classes": "",
                    "fontWeight": "600",
                    "textAlign": "center"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tself.view.custom.overviewMode = 'details'"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "DetailsBtn"
            },
            "position": {
              "basis": "88px",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.overviewMode}='details','theme-toggle-option theme-toggle-option-selected','theme-toggle-option bg-component')"
                  },
                  "type": "expr"
                }
              },
              "props.style.cursor": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.overviewMode}='details','auto','pointer')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "justify": "center",
              "style": {
                "classes": "theme-toggle-option bg-component",
                "borderRightColor": "--neutral-80",
                "borderRightStyle": "solid",
                "borderRightWidth": 1,
                "fontSize": "12px",
                "minHeight": "28px",
                "padding": "4px 12px",
                "textAlign": "center"
              }
            },
            "type": "ia.container.flex"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "DesignLabel"
                },
                "position": {
                  "shrink": 0
                },
                "props": {
                  "text": "Design",
                  "style": {
                    "classes": "",
                    "fontWeight": "600",
                    "textAlign": "center"
                  }
                },
                "type": "ia.display.label"
              }
            ],
            "events": {
              "dom": {
                "onClick": {
                  "config": {
                    "script": "\tself.view.custom.overviewMode = 'design'"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "DesignBtn"
            },
            "position": {
              "basis": "88px",
              "grow": 0,
              "shrink": 0
            },
            "propConfig": {
              "props.style.classes": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.overviewMode}='design','theme-toggle-option theme-toggle-option-selected','theme-toggle-option bg-component')"
                  },
                  "type": "expr"
                }
              },
              "props.style.cursor": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.overviewMode}='design','auto','pointer')"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "alignItems": "center",
              "justify": "center",
              "style": {
                "classes": "theme-toggle-option bg-component",
                "fontSize": "12px",
                "minHeight": "28px",
                "padding": "4px 12px",
                "textAlign": "center"
              }
            },
            "type": "ia.container.flex"
          }
        ],
        "meta": {
          "name": "ModeToggle"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "classes": "theme-toggle",
            "borderColor": "--neutral-50",
            "borderRadius": "10px",
            "borderStyle": "solid",
            "borderWidth": 1,
            "marginBottom": "16px",
            "overflow": "hidden",
            "width": "176px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Content"
        },
        "position": {
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "expression": "if({view.custom.overviewMode}='details','00_Pages/Devices/DetailsOverview',if({view.custom.overviewMode}='design','00_Pages/Devices/DesignOverview','00_Pages/NoViewPath'))"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "path": "00_Pages/Devices/DetailsOverview",
          "style": {
            "classes": "",
            "height": "100%",
            "minHeight": "400px",
            "minWidth": 0,
            "overflowX": "hidden",
            "width": "100%"
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "bg-page themed-scroll",
        "padding": "24px",
        "height": "100%",
        "overflowY": "auto",
        "overflowX": "hidden",
        "minWidth": 0
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
