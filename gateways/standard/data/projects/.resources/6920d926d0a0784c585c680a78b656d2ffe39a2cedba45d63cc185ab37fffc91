{
  "custom": {},
  "propConfig": {
    "custom.TicketGenAccess": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]_Config/Azure Devops/Connected"
        },
        "transforms": [
          {
            "expression": "hasRole(\u0027OneShot\u0027,{session.props.auth.user.userName},{session.props.auth.idp}) \u0026\u0026 {value}",
            "type": "expression"
          }
        ],
        "type": "tag"
      }
    },
    "props.auth": {
      "access": "PRIVATE",
      "persistent": false
    },
    "props.device.accelerometer": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.identifier": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.timezone": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.type": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.userAgent": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.gateway": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.data": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.permissionGranted": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.host": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.id": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.lastActivity": {
      "access": "SYSTEM",
      "persistent": false
    }
  },
  "props": {
    "address": "172.19.0.1",
    "device": {},
    "geolocation": {},
    "locale": "en-US",
    "timeZoneId": "America/New_York"
  }
}