{
  "custom": {
    "ackHighPriority": -1,
    "active": false,
    "activeHighPriority": -1,
    "flash": true
  },
  "params": {
    "tagPath": ""
  },
  "propConfig": {
    "custom.ackHighPriority": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Value/Alarms.HighestAckedPriority"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t-1,\r\n\t{value}\r\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.active": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Value/Alarms.HasActive"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\tFalse,\r\n\t{value}\r\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.activeHighPriority": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.params.tagPath}"
          },
          "tagPath": "{tagPath}/Value/Alarms.HighestActivePriority"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t-1,\r\n\t{value}\r\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.flash": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "direct",
          "tagPath": "[default]_Config/Flash"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\tFalse,\r\n\t{value}\r\n)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 20,
      "width": 20
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "struct": {
                  "ackHighPriority": "{view.custom.ackHighPriority}",
                  "active": "{view.custom.active}",
                  "activeHighPriority": "{view.custom.activeHighPriority}",
                  "flash": "{view.custom.flash}"
                },
                "waitOnAll": true
              },
              "transforms": [
                {
                  "expression": "if({value}['ackHighPriority'] != {value}['activeHighPriority'] && {value}['active'],\r\n\t{value}['flash'],\r\n\tTrue\r\n)",
                  "type": "expression"
                }
              ],
              "type": "expr-struct"
            }
          },
          "props.path": {
            "binding": {
              "config": {
                "path": "view.custom.activeHighPriority"
              },
              "transforms": [
                {
                  "expression": "case({value},\r\n     4, '03_Elements/01_Status/NotificationIcons/Alarms/Critical',\r\n     3, '03_Elements/01_Status/NotificationIcons/Alarms/High',\r\n     2, '03_Elements/01_Status/NotificationIcons/Alarms/Medium',\r\n     1, '03_Elements/01_Status/NotificationIcons/Alarms/Low',\r\n     '03_Elements/01_Status/NotificationIcons/Blank')",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "type": "ia.display.view"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
