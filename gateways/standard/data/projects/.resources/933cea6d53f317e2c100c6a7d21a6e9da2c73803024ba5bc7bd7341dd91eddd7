{
  "custom": {
    "inArray": false
  },
  "params": {
    "discrete": false,
    "tagPath": ""
  },
  "propConfig": {
    "custom.inArray": {
      "binding": {
        "config": {
          "struct": {
            "tagPath": "{view.params.tagPath}",
            "tags": "{session.custom.AdhocTrend.tags}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\tif value.tagPath != '' and len(value.tags) > 0:\n\t\tif value.tagPath in value.tags:\n\t\t\treturn True\n\treturn False",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      },
      "persistent": true
    },
    "params.discrete": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "props.defaultSize.height": {
      "binding": {
        "config": {
          "expression": "if({session.custom.TicketLogAccess}, 152, 120)"
        },
        "type": "expr"
      }
    }
  },
  "props": {
    "defaultSize": {
      "height": 152,
      "width": 180
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\ttagPath = self.view.params.tagPath\n\tviewName = self.view.id.split('@')[0]\n\tshared.Alerts.contextMenuTicketLog(tagPath, viewName)\n\tsystem.perspective.closePopup('ContextMenu')"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "TicketLogger"
        },
        "position": {
          "basis": "32px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "params": {
            "name": "Ticket Logger",
            "classes": "container-item font-header",
            "cursor": "pointer",
            "fontWeight": "500"
          },
          "path": "01_Popups/00_Faceplates/Alerts/Menu"
        },
        "type": "ia.display.view",
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "session.custom.TicketLogAccess"
              },
              "type": "property"
            }
          },
          "position.basis": {
            "binding": {
              "config": {
                "expression": "if({session.custom.TicketLogAccess}, \"32px\", \"0px\")"
              },
              "type": "expr"
            }
          }
        }
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif len(self.session.custom.AdhocTrend.tags) < 10:\n\t\ttagPath = self.view.params.tagPath\n\t\tif tagPath not in self.session.custom.AdhocTrend.tags:\n\t\t\tself.session.custom.AdhocTrend.tags.append(tagPath)\n\t\tshared.Alerts.showAdhocTrend()\n\t\tsystem.perspective.closePopup('ContextMenu')\n\telse:\n\t\tshared.Alerts.showAlert(state=\"warning\",title=\"Adhoc Trending\",message='You have exceeded the limit of 10 tags, Please remove tags that are not required from the trend.',showCloseBtn=False,btnTextPrimary=\"Okay\",btnTextSecondary=\"\",btnActionPrimary=\"\",btnActionSecondary=\"\",payload={})"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "AddToTrend"
        },
        "position": {
          "basis": "32px",
          "grow": 0,
          "shrink": 0
        },
        "props": {
          "params": {
            "name": "(+) Add to trend"
          },
          "path": "01_Popups/00_Faceplates/Alerts/Menu"
        },
        "type": "ia.display.view",
        "propConfig": {
          "props.params.classes": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\n\t\"container-item font-header\",\n\t\"container-item bg-disabled font-baddata\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.cursor": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\n\t\"pointer\",\n\t\"auto\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.params.fontWeight": {
            "binding": {
              "config": {
                "path": "view.custom.inArray"
              },
              "transforms": [
                {
                  "expression": "if(!{value},\n\t\"500\",\n\t\"normal\"\n)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        }
      },
