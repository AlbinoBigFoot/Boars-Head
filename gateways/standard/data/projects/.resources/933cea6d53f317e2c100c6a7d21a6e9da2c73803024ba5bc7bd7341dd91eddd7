                "script": "\ttagPath = self.view.params.tagPath\n\tif tagPath in self.session.custom.AdhocTrend.tags:\n\t\tself.session.custom.AdhocTrend.tags.remove(tagPath)\n\t\tsystem.perspective.closePopup('ContextMenu')"
