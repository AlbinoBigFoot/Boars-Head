{
  "custom": {},
  "params": {
    "color": "",
    "justify": "flex-start",
    "penName": "",
    "plotId": "p0",
    "tagPath": ""
  },
  "propConfig": {
    "params.color": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.justify": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.penName": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.plotId": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 24,
      "width": 200
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "24px",
          "shrink": 0
        },
        "propConfig": {
          "props.color": {
            "binding": {
              "config": {
                "path": "view.params.color"
              },
              "type": "property"
            },
            "persistent": true
          }
        },
        "props": {
          "path": "material/show_chart"
        },
        "type": "ia.display.icon"
      },
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.penName"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "Fonts/Value",
            "marginLeft": "1%",
            "overflowWrap": "normal"
          }
        },
        "type": "ia.display.label"
      },
      {
        "type": "ia.input.dropdown",
        "meta": {
          "name": "PlotSelect"
        },
        "position": {
          "basis": "90px",
          "shrink": 0
        },
        "props": {
          "allowCustomOptions": false,
          "style": {
            "classes": "font-value adhoc-trend-pen-plot-select",
            "marginLeft": "4px",
            "minWidth": 80
          },
          "options": []
        },
        "propConfig": {
          "props.options": {
            "binding": {
              "config": {
                "path": "session.custom.AdhocTrend.plots"
              },
              "transforms": [
                {
                  "code": "\treturn shared.AdhocTrend.plot_dropdown_options(value)\n",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.plotId"
              },
              "transforms": [
                {
                  "code": "\treturn str(value) if value not in (None, '') else 'p0'\n",
                  "type": "script"
                }
              ],
              "type": "property"
            },
            "onChange": {
              "enabled": null,
              "script": "\tif currentValue.value in (None, ''):\n\t\treturn\n\tkey = self.view.params.tagPath\n\tif key in (None, ''):\n\t\tkey = self.view.params.penName\n\tpenPlots = shared.AdhocTrend.move_pen(self.session.custom.AdhocTrend, key, currentValue.value)\n\tself.session.custom.AdhocTrend.penPlots = penPlots\n"
            }
          }
        }
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "propConfig": {
      "props.justify": {
        "binding": {
          "config": {
            "path": "view.params.justify"
          },
          "type": "property"
        }
      },
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "type": "ia.container.flex",
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
