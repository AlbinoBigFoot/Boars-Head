        "config": {
          "expression": "if({view.custom.tagPath} \u003d \u0027\u0027,\r\n\t\u0027\u0027,\r\n\tif(!isBad(tag({view.custom.tagPath} + \u0027/Value.Metadata\u0027)),\r\n\t\tif(isNull(tag({view.custom.tagPath} + \u0027/Value.Metadata\u0027)[\u0027states\u0027]),\r\n\t\t\t\u0027\u0027,\r\n\t\t\ttag({view.custom.tagPath} + \u0027/Value.Metadata\u0027)[\u0027states\u0027]),\r\n\t\tif(!isBad(tag({view.custom.tagPath} + \u0027/Metadata\u0027)),\r\n\t\t\tif(isNull(jsonGet(tag({view.custom.tagPath} + \u0027/Metadata\u0027), \u0027states\u0027)),\r\n\t\t\t\t\u0027\u0027,\r\n\t\t\t\tjsonGet(tag({view.custom.tagPath} + \u0027/Metadata\u0027), \u0027states\u0027)),\r\n\t\t\t\u0027\u0027)))"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.quality": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.Quality"
        },
        "transforms": [
          {
            "expression": "if(isNull({value}),\r\n\t\"\",\r\n\t{value}\r\n\t)",
            "type": "expression"
          }
        ],
        "type": "tag"
      },
      "persistent": true
    },
    "custom.tagPath": {
      "binding": {
        "config": {
          "path": "view.params.value"
        },
        "type": "property"
      },
      "persistent": true
    },
    "custom.textAlign": {
      "persistent": true
    },
    "custom.value": {
      "binding": {
        "config": {
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "tagPath": "{view.custom.tagPath}"
          },
          "tagPath": "{tagPath}/Value.value"
        },
