              },
              "transforms": [
                {
                  "code": "\tfrom shared import Utilities\n\tresult \u003d Utilities.getLabelValue(value.value, value.multistates)\n\tif result in (None, \u0027\u0027) and value.value not in (None, \u0027\u0027):\n\t\ttry:\n\t\t\tv \u003d int(value.value)\n\t\t\tfallback \u003d {0: \u0027Off\u0027, 1: \u0027Cooling\u0027, 2: \u0027Defrost\u0027, 3: \u0027Fault\u0027, 4: \u0027Manual\u0027, 5: \u0027Idle\u0027}\n\t\t\tresult \u003d fallback.get(v, str(value.value))\n\t\texcept:\n\t\t\tresult \u003d str(value.value)\n\treturn (result if result is not None else \u0027\u0027) + \"\u0026nbsp;\"",
