              "transforms": [
                {
                  "expression": "if({value} \u003d \"Good\",\r\n\t\u0027font-livedata\u0027,\r\n\t\u0027font-baddata\u0027\r\n\t)",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.style.marginRight": {
            "binding": {
              "config": {
                "path": "view.custom.marginRight"
              },
              "type": "property"
            }
          },
          "props.style.textAlign": {
            "binding": {
              "config": {
                "path": "view.custom.textAlign"
              },
              "type": "property"
            }
          }
        },
