            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tfrom shared import Alerts\n\n\ttrendId = self.session.custom.AdhocTrend.trendId\n\ttrendName = self.session.custom.AdhocTrend.trendName\n\tisShared = self.session.custom.AdhocTrend.isShared\n\tusername = self.session.props.auth.user.userName\n\tif not username:\n\t\tusername = \"anonymous\"\n\n\ttry:\n\t\tpopupId = self.getSibling(\"Cancel\").custom.id\n\texcept:\n\t\tuid = self.session.props.auth.user.id\n\t\tpopupId = \"SaveTrendConfig-\" + (str(uid) if uid not in (None, \"\") else \"anon\")\n\n\tdef _close_save_popup():\n\t\tcandidates = [popupId]\n\t\ttry:\n\t\t\tcandidates.append(str(popupId).strip())\n\t\texcept:\n\t\t\tpass\n\t\tcandidates.extend([\"SaveTrendConfig\", \"SaveTrendConfig \", \"SaveTrendConfig-anon\"])\n\t\tuid = None\n\t\ttry:\n\t\t\tuid = self.session.props.auth.user.id\n\t\texcept:\n\t\t\tpass\n\t\tif uid not in (None, \"\"):\n\t\t\tcandidates.extend([\"SaveTrendConfig \" + str(uid), \"SaveTrendConfig-\" + str(uid)])\n\t\tfor pid in candidates:\n\t\t\tif not pid:\n\t\t\t\tcontinue\n\t\t\ttry:\n\t\t\t\tsystem.perspective.closePopup(pid)\n\t\t\texcept:\n\t\t\t\tpass\n\n\tif not trendName or str(trendName).strip() == \"\":\n\t\tAlerts.showAlert(\n\t\t\tstate=\"warning\",\n\t\t\ttitle=\"Missing Information\",\n\t\t\tmessage=\"Please enter a Trend Name before saving.\",\n\t\t\tshowCloseBtn=True,\n\t\t\tbtnTextPrimary=\"OK\",\n\t\t\tbtnActionPrimary=\"closeAlert\"\n\t\t)\n\t\treturn\n\n\tself.session.custom.AdhocTrend.username = username\n\tjsonConfigString = system.util.jsonEncode(self.session.custom.AdhocTrend)\n\n\ttry:\n\t\tif trendId != \"\" and trendId is not None:\n\t\t\tsystem.db.runNamedQuery(\"AdhocTrend/Update\", {\n\t\t\t\t\"trendId\": trendId,\n\t\t\t\t\"trendName\": str(trendName).strip(),\n\t\t\t\t\"trendConfig\": jsonConfigString,\n\t\t\t\t\"isShared\": bool(isShared)\n\t\t\t})\n\t\t\tsuccess_msg = \"Trend successfully updated.\"\n\t\telse:\n\t\t\tsystem.db.runNamedQuery(\"AdhocTrend/Insert\", {\n\t\t\t\t\"username\": username,\n\t\t\t\t\"trendName\": str(trendName).strip(),\n\t\t\t\t\"trendConfig\": jsonConfigString,\n\t\t\t\t\"isShared\": bool(isShared)\n\t\t\t})\n\t\t\tds = system.db.runPrepQuery(\n\t\t\t\t\"SELECT TOP 1 id FROM dbo.adhoc_trend_configs WHERE username = ? AND trend_name = ? ORDER BY updated_at DESC\",\n\t\t\t\t[username, str(trendName).strip()],\n\t\t\t\t\"ignition\"\n\t\t\t)\n\t\t\tif ds is not None and ds.getRowCount() > 0:\n\t\t\t\tself.session.custom.AdhocTrend.trendId = ds.getValueAt(0, 0)\n\t\t\tsuccess_msg = \"New trend saved successfully.\"\n\n\t\t_close_save_popup()\n\t\tAlerts.showAlert(\n\t\t\tstate=\"success\",\n\t\t\ttitle=\"Success\",\n\t\t\tmessage=success_msg,\n\t\t\tshowCloseBtn=True,\n\t\t\tbtnTextPrimary=\"OK\",\n\t\t\tbtnActionPrimary=\"closeAlert\"\n\t\t)\n\texcept Exception as e:\n\t\tAlerts.showAlert(\n\t\t\tstate=\"error\",\n\t\t\ttitle=\"Database Error\",\n\t\t\tmessage=\"Failed to save trend: \" + str(e),\n\t\t\tshowCloseBtn=True,\n\t\t\tbtnTextPrimary=\"Close\",\n\t\t\tbtnActionPrimary=\"closeAlert\"\n\t\t)\n"
                  },
