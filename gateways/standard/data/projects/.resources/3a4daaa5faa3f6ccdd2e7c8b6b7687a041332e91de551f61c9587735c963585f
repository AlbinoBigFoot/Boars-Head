def _includeChild(name):
	if not name or name in EXCLUDE_NAMES:
		return False
	for prefix in EXCLUDE_PREFIXES:
		if name.startswith(prefix):
			return False
	return True


def _columnKind(fieldName, valueTagPath):
	if fieldName in BOOLEAN_FIELDS:
		return "boolean"
	try:
		cfg = system.tag.getConfiguration(valueTagPath, False)[0]
		dt = str(cfg.get("dataType", ""))
		if "Boolean" in dt:
			return "boolean"
	except:
		pass
	try:
		meta = system.tag.readBlocking([valueTagPath + ".Metadata"])[0].value
		if meta is not None:
			states = None
			if hasattr(meta, "__getitem__"):
				try:
					states = meta["states"]
				except:
					states = None
			elif hasattr(meta, "get"):
				states = meta.get("states")
			if states:
				return "boolean"
	except:
		pass
	return "numeric"


def discoverPointFields(templatePath):
	"""Return ordered list of (fieldName, kind) from a device UDT template."""
	fields = []
	results = system.tag.browse(templatePath, {"recursive": False}).getResults()
	for br in results:
		name = _browseName(br)
		if not _includeChild(name):
			continue
		childPath = templatePath + "/" + name
		valuePath = childPath + "/Value"
		if not system.tag.exists(valuePath):
			continue
		kind = _columnKind(name, valuePath)
		fields.append((name, kind))

	# Prefer known order, then natural sort leftovers
	order_index = {n: i for i, n in enumerate(PREFERRED_ORDER)}
	fields.sort(key=lambda t: (order_index.get(t[0], 1000), _naturalSortKey(t[0])))
	return fields


def _isEquipmentDeviceType(typeId):
	"""
	True for folder-level device UDTs (Devices/Evaporator, Devices/Pump, …).
	False for nested VFDs, Overview UDTs, point UDTs (_Root/Analog), alarms, etc.
	"""
	tid = str(typeId or "")
	if not tid.startswith("Devices/"):
		return False
	# Nested under evaporators / similar — never a row in the equipment Overview table
	if tid in ("Devices/VFD", "Devices/Vfd"):
		return False
	return True


def findDevices(folderPath):
	"""
	Enabled device UDT instances that are direct children of the equipment folder.
	Requires typeId under Devices/* (excludes Overview, nested Fans/VFDs, point UDTs).
	"""
	devices = []
	folderNorm = str(folderPath).rstrip("/")
	results = system.tag.browse(folderPath, {
		"tagType": "UdtInstance",
		"recursive": False
	}).getResults()
	for br in results:
		name = _browseName(br)
		path = _browseFullPath(br)
		if not name or not path:
			continue
		if not _includeChild(name):
			continue
		# Direct children only (belt-and-suspenders if browse ignores recursive:False)
		if not _pathsEqual(_parentPath(path), folderNorm):
			continue
		typeId = _browseTypeId(br, path)
		if not _isEquipmentDeviceType(typeId):
			continue
		if not _isEnabled(path):
			continue
		devices.append((name, path))
	devices.sort(key=lambda t: _naturalSortKey(t[0]))
	return devices


def buildInstancesPayload(folderPath, templatePath=None):
	devices = findDevices(folderPath)
	if not devices:
		return {"columns": [makeTagPathColumn()], "data": []}

	if templatePath is None:
		templatePath = devices[0][1]

	fields = discoverPointFields(templatePath)

	columns = [makeTagPathColumn()]
	for fieldName, kind in fields:
		if kind == "boolean":
			columns.append(makeBooleanColumn(fieldName))
		else:
			columns.append(makeNumericColumn(fieldName))

	data = []
	for name, path in devices:
		row = {"tagPath": path}
		for fieldName, kind in fields:
			childPath = path + "/" + fieldName
			if system.tag.exists(childPath) and _isEnabled(childPath):
				row[fieldName] = childPath
		data.append(row)

	return {"columns": columns, "data": data}


def writeInstances(overviewPath, payload):
	instancesValue = overviewPath.rstrip("/") + "/Instances/Value"
	if not system.tag.exists(instancesValue):
		raise Exception("Missing Instances/Value at %s" % instancesValue)
	q = system.tag.writeBlocking([instancesValue], [payload])[0]
	if not q.isGood():
		raise Exception("Failed writing %s: %s" % (instancesValue, str(q)))
	return instancesValue


def writeDeviceCount(overviewPath, count):
	"""Lightspeed Overview/DeviceCount/Value — memory Int4 device tally."""
	path = overviewPath.rstrip("/") + "/DeviceCount/Value"
	if not system.tag.exists(path):
		logger.warn("Missing DeviceCount/Value at %s" % path)
		return None
	q = system.tag.writeBlocking([path], [int(count)])[0]
	if not q.isGood():
		raise Exception("Failed writing %s: %s" % (path, str(q)))
	return path


def buildActiveAlarmCountExpression(devicePaths, targetSuffix="/_Alarms/_Active"):
	"""
	Lightspeed pattern: sum({path1/_Alarms/_Active}, {path2/_Alarms/_Active}, ...)
	Boolean/active tags coerce to 0/1 in expression sum.
	"""
	refs = []
	for path in devicePaths:
		alarmPath = path.rstrip("/") + targetSuffix
		if system.tag.exists(alarmPath):
			refs.append("{%s}" % alarmPath)
	if not refs:
		return "0"
	return "sum(" + ",\n".join(refs) + ")"


def writeActiveAlarmCount(overviewPath, devicePaths):
	"""
	Write Overview/ActiveAlarmCount/Value as an expression tag that sums
	each device's /_Alarms/_Active (Lightspeed Meter/CRAC Overview pattern).
	"""
	parent = overviewPath.rstrip("/") + "/ActiveAlarmCount"
	valuePath = parent + "/Value"
	if not system.tag.exists(valuePath):
		logger.warn("Missing ActiveAlarmCount/Value at %s" % valuePath)
		return None

	expr = buildActiveAlarmCountExpression(devicePaths)
	cfg = {
		"name": "Value",
		"tagType": "AtomicTag",
		"valueSource": "expr",
		"expression": expr,
		"dataType": "Int4",
		"formatString": "0",
	}
	try:
		system.tag.configure(parent, [cfg], "o")
	except Exception as e:
		logger.error("configure ActiveAlarmCount failed: %s" % str(e))
		raise
	return valuePath


def clearRebuild(rebuildTagPath):
	try:
		system.tag.writeBlocking([rebuildTagPath], [False])
	except:
		pass


def rebuildOverview(overviewOrRebuildPath):
	"""
	Rebuild Overview/Instances/Value plus DeviceCount and ActiveAlarmCount
	(Lightspeed Overview pattern) for the equipment folder that owns this Overview.
	Accepts .../Overview/Rebuild or .../Overview or the equipment folder path.
	"""
	rebuildPath = None
	s = str(overviewOrRebuildPath).rstrip("/")
	if s.endswith("/Rebuild"):
		rebuildPath = s

	overviewPath = _normalizeOverviewPath(s)
	folderPath = _equipmentFolder(overviewPath)

	if not system.tag.exists(overviewPath):
		raise Exception("Overview not found: %s" % overviewPath)
	if not system.tag.exists(overviewPath.rstrip("/") + "/Instances/Value"):
		raise Exception("Missing Instances/Value at %s/Instances/Value" % overviewPath)

	devices = findDevices(folderPath)
	devicePaths = [path for name, path in devices]

	payload = buildInstancesPayload(folderPath)
	written = writeInstances(overviewPath, payload)
	writeDeviceCount(overviewPath, len(devicePaths))
	try:
		writeActiveAlarmCount(overviewPath, devicePaths)
	except Exception as e:
		logger.error("ActiveAlarmCount rebuild failed: %s" % str(e))

	logger.info(
		"Rebuilt %s (%d rows, %d cols, deviceCount=%d) from %s"
		% (written, len(payload.get("data", [])), len(payload.get("columns", [])), len(devicePaths), folderPath)
	)

	if rebuildPath:
		clearRebuild(rebuildPath)
	elif system.tag.exists(overviewPath + "/Rebuild"):
		clearRebuild(overviewPath + "/Rebuild")

	return payload


def rebuildAllOverviews(provider="default"):
	"""Rebuild every known equipment Overview (used by [default]_Config/Rebuild)."""
	results = []
	for rebuildPath in listRebuildPaths(provider):
		# Skip the global trigger itself
		if rebuildPath.rstrip("/").endswith("_Config/Rebuild"):
			continue
		try:
			payload = rebuildOverview(rebuildPath)
			results.append((rebuildPath, len(payload.get("data", []))))
		except Exception as e:
			logger.error("rebuildAllOverviews failed for %s: %s" % (rebuildPath, str(e)))
			results.append((rebuildPath, str(e)))
	return results


def rebuildFromRebuildTag(rebuildTagPath):
	"""Entry point for gateway Tag Change on Overview/.../Rebuild or _Config/Rebuild."""
	s = str(rebuildTagPath).rstrip("/")
	# Global trigger: rebuild all equipment overviews, not _Config itself
	if s.endswith("_Config/Rebuild") or s.endswith("/_Config/Rebuild"):
		results = rebuildAllOverviews()
		clearRebuild(s)
		logger.info("Global Overview rebuild via %s: %s" % (s, results))
		return results
	return rebuildOverview(rebuildTagPath)


def listRebuildPaths(provider="default", pathFilter="*"):
	"""
	List Overview/*/Rebuild paths (helper for configuring Tag Change paths).
	Mirrors Lightspeed unitOverviewExpressionBuilder intent for BH.
	"""
	paths = []
	try:
		query = {
			"options": {
				"includeUdtMembers": False,
				"includeUdtDefinitions": False
			},
			"condition": {
				"path": pathFilter,
				"attributes": {"values": [], "requireAll": True}
			},
			"returnProperties": ["tagType", "quality"]
		}
		results = system.tag.query(provider, query, 100000)
		for result in results:
			full = str(result.get("fullPath", ""))
			if full.endswith("/Overview") or full.rstrip("/").split("/")[-1] == "Overview":
				rebuild = full.rstrip("/") + "/Rebuild"
				if system.tag.exists(rebuild):
					paths.append(rebuild)
	except Exception as e:
		logger.warn("listRebuildPaths failed: %s" % str(e))
	# Always include known equipment-folder overviews if present
	for folder in ("Evaporators", "Compressors", "CoolingTowers", "Pumps", "ExhaustFans"):
		fallback = "[%s]%s/Overview/Rebuild" % (provider, folder)
		if system.tag.exists(fallback) and fallback not in paths:
			paths.append(fallback)
	return sorted(paths)
