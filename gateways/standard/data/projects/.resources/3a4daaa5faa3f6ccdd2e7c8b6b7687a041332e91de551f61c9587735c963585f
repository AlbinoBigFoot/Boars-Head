# Overview Instances builder (Lightspeed-style).
# Triggered when Overview/.../Rebuild is set True (gateway Tag Change).
#
# Writes {columns, data} to Overview/Instances/Value where data cells are tag
# paths (not live values). Cell views bind Value / Metadata from those paths.

import re

logger = system.util.getLogger("shared.Overview")

EXCLUDE_NAMES = set([
	"Overview", "SummaryInstances", "Metadata", "_Alarms",
	"Instances", "DeviceCount", "ActiveAlarmCount", "Rebuild"
])

# Child name prefixes to skip (evaporator Fan N folders, etc.)
EXCLUDE_PREFIXES = ("Fan",)

# Fields that always use the Boolean/multistate table cell
BOOLEAN_FIELDS = set(["Status"])

# Preferred column order when present
PREFERRED_ORDER = ["Temp", "Pressure", "Status"]


def _browseName(br):
	try:
		return str(br.getName())
	except:
		try:
			return str(br["name"])
		except:
			return None


def _browseFullPath(br):
	try:
		return str(br.getFullPath())
	except:
		try:
			return str(br["fullPath"])
		except:
			return None


def _browseTagType(br):
	try:
		return str(br.getTagType())
	except:
		try:
			return str(br["tagType"])
		except:
			return ""


def _browseTypeId(br, pathStr=None):
	"""UDT typeId from browse result, else tag configuration."""
	for getter in ("getTypeId", "getTypePath"):
		try:
			fn = getattr(br, getter, None)
			if fn:
				v = fn()
				if v:
					return str(v)
		except:
			pass
	try:
		v = br["typeId"]
		if v:
			return str(v)
	except:
		pass
	p = pathStr or _browseFullPath(br)
	if not p:
		return ""
	try:
		cfg = system.tag.getConfiguration(p, False)[0]
		return str(cfg.get("typeId", "") or "")
	except:
		return ""


def _parentPath(pathStr):
	s = str(pathStr).rstrip("/")
	if "/" not in s:
		return s
	return s.rsplit("/", 1)[0]


def _pathsEqual(a, b):
	"""Compare tag paths ignoring trailing slash / provider bracket quirks."""
	def norm(p):
		s = str(p).rstrip("/")
		# [default]Foo and Foo under default provider
		if s.startswith("[") and "]" in s:
			s = s.split("]", 1)[1]
		return s
	return norm(a) == norm(b)


def _naturalSortKey(s):
	parts = re.split(r"(\d+)", str(s))
	return [int(p) if p.isdigit() else p.lower() for p in parts]


def _isEnabled(pathStr):
	try:
		cfg = system.tag.getConfiguration(pathStr, False)[0]
		if "enabled" in cfg:
			return bool(cfg.get("enabled"))
	except:
		pass
	return True


def _normalizeOverviewPath(tagPath):
	"""Accept .../Overview/Rebuild, .../Overview, or equipment folder."""
	s = str(tagPath).rstrip("/")
	if s.endswith("/Rebuild"):
		s = s[:-len("/Rebuild")]
	if s.endswith("/Instances/Value"):
		s = s[:-len("/Instances/Value")]
	if s.endswith("/Instances"):
		s = s[:-len("/Instances")]
	if not s.endswith("/Overview"):
		# equipment folder → append Overview
		if system.tag.exists(s + "/Overview"):
			s = s + "/Overview"
	return s


def _equipmentFolder(overviewPath):
	return _parentPath(overviewPath)


