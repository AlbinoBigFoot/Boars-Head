{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 200,
      "width": 220
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "font-label"
              },
              "text": "User:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Value"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "session.props.auth"
                  },
                  "transforms": [
                    {
                      "expression": "if({value}['authenticated'],\n\tif({value}['user']['firstName'] != None,\n\t\tif({value}['user']['lastName'] != None,\n\t\t\t{value}['user']['firstName'] + ' ' + {value}['user']['lastName'],\n\t\t\t{value}['user']['firstName']\n\t\t),\n\t\t{value}['user']['userName']\n\t),\n\t'Not logged in'\n)\n",
                      "type": "expression"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "font-value",
                "marginLeft": "2%"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "User"
        },
        "position": {
          "shrink": 0
        },
        "type": "ia.container.flex"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "font-label"
              },
              "text": "Roles:"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "RolesValue"
            },
            "position": {
              "grow": 1
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "path": "session.props.auth.user.roles"
                  },
                  "transforms": [
                    {
                      "code": "\tif value is None or len(value) == 0:\n\t\treturn '(none)'\n\treturn ', '.join([str(r) for r in value])",
                      "type": "script"
                    }
                  ],
                  "type": "property"
                }
              }
            },
            "props": {
              "style": {
                "classes": "font-value",
                "marginLeft": "2%",
                "overflowWrap": "break-word"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "Roles"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "alignItems": "flex-start",
          "style": {
            "marginTop": "10px"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "LoginLogOut"
        },
        "position": {
          "align": "center",
          "basis": "32px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "session.props.auth.authenticated"
              },
              "transforms": [
                {
                  "expression": "if({value}, 'Log Out', 'Log In')",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/login",
              "color": "var(--text-inverse)"
            }
          },
          "style": {
            "classes": "container-button font-button",
            "marginTop": "16px",
            "width": 140
          },
          "text": "Log In"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "script": "\t# Force IdP login UI so operators can switch accounts without a full logout first\n\tsystem.perspective.login(forceAuth=True)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "SwitchUser"
        },
        "position": {
          "align": "center",
          "basis": "32px",
          "shrink": 0
        },
        "propConfig": {
          "meta.visible": {
            "binding": {
              "config": {
                "path": "session.props.auth.authenticated"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/swap_horiz",
              "color": "var(--text-inverse)"
            }
          },
          "style": {
            "classes": "container-button font-button",
            "marginTop": "8px",
            "width": 140
          },
          "text": "Switch User"
        },
        "type": "ia.input.button"
      }
    ],
    "meta": {
      "name": "root",
      "contextMenu": {}
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "account-popup bg-component container-card",
        "padding": "12px"
      }
    },
    "type": "ia.container.flex",
    "propConfig": {
      "meta.contextMenu.items": {
        "binding": {
          "config": {
            "struct": {
              "tagPath": "\"No TagPath: \""
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "code": "\ttagPath = ''\n\ttry:\n\t\ttagPath = self.view.params.tagPath\n\texcept:\n\t\tpass\n\tif tagPath is None or str(tagPath).strip() == '':\n\t\ttagPath = value.tagPath + self.view.id.split('@')[0].split('/')[-1]\n\titems = [\n\t\t\t  {\n\t\t\t    \"text\": \"Ticket Logger\",\n\t\t\t    \"icon\": {\n\t\t\t      \"path\": \"material/info\",\n\t\t\t      \"color\": \"--neutral-80\",\n\t\t\t      \"style\": {}\n\t\t\t    },\n\t\t\t    \"style\": {\n\t\t\t      \"classes\": \"bg-component font-value\",\n\t\t\t      \"height\": 24,\n\t\t\t      \"width\": 120\n\t\t\t    },\n\t\t\t    \"type\": \"message\",\n\t\t\t    \"children\": [],\n\t\t\t    \"link\": {\n\t\t\t      \"url\": \"\",\n\t\t\t      \"target\": \"self\"\n\t\t\t    },\n\t\t\t    \"method\": {\n\t\t\t      \"name\": \"\",\n\t\t\t      \"params\": {}\n\t\t\t    },\n\t\t\t    \"message\": {\n\t\t\t      \"type\": \"ticketLog\",\n\t\t\t      \"payload\": {\n\t\t\t        \"tagPath\": tagPath,\n\t\t\t        \"viewName\": self.view.id.split('@')[0]\n\t\t\t      },\n\t\t\t      \"scope\": \"page\"\n\t\t\t    }\n\t\t\t  }\n\t\t\t]\n\treturn items",
              "type": "script"
            }
          ],
          "type": "expr-struct"
        }
      },
      "meta.contextMenu.enabled": {
        "binding": {
          "config": {
            "struct": {
              "items": "{this.meta.contextMenu.items}",
              "permission": "{session.custom.TicketLogAccess}"
            },
            "waitOnAll": true
          },
          "transforms": [
            {
              "expression": "len({value}['items']) > 0 && {value}['permission']",
              "type": "expression"
            }
          ],
          "type": "expr-struct"
        }
      }
    },
    "scripts": {
      "customMethods": [],
      "extensionFunctions": null,
      "messageHandlers": [
        {
          "messageType": "ticketLog",
          "pageScope": true,
          "script": "\t# Ticket Logger context-menu opener\n\tshared.Alerts.contextMenuTicketLog(payload['tagPath'], payload['viewName'])",
          "sessionScope": false,
          "viewScope": false
        }
      ]
    }
  }
}
