# Copy to .env and set secrets. Never commit .env.

GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=ChangeMe_IgnitionAdmin1!

# SQL Server SA password: 8+ chars, upper, lower, number, symbol
MSSQL_SA_PASSWORD=ChangeMe_SqlSa1!
MSSQL_PID=Developer
# Host port — change if 1433 is already used on this machine
MSSQL_PORT=11433

TZ=America/New_York

# Host ports chosen to avoid common local Ignition/SQL conflicts
STANDARD_HTTP_PORT=19088
STANDARD_HTTPS_PORT=19043
STANDARD_GAN_PORT=18060
STANDARD_MAX_MEMORY_MB=2048

EDGE_HTTP_PORT=19188
EDGE_HTTPS_PORT=19143
EDGE_GAN_PORT=18160
EDGE_MAX_MEMORY_MB=1024

# Keep true while Standard is 8.1 and Edge is 8.3
GATEWAY_NETWORK_ALLOWJAVASERIALIZATION=true
