# Copy to .env and set secrets. Never commit .env.

GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=ChangeMe_IgnitionAdmin1!

# SQL Server SA password: 8+ chars, upper, lower, number, symbol
MSSQL_SA_PASSWORD=ChangeMe_SqlSa1!
MSSQL_PID=Developer
# Host port — change if 1433 is already used on this machine
MSSQL_PORT=11433

TZ=America/New_York

# Host ports chosen to avoid common local Ignition/SQL conflicts
STANDARD_HTTP_PORT=19088
STANDARD_HTTPS_PORT=19043
STANDARD_GAN_PORT=18060
STANDARD_MAX_MEMORY_MB=2048

EDGE_HTTP_PORT=19188
EDGE_HTTPS_PORT=19143
EDGE_GAN_PORT=18160
EDGE_MAX_MEMORY_MB=1024

# Optional; both gateways are 8.3 — leave false unless you need mixed-version GAN
GATEWAY_NETWORK_ALLOWJAVASERIALIZATION=false

# Ignition 8.3 filesystem scan API — format MUST be Name:plaintextKey (e.g. Access:...)
# Used by the Cursor/Claude ignition-scan hook after project/config file edits
# IGNITION_API_TOKEN=Access:replace-me
# IGNITION_API_BASE=http://localhost:19088/data/api/v1/scan/

# Engineering wiki (Docusaurus) — docker compose up -d wiki
WIKI_PORT=3030

# Monday.com Ticket Logger (optional env override; live config is tags under
# [default]_Config/Monday/* — API Token, Board Id, Group Id, Columns/*, Connected)
# MONDAY_API_TOKEN=
# MONDAY_BOARD_ID=18423731526
# MONDAY_GROUP_ID=topics
# MONDAY_API_VERSION=2026-07

# Monday ? local Cursor agent webhook proxy (see docs/monday-local-agent.md)
# MONDAY_WEBHOOK_PORT=9876
# MONDAY_AGENT_USER_IDS=111292620
# MONDAY_AGENT_MATCH_SUBSTRINGS=dylan.jones,dylan jones,djones@oneshotautomation
# MONDAY_AGENT_DRY_RUN=0
# CURSOR_AGENT_CMD=C:\Users\dylan.jones\AppData\Local\cursor-agent\agent.cmd
# CURSOR_API_KEY=   # optional if `agent login` already done

# Pushover (local only — real values in .env, never commit)
PUSHOVER_TOKEN=
PUSHOVER_USER=

