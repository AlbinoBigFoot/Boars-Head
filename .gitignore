# Ignition host bind-mounts: track projects + Perspective themes for Git; ignore runtime/cache/DB noise
gateways/**/data/**
!gateways/**/data/projects/
!gateways/**/data/projects/**
# Gateway Perspective themes (light/dark × cool/warm) — required for session.props.theme
!gateways/**/data/config/
!gateways/**/data/config/resources/
!gateways/**/data/config/resources/core/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/themes/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/themes/**
# Gateway Perspective icon libraries (e.g. equipment.svg for nav tree)
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/icons/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/icons/**

# Volatile even under projects if present
gateways/**/data/log/
gateways/**/data/logs/
gateways/**/data/*.log
gateways/**/data/cache/
gateways/**/data/temp/
gateways/**/data/local/
gateways/**/data/.uuid
gateways/**/data/ignition.conf.bak*


# Graphify temp (keep reports if desired)
graphify-out/.graphify_*
graphify-out/cost.json
