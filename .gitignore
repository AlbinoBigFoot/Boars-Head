# Gateway Perspective themes (light/dark × cool/warm) — required for session.props.theme
!gateways/**/data/config/
!gateways/**/data/config/resources/
!gateways/**/data/config/resources/core/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/themes/
!gateways/**/data/config/resources/core/com.inductiveautomation.perspective/themes/**

# Volatile even under projects if present
gateways/**/data/log/
gateways/**/data/logs/
gateways/**/data/*.log
gateways/**/data/cache/
gateways/**/data/temp/
gateways/**/data/local/
