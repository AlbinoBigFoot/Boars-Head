{
  "name": "bh-scada-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Boar's Head SCADA Wiki (Docusaurus): the BH Ignition project, gateway, tags, views, scripting and workflow.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3030",
    "start:container": "docusaurus start --host 0.0.0.0 --port 3000 --poll 1000",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 3031",
    "clear": "docusaurus clear",
    "gen": "python -I tools/gen_all.py",
    "check": "python -I tools/check_docs.py"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  },
  "engines": { "node": ">=20.0" }
}
